{
  "name": "saad",
  "displayName": "Saad",
  "description": "The Saad language: highlighting, errors as you type, go to definition, find references, hover, outline and debugging",
  "version": "0.4.1",
  "publisher": "jakobsaadbye",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jakobsaadbye/Saad",
    "directory": "lsp/vscode"
  },
  "homepage": "https://github.com/jakobsaadbye/Saad/tree/main/lsp",
  "bugs": {
    "url": "https://github.com/jakobsaadbye/Saad/issues"
  },
  "keywords": [
    "saad",
    "language server",
    "lsp",
    "debugger"
  ],
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages",
    "Debuggers"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:saad",
    "onDebugResolve:saad",
    "onDebugDynamicConfigurations:saad",
    "onCommand:saad.debugFile"
  ],
  "contributes": {
    "languages": [
      {
        "id": "saad",
        "aliases": [
          "Saad",
          "saad"
        ],
        "extensions": [
          ".sd"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/saad-light.svg",
          "dark": "./icons/saad-dark.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "saad",
        "scopeName": "source.saad",
        "path": "./syntaxes/saad.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Saad",
      "properties": {
        "saad.compilerPath": {
          "type": "string",
          "default": "saad",
          "description": "The Saad compiler (saad.exe). Absolute, or relative to the workspace. By default bin/saad.exe of the workspace, or saad on the PATH."
        },
        "saad.serverPath": {
          "type": "string",
          "default": "",
          "description": "The language server, built with 'saad build lsp/main.sd'. Absolute, or relative to the workspace. Empty for lsp/build/out.exe of the repository the compiler is in, or of the workspace."
        },
        "saad.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Shows the messages between VS Code and the language server in the Output panel."
        }
      }
    },
    "commands": [
      {
        "command": "saad.restartServer",
        "title": "Saad: Restart the language server"
      },
      {
        "command": "saad.buildServer",
        "title": "Saad: Build the language server"
      },
      {
        "command": "saad.debugFile",
        "title": "Saad: Debug the file",
        "icon": "$(debug-alt)"
      }
    ],
    "breakpoints": [
      {
        "language": "saad"
      }
    ],
    "debuggers": [
      {
        "type": "saad",
        "label": "Saad",
        "languages": [
          "saad"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "default": "${file}",
                "description": "The .sd file of the program, e.g main.sd. It is built with 'saad build --debug'."
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": [],
                "description": "The arguments of the program (os.args())."
              },
              "cwd": {
                "type": "string",
                "default": "${workspaceFolder}",
                "description": "The folder the program runs in."
              },
              "backend": {
                "type": "string",
                "enum": [
                  "x64",
                  "llvm"
                ],
                "default": "x64",
                "description": "x64: the compiler's own backend. llvm: the LLVM backend (saad build --llvm), when the compiler has it."
              },
              "optimization": {
                "type": "integer",
                "enum": [
                  0,
                  1,
                  2,
                  3
                ],
                "description": "The -O of the LLVM backend. -O0 when not given, so each line is where the debugger expects it."
              },
              "stopOnEntry": {
                "type": "boolean",
                "default": false,
                "description": "Stop at the start of the program."
              },
              "env": {
                "type": "object",
                "description": "Environment variables of the program."
              },
              "terminal": {
                "type": "string",
                "enum": [
                  "console",
                  "integrated",
                  "external"
                ],
                "description": "Where the output of the program goes (CodeLLDB's setting)."
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "saad",
            "request": "launch",
            "name": "Debug the Saad program",
            "program": "${file}"
          }
        ],
        "configurationSnippets": [
          {
            "label": "Saad: Debug the program",
            "description": "Builds the program with debug information and debugs it with CodeLLDB",
            "body": {
              "type": "saad",
              "request": "launch",
              "name": "Debug the Saad program",
              "program": "^\"\\${file}\""
            }
          },
          {
            "label": "Saad: Debug the program with LLVM",
            "description": "The same with the LLVM backend",
            "body": {
              "type": "saad",
              "request": "launch",
              "name": "Debug the Saad program (LLVM)",
              "program": "^\"\\${file}\"",
              "backend": "llvm"
            }
          }
        ]
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "saad.debugFile",
          "when": "resourceLangId == saad",
          "group": "navigation@1"
        }
      ],
      "commandPalette": [
        {
          "command": "saad.debugFile",
          "when": "resourceLangId == saad"
        }
      ]
    },
    "semanticTokenModifiers": [
      {
        "id": "overloaded",
        "description": "An operator that the program declares, e.g the + of a + b of two Vec2"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "saad",
        "scopes": {
          "operator.overloaded": [
            "entity.name.function.operator.saad"
          ]
        }
      }
    ]
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "icon": "icons/icon.png",
  "extensionDependencies": [
    "vadimcn.vscode-lldb"
  ]
}
