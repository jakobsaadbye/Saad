{
  "name": "saad",
  "displayName": "Saad",
  "description": "The Saad language: highlighting, errors as you type, go to definition, find references, hover and outline",
  "version": "0.1.0",
  "publisher": "saad",
  "license": "MIT",
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:saad"
  ],
  "contributes": {
    "languages": [
      {
        "id": "saad",
        "aliases": [
          "Saad",
          "saad"
        ],
        "extensions": [
          ".sd"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/saad-light.svg",
          "dark": "./icons/saad-dark.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "saad",
        "scopeName": "source.saad",
        "path": "./syntaxes/saad.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Saad",
      "properties": {
        "saad.compilerPath": {
          "type": "string",
          "default": "saad",
          "description": "The Saad compiler (saad.exe). Absolute, or relative to the workspace. By default bin/saad.exe of the workspace, or saad on the PATH."
        },
        "saad.serverPath": {
          "type": "string",
          "default": "",
          "description": "The language server, built with 'saad build lsp/main.sd'. Absolute, or relative to the workspace. Empty for lsp/build/out.exe of the repository the compiler is in, or of the workspace."
        },
        "saad.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Shows the messages between VS Code and the language server in the Output panel."
        }
      }
    },
    "commands": [
      {
        "command": "saad.restartServer",
        "title": "Saad: Restart the language server"
      },
      {
        "command": "saad.buildServer",
        "title": "Saad: Build the language server"
      }
    ]
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "icon": "icons/icon.png"
}
