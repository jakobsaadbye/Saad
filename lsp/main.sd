// The Saad language server. Editors start it and talk to it over stdin and stdout with the Language Server Protocol.
// It runs 'saad index' on the program of a file and answers from what that writes (docs/lsp.md), for
//
//   * errors and warnings as the code is written (diagnostics)
//   * go to definition, find references and hover
//   * the outline of a file (document symbols) and the symbols of the workspace
//   * completion, signature help and semantic tokens
//   * rename, and a quick fix for the missing cases of a switch
//
// Build it with 'saad build lsp/main.sd'. Usage: saad-lsp [--compiler path/to/saad]

import rpc;
import source;
import project;
import json;
import fmt;
import os;
import io;
import time;

Document :: struct {
    uri:     string;
    path:    string;
    key:     string;       // source.keyOf(path)
    text:    source.Text;
    unsaved: bool;         // The text isn't what is in the file
    overlay: string;       // The file that has the text for the compiler while it isn't saved
    written: bool;         // The overlay has the text
}

documents: [..]Document;
projects:  [..]project.Project;
texts:     Map<string, source.Text>;  // Files that are not open, read from disk. By key
owners:    Map<string, string>;       // The program (the key of its main file) a file is part of, once it is known. By key

generation    := 0;       // Goes up when a document changes, so the projects know they are out of date
compiler      := "saad";
workspaceRoot := "";      // A path, or empty
overlayFolder := "";
overlayCount  := 0;
shuttingDown  := false;
changedKey    := "";      // A document that changed, and whose program is checked when no more messages are waiting
changedPath   := "";

main :: () {
    args := os.args();
    for arg, i in args {
        if arg == "--compiler" && i + 1 < args.count {
            compiler = args[i + 1];
        }
    }
    setupOverlayFolder();
    rpc.log(fmt.sprint("Started. The compiler is %", compiler));

    while true {
        message, ok := rpc.read();
        if !ok {
            break;
        }
        handle(message);

        // While typing, a change comes after the other. The program is checked once they stop
        if changedKey != "" && !io.hasInput() {
            key := changedKey;
            changedKey = "";
            refresh(key, changedPath);
        }
    }
    stop();  // The input ended
}

handle :: (m: rpc.Message) {
    switch m.name {
        case "initialize"                { initialize(m); }
        case "initialized"               { }
        case "shutdown"                  { shuttingDown = true; rpc.respond(m.id, "null"); }
        case "exit"                      { stop(); }
        case "textDocument/didOpen"      { didOpen(m.params); }
        case "textDocument/didChange"    { didChange(m.params); }
        case "textDocument/didSave"      { didSave(m.params); }
        case "textDocument/didClose"     { didClose(m.params); }
        case "textDocument/definition"   { definition(m); }
        case "textDocument/references"   { references(m); }
        case "textDocument/hover"        { hover(m); }
        case "textDocument/documentSymbol" { documentSymbols(m); }
        case "workspace/symbol"          { workspaceSymbols(m); }
        case "textDocument/completion"   { completion(m); }
        case "textDocument/signatureHelp" { signatureHelp(m); }
        case "textDocument/semanticTokens/full" { semanticTokens(m); }
        case "textDocument/prepareRename" { prepareRename(m); }
        case "textDocument/rename"       { rename(m); }
        case "textDocument/codeAction"   { codeActions(m); }
        else {
            if rpc.isRequest(m) {
                rpc.fail(m.id, rpc.MethodNotFound, fmt.sprint("% is not supported", m.name));
            }
            // Other notifications, e.g $/cancelRequest, need nothing
        }
    }
}

//
// The life of the server
//

initialize :: (m: rpc.Message) {
    root := m.params.get("rootUri").asString();
    folders := m.params.get("workspaceFolders");
    if folders.length() > 0 {
        root = folders.at(0).get("uri").asString();
    }
    workspaceRoot = source.pathOf(root);

    configured := m.params.get("initializationOptions").get("compilerPath").asString();
    if configured != "" {
        compiler = configured;
    }
    rpc.log(fmt.sprint("The workspace is '%'. The compiler is %", workspaceRoot, compiler));

    capabilities := "{\"positionEncoding\":\"utf-16\",\"textDocumentSync\":{\"openClose\":true,\"change\":1,\"save\":{\"includeText\":false}},\"definitionProvider\":true,\"referencesProvider\":true,\"hoverProvider\":true,\"documentSymbolProvider\":true,\"workspaceSymbolProvider\":true,\"completionProvider\":{\"triggerCharacters\":[\".\",\"@\"]},\"signatureHelpProvider\":{\"triggerCharacters\":[\"(\",\",\"],\"retriggerCharacters\":[\",\"]},\"semanticTokensProvider\":{\"legend\":{\"tokenTypes\":%,\"tokenModifiers\":%},\"full\":true},\"renameProvider\":{\"prepareProvider\":true},\"codeActionProvider\":{\"codeActionKinds\":[\"quickfix\"]}}";
    capabilities = fmt.sprint(capabilities, json.encode(TokenTypes), json.encode(TokenModifiers));
    rpc.respond(m.id, fmt.sprint("{\"capabilities\":%,\"serverInfo\":{\"name\":\"saad-lsp\",\"version\":\"0.3.0\"}}", capabilities));
}

// The editor asks the server to end after asking it to shut down. Otherwise the server ends with an error
stop :: () {
    for doc in documents {
        _ := os.removeFile(doc.overlay); // It may not be there
    }
    if shuttingDown {
        os.exit(0);
    }
    os.exit(1);
}

setupOverlayFolder :: () {
    overlayFolder = "/tmp";
    for name in ["TEMP", "TMPDIR"] {
        folder, ok := os.getEnv(name);
        if ok && folder != "" {
            overlayFolder = folder;
            return;
        }
    }
}

//
// Documents
//

didOpen :: (params: json.Value) {
    item := params.get("textDocument");
    uri  := item.get("uri").asString();
    path := source.pathOf(uri);
    if path == "" {
        return;
    }

    doc := findDocument(source.keyOf(path));
    if doc == null {
        d: Document;
        d.uri  = uri;
        d.path = path;
        d.key  = source.keyOf(path);
        overlayCount += 1;
        d.overlay = fmt.sprint("%/saad-lsp-%-%.sd", overlayFolder, time.now().unix(), overlayCount);
        documents.add(d);
        doc = documents.indexRef(documents.count - 1);
    }
    doc.text    = source.newText(item.get("text").asString().copy());
    onDisk, notRead := os.readFile(path);
    doc.unsaved = notRead != null || onDisk != doc.text.text;
    onDisk.free();
    doc.written = false;
    generation += 1;

    refresh(doc.key, doc.path);
}

didChange :: (params: json.Value) {
    uri := params.get("textDocument").get("uri").asString();
    doc := findDocument(source.keyOf(source.pathOf(uri)));
    changes := params.get("contentChanges");
    if doc == null || changes.length() == 0 {
        return;
    }

    // The whole text is sent (textDocumentSync.change is 1)
    doc.text.text.free();
    doc.text    = source.newText(changes.at(changes.length() - 1).get("text").asString().copy());
    doc.unsaved = true;
    doc.written = false;
    generation += 1;

    // Checked in main when no more messages are waiting. Another document that changed before is checked now
    if changedKey != "" && changedKey != doc.key {
        refresh(changedKey, changedPath);
    }
    changedKey  = doc.key;
    changedPath = doc.path;
}

didSave :: (params: json.Value) {
    uri  := params.get("textDocument").get("uri").asString();
    path := source.pathOf(uri);
    key  := source.keyOf(path);
    doc  := findDocument(key);
    if doc != null {
        doc.unsaved = false;
    }
    generation += 1;
    if changedKey == key {
        changedKey = "";
    }
    refresh(key, path);
}

didClose :: (params: json.Value) {
    uri := params.get("textDocument").get("uri").asString();
    key := source.keyOf(source.pathOf(uri));
    for doc, i in documents {
        if doc.key == key {
            _ := os.removeFile(doc.overlay); // It may not be there
            documents.removeAt(i);
            generation += 1;
            return;
        }
    }
}

findDocument :: (key: string) -> *Document {
    for doc, i in documents {
        if doc.key == key {
            return documents.indexRef(i);
        }
    }
    return null;
}

// Checks the program of the file again, and the other programs that have it, and sends their diagnostics
refresh :: (key: string, path: string) {
    projectFor(key, path);
    for p, i in projects {
        if !p.retired && p.fileNumber(key) >= 0 {
            update(i);
        }
    }
}

//
// Projects
//

// The project to answer a question about a file with. It is updated. -1 if there is none
projectFor :: (key: string, path: string) -> int {
    // The standard library is one program, so the uses of a name in all of it are found. A program that uses it only
    // has the parts it uses in its index
    if isInStandardLibrary(key) {
        for p, i in projects {
            if p.options == AllStd {
                update(i);
                return i as int;
            }
        }
        i := projectOf(path);
        projects.indexRef(i).options = AllStd;
        update(i);
        return i;
    }

    // The program it was part of. A program with errors keeps its files even when the errors leave one out for now,
    // e.g while an import of it is being written, so the file isn't answered as a program of its own meanwhile
    if owners.has(key) {
        i := projectOf(owners.get(key, ""));
        update(i);
        owner := projects.indexRef(i);
        if owner.fileNumber(key) >= 0 || owner.index.diagnostics.count > 0 {
            return i;
        }
        rpc.log(fmt.sprint("% isn't part of % anymore", path, owner.root));
        owners.remove(key);
    }

    // A program that has the file, other than the file on its own
    for p, i in projects {
        if !p.retired && p.fileNumber(key) >= 0 && source.keyOf(p.root) != key {
            update(i);
            if projects[i].fileNumber(key) >= 0 {
                own(key, i as int);
                return i as int;
            }
        }
    }

    // A main.sd in the folder of the file, or a folder above it in the workspace
    folder := source.folderOf(path);
    for level in 0..5 {
        if folder == "" {
            break;
        }
        candidate := fmt.sprint("%/main.sd", folder);
        if source.keyOf(candidate) != key && os.fileExists(candidate) {
            i := projectOf(candidate);
            update(i);
            if projects[i].fileNumber(key) >= 0 {
                own(key, i);
                return i;
            }
        }
        if source.keyOf(folder) == source.keyOf(workspaceRoot) {
            break;
        }
        folder = source.folderOf(folder);
    }

    // The file on its own
    i := projectOf(path);
    update(i);
    return i;
}

AllStd :: " --all-std";

// The file is part of the program. The project of the file on its own, if there is one, isn't needed anymore: its
// diagnostics are cleared, as the program sends the file's
own :: (key: string, program: int) {
    owners.set(key.copy(), source.keyOf(projects[program].root));
    for p, i in projects {
        if i != program && !p.retired && source.keyOf(p.root) == key {
            alone := projects.indexRef(i);
            alone.retired = true;
            alone.generation = -1;
            for published in alone.published {
                if published != key {
                    rpc.notify("textDocument/publishDiagnostics", fmt.sprint("{\"uri\":%,\"diagnostics\":[]}", json.encode(uriFor(published, published))));
                }
            }
            alone.published.clear();
            rpc.log(fmt.sprint("% is part of %", alone.root, projects[program].root));
        }
    }
}

// If the program sends the diagnostics of the file: it is the file's program, or the file has none yet
isOwnerOf :: (p: *project.Project, key: string) -> bool {
    if !owners.has(key) {
        return true;
    }
    return owners.get(key, "") == source.keyOf(p.root);
}

// If the file is in the standard library, which is the std folder next to the bin folder of the compiler
isInStandardLibrary :: (key: string) -> bool {
    bin := source.folderOf(compiler);
    if bin == "" {
        return false;  // The compiler is on the PATH, so where it is isn't known
    }
    std := source.keyOf(fmt.sprint("%/std/", source.folderOf(bin)));
    return key.startsWith(std);
}

// The project with the main file. It is made if there is none
projectOf :: (root: string) -> int {
    key := source.keyOf(root);
    for p, i in projects {
        if source.keyOf(p.root) == key {
            projects.indexRef(i).retired = false;
            return i as int;
        }
    }
    p: project.Project;
    p.root = root;
    projects.add(p);
    return (projects.count - 1) as int;
}

// Indexes the project again if a document changed since it was indexed, and sends its diagnostics
update :: (i: int) {
    p := projects.indexRef(i);
    if p.generation == generation {
        return;
    }

    watch := time.startStopwatch();
    ok := p.run(compiler, overlayOptions());
    p.generation = generation;
    texts.clear();  // Files may have changed on disk too
    if !ok {
        return;
    }
    rpc.log(fmt.sprint("Indexed % in % ms: % files, % symbols, % references, % diagnostics", p.root, watch.milliseconds() as int, p.index.files.count, p.index.symbols.count, p.index.references.count, p.index.diagnostics.count));
    publishDiagnostics(p);
}

// The --overlay options for the documents that aren't saved. Their text is written to their overlay files
overlayOptions :: () -> string {
    sb := fmt.newStringBuilder(256);
    for doc, d in documents {
        if !doc.unsaved {
            continue;
        }
        if !doc.written {
            documents.indexRef(d).written = os.writeFile(doc.overlay, doc.text.text) == null;
        }
        sb.add(" --overlay \"%=%\"", doc.path, doc.overlay);
    }
    return sb.toString();
}

// Sends the diagnostics of every file of the project, and clears the ones it sent before for files that have none now
publishDiagnostics :: (p: *project.Project) {
    keys: [..]string;   // Of the files with diagnostics
    paths: [..]string;
    for d in p.index.diagnostics {
        path := d.file;
        if path == "" { path = p.root; }
        key := source.keyOf(path);
        if !keys.contains(key) && isOwnerOf(p, key) {
            keys.add(key);
            paths.add(path);
        }
    }

    // An open file of the project gets them too when it has none, so the editor clears what it shows
    with := keys.count;
    for doc in documents {
        if p.fileNumber(doc.key) >= 0 && !keys.contains(doc.key) && isOwnerOf(p, doc.key) {
            keys.add(doc.key);
            paths.add(doc.path);
        }
    }

    for key, k in keys {
        path := paths[k];
        sb := fmt.newStringBuilder(1024);
        first := true;
        for d in p.index.diagnostics {
            file := d.file;
            if file == "" { file = p.root; }
            if source.keyOf(file) != key {
                continue;
            }
            if !first { sb.addChar(','); }
            first = false;
            sb.addString(diagnosticJson(d, key, path));
        }
        rpc.notify("textDocument/publishDiagnostics", fmt.sprint("{\"uri\":%,\"diagnostics\":[%]}", json.encode(uriFor(key, path)), sb.toString()));
    }

    for key in p.published {
        if !keys.contains(key) && isOwnerOf(p, key) {
            rpc.notify("textDocument/publishDiagnostics", fmt.sprint("{\"uri\":%,\"diagnostics\":[]}", json.encode(uriFor(key, key))));
        }
    }
    keys.count = with;  // Only the files that had diagnostics
    p.published.free();
    p.published = keys;
}

diagnosticJson :: (d: project.Diagnostic, key: string, path: string) -> string {
    related := fmt.newStringBuilder(128);
    for r, i in d.related {
        if i > 0 { related.addChar(','); }
        file := r.file;
        if file == "" { file = path; }
        related.addString(fmt.sprint("{\"location\":%,\"message\":%}", locationJson(source.keyOf(file), file, r.range), json.encode(r.message)));
    }
    return fmt.sprint("{\"range\":%,\"severity\":%,\"source\":\"saad\",\"message\":%,\"relatedInformation\":[%]}",
        rangeJson(key, path, d.range), d.severity, json.encode(d.message), related.toString());
}

//
// Positions: the compiler counts bytes, the editor UTF-16 units
//

// The text of a file: the editor's if it is open, otherwise the file on disk
textOf :: (key: string, path: string) -> *source.Text {
    doc := findDocument(key);
    if doc != null {
        return &doc.text;
    }
    if !texts.has(key) {
        text, _ := os.readFile(path);   // A file that isn't there is empty
        texts.set(key, source.newText(text));
    }
    return texts.indexRef(key);
}

rangeJson :: (key: string, path: string, r: project.Range) -> string {
    text := textOf(key, path);
    startLine := max(r.start.line, 0);
    endLine   := max(r.end.line, 0);
    start := source.toUtf16(text.line(startLine), max(r.start.character, 0));
    end   := source.toUtf16(text.line(endLine), max(r.end.character, 0));
    return fmt.sprint("{\"start\":{\"line\":%,\"character\":%},\"end\":{\"line\":%,\"character\":%}}", startLine, start, endLine, end);
}

locationJson :: (key: string, path: string, r: project.Range) -> string {
    return fmt.sprint("{\"uri\":%,\"range\":%}", json.encode(uriFor(key, path)), rangeJson(key, path, r));
}

// The URI of a file: the editor's own for an open document, so it is written the same
uriFor :: (key: string, path: string) -> string {
    doc := findDocument(key);
    if doc != null {
        return doc.uri;
    }
    return source.uriOf(path);
}

max :: (a: int, b: int) -> int {
    if a > b { return a; }
    return b;
}

//
// Questions about a position in a file
//

// Where a request points: the project, the file in it and the position as the compiler counts it
Place :: struct {
    program: int = -1;    // In projects
    file:    int = -1;
    at:      project.Position;
}

placeOf :: (params: json.Value) -> Place {
    uri  := params.get("textDocument").get("uri").asString();
    path := source.pathOf(uri);
    if path == "" {
        return Place{};
    }
    key := source.keyOf(path);

    place: Place;
    place.program = projectFor(key, path);
    if place.program < 0 {
        return place;
    }
    place.file = projects[place.program].fileNumber(key);

    position := params.get("position");
    line := position.get("line").asNumber() as int;
    character := position.get("character").asNumber() as int;
    place.at.line = line;
    place.at.character = source.toByte(textOf(key, path).line(line), character);
    return place;
}

// The symbol of the name at the place, or null
symbolAt :: (place: Place) -> *project.Symbol {
    if place.program < 0 || place.file < 0 {
        return null;
    }
    p := projects.indexRef(place.program);
    return p.symbol(p.symbolAt(place.file, place.at));
}

symbolLocation :: (p: *project.Project, file: int, r: project.Range) -> string {
    path := p.index.files[file];
    return locationJson(source.keyOf(path), path, r);
}

definition :: (m: rpc.Message) {
    place := placeOf(m.params);
    sym := symbolAt(place);
    if sym == null {
        rpc.respond(m.id, "null");
        return;
    }
    p := projects.indexRef(place.program);
    rpc.respond(m.id, symbolLocation(p, sym.file, sym.nameRange));
}

references :: (m: rpc.Message) {
    place := placeOf(m.params);
    sym := symbolAt(place);
    if sym == null {
        rpc.respond(m.id, "[]");
        return;
    }
    p := projects.indexRef(place.program);

    sb := fmt.newStringBuilder(1024);
    sb.addChar('[');
    count := 0;
    if m.params.get("context").get("includeDeclaration").asBool() {
        sb.addString(symbolLocation(p, sym.file, sym.nameRange));
        count += 1;
    }
    for ref in p.index.references {
        if ref.symbol == sym.id {
            if count > 0 { sb.addChar(','); }
            sb.addString(symbolLocation(p, ref.file, ref.range));
            count += 1;
        }
    }
    sb.addChar(']');
    rpc.respond(m.id, sb.toString());
}

hover :: (m: rpc.Message) {
    place := placeOf(m.params);
    sym := symbolAt(place);
    if sym == null {
        rpc.respond(m.id, "null");
        return;
    }
    p := projects.indexRef(place.program);

    text := fmt.sprint("```saad\n%\n```", signatureOf(p, sym));
    if sym.doc != "" {
        text = fmt.sprint("%\n\n%", text, sym.doc);
    }
    rpc.respond(m.id, fmt.sprint("{\"contents\":{\"kind\":\"markdown\",\"value\":%}}", json.encode(text)));
}

// How a symbol is shown, e.g "area :: method (self: *Circle) -> f32" or "Vec2.x: f32"
signatureOf :: (p: *project.Project, sym: *project.Symbol) -> string {
    name := sym.name;
    container := p.symbol(sym.container);
    if container != null && (sym.kind == "field" || sym.kind == "variant" || sym.kind == "enumMember") {
        name = fmt.sprint("%.%", container.name, sym.name);
    }

    return switch sym.kind {
        case "function"
        case "method"
        case "struct"
        case "union"
        case "interface"
        case "enum"
        case "typeAlias"     => fmt.sprint("% :: %", name, sym.detail);
        case "namespace"     => fmt.sprint("namespace %", name);
        case "enumMember"    => fmt.sprint("% = %", name, sym.detail);
        case "constant"      => fmt.sprint("% : % : (constant)", name, sym.detail);
        case "typeParameter" => fmt.sprint("% (a type parameter)", name);
        else                 => fmt.sprint("%: %", name, sym.detail);
    };
}

//
// Symbols
//

// The SymbolKind of LSP
symbolKind :: (kind: string) -> int {
    return switch kind {
        case "namespace"     => 3;
        case "method"        => 6;
        case "field"         => 8;
        case "enum"          => 10;
        case "function"      => 12;
        case "constant"      => 14;
        case "enumMember"
        case "variant"       => 22;
        case "struct"
        case "union"         => 23;
        case "interface"     => 11;
        case "typeAlias"     => 5;
        case "typeParameter" => 26;
        else                 => 13;  // Variable
    };
}

documentSymbols :: (m: rpc.Message) {
    uri  := m.params.get("textDocument").get("uri").asString();
    path := source.pathOf(uri);
    key  := source.keyOf(path);
    i    := projectFor(key, path);
    if i < 0 {
        rpc.respond(m.id, "[]");
        return;
    }
    p    := projects.indexRef(i);
    file := p.fileNumber(key);

    // The symbols of the file. One is in another if it is declared in it, e.g a field in its struct
    ids: [..]int;
    for sym in p.index.symbols {
        if sym.file == file && !project.isLocal(sym.kind) {
            ids.add(sym.id);
        }
    }

    sb := fmt.newStringBuilder(4096);
    sb.addChar('[');
    first := true;
    for id in ids {
        if parentIn(p, id, ids) < 0 {
            if !first { sb.addChar(','); }
            first = false;
            addDocumentSymbol(&sb, p, id, ids, key, path);
        }
    }
    sb.addChar(']');
    rpc.respond(m.id, sb.toString());
}

// The symbol the symbol is shown in, or -1. A method declared outside of its struct is shown on its own
parentIn :: (p: *project.Project, id: int, ids: [..]int) -> int {
    sym := p.symbol(id);
    parent := p.symbol(sym.container);
    if parent == null || !ids.contains(parent.id) {
        return -1;
    }
    if !project.contains(parent.range, sym.nameRange.start, true) {
        return -1;
    }
    return parent.id;
}

addDocumentSymbol :: (sb: *fmt.StringBuilder, p: *project.Project, id: int, ids: [..]int, key: string, path: string) {
    sym := p.symbol(id);
    sb.add("{\"name\":%,\"detail\":%,\"kind\":%,\"range\":%,\"selectionRange\":%,\"children\":[",
        json.encode(sym.name), json.encode(sym.detail), symbolKind(sym.kind), rangeJson(key, path, sym.range), rangeJson(key, path, sym.nameRange));
    first := true;
    for child in ids {
        if parentIn(p, child, ids) == id {
            if !first { sb.addChar(','); }
            first = false;
            addDocumentSymbol(sb, p, child, ids, key, path);
        }
    }
    sb.addString("]}");
}

workspaceSymbols :: (m: rpc.Message) {
    query := m.params.get("query").asString().toLower();

    // Without an open file, the program of the workspace
    if projects.count == 0 && workspaceRoot != "" {
        main := fmt.sprint("%/main.sd", workspaceRoot);
        if os.fileExists(main) {
            update(projectOf(main));
        }
    }

    sb := fmt.newStringBuilder(4096);
    sb.addChar('[');
    seen: [..]string;  // A symbol can be in more than one project
    for _, i in projects {
        if projects[i].retired {
            continue;
        }
        update(i);
        p := projects.indexRef(i);
        for sym in p.index.symbols {
            if seen.count >= 500 {
                break;
            }
            if project.isLocal(sym.kind) || !matches(sym.name.toLower(), query) {
                continue;
            }
            path := p.index.files[sym.file];
            id := fmt.sprint("%:%:%", source.keyOf(path), sym.nameRange.start.line, sym.nameRange.start.character);
            if seen.contains(id) {
                continue;
            }
            if seen.count > 0 { sb.addChar(','); }
            seen.add(id);

            container := "";
            parent := p.symbol(sym.container);
            if parent != null { container = parent.name; }
            sb.add("{\"name\":%,\"kind\":%,\"location\":%,\"containerName\":%}",
                json.encode(sym.name), symbolKind(sym.kind), symbolLocation(p, sym.file, sym.nameRange), json.encode(container));
        }
    }
    sb.addChar(']');
    rpc.respond(m.id, sb.toString());
}

// If the letters of the query are in the name in the same order, e.g "nwrd" matches "newRandom"
matches :: (name: string, query: string) -> bool {
    q := 0;
    for ch in name {
        if q < query.len && ch == query[q] {
            q += 1;
        }
    }
    return q == query.len;
}

//
// Completion and signature help, from 'saad complete' (docs/lsp.md)
//

// What can be written at the place of the request. ok is false when the compiler couldn't answer
completionsAt :: (params: json.Value) -> project.Completions, bool {
    uri  := params.get("textDocument").get("uri").asString();
    path := source.pathOf(uri);
    none: project.Completions;
    if path == "" {
        return none, false;
    }
    // The compiler checks the text as it is now, so the project isn't indexed first. That is done when the typing stops
    key := source.keyOf(path);
    program := -1;
    if owners.has(key) {
        program = projectOf(owners.get(key, ""));
    }
    for p, i in projects {
        if program < 0 && !p.retired && p.fileNumber(key) >= 0 {
            program = i as int;
        }
    }
    if program < 0 {
        program = projectFor(key, path);
    }
    if program < 0 {
        return none, false;
    }

    position := params.get("position");
    at: project.Position;
    at.line = position.get("line").asNumber() as int;
    at.character = source.toByte(textOf(key, path).line(at.line), position.get("character").asNumber() as int);
    p := projects.indexRef(program);
    return p.complete(compiler, overlayOptions(), path, at);
}

// The line an import is added at: after the imports, uses and namespace line at the top of the file, or the first line
importLine :: (text: *source.Text) -> int {
    after := 0;
    for i in 0..text.lines.count {
        line := text.line(i as int);
        if line.startsWith("import ") || line.startsWith("use ") || line.startsWith("namespace ") {
            after = i as int + 1;
        } else if line != "" && !line.startsWith("//") && !line.startsWith("\r") {
            break;
        }
    }
    return after;
}

// The edit that adds 'import name;' to the file, for additionalTextEdits
importEdit :: (text: *source.Text, name: string) -> string {
    line := importLine(text);
    return fmt.sprint("[{\"range\":{\"start\":{\"line\":%,\"character\":0},\"end\":{\"line\":%,\"character\":0}},\"newText\":%}]",
        line, line, json.encode(fmt.sprint("import %;\n", name)));
}

// The CompletionItemKind of LSP
completionKind :: (kind: string) -> int {
    return switch kind {
        case "method"        => 2;
        case "function"      => 3;
        case "field"         => 5;
        case "variable"
        case "parameter"
        case "global"        => 6;
        case "namespace"     => 9;
        case "enum"          => 13;
        case "keyword"       => 14;
        case "enumMember"
        case "variant"       => 20;
        case "constant"      => 21;
        case "struct"
        case "union"
        case "typeAlias"     => 22;
        case "interface"     => 8;
        case "typeParameter" => 25;
        else                 => 1;
    };
}

completion :: (m: rpc.Message) {
    result, ok := completionsAt(m.params);
    if !ok {
        rpc.respond(m.id, "[]");
        return;
    }
    path := source.pathOf(m.params.get("textDocument").get("uri").asString());
    text := textOf(source.keyOf(path), path);
    position := m.params.get("position");
    line := text.line(position.get("line").asNumber() as int);
    called := isCalled(line, source.toByte(line, position.get("character").asNumber() as int));

    sb := fmt.newStringBuilder(4096);
    sb.addChar('[');
    for item, i in result.items {
        if i > 0 { sb.addChar(','); }
        sb.addString(fmt.sprint("{\"label\":%,\"kind\":%,\"detail\":%", json.encode(item.label), completionKind(item.kind), json.encode(item.detail)));
        if item.doc != "" {
            sb.addString(fmt.sprint(",\"documentation\":{\"kind\":\"markdown\",\"value\":%}", json.encode(item.doc)));
        }
        if item.insert != "" {
            sb.addString(fmt.sprint(",\"insertText\":%", json.encode(item.insert)));
        } else if (item.kind == "function" || item.kind == "method") && !called {
            // The parentheses of the call, with the cursor between them when it takes arguments
            if item.parameters == 0 {
                sb.addString(fmt.sprint(",\"insertText\":%", json.encode(fmt.sprint("%()", item.label))));
            } else {
                sb.addString(fmt.sprint(",\"insertText\":%,\"insertTextFormat\":2", json.encode(fmt.sprint("%($0)", item.label))));
                sb.addString(",\"command\":{\"title\":\"Signature help\",\"command\":\"editor.action.triggerParameterHints\"}");
            }
        }
        // A namespace that isn't imported, or a name of one, adds the import
        needs := item.needsImport;
        if needs == "" {
            needs = result.missingImport;
        }
        if needs != "" {
            sb.addString(fmt.sprint(",\"additionalTextEdits\":%", importEdit(text, needs)));
        }
        // Keywords after the names of the program
        if item.kind == "keyword" {
            sb.addString(fmt.sprint(",\"sortText\":%", json.encode(fmt.sprint("~%", item.label))));
        }
        sb.addChar('}');
    }
    sb.addChar(']');
    rpc.respond(m.id, sb.toString());
}

// If the name at the byte is followed by a '(', e.g when 'pri' of 'pri(x)' is completed, so no parentheses are added
isCalled :: (line: string, at: int) -> bool {
    i := at;
    while i < line.len && (line[i].isLetterOrDigit() || line[i] == '_') { i += 1; }
    while i < line.len && line[i] == ' ' { i += 1; }
    return i < line.len && line[i] == '(';
}

signatureHelp :: (m: rpc.Message) {
    result, ok := completionsAt(m.params);
    if !ok || result.signature == null {
        rpc.respond(m.id, "null");
        return;
    }
    signature := result.signature;
    parameters := fmt.newStringBuilder(256);
    for parameter, i in signature.parameters {
        if i > 0 { parameters.addChar(','); }
        parameters.addString(fmt.sprint("{\"label\":%}", json.encode(parameter)));
    }
    doc := "";
    if signature.doc != "" {
        doc = fmt.sprint(",\"documentation\":{\"kind\":\"markdown\",\"value\":%}", json.encode(signature.doc));
    }
    rpc.respond(m.id, fmt.sprint("{\"signatures\":[{\"label\":%,\"parameters\":[%]%}],\"activeSignature\":0,\"activeParameter\":%}",
        json.encode(signature.label), parameters.toString(), doc, signature.active));
}

//
// Semantic tokens: the names of a file by what they are, from the index. The editor colors the rest with its grammar
//

TokenTypes     :: ["namespace", "type", "struct", "enum", "enumMember", "function", "method", "property", "variable", "parameter", "typeParameter"];
TokenModifiers :: ["declaration", "readonly"];

// The index of the token type of a kind of symbol in TokenTypes
tokenType :: (kind: string) -> int {
    return switch kind {
        case "namespace"     => 0;
        case "typeAlias"     => 1;
        case "struct"
        case "union"
        case "interface"     => 2;
        case "enum"          => 3;
        case "enumMember"
        case "variant"       => 4;
        case "function"      => 5;
        case "method"        => 6;
        case "field"         => 7;
        case "parameter"     => 9;
        case "typeParameter" => 10;
        else                 => 8;  // variable, global and constant
    };
}

//
// Rename: the declaration of the name at the position and every use of it, in every file of the program
//

// Where the name is in a range of a use, e.g the 'print' of 'fmt.print'. ok is false when it isn't written there, e.g
// a use through the alias of an import
nameIn :: (key: string, path: string, r: project.Range, name: string) -> project.Range, bool {
    if r.start.line != r.end.line {
        return r, false;
    }
    line := textOf(key, path).line(r.start.line);
    if r.start.character < 0 || r.end.character > line.len || r.end.character - r.start.character < name.len {
        return r, false;
    }
    text := line.slice(r.start.character, r.end.character);
    if text == name {
        return r, true;
    }
    // 'ns.name': the name after the last '.'
    if text.endsWith(name) && text[text.len - name.len - 1] == '.' {
        found := r;
        found.start.character = r.end.character - name.len as int;
        return found, true;
    }
    return r, false;
}

// The symbol to rename at the place, or null with why not
renameTarget :: (place: Place) -> *project.Symbol, string {
    sym := symbolAt(place);
    if sym == null {
        return null, "There is no name here to rename";
    }
    if sym.kind == "namespace" {
        return null, "A namespace is renamed by the 'namespace' line of its files";
    }
    if sym.name == "self" {
        return null, "'self' can't be renamed";
    }
    p := projects.indexRef(place.program);
    declaredIn := source.keyOf(p.index.files[sym.file]);
    if isInStandardLibrary(declaredIn) && p.options != AllStd {
        return null, fmt.sprint("'%' is in the standard library. Rename it in a file of the standard library, where all of its uses are known", sym.name);
    }
    return sym, "";
}

prepareRename :: (m: rpc.Message) {
    place := placeOf(m.params);
    sym, why := renameTarget(place);
    if sym == null {
        rpc.fail(m.id, rpc.RequestFailed, why);
        return;
    }
    // The name under the cursor
    p := projects.indexRef(place.program);
    path := p.index.files[place.file];
    key := source.keyOf(path);
    for ref in p.index.references {
        if ref.file == place.file && ref.symbol == sym.id && project.contains(ref.range, place.at, true) {
            r, ok := nameIn(key, path, ref.range, sym.name);
            if ok {
                rpc.respond(m.id, fmt.sprint("{\"range\":%,\"placeholder\":%}", rangeJson(key, path, r), json.encode(sym.name)));
                return;
            }
        }
    }
    rpc.respond(m.id, fmt.sprint("{\"range\":%,\"placeholder\":%}", rangeJson(source.keyOf(p.index.files[sym.file]), p.index.files[sym.file], sym.nameRange), json.encode(sym.name)));
}

rename :: (m: rpc.Message) {
    newName := m.params.get("newName").asString();
    if !isName(newName) {
        rpc.fail(m.id, rpc.RequestFailed, fmt.sprint("'%' isn't a name", newName));
        return;
    }
    place := placeOf(m.params);
    sym, why := renameTarget(place);
    if sym == null {
        rpc.fail(m.id, rpc.RequestFailed, why);
        return;
    }
    p := projects.indexRef(place.program);

    // The edits of each file, as JSON
    files: [..]int;
    edits: [..]fmt.StringBuilder;
    seen:  [..]string;
    places: [..]project.Reference;
    places.add(project.Reference{file: sym.file, range: sym.nameRange, symbol: sym.id});
    for ref in p.index.references {
        if ref.symbol == sym.id {
            places.add(ref);
        }
    }
    for at in places {
        path := p.index.files[at.file];
        key := source.keyOf(path);
        r, ok := nameIn(key, path, at.range, sym.name);
        if !ok {
            continue;
        }
        id := fmt.sprint("%:%:%", at.file, r.start.line, r.start.character);
        if seen.contains(id) {
            continue;
        }
        seen.add(id);
        k := files.indexOf(at.file);
        if k < 0 {
            files.add(at.file);
            edits.add(fmt.newStringBuilder(256));
            k = (files.count - 1) as int;
        } else {
            edits.indexRef(k).addChar(',');
        }
        edits.indexRef(k).add("{\"range\":%,\"newText\":%}", rangeJson(key, path, r), json.encode(newName));
    }

    sb := fmt.newStringBuilder(1024);
    sb.addString("{\"changes\":{");
    for file, k in files {
        if k > 0 { sb.addChar(','); }
        path := p.index.files[file];
        sb.add("%:[%]", json.encode(uriFor(source.keyOf(path), path)), edits[k].toString());
    }
    sb.addString("}}");
    rpc.respond(m.id, sb.toString());
}

// If the text is a name that isn't a keyword, e.g a new name for a rename
isName :: (text: string) -> bool {
    if text.len == 0 {
        return false;
    }
    for ch, i in text {
        letter := (ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') || ch == '_';
        digit  := ch >= '0' && ch <= '9';
        if !letter && !(digit && i > 0) {
            return false;
        }
    }
    return !Keywords.contains(text);
}

Keywords :: ["if", "else", "for", "while", "in", "switch", "case", "return", "defer", "try", "catch", "throw", "break", "continue", "struct", "union", "interface", "enum", "enumflags", "newtype", "default",
             "method", "import", "use", "namespace", "extern", "as", "new", "assert", "typeof", "sizeof", "true", "false",
             "null", "self", "int", "uint", "float", "bool", "string", "any", "void", "u8", "u16", "u32", "u64", "i8", "i16",
             "i32", "i64", "f32", "f64", "xx"];

//
// Code actions: the missing cases of a switch
//

// For the error "The switch doesn't handle .closed, .locked of Status", the cases .closed and .locked are added before
// the '}' of the switch
codeActions :: (m: rpc.Message) {
    uri  := m.params.get("textDocument").get("uri").asString();
    path := source.pathOf(uri);
    key  := source.keyOf(path);
    diagnostics := m.params.get("context").get("diagnostics");

    sb := fmt.newStringBuilder(512);
    sb.addChar('[');
    count := 0;
    for d in 0..diagnostics.length() {
        diagnostic := diagnostics.at(d);
        message := diagnostic.get("message").asString();
        prefix := "The switch doesn't handle ";
        if !message.startsWith(prefix) {
            continue;
        }
        end := message.indexOf(" of ");
        if end < 0 {
            continue;
        }
        values := message.slice(prefix.len as int, end).split(", ");
        start := diagnostic.get("range").get("start");
        edit, ok := missingCasesEdit(key, path, start.get("line").asNumber() as int, start.get("character").asNumber() as int, values);
        if !ok {
            continue;
        }
        if count > 0 { sb.addChar(','); }
        count += 1;
        title := "Add the missing case";
        if values.count > 1 { title = "Add the missing cases"; }
        sb.add("{\"title\":%,\"kind\":\"quickfix\",\"isPreferred\":true,\"diagnostics\":[%],\"edit\":{\"changes\":{%:[%]}}}",
            json.encode(title), json.encode(diagnostic), json.encode(uri), edit);
    }
    sb.addChar(']');
    rpc.respond(m.id, sb.toString());
}

// The edit that adds the cases to the switch whose value starts at the position (UTF-16). ok is false when the switch
// isn't found
missingCasesEdit :: (key: string, path: string, line: int, utf16: int, values: [..]string) -> string, bool {
    text := textOf(key, path);
    if line < 0 || line >= text.lines.count {
        return "", false;
    }
    at := text.lines[line] + source.toByte(text.line(line), utf16);

    // The '{' of the switch, then its '}'
    open := -1;
    for i in at..text.text.len {
        if text.text[i] == '{' { open = i as int; break; }
        if text.text[i] == ';' || text.text[i] == '}' { break; }
    }
    if open < 0 {
        return "", false;
    }
    close := matchingBrace(text.text, open);
    if close < 0 {
        return "", false;
    }

    // The line of the '}' and its indentation, and the indentation of the cases
    closeLine := lineOf(text, close);
    lineStart := text.lines[closeLine];
    indent := text.text.slice(lineStart as int, lineStart as int + leadingSpaces(text.line(closeLine)));
    caseIndent := fmt.sprint("%    ", indent);
    isExpression := false;
    body := text.text.slice(open + 1, close);
    caseAt := body.indexOf("case ");
    if caseAt >= 0 {
        lineBegin := caseAt;
        while lineBegin > 0 && body[lineBegin - 1] != '\n' { lineBegin -= 1; }
        caseIndent = body.slice(lineBegin, caseAt);
        isExpression = body.indexOf("=>") >= 0;
    }
    onItsOwnLine := text.text.slice(lineStart as int, close).len == leadingSpaces(text.line(closeLine));

    insert := fmt.newStringBuilder(128);
    if !onItsOwnLine {
        insert.addChar('\n');
    }
    for value in values {
        if isExpression {
            insert.add("%case % => \n", caseIndent, value);
        } else {
            insert.add("%case % { }\n", caseIndent, value);
        }
    }
    if !onItsOwnLine {
        insert.addString(indent);
    }
    position := closeLine;
    character := 0;
    if !onItsOwnLine {
        character = source.toUtf16(text.line(closeLine), close - lineStart as int);
    }
    return fmt.sprint("{\"range\":{\"start\":{\"line\":%,\"character\":%},\"end\":{\"line\":%,\"character\":%}},\"newText\":%}",
        position, character, position, character, json.encode(insert.toString())), true;
}

// The '}' of the '{' at open, skipping strings, characters and comments. -1 when there is none
matchingBrace :: (text: string, open: int) -> int {
    depth := 0;
    i := open;
    while i < text.len {
        ch := text[i];
        if ch == '"' || ch == '\'' {
            i += 1;
            while i < text.len && text[i] != ch && text[i] != '\n' {
                if text[i] == '\\' { i += 1; }
                i += 1;
            }
        } else if ch == '/' && i + 1 < text.len && text[i + 1] == '/' {
            while i < text.len && text[i] != '\n' { i += 1; }
        } else if ch == '{' {
            depth += 1;
        } else if ch == '}' {
            depth -= 1;
            if depth == 0 {
                return i as int;
            }
        }
        i += 1;
    }
    return -1;
}

lineOf :: (text: *source.Text, offset: int) -> int {
    line := 0;
    for start, n in text.lines {
        if start <= offset {
            line = n as int;
        }
    }
    return line;
}

leadingSpaces :: (line: string) -> int {
    n := 0;
    while n < line.len && (line[n] == ' ' || line[n] == '\t') { n += 1; }
    return n;
}

// A name of the file, in bytes as the compiler counts
Token :: struct {
    line:      int;
    start:     int;
    end:       int;
    kind:      int;
    modifiers: int;
}

semanticTokens :: (m: rpc.Message) {
    uri  := m.params.get("textDocument").get("uri").asString();
    path := source.pathOf(uri);
    key  := source.keyOf(path);
    i    := projectFor(key, path);
    if i < 0 {
        rpc.respond(m.id, "{\"data\":[]}");
        return;
    }
    p    := projects.indexRef(i);
    file := p.fileNumber(key);

    tokens: [..]Token;
    for sym in p.index.symbols {
        if sym.file == file {
            tokens.add(tokenOf(sym.nameRange, &sym, 1));
        }
    }
    for ref in p.index.references {
        if ref.file == file {
            sym := p.symbol(ref.symbol);
            if sym != null {
                tokens.add(tokenOf(ref.range, sym, 0));
            }
        }
    }
    sortTokens(tokens.elements());

    // Each token is 5 numbers, relative to the one before: line, start, length, type and modifiers. In UTF-16 units
    text := textOf(key, path);
    sb := fmt.newStringBuilder(tokens.count as int * 16 + 16);
    lastLine  := 0;
    lastStart := 0;
    written   := 0;
    for t, n in tokens {
        if t.end <= t.start || t.line < 0 {
            continue;
        }
        if n > 0 {
            previous := tokens[n - 1];
            if previous.line == t.line && previous.start == t.start {
                continue;  // The same name twice, e.g a declaration that is also a use
            }
        }
        line  := text.line(t.line);
        start := source.toUtf16(line, t.start);
        end   := source.toUtf16(line, t.end);
        deltaStart := start;
        if t.line == lastLine {
            deltaStart = start - lastStart;
        }
        if written > 0 { sb.addChar(','); }
        sb.add("%,%,%,%,%", t.line - lastLine, deltaStart, end - start, t.kind, t.modifiers);
        lastLine  = t.line;
        lastStart = start;
        written  += 1;
    }
    rpc.respond(m.id, fmt.sprint("{\"data\":[%]}", sb.toString()));
}

tokenOf :: (r: project.Range, sym: *project.Symbol, declaration: int) -> Token {
    t: Token;
    t.line  = r.start.line;
    t.start = r.start.character;
    t.end   = r.end.character;
    if r.end.line != r.start.line {
        t.end = t.start;  // A name is on one line
    }
    t.kind = tokenType(sym.kind);
    t.modifiers = declaration;
    if sym.kind == "constant" || sym.kind == "enumMember" {
        t.modifiers += 2;  // readonly
    }
    return t;
}

// By line, then by start. Insertion sort, as most of the tokens are in order already
sortTokens :: (tokens: []Token) {
    for i in 1..tokens.count {
        t := tokens[i];
        j := i - 1;
        while j >= 0 && (tokens[j].line > t.line || (tokens[j].line == t.line && tokens[j].start > t.start)) {
            tokens[j + 1] = tokens[j];
            j -= 1;
        }
        tokens[j + 1] = t;
    }
}
