use c;

// A copy of the string as a c.string, with a 0 after its bytes, e.g for a function of C. Free it with .free(). It is on
// the heap, as C frees it
toCString :: method (s: string) -> c.string {
    cstr := resizeMemory(heapAllocator(), null, 0, s.len + 1) as *u8;
    memcpy(cstr, s.data, s.len);
    cstr[s.len] = 0;
    return c.string{cstr};
}

slice :: method (s: string, from: int, to := -1) -> string {
    result: string;

    if to == -1 {
        result.data = &s.data[from];
        result.len = s.len - from;
    } else {
        result.data = &s.data[from];
        result.len = to - from;
    }

    return result;
}

// Frees a string that was allocated, e.g by copy() or fmt.sprint(), with the allocator of the thread, or the one it
// was allocated with
free :: method (s: string, allocator: Allocator = null) {
    if s.data != null { resizeMemory(allocator, s.data, s.len, 0); }
}

// A copy of the string, from the allocator of the thread, or the one given, e.g title.copy(mem.heap()) for a string
// that lives longer than a request
copy :: method (s: string, allocator: Allocator = null) -> string {
    result: string;

    result.data = resizeMemory(allocator, null, 0, s.len) as *u8;
    memcpy(result.data, s.data, s.len);

    result.len = s.len;

    return result;
}

toUpper :: method (s: string) -> string {
    result := s.copy();

    for c, i in s {
        if c >= 'a' && c <= 'z' {
            result[i] = c - 32;
        }
    }

    return result;
}

toLower :: method (s: string) -> string {
    result := s.copy();

    for c, i in s {
        if c >= 'A' && c <= 'Z' {
            result[i] = c + 32;
        }
    }

    return result;
}

startsWith :: method (s: string, str: string) -> bool {
    if s.len < str.len {
        return false; // It read past the end of s before, which the bounds checks found
    }
    for c, i in str {
        if s[i] != c {
            return false;
        }
    }

    return true;
}

endsWith :: method (s: string, str: string) -> bool {
    if s.len < str.len {
        return false;
    }

    trailing := s.slice(s.len - str.len);

    for c, i in trailing {
        if str[i] != c {
            return false;
        }
    }

    return true;
}

// Returns the first index at which a given element can be found in the array, or -1 if it is not present.
indexOf :: method (s: string, str: string, fromIndex := 0) -> int {
    if s.len == 0 || str.len == 0 {
        return -1;
    }

    if fromIndex >= s.len {
        return -1;
    }

    src := s.slice(fromIndex);

    for c1, i in src {
        if src[i] == str[0] {

            // Scan forward to match substrings
            match := true;
            for c2, j in str {

                if i + j >= src.len {
                    // We wen't to the end of the soruce string
                    return -1;
                }

                c1f := src[i + j];

                if c2 != c1f {
                    // Substrings didn't match
                    match = false;
                    break;
                }
            }

            if match {
                return i + fromIndex;
            }
        }
    }

    return -1;
}

split :: method (s: string, sep: string) -> [..]string {
    result: [..]string;

    cursor := 0;
    while true {
        i := s.indexOf(sep, cursor);
        if i == -1 {
            tail := s.slice(cursor);
            result.add(tail);
            break;
        } else {
            segment := s.slice(cursor, i);
            result.add(segment);
            cursor = i + sep.len as int;
        }
    }

    return result;
}

reverse :: method (s: string) -> string {
    result := s.copy();

    for c, i in s {
        j := s.len - 1 - i;
        result[j] = c;
    }

    return result;
}
//
// Characters. A char is a byte of the UTF-8 text, e.g 'a' or the s[i] of a string, so these know the ASCII letters,
// digits and spaces, and leave the bytes of other characters (128 and up) alone
//

// '0' to '9'
isDigit :: method (c: char) -> bool { return c >= '0' && c <= '9'; }

// 'a' to 'z' and 'A' to 'Z'
isLetter :: method (c: char) -> bool { return c.isLower() || c.isUpper(); }

// A letter or a digit
isLetterOrDigit :: method (c: char) -> bool { return c.isLetter() || c.isDigit(); }

// 'A' to 'Z'
isUpper :: method (c: char) -> bool { return c >= 'A' && c <= 'Z'; }

// 'a' to 'z'
isLower :: method (c: char) -> bool { return c >= 'a' && c <= 'z'; }

// ' ', '\t', '\n', '\r', '\v' and '\f'
isSpace :: method (c: char) -> bool {
    return c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == '\x0B' || c == '\x0C';
}

// '0' to '9', 'a' to 'f' and 'A' to 'F'
isHexDigit :: method (c: char) -> bool {
    return c.isDigit() || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F');
}

// A character of ASCII, below 128
isAscii :: method (c: char) -> bool { return (c as u8) < 128; }

// The uppercase letter of a lowercase one, e.g 'A' of 'a'. Other characters are themselves
toUpper :: method (c: char) -> char {
    if c.isLower() { return (c as u8 - 32) as char; }
    return c;
}

// The lowercase letter of an uppercase one, e.g 'a' of 'A'. Other characters are themselves
toLower :: method (c: char) -> char {
    if c.isUpper() { return (c as u8 + 32) as char; }
    return c;
}

// The value of a digit, e.g 7 of '7', or of a hex digit, e.g 10 of 'a' and 'A'. -1 for other characters
digitValue :: method (c: char) -> int {
    if c.isDigit() { return (c as u8 - '0') as int; }
    if c >= 'a' && c <= 'f' { return (c as u8 - 'a' + 10) as int; }
    if c >= 'A' && c <= 'F' { return (c as u8 - 'A' + 10) as int; }
    return -1;
}
