//////////////////////////////////
// Runtime package
//
// @Note: This MUST match the datastructures laid out in runtime_support.c
//////////////////////////////////

String :: struct {
    data: *char;
    len:  i64;
}

// The compiler generates one constant descriptor for every type that is converted to an 'any'. The layouts of these structs are read by
// the compiler (see type_info_global in ir_lower.c), so members can be added, but each name must stay
//
// A Type is what every type has. The kinds with more to them have a struct of their own that embeds the Type: TypePointer,
// TypeArray, TypeEnum and TypeStruct, which type.asPointer(), asArray(), asEnum() and asStruct() give. They are a *Type
// where one is wanted, and have its members, e.g structType.name. The other kinds are only a Type: bool, int, float,
// string, void and any. An integer is told apart by its size and flags, e.g a u8 has size 1 and isn't isSigned, and a
// char is a u8 that isChar

TypeKind :: enum {
    void,
    bool,
    int,
    float,
    string,
    array,
    pointer,
    struct,
    enum,
    function,
    tuple,
    variadic,
    any,
};

Type :: struct {
    name:  string;      // As it is written, e.g int, *User or List<int>
    kind:  TypeKind;
    size:  int;         // In bytes
    flags: TypeFlags;
};

// What else a Type is, in Type.flags
TypeFlags :: enumflags {
    isUnion,     // A union, a TypeStruct whose first member is the tag
    isOptional,  // A ?T, which is a struct with the members item: T and present: bool
    isFlags,     // An enum flags, a TypeEnum whose values are combined, e.g 3 is the first two values
    isSigned,    // An integer that can be negative: i8, i16, i32 (int) or i64
    isChar,      // A char, a u8 that is a character
    isList,      // A List<T>, e.g [..]int: a TypeStruct of data, count, capacity and allocator
    isMap,       // A Map<K, V>
}

TypePointer :: struct {
    @embed base: Type;
    pointerTo:   *Type;
}

TypeArrayKind :: enum {
    fixed,
    slice,
    dynamic,
}

TypeArray :: struct {
    @embed base: Type;
    arrayKind:   TypeArrayKind;
    elemType:    *Type;
    count:       i64;    // The number of elements of a fixed array. A slice has its count in its value
}

EnumValue :: struct {
    name:  string;
    value: i64;
}

TypeEnum :: struct {
    @embed base: Type;
    backingType: *Type;
    values:      []EnumValue;
};

StructMember :: struct {
    name:       string;
    type:       *Type;
    offset:     i64;
    index:      i64;
    attributes: []any;  // The values of the attributes on the member e.g @json.Field(name: "id")
}

// A union is a struct with this flag. Its first member is the tag ($tag: u32), the index of the variant it holds. The other members
// are the variants, which all start at the same offset. See any.variant()
TypeStruct :: struct {
    @embed base: Type;
    members:     []StructMember;
    alignment:   int;
    attributes:  []any;  // The values of the attributes on the struct e.g @cli.Options(about: "...")
};

//////////////////////////////////
// Raw underlying types
//////////////////////////////////

Any :: struct {
    data: *void;
    type: *Type;
}

// An any of the value at data, which has the type, e.g of a member found by reflection: (&bytes[member.offset], member.type).
// The program says what the memory holds, so it is the one place where a *void and a *Type are put together. Everything
// that gets the any knows the type of the value from it
anyAt :: (data: *void, type: *Type) -> any {
    value: any;
    raw := (&value) as *Any;
    raw.data = data;
    raw.type = type;
    return value;
}

//////////////////////////////////
// Builtin functions that are filled out by the compiler
//////////////////////////////////

//////////////////////////////////
// Runtime functions
//////////////////////////////////

extern "C" {
    runtime_compare_strings :: (str1: *string, str2: *string) -> int;
}

// The name of an enum value, e.g "open" for Status.open. ok is false if no value of the enum has the value
nameOf :: method (type: *TypeEnum, value: i64) -> string, bool {
    for v in type.values {
        if v.value == value {
            return v.name, true;
        }
    }
    none: string;
    return none, false;
}

// The address of the member inside a struct value that starts at data
valueIn :: method (member: *StructMember, data: *void) -> *void {
    bytes := data as *u8;
    address := &bytes[member.offset];
    return address;
}

// A member that isn't a part of the data of its struct, e.g a link to where it came from: fmt doesn't print it, json
// neither writes nor reads it, and dbms doesn't make it a column
@attribute
Hidden :: struct {}

// True for a member marked with @Hidden
isHidden :: method (member: *StructMember) -> bool {
    hidden: Hidden;
    return attributeOf(member, &hidden);
}

// The type of T, e.g typeInfo<User>().asStruct().members. Each type has one descriptor, so two are the same type when they
// are the same pointer
typeInfo :: <T>() -> *Type {
    // Through a pointer, which keeps the type of a collection, which would be a slice of its elements in an any
    pointer: *T;
    boxed: any = pointer;
    return boxed.type.pointee();
}

// If the type is T, e.g type.is<time.Time>(). It compares the descriptors, not the names, so a type of another namespace
// with the same name isn't T
is :: method <T>(type: *Type) -> bool {
    return type == typeInfo<T>();
}

// Gets the value of the attribute of type T on the member, e.g
//
//     field: json.Field;
//     if attributeOf(member, &field) { ... field.name ... }
attributeOf :: <T>(member: *StructMember, value: *T) -> bool {
    for attribute in member.attributes {
        if attribute.type == typeInfo<T>() {
            *value = *(attribute.data as *T);
            return true;
        }
    }
    return false;
}

// A function with attribute values, e.g a handler of a web server:
//
//     @attribute
//     Route :: struct { path: string; }
//
//     @Route("/posts")
//     listPosts :: (request: *Request) { ... }
//
//     for f in attributedFunctions() {
//         route: Route;
//         if f.attribute(&route) {
//             handler := f.function as (request: *Request);   // Its type, which the program knows
//             ...
//         }
//     }
AttributedFunction :: struct {
    name:          string;  // As it is declared, e.g listPosts
    namespaceName: string;  // Of its file, e.g blog. Empty when the file has none
    function:      *void;   // Its address. Cast it to its function type to call it
    attributes:    []any;

    // Calling it without knowing its type, e.g for a router: the arguments are in a block laid out like a struct of
    // its parameters, and invoke() stores the results in a block laid out like a struct of its results
    parameters:    []FunctionValue;
    results:       []FunctionValue;
    argumentsSize: int;
    resultsSize:   int;
    invoke:        (arguments: *u8, results: *u8);   // Throws what the function throws
}

// A parameter or a result of a function, and where it is in the block of the arguments or the results
FunctionValue :: struct {
    name:         string;   // Empty for a result
    type:         *Type;
    offset:       int;
    hasDefault:   bool;     // A parameter with a default value, e.g page := 1
    defaultValue: *void;    // The default, when it is known when compiling, e.g a number, a string or a constant
}

// Every function of the program with attribute values. The compiler writes the list, and compiles the functions on it
attributedFunctionList: []AttributedFunction;

attributedFunctions :: () -> []AttributedFunction {
    return attributedFunctionList;
}

// Gets the value of the attribute of type T on the function, like attributeOf for a member
// Gets the value of the attribute of type T on a struct, e.g
//
//     options: cli.Options;
//     if type.attribute(&options) { ... options.about ... }
attribute :: method <T>(type: *TypeStruct, value: *T) -> bool {
    for attribute in type.attributes {
        if attribute.type == typeInfo<T>() {
            *value = *(attribute.data as *T);
            return true;
        }
    }
    return false;
}

attribute :: method <T>(f: *AttributedFunction, value: *T) -> bool {
    for attribute in f.attributes {
        if attribute.type == typeInfo<T>() {
            *value = *(attribute.data as *T);
            return true;
        }
    }
    return false;
}

//
// The methods of an enum flags, e.g options.has(.verbose). The compiler calls these for them, e.g flagsHas(options, .verbose)
//

// If all of the flags are set, e.g options.has(.verbose | .color)
flagsHas :: <F>(flags: F, flag: F) -> bool { return (flags & flag) == flag; }

// If any of the flags is set
flagsHasAny :: <F>(flags: F, flag: F) -> bool { return (flags & flag) as i64 != 0; }

// The flags with these set too, e.g options.with(.verbose)
flagsWith :: <F>(flags: F, flag: F) -> F { return flags | flag; }

// The flags without these, e.g options.without(.verbose)
flagsWithout :: <F>(flags: F, flag: F) -> F { return flags & ~flag; }

// If no flag is set
flagsIsEmpty :: <F>(flags: F) -> bool { return flags as i64 == 0; }

//////////////////////////////////
// Questions about types. The values of a type are read and changed with the methods of any, in any.sd
//////////////////////////////////

isInteger :: method (type: *Type) -> bool { return type.kind == .int; }
isFloat   :: method (type: *Type) -> bool { return type.kind == .float; }
isNumber  :: method (type: *Type) -> bool { return type.kind == .int || type.kind == .float; }
isSigned  :: method (type: *Type) -> bool { return type.flags.has(.isSigned); }    // i8, i16, i32 (int) or i64
isChar    :: method (type: *Type) -> bool { return type.flags.has(.isChar); }
isUnion   :: method (type: *Type) -> bool { return type.flags.has(.isUnion); }
isOptional :: method (type: *Type) -> bool { return type.flags.has(.isOptional); }
isFlags   :: method (type: *Type) -> bool { return type.flags.has(.isFlags); }     // An enum flags
isList    :: method (type: *Type) -> bool { return type.flags.has(.isList); }      // A List<T>, e.g [..]int
isMap     :: method (type: *Type) -> bool { return type.flags.has(.isMap); }

// A slice, e.g []int
isSlice :: method (type: *Type) -> bool {
    return type.kind == .array && (type as *TypeArray).arrayKind == .slice;
}

// A fixed array, a slice or a List: the values that have an elementType(), and that any.count() and any.element() read
isSequence :: method (type: *Type) -> bool {
    return type.elementType() != null;
}

// The type as the struct of its kind, or null when it is of another kind
asPointer :: method (type: *Type) -> *TypePointer {
    if type.kind != .pointer { return null; }
    return type as *TypePointer;
}

asArray :: method (type: *Type) -> *TypeArray {
    if type.kind != .array { return null; }
    return type as *TypeArray;
}

asEnum :: method (type: *Type) -> *TypeEnum {
    if type.kind != .enum { return null; }
    return type as *TypeEnum;
}

asStruct :: method (type: *Type) -> *TypeStruct {
    if type.kind != .struct { return null; }
    return type as *TypeStruct;
}

// The type that a pointer points to, e.g User for *User. Null for other types
pointee :: method (type: *Type) -> *Type {
    if type.kind != .pointer { return null; }
    return (type as *TypePointer).pointerTo;
}

// The type of the elements of a fixed array, a slice or a List, e.g int for [..]int. Null for other types
elementType :: method (type: *Type) -> *Type {
    if type.kind == .array { return (type as *TypeArray).elemType; }
    if type.isList() { return (type as *TypeStruct).members[0].type.pointee(); }
    return null;
}

// The type of the value of an optional, e.g int for ?int. Null for other types
optionalType :: method (type: *Type) -> *Type {
    if !type.isOptional() { return null; }
    return (type as *TypeStruct).members[0].type;
}

// The types of the keys and the values of a Map<K, V>. Null for other types
keyType :: method (type: *Type) -> *Type {
    entry := mapEntryType(type);
    if entry == null { return null; }
    return entry.members[0].type;
}

valueType :: method (type: *Type) -> *Type {
    entry := mapEntryType(type);
    if entry == null { return null; }
    return entry.members[1].type;
}

// The Entry<K, V> of the entries of a map
@private
mapEntryType :: (type: *Type) -> *TypeStruct {
    if !type.isMap() { return null; }
    return (type as *TypeStruct).members[0].type.elementType().asStruct();
}

// The smallest and the largest value of an integer type, e.g -128 and 127 for an i8, and 0 and 255 for a u8
integerRange :: method (type: *Type) -> (i64, u64) {
    bits := type.size * 8;
    if type.isSigned() {
        if bits >= 64 { return -9223372036854775807 - 1, 9223372036854775807; }
        limit := (1 as i64) << (bits - 1);
        return -limit, (limit - 1) as u64;
    }
    if bits >= 64 { return 0, ~(0 as u64); }
    return 0, (((1 as i64) << bits) - 1) as u64;
}

// The member of the struct with the name, or null
member :: method (type: *TypeStruct, name: string) -> *StructMember {
    for i in 0..type.members.count {
        if type.members[i].name == name { return &type.members[i]; }
    }
    return null;
}

// The variant of the union with the name, or null
variant :: method (type: *TypeStruct, name: string) -> *StructMember {
    if !type.isUnion() { return null; }
    for i in 1..type.members.count {
        if type.members[i].name == name { return &type.members[i]; }
    }
    return null;
}

// The value of the enum with the name, e.g 1 for "closed" of Status :: enum { open; closed; }. false when it has none
valueNamed :: method (type: *TypeEnum, name: string) -> i64, bool {
    for v in type.values {
        if v.name == name { return v.value, true; }
    }
    return 0, false;
}
