//////////////////////////////////
// Runtime package
//
// @Note: This MUST match the datastructures laid out in runtime_support.c
//////////////////////////////////

String :: struct {
    data: *char;
    len:   i64;
}

TypeKind :: enum {
    void,
    bool, 
    int,
    float,
    string,
    array,
    pointer,
    struct,
    enum,
    function,
    tuple,
    variadic,
    any,
};

TypePrimitiveKind :: enum {
    uint, // alias for u32
    u8,
    u16,
    u32,
    u64,
    int, // alias for i32
    i8,
    i16,
    i32,
    i64,
    float, // alias for f32
    f32,
    f64,
    string,
    bool,
    void,
    untypedInt,
    untypedFloat,
};

TypeArrayKind :: enum {
    fixed,
    slice,
    dynamic,
}

Type :: struct {
    name:  string;
    kind:  TypeKind;
    size:  int;
    flags: int;
};

TypePrimitive :: struct  {
    head: Type;
    kind: TypePrimitiveKind;
};

TypePointer :: struct {
    head:       Type;
    pointerTo: *Type;
}

TypeArray :: struct {
    head:      Type;
    kind:      TypeArrayKind;
    elemType: *Type;
    count:     i64;
}

TypeEnum :: struct {
    head:         Type;
    valueName:    string;
    backingType: *Type;
    minValue:     int;
    maxValue:     int;
};

StructMember :: struct {
    name:  string;
    type:  *Type;
    value: *void;
    index:  i64;
    offset: i64;
}

TypeStruct :: struct {
    head:      Type;
    members:   []StructMember;
    alignment: int;
};

TypeAny :: struct {
    head:  Type;
    data: *void;
    type: *Type;
}

//////////////////////////////////
// Raw underlying types
//////////////////////////////////

Any :: struct {
    data: *void;
    type: *Type;
}


//////////////////////////////////
// Builtin functions that are filled out by the compiler
//////////////////////////////////

//////////////////////////////////
// Runtime functions
//////////////////////////////////

extern "C" {
    runtime_get_type_pointer :: (name: string, pointerTo: *Type) -> *TypePointer;
    runtime_get_type_array   :: (name: string, kind: TypeArrayKind, elem_type: *Type, count: i64) -> *TypeArray;
    runtime_get_type_enum    :: (name: string, valueName: string, backingType: *Type, minValue: int, maxValue: int) -> *TypeEnum;
    runtime_get_type_struct  :: (name: string, members: *StructMember, members_count: int, size: int, alignment: int) -> *TypeStruct;
    runtime_get_type_any     :: () -> *TypeAny;
    runtime_compare_strings  :: (str1: *string, str2: *string) -> int;
}

isPrimitive :: method (type: *Type) -> bool {
    if type.kind == .bool  { return true; } 
    if type.kind == .int   { return true; }
    if type.kind == .float { return true; }
    return false;
}