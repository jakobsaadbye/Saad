//////////////////////////////////
// Runtime package
//
// @Note: This MUST match the datastructures laid out in runtime_support.c
//////////////////////////////////

String :: struct {
    data: *char;
    len:   i64;
}

// The compiler generates one constant descriptor for every type that is converted to an 'any'. The layouts of these structs are read by
// the compiler (see type_info_global in ir_lower.c), so members can be added, but each name must stay

TypeKind :: enum {
    void,
    bool,
    int,
    float,
    string,
    array,
    pointer,
    struct,
    enum,
    function,
    tuple,
    variadic,
    any,
};

TypePrimitiveKind :: enum {
    uint, // alias for u32
    u8,
    u16,
    u32,
    u64,
    int, // alias for i32
    i8,
    i16,
    i32,
    i64,
    float, // alias for f32
    f32,
    f64,
    char,
    bool,
    void,
};

TypeArrayKind :: enum {
    fixed,
    slice,
    dynamic,
}

Type :: struct {
    name:  string;
    kind:  TypeKind;
    size:  int;
    flags: TypeFlags;
};

// What else a Type is, in Type.flags
TypeFlags :: enum flags {
    isUnion,     // A union, a TypeStruct whose first member is the tag
    isOptional,  // A ?T, which is a struct with the members item: T and present: bool
    isFlags,     // An enum flags, a TypeEnum whose values are combined, e.g 3 is the first two values
}

TypePrimitive :: struct  {
    head: Type;
    kind: TypePrimitiveKind;
};

TypePointer :: struct {
    head:       Type;
    pointerTo: *Type;
}

TypeArray :: struct {
    head:      Type;
    kind:      TypeArrayKind;
    elemType: *Type;
    count:     i64;   // The number of elements of a fixed array. A slice has its count in its value
}

EnumValue :: struct {
    name:  string;
    value: i64;
}

TypeEnum :: struct {
    head:         Type;
    backingType: *Type;
    values:       []EnumValue;
};

StructMember :: struct {
    name:       string;
    type:       *Type;
    offset:     i64;
    index:      i64;
    attributes: []any;  // The values of the attributes on the member e.g @json.Field(name: "id")
}

// A union is a struct with this flag. Its first member is the tag ($tag: u32), the index of the variant it holds. The other members
// are the variants, which all start at the same offset. See variantOf()
TypeStruct :: struct {
    head:      Type;
    members:   []StructMember;
    alignment: int;
};

TypeAny :: struct {
    head: Type;
}

//////////////////////////////////
// Raw underlying types
//////////////////////////////////

Any :: struct {
    data: *void;
    type: *Type;
}

//////////////////////////////////
// Builtin functions that are filled out by the compiler
//////////////////////////////////

//////////////////////////////////
// Runtime functions
//////////////////////////////////

extern "C" {
    runtime_compare_strings  :: (str1: *string, str2: *string) -> int;
}

isPrimitive :: method (type: *Type) -> bool {
    if type.kind == .bool  { return true; } 
    if type.kind == .int   { return true; }
    if type.kind == .float { return true; }
    return false;
}
// The name of an enum value, e.g "open" for Status.open. ok is false if no value of the enum has the value
nameOf :: method (type: *TypeEnum, value: i64) -> string, bool {
    for v in type.values {
        if v.value == value {
            return v.name, true;
        }
    }
    none: string;
    return none, false;
}

// Reads the value of an enum stored at data, as an i64
readValue :: method (type: *TypeEnum, data: *void) -> i64 {
    return switch type.backingType.size {
        case 1 => (*(data as *i8)) as i64;
        case 2 => (*(data as *i16)) as i64;
        case 8 => *(data as *i64);
        else   => (*(data as *i32)) as i64;
    };
}

// The address of the member inside a struct value that starts at data
valueIn :: method (member: *StructMember, data: *void) -> *void {
    bytes := data as *u8;
    address := &bytes[member.offset];
    return address;
}

// A member that isn't a part of the data of its struct, e.g a link to where it came from: fmt doesn't print it, json
// neither writes nor reads it, and dbms doesn't make it a column
@attribute
Hidden :: struct {}

// True for a member marked with @Hidden
isHidden :: method (member: *StructMember) -> bool {
    hidden: Hidden;
    return attributeOf(member, &hidden);
}

// Gets the value of the attribute of type T on the member, e.g
//
//     field: json.Field;
//     if attributeOf(member, &field) { ... field.name ... }
attributeOf :: <T>(member: *StructMember, value: *T) -> bool {
    name := typeof(*value);
    for attribute in member.attributes {
        if attribute.type.name == name {
            *value = *(attribute.data as *T);
            return true;
        }
    }
    return false;
}

// A function with attribute values, e.g a handler of a web server:
//
//     @attribute
//     Route :: struct { path: string; }
//
//     @Route("/posts")
//     listPosts :: (request: *Request) { ... }
//
//     for f in attributedFunctions() {
//         route: Route;
//         if f.attribute(&route) {
//             handler := f.function as (request: *Request);   // Its type, which the program knows
//             ...
//         }
//     }
AttributedFunction :: struct {
    name:          string;  // As it is declared, e.g listPosts
    namespaceName: string;  // Of its file, e.g blog. Empty when the file has none
    function:      *void;   // Its address. Cast it to its function type to call it
    attributes:    []any;

    // Calling it without knowing its type, e.g for a router: the arguments are in a block laid out like a struct of
    // its parameters, and invoke() stores the results in a block laid out like a struct of its results
    parameters:    []FunctionValue;
    results:       []FunctionValue;
    argumentsSize: int;
    resultsSize:   int;
    invoke:        (arguments: *u8, results: *u8);   // Throws what the function throws
}

// A parameter or a result of a function, and where it is in the block of the arguments or the results
FunctionValue :: struct {
    name:         string;   // Empty for a result
    type:         *Type;
    offset:       int;
    hasDefault:   bool;     // A parameter with a default value, e.g page := 1
    defaultValue: *void;    // The default, when it is known when compiling, e.g a number, a string or a constant
}

// Every function of the program with attribute values. The compiler writes the list, and compiles the functions on it
attributedFunctionList: []AttributedFunction;

attributedFunctions :: () -> []AttributedFunction {
    return attributedFunctionList;
}

// Gets the value of the attribute of type T on the function, like attributeOf for a member
attribute :: method <T>(f: *AttributedFunction, value: *T) -> bool {
    name := typeof(*value);
    for attribute in f.attributes {
        if attribute.type.name == name {
            *value = *(attribute.data as *T);
            return true;
        }
    }
    return false;
}

isUnion :: method (type: *Type) -> bool {
    return type.flags.has(.isUnion);
}

isOptional :: method (type: *Type) -> bool {
    return type.flags.has(.isOptional);
}

//
// The methods of an enum flags, e.g options.has(.verbose). The compiler calls these for them, e.g flagsHas(options, .verbose)
//

// If all of the flags are set, e.g options.has(.verbose | .color)
flagsHas :: <F>(flags: F, flag: F) -> bool { return (flags & flag) == flag; }

// If any of the flags is set
flagsHasAny :: <F>(flags: F, flag: F) -> bool { return (flags & flag) as i64 != 0; }

// The flags with these set too, e.g options.with(.verbose)
flagsWith :: <F>(flags: F, flag: F) -> F { return flags | flag; }

// The flags without these, e.g options.without(.verbose)
flagsWithout :: <F>(flags: F, flag: F) -> F { return flags & ~flag; }

// If no flag is set
flagsIsEmpty :: <F>(flags: F) -> bool { return flags as i64 == 0; }

// The value inside the optional (a ?T) stored at data, and its type T. present is false when it is empty
optionalValue :: method (type: *TypeStruct, data: *void) -> (*void, *Type, bool) {
    item    := &type.members[0];
    present := *(type.members[1].valueIn(data) as *bool);
    return item.valueIn(data), item.type, present;
}

// Makes the optional at data empty, or present with a zero value. Gives where the value goes and its type
setOptional :: method (type: *TypeStruct, data: *void, present: bool) -> (*void, *Type) {
    bytes := data as *u8;
    for i in 0..type.head.size {
        bytes[i] = 0;
    }
    *(type.members[1].valueIn(data) as *bool) = present;
    item := &type.members[0];
    return item.valueIn(data), item.type;
}

// The variant that the union stored at data holds
variantOf :: method (type: *TypeStruct, data: *void) -> *StructMember {
    tag := (*(data as *u32)) as i64;
    if tag + 1 >= type.members.count {
        return null;
    }
    return &type.members[tag + 1];
}

// Makes the union stored at data hold the variant, with a zeroed value. Returns where the value goes
setVariant :: method (type: *TypeStruct, data: *void, variant: *StructMember) -> *void {
    bytes := data as *u8;
    for i in 0..type.head.size {
        bytes[i] = 0;
    }
    *(data as *u32) = (variant.index - 1) as u32;
    return variant.valueIn(data);
}
