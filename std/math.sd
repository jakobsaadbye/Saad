namespace math;

//////////////////////////////////////////////////////////////////////////////////////
//  C math.h functions
//////////////////////////////////////////////////////////////////////////////////////
extern "C" {

    //////////////////////////////////////////////////////////////////////////////////////
    //  Basic / Rounding
    //////////////////////////////////////////////////////////////////////////////////////
    abs   :: (value: f64) -> f64;
    fabs  :: (value: f64) -> f64;
    fabsf :: (value: f32) -> f32;

    round  :: (value: f64) -> f64;
    roundf :: (value: f32) -> f32;
    lround :: (value: f64) -> i64;
    llround :: (value: f64) -> i64;

    floor  :: (value: f64) -> f64;
    floorf :: (value: f32) -> f32;

    ceil  :: (value: f64) -> f64;
    ceilf :: (value: f32) -> f32;

    trunc  :: (value: f64) -> f64;
    truncf :: (value: f32) -> f32;

    rint  :: (value: f64) -> f64;
    rintf :: (value: f32) -> f32;

    nearbyint  :: (value: f64) -> f64;
    nearbyintf :: (value: f32) -> f32;

    //////////////////////////////////////////////////////////////////////////////////////
    //  Trigonometry
    //////////////////////////////////////////////////////////////////////////////////////
    sin  :: (angle: f64) -> f64;
    sinf :: (angle: f32) -> f32;

    cos  :: (angle: f64) -> f64;
    cosf :: (angle: f32) -> f32;

    tan  :: (angle: f64) -> f64;
    tanf :: (angle: f32) -> f32;

    asin  :: (value: f64) -> f64;
    asinf :: (value: f32) -> f32;

    acos  :: (value: f64) -> f64;
    acosf :: (value: f32) -> f32;

    atan  :: (value: f64) -> f64;
    atanf :: (value: f32) -> f32;

    atan2  :: (y: f64, x: f64) -> f64;
    atan2f :: (y: f32, x: f32) -> f32;

    //////////////////////////////////////////////////////////////////////////////////////
    //  Hyperbolic
    //////////////////////////////////////////////////////////////////////////////////////
    sinh  :: (value: f64) -> f64;
    sinhf :: (value: f32) -> f32;

    cosh  :: (value: f64) -> f64;
    coshf :: (value: f32) -> f32;

    tanh  :: (value: f64) -> f64;
    tanhf :: (value: f32) -> f32;

    asinh  :: (value: f64) -> f64;
    asinhf :: (value: f32) -> f32;

    acosh  :: (value: f64) -> f64;
    acoshf :: (value: f32) -> f32;

    atanh  :: (value: f64) -> f64;
    atanhf :: (value: f32) -> f32;

    //////////////////////////////////////////////////////////////////////////////////////
    //  Exponential & Logarithm
    //////////////////////////////////////////////////////////////////////////////////////
    sqrt  :: (value: f64) -> f64;
    sqrtf :: (value: f32) -> f32;

    cbrt  :: (value: f64) -> f64;
    cbrtf :: (value: f32) -> f32;

    exp   :: (value: f64) -> f64;
    expf  :: (value: f32) -> f32;

    exp2  :: (value: f64) -> f64;
    exp2f :: (value: f32) -> f32;

    expm1  :: (value: f64) -> f64;
    expm1f :: (value: f32) -> f32;

    log   :: (value: f64) -> f64;
    logf  :: (value: f32) -> f32;

    log2  :: (value: f64) -> f64;
    log2f :: (value: f32) -> f32;

    log10  :: (value: f64) -> f64;
    log10f :: (value: f32) -> f32;

    log1p  :: (value: f64) -> f64;
    log1pf :: (value: f32) -> f32;

    //////////////////////////////////////////////////////////////////////////////////////
    //  Power
    //////////////////////////////////////////////////////////////////////////////////////
    pow  :: (base: f64, exp: f64) -> f64;
    powf :: (base: f32, exp: f32) -> f32;

    hypot  :: (x: f64, y: f64) -> f64;
    hypotf :: (x: f32, y: f32) -> f32;

    //////////////////////////////////////////////////////////////////////////////////////
    //  Floating-point manipulation
    //////////////////////////////////////////////////////////////////////////////////////
    fmod  :: (x: f64, y: f64) -> f64;
    fmodf :: (x: f32, y: f32) -> f32;

    remainder  :: (x: f64, y: f64) -> f64;
    remainderf :: (x: f32, y: f32) -> f32;

    fmin  :: (x: f64, y: f64) -> f64;
    fminf :: (x: f32, y: f32) -> f32;

    fmax  :: (x: f64, y: f64) -> f64;
    fmaxf :: (x: f32, y: f32) -> f32;

    fdim  :: (x: f64, y: f64) -> f64;
    fdimf :: (x: f32, y: f32) -> f32;

    fma  :: (x: f64, y: f64, z: f64) -> f64;
    fmaf :: (x: f32, y: f32, z: f32) -> f32;

    // Decompose floating-point number into significand and exponent
    frexp  :: (value: f64, exp: *i32) -> f64;
    frexpf :: (value: f32, exp: *i32) -> f32;

    // Multiply by power of 2
    ldexp  :: (value: f64, exp: i32) -> f64;
    ldexpf :: (value: f32, exp: i32) -> f32;

    // Decompose into integer and fractional parts
    modf  :: (value: f64, iptr: *f64) -> f64;
    modff :: (value: f32, iptr: *f32) -> f32;

    // Scale by FLT_RADIX power
    scalbn  :: (value: f64, exp: i32) -> f64;
    scalbnf :: (value: f32, exp: i32) -> f32;

    // Extract exponent
    ilogb  :: (value: f64) -> i32;
    ilogbf :: (value: f32) -> i32;

    logb  :: (value: f64) -> f64;
    logbf :: (value: f32) -> f32;

    // Copy sign from one value to another
    copysign  :: (x: f64, y: f64) -> f64;
    copysignf :: (x: f32, y: f32) -> f32;

    // Next representable value
    nextafter  :: (x: f64, y: f64) -> f64;
    nextafterf :: (x: f32, y: f32) -> f32;

    //////////////////////////////////////////////////////////////////////////////////////
    //  Classification (return i32: non-zero = true)
    //////////////////////////////////////////////////////////////////////////////////////
    isnan    :: (value: f64) -> i32;
    isinf    :: (value: f64) -> i32;
    isfinite :: (value: f64) -> i32;
    isnormal :: (value: f64) -> i32;
    signbit  :: (value: f64) -> i32;

    //////////////////////////////////////////////////////////////////////////////////////
    //  Error & Gamma
    //////////////////////////////////////////////////////////////////////////////////////
    erf   :: (value: f64) -> f64;
    erff  :: (value: f32) -> f32;

    erfc  :: (value: f64) -> f64;
    erfcf :: (value: f32) -> f32;

    tgamma  :: (value: f64) -> f64;
    tgammaf :: (value: f32) -> f32;

    lgamma  :: (value: f64) -> f64;
    lgammaf :: (value: f32) -> f32;
}

//////////////////////////////////////////////////////////////////////////////////////
//  Constants and helpers of Saad's own
//////////////////////////////////////////////////////////////////////////////////////

Pi  :: 3.14159265358979323846;
Tau :: 2.0 * Pi;

// The smaller of two values, for any type that can be compared with <, e.g math.min(3, 7) or math.min(a, b) of two f32
min :: <T>(a: T, b: T) -> T {
    if b < a { return b; }
    return a;
}

// The bigger of two values, for any type that can be compared with <
max :: <T>(a: T, b: T) -> T {
    if a < b { return b; }
    return a;
}

// The value, kept between low and high, e.g math.clamp(health, 0, 100)
clamp :: <T>(value: T, low: T, high: T) -> T {
    if value < low  { return low; }
    if high < value { return high; }
    return value;
}

// The value a fraction t of the way from a to b: a at 0, b at 1
lerp :: (a: f32, b: f32, t: f32) -> f32 {
    return a + (b - a) * t;
}

// Where value is between a and b, as a fraction: 0 at a, 1 at b. The opposite of lerp
inverseLerp :: (a: f32, b: f32, value: f32) -> f32 {
    if a == b { return 0; }
    return (value - a) / (b - a);
}

// Moves current towards target by at most maxDelta, without going past it
moveTowards :: (current: f32, target: f32, maxDelta: f32) -> f32 {
    if fabsf(target - current) <= maxDelta { return target; }
    if target > current { return current + maxDelta; }
    return current - maxDelta;
}

// -1, 0 or 1, by the sign of the value
sign :: (value: f32) -> f32 {
    if value > 0 { return 1; }
    if value < 0 { return -1; }
    return 0;
}

// Degrees to radians, e.g math.toRadians(90.0) is Pi / 2
toRadians :: (degrees: f32) -> f32 {
    return degrees * (Pi / 180.0);
}

// Radians to degrees
toDegrees :: (radians: f32) -> f32 {
    return radians * (180.0 / Pi);
}
