namespace math;

//////////////////////////////////////////////////////////////////////////////////////
//  C math.h functions
//////////////////////////////////////////////////////////////////////////////////////

// The functions of C89. On Windows they are in msvcrt.dll, the C runtime that programs are linked with
extern "C" {
    fabs :: (value: f64) -> f64;

    floor  :: (value: f64) -> f64;
    floorf :: (value: f32) -> f32;
    ceil   :: (value: f64) -> f64;
    ceilf  :: (value: f32) -> f32;

    // Trigonometry, in radians
    sin    :: (angle: f64) -> f64;
    sinf   :: (angle: f32) -> f32;
    cos    :: (angle: f64) -> f64;
    cosf   :: (angle: f32) -> f32;
    tan    :: (angle: f64) -> f64;
    tanf   :: (angle: f32) -> f32;
    asin   :: (value: f64) -> f64;
    asinf  :: (value: f32) -> f32;
    acos   :: (value: f64) -> f64;
    acosf  :: (value: f32) -> f32;
    atan   :: (value: f64) -> f64;
    atanf  :: (value: f32) -> f32;
    atan2  :: (y: f64, x: f64) -> f64;
    atan2f :: (y: f32, x: f32) -> f32;

    // Hyperbolic
    sinh  :: (value: f64) -> f64;
    sinhf :: (value: f32) -> f32;
    cosh  :: (value: f64) -> f64;
    coshf :: (value: f32) -> f32;
    tanh  :: (value: f64) -> f64;
    tanhf :: (value: f32) -> f32;

    // Powers, exponentials and logarithms
    sqrt   :: (value: f64) -> f64;
    sqrtf  :: (value: f32) -> f32;
    pow    :: (base: f64, exp: f64) -> f64;
    powf   :: (base: f32, exp: f32) -> f32;
    exp    :: (value: f64) -> f64;
    expf   :: (value: f32) -> f32;
    log    :: (value: f64) -> f64;
    logf   :: (value: f32) -> f32;
    log10  :: (value: f64) -> f64;
    log10f :: (value: f32) -> f32;

    // Taking floats apart
    fmod  :: (x: f64, y: f64) -> f64;
    fmodf :: (x: f32, y: f32) -> f32;
    modf  :: (value: f64, iptr: *f64) -> f64;      // Integer and fractional parts
    modff :: (value: f32, iptr: *f32) -> f32;
    frexp :: (value: f64, exp: *i32) -> f64;       // Significand and exponent
    ldexp :: (value: f64, exp: i32) -> f64;        // value * 2^exp
}

// The functions of C99. msvcrt.dll is older than C99 and doesn't have them, so on Windows they come from ucrtbase.dll, the
// Universal C runtime that is part of Windows since Windows 10. A function that a DLL doesn't have stops a program before
// it starts, without a message. On Linux the name of the DLL doesn't matter
extern "ucrtbase.dll" {
    // Rounding
    round      :: (value: f64) -> f64;
    roundf     :: (value: f32) -> f32;
    lround     :: (value: f64) -> i64;
    llround    :: (value: f64) -> i64;
    trunc      :: (value: f64) -> f64;
    truncf     :: (value: f32) -> f32;
    rint       :: (value: f64) -> f64;
    rintf      :: (value: f32) -> f32;
    nearbyint  :: (value: f64) -> f64;
    nearbyintf :: (value: f32) -> f32;

    // Inverse hyperbolic
    asinh  :: (value: f64) -> f64;
    asinhf :: (value: f32) -> f32;
    acosh  :: (value: f64) -> f64;
    acoshf :: (value: f32) -> f32;
    atanh  :: (value: f64) -> f64;
    atanhf :: (value: f32) -> f32;

    // Powers, exponentials and logarithms
    cbrt   :: (value: f64) -> f64;
    cbrtf  :: (value: f32) -> f32;
    hypot  :: (x: f64, y: f64) -> f64;
    exp2   :: (value: f64) -> f64;
    exp2f  :: (value: f32) -> f32;
    expm1  :: (value: f64) -> f64;
    expm1f :: (value: f32) -> f32;
    log2   :: (value: f64) -> f64;
    log2f  :: (value: f32) -> f32;
    log1p  :: (value: f64) -> f64;
    log1pf :: (value: f32) -> f32;

    // Floating-point manipulation
    remainder  :: (x: f64, y: f64) -> f64;
    remainderf :: (x: f32, y: f32) -> f32;
    fmin       :: (x: f64, y: f64) -> f64;
    fminf      :: (x: f32, y: f32) -> f32;
    fmax       :: (x: f64, y: f64) -> f64;
    fmaxf      :: (x: f32, y: f32) -> f32;
    fdim       :: (x: f64, y: f64) -> f64;
    fdimf      :: (x: f32, y: f32) -> f32;
    fma        :: (x: f64, y: f64, z: f64) -> f64;
    fmaf       :: (x: f32, y: f32, z: f32) -> f32;
    scalbn     :: (value: f64, exp: i32) -> f64;     // Scale by FLT_RADIX power
    scalbnf    :: (value: f32, exp: i32) -> f32;
    ilogb      :: (value: f64) -> i32;               // The exponent
    ilogbf     :: (value: f32) -> i32;
    logb       :: (value: f64) -> f64;
    logbf      :: (value: f32) -> f32;
    copysign   :: (x: f64, y: f64) -> f64;           // The size of x with the sign of y
    copysignf  :: (x: f32, y: f32) -> f32;
    nextafter  :: (x: f64, y: f64) -> f64;           // The next float after x towards y
    nextafterf :: (x: f32, y: f32) -> f32;

    // Error and gamma
    erf     :: (value: f64) -> f64;
    erff    :: (value: f32) -> f32;
    erfc    :: (value: f64) -> f64;
    erfcf   :: (value: f32) -> f32;
    tgamma  :: (value: f64) -> f64;
    tgammaf :: (value: f32) -> f32;
    lgamma  :: (value: f64) -> f64;
    lgammaf :: (value: f32) -> f32;
}

//////////////////////////////////////////////////////////////////////////////////////
//  The functions of math.h that are macros or inline functions on Windows, and in no DLL
//////////////////////////////////////////////////////////////////////////////////////

// The absolute value. C's abs is of an int, which this was bound to, so it gave back what it was given
abs :: (value: f64) -> f64 {
    return fabs(value);
}

fabsf :: (value: f32) -> f32 {
    bits := *(&value as *u32) & 0x7fffffff;    // Without the sign bit, also for -0.0 and NaN
    return *(&bits as *f32);
}

hypotf :: (x: f32, y: f32) -> f32 {
    return hypot(x, y) as f32;
}

ldexpf :: (value: f32, exp: i32) -> f32 {
    return ldexp(value, exp) as f32;
}

frexpf :: (value: f32, exp: *i32) -> f32 {
    return frexp(value, exp) as f32;
}

// Classification: non-zero is true, like C. Read from the bits of the f64: the sign, 11 bits of exponent and 52 of fraction
@private
exponentBits :: (value: f64) -> u64 {
    return (*(&value as *u64) >> 52) & 0x7ff;
}

isnan :: (value: f64) -> i32 {
    if value != value { return 1; }    // Only NaN isn't equal to itself
    return 0;
}

isinf :: (value: f64) -> i32 {
    if exponentBits(value) == 0x7ff && (*(&value as *u64) & 0xfffffffffffff) == 0 { return 1; }
    return 0;
}

isfinite :: (value: f64) -> i32 {
    if exponentBits(value) != 0x7ff { return 1; }
    return 0;
}

isnormal :: (value: f64) -> i32 {
    exponent := exponentBits(value);
    if exponent != 0 && exponent != 0x7ff { return 1; }
    return 0;
}

signbit :: (value: f64) -> i32 {
    return (*(&value as *u64) >> 63) as i32;
}

//////////////////////////////////////////////////////////////////////////////////////
//  Constants and helpers of Saad's own
//////////////////////////////////////////////////////////////////////////////////////

Pi  :: 3.14159265358979323846;
Tau :: 2.0 * Pi;

// The smaller of two values, for any type that can be compared with <, e.g math.min(3, 7) or math.min(a, b) of two f32
min :: <T>(a: T, b: T) -> T {
    if b < a { return b; }
    return a;
}

// The bigger of two values, for any type that can be compared with <
max :: <T>(a: T, b: T) -> T {
    if a < b { return b; }
    return a;
}

// The value, kept between low and high, e.g math.clamp(health, 0, 100)
clamp :: <T>(value: T, low: T, high: T) -> T {
    if value < low  { return low; }
    if high < value { return high; }
    return value;
}

// The value a fraction t of the way from a to b: a at 0, b at 1
lerp :: (a: f32, b: f32, t: f32) -> f32 {
    return a + (b - a) * t;
}

// Where value is between a and b, as a fraction: 0 at a, 1 at b. The opposite of lerp
inverseLerp :: (a: f32, b: f32, value: f32) -> f32 {
    if a == b { return 0; }
    return (value - a) / (b - a);
}

// Moves current towards target by at most maxDelta, without going past it
moveTowards :: (current: f32, target: f32, maxDelta: f32) -> f32 {
    if fabsf(target - current) <= maxDelta { return target; }
    if target > current { return current + maxDelta; }
    return current - maxDelta;
}

// -1, 0 or 1, by the sign of the value
sign :: (value: f32) -> f32 {
    if value > 0 { return 1; }
    if value < 0 { return -1; }
    return 0;
}

// Degrees to radians, e.g math.toRadians(90.0) is Pi / 2
toRadians :: (degrees: f32) -> f32 {
    return degrees * (Pi / 180.0);
}

// Radians to degrees
toDegrees :: (radians: f32) -> f32 {
    return radians * (180.0 / Pi);
}
