namespace os;

// Files, environment variables and processes. Built on the C runtime.
// The Windows API is in os.windows

use c;
import os.windows;

// Ends the program right away with the exit code
exit :: (code: int) {
    c.exit(code);
}

// Runs a command in the shell and returns its exit code
run :: (command: string) -> int {
    cCommand := command.toCString();
    code := system(cCommand);
    free(cCommand);
    return code;
}

// Runs a command in the shell and returns what it wrote to its standard output, and its exit code. The text is allocated
// with malloc. What the command writes to its standard error is not captured, e.g
//
//     text, code := os.output("git status --short");
//
// The shell is cmd.exe, which removes the first and the last quote of a command that starts with a quote. So the command
// is put in quotes, and one that starts with a quoted path works: os.output("\"C:/Program Files/tool.exe\" \"my file.txt\"")
output :: (command: string) -> string, int {
    quoted := malloc(command.len + 3) as *u8;
    quoted[0] = '"';
    memcpy(&quoted[1], command.data, command.len);
    quoted[command.len + 1] = '"';
    quoted[command.len + 2] = 0;

    mode := "rb";
    pipe := _popen(quoted, mode.data);
    free(quoted);
    if pipe == null {
        return "", -1;
    }

    text := readAll(pipe);
    code := _pclose(pipe);
    return text, code;
}

// The arguments the program was started with. The first is the program itself
args :: () -> []string {
    argc: i32;
    argv, env: **u8;
    startInfo: i32;
    windows.__getmainargs(&argc, &argv, &env, 0, &startInfo);

    result: []string;
    result.data  = malloc(argc as int * sizeof(string)) as *string;
    result.count = argc;
    for i in 0..argc {
        result[i] = fromCString(argv[i]);
    }
    return result;
}

// The value of an environment variable. ok is false if it isn't set
getEnv :: (name: string) -> string, bool {
    cName := name.toCString();
    value := getenv(cName);
    free(cName);
    if value == null {
        return "", false;
    }
    return fromCString(value), true;
}

// The whole file. ok is false if it couldn't be read. The text is allocated with malloc
readFile :: (path: string) -> string, bool {
    file := openFile(path, "rb");
    if file == null {
        return "", false;
    }

    text := readAll(file);
    fclose(file);
    return text, true;
}


// Everything that is left to read of a FILE
@private
readAll :: (file: *void) -> string {
    capacity := 4096;
    count    := 0;
    data     := malloc(capacity) as *u8;
    while true {
        if count == capacity {
            capacity *= 2;
            data = realloc(data, capacity) as *u8;
        }
        read := fread(&data[count], 1, (capacity - count) as i64, file) as int;
        if read <= 0 {
            break;
        }
        count += read;
    }

    text: string;
    text.data = data;
    text.len  = count;
    return text;
}

// Creates the file or replaces what is in it. Returns false if it couldn't be written
writeFile :: (path: string, text: string) -> bool {
    return writeToFile(path, text, "wb");
}

// Adds the text to the end of the file, and creates it if it doesn't exist
appendFile :: (path: string, text: string) -> bool {
    return writeToFile(path, text, "ab");
}

// Makes the folder, if it isn't there. Its parent folder must be there. true when it is there afterwards
makeDir :: (path: string) -> bool {
    cPath := path.toCString();
    made := windows.CreateDirectoryA(cPath, null);
    free(cPath);
    return made || windows.GetLastError() == windows.ErrorAlreadyExists;
}

fileExists :: (path: string) -> bool {
    file := openFile(path, "rb");
    if file == null {
        return false;
    }
    fclose(file);
    return true;
}

// Returns false if the file couldn't be removed
removeFile :: (path: string) -> bool {
    cPath := path.toCString();
    result := remove(cPath);
    free(cPath);
    return result == 0;
}

// Returns false if the file couldn't be renamed
renameFile :: (oldPath: string, newPath: string) -> bool {
    cOld := oldPath.toCString();
    cNew := newPath.toCString();
    result := rename(cOld, cNew);
    free(cOld);
    free(cNew);
    return result == 0;
}

@private
openFile :: (path: string, mode: string) -> *void {
    cPath := path.toCString();
    file := fopen(cPath, mode.data);
    free(cPath);
    return file;
}

@private
writeToFile :: (path: string, text: string, mode: string) -> bool {
    file := openFile(path, mode);
    if file == null {
        return false;
    }
    written := fwrite(text.data, 1, text.len, file);
    fclose(file);
    return written == text.len;
}
