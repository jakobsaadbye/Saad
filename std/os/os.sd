namespace os;

// Files, environment variables and processes. Built on the C runtime.
// The Windows API is in os.windows

use c;
import os.windows;
import mem;
import fmt;

// Ends the program right away with the exit code
exit :: (code: int) {
    c.exit(code);
}

// Runs a command in the shell and returns its exit code
run :: (command: string) -> int {
    cCommand := command.toCString();
    code := system(cCommand);
    cCommand.free();
    return code;
}

// Runs a command in the shell and returns what it wrote to its standard output, and its exit code. The text is allocated
// with malloc. What the command writes to its standard error is not captured, e.g
//
//     text, code := os.output("git status --short");
//
// The shell is cmd.exe, which removes the first and the last quote of a command that starts with a quote. So the command
// is put in quotes, and one that starts with a quoted path works: os.output("\"C:/Program Files/tool.exe\" \"my file.txt\"")
output :: (command: string) -> string, int {
    quoted := mem.allocate(command.len + 3) as *u8;
    quoted[0] = '"';
    mem.copy(&quoted[1], command.data, command.len);
    quoted[command.len + 1] = '"';
    quoted[command.len + 2] = 0;

    pipe := _popen(c.string{quoted}, "rb");
    mem.free(quoted);
    if pipe == null {
        return "", -1;
    }

    text := readAll(pipe);
    code := _pclose(pipe);
    return text, code;
}

// The arguments the program was started with. The first is the program itself
args :: () -> []string {
    argc: i32;
    argv, env: *c.string;
    startInfo: i32;
    windows.__getmainargs(&argc, &argv, &env, 0, &startInfo);

    result: []string;
    result.data  = mem.allocate(argc as int * sizeof(string)) as *string;
    result.count = argc;
    for i in 0..argc {
        result[i] = argv[i].toString();
    }
    return result;
}

// The value of an environment variable. ok is false if it isn't set
getEnv :: (name: string) -> string, bool {
    cName := name.toCString();
    value := getenv(cName);
    cName.free();
    if value.isNull() {
        return "", false;
    }
    return value.toString(), true;
}

// The kinds of the errors of os, e.g err.is(os.NotFound)
NotFound :: ErrorKind{"os.NotFound"}; // The file isn't there
IOError  :: ErrorKind{"os.IOError"};  // The file is there, but couldn't be read or written, e.g without the right to

// The whole file, or an error, of the kind os.NotFound when it isn't there. The text is allocated with mem.allocate
readFile :: (path: string) -> string, error {
    file := openFile(path, "rb");
    if file == null {
        return "", fileError("Can't read", path);
    }

    text := readAll(file);
    fclose(file);
    return text, null;
}

// The error of a file that couldn't be used: os.NotFound when it isn't there, otherwise os.IOError
@private
fileError :: (what: string, path: string) -> error {
    message: fmt.StringBuilder;
    message.add("% %", what, path);
    if !fileExists(path) && what == "Can't read" {
        message.addString(": it isn't there");
        return newError(message.toString(), NotFound);
    }
    return newError(message.toString(), IOError);
}


// Everything that is left to read of a FILE
@private
readAll :: (file: *void) -> string {
    capacity := 4096;
    count    := 0;
    data     := mem.allocate(capacity) as *u8;
    while true {
        if count == capacity {
            capacity *= 2;
            data = mem.resize(data, capacity) as *u8;
        }
        read := fread(&data[count], 1, (capacity - count) as i64, file) as int;
        if read <= 0 {
            break;
        }
        count += read;
    }

    text: string;
    text.data = data;
    text.len  = count;
    return text;
}

// Creates the file or replaces what is in it. An os.IOError when it couldn't be written
writeFile :: (path: string, text: string) -> error {
    if writeToFile(path, text, "wb") { return null; }
    return fileError("Can't write", path);
}

// Adds the text to the end of the file, and creates it if it doesn't exist
appendFile :: (path: string, text: string) -> error {
    if writeToFile(path, text, "ab") { return null; }
    return fileError("Can't write", path);
}

// Makes the folder, if it isn't there. Its parent folder must be there. null when it is there afterwards
makeDir :: (path: string) -> error {
    cPath := path.toCString();
    made := windows.CreateDirectoryA(cPath, null);
    cPath.free();
    if made || windows.GetLastError() == windows.ErrorAlreadyExists { return null; }
    return fileError("Can't make the folder", path);
}

// Whether the path is a folder
isDirectory :: (path: string) -> bool {
    cPath := path.toCString();
    attributes := windows.GetFileAttributesA(cPath);
    cPath.free();
    return attributes != windows.InvalidAttributes && (attributes & windows.FileAttributeDirectory) != 0;
}

// The names of the files and folders in a folder, sorted, without . and .. An error when it isn't a folder, e.g
// os.NotFound. The names are allocated with mem.allocate
listDir :: (path: string) -> [..]string, error {
    names: [..]string;
    if !isDirectory(path) {
        return names, newError(fmt.sprint("Can't list %: it isn't a folder", path), NotFound);
    }
    pattern := fmt.sprint("%/*", path);
    cPattern := pattern.toCString();
    data: windows.FindData;
    handle := windows.FindFirstFileA(cPattern, &data);
    cPattern.free();
    if handle as u64 == windows.InvalidHandle { return names, null; }   // Empty
    while true {
        name := c.string{&data.fileName[0]}.toString();
        if name != "." && name != ".." { names.add(name.copy()); }
        if !windows.FindNextFileA(handle, &data) { break; }
    }
    windows.FindClose(handle);
    names.sort();
    return names, null;
}

fileExists :: (path: string) -> bool {
    file := openFile(path, "rb");
    if file == null {
        return false;
    }
    fclose(file);
    return true;
}

// Removes the file. An error when it couldn't be, e.g os.NotFound
removeFile :: (path: string) -> error {
    if !fileExists(path) { return newError(fmt.sprint("Can't remove %: it isn't there", path), NotFound); }
    cPath := path.toCString();
    result := remove(cPath);
    cPath.free();
    if result == 0 { return null; }
    return fileError("Can't remove", path);
}

// Renames or moves the file. An error when it couldn't be, e.g os.NotFound
renameFile :: (oldPath: string, newPath: string) -> error {
    if !fileExists(oldPath) { return newError(fmt.sprint("Can't rename %: it isn't there", oldPath), NotFound); }
    cOld := oldPath.toCString();
    cNew := newPath.toCString();
    result := rename(cOld, cNew);
    cOld.free();
    cNew.free();
    if result == 0 { return null; }
    return fileError("Can't rename", oldPath);
}

@private
openFile :: (path: string, mode: c.string) -> *void {
    cPath := path.toCString();
    file := fopen(cPath, mode);
    cPath.free();
    return file;
}

@private
writeToFile :: (path: string, text: string, mode: c.string) -> bool {
    file := openFile(path, mode);
    if file == null {
        return false;
    }
    written := fwrite(text.data, 1, text.len, file);
    fclose(file);
    return written == text.len;
}
