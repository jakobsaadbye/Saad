namespace json;

// Reads JSON text into a value through reflection, e.g
//
//     person, err := json.decode<Person>(text);
//     if err != "" { fmt.print("Bad JSON: %", err); }
//
//     err2 := json.decodeInto(text, &settings);   // Into a value that exists, e.g to keep what the JSON doesn't have

import fmt;
import time;
import errors;

// Reads the JSON into the value. err is empty when it worked, otherwise it tells what is wrong and where.
//
// * Members that are not in the JSON keep their value, so defaults stay. Members of the JSON that the struct doesn't have are skipped
// * json.Field gives a member another name, and skip: true leaves it alone. The options say how the other names are written,
//   e.g json.SnakeCase, and if members the struct doesn't have are an error (strict)
// * A null leaves the value as it is, except for pointers, which become null, and optionals (?T), which become empty
// * Strings, slices, lists, maps and the values of pointers are allocated with malloc
// * Enums are read from the name of the value, e.g "open", or its number
// * The error is of the kind json.DecodeError, e.g "age: expected a number, got a string" or a syntax error of the text
decode :: <T>(text: string, options := Options{}) -> T, error {
    value: T;
    err := decodeInto(text, &value, options);
    return value, err;
}

// Like decode, but into a value that exists. Members that are not in the JSON keep their value
decodeInto :: <T>(text: string, value: *T, options := Options{}) -> error {
    root, err := parse(text);
    if err != null {
        return err;
    }

    failed := assign(root, anyOf(value), "", &options);

    // The strings of the parsed values are used by the decoded value, so only the arrays and objects are freed
    root.free();
    if failed != "" { return errors.make(failed, kind: DecodeError); }
    return null;
}

// The kind of the errors of decode, decodeInto and parse
DecodeError :: ErrorKind{"json.DecodeError"};

// Reads a parsed value into a place whose type is only known when the program runs, e.g the argument of a parameter of a
// function of attributedFunctions(), which a reflect.Call gives as an any: json.assignAt(value, call.argument(1)). 'path'
// names it in the error, e.g "authorId"
assignAt :: (v: Value, place: any, path := "", options := Options{}) -> error {
    failed := assign(v, place, path, &options);
    if failed != "" { return errors.make(failed, kind: DecodeError); }
    return null;
}

// A copy of the value with its own arrays and objects
clone :: method (v: Value) -> Value {
    noItems:  [..]Value;
    noFields: Map<string, Value>;
    copy := v;
    copy.items  = noItems;
    copy.fields = noFields;
    for item in v.items {
        copy.items.add(item.clone());
    }
    for entry in v.fields {
        copy.fields.set(entry.key, entry.value.clone());
    }
    return copy;
}

@private
kindName :: (kind: Kind) -> string {
    return switch kind {
        case .null   => "null";
        case .bool   => "a bool";
        case .number => "a number";
        case .string => "a string";
        case .array  => "an array";
        case .object => "an object";
    };
}

@private
mismatch :: (path: string, wanted: string, v: Value) -> string {
    if path.len == 0 {
        return fmt.sprint("Expected %, but got %", wanted, kindName(v.kind));
    }
    return fmt.sprint("%: Expected %, but got %", path, wanted, kindName(v.kind));
}

@private
failAt :: (path: string, message: string) -> string {
    if path.len == 0 {
        return message;
    }
    return fmt.sprint("%: %", path, message);
}

@private
memberPath :: (path: string, name: string) -> string {
    if path.len == 0 {
        return name;
    }
    return fmt.sprint("%.%", path, name);
}

@private
indexPath :: (path: string, index: i64) -> string {
    return fmt.sprint("%[%]", path, index);
}

// Reads the value v into the memory at data, which holds a value of the type
@private
assign :: (v: Value, place: any, path: string, options: *Options) -> string {
    type := place.type;

    // null leaves the value as it is, but a pointer becomes null and an optional empty
    if v.kind == .null {
        if type.kind == .pointer || type.isOptional() { place.zero(); }
        return "";
    }

    // An optional, ?T, gets a value of T
    if type.isOptional() {
        return assign(v, place.setOptional(), path, options);
    }

    switch type.kind {
        case .bool {
            if v.kind != .bool { return mismatch(path, "a bool", v); }
            place.set(v.boolean);
            return "";
        }
        case .int {
            if v.kind != .number { return mismatch(path, "a number", v); }
            return assignInteger(v, place, path);
        }
        case .float {
            if v.kind != .number { return mismatch(path, "a number", v); }
            place.setFloat(v.number);
            return "";
        }
        case .string {
            if v.kind != .string { return mismatch(path, "a string", v); }
            place.set(v.text);
            return "";
        }
        case .enum {
            return assignEnum(v, place, path, options);
        }
        case .pointer {
            if type.pointee().kind == .void {
                return failAt(path, "Can't read JSON into a *void");
            }
            return assign(v, place.allocate(), path, options);
        }
        case .array {
            return assignElements(v, place, path, options);
        }
        case .struct {
            if type.name == "time.Time" {
                // RFC 3339 text, e.g "2026-11-02T10:15:00Z"
                if v.kind != .string { return mismatch(path, "a time as a string", v); }
                t, ok := time.parse(v.text);
                if !ok { return failAt(path, fmt.sprint("\"%\" is not a time like 2026-11-02T10:15:00Z", v.text)); }
                place.set(t);
                return "";
            }
            return assignStruct(v, place, path, options);
        }
        else {
            return failAt(path, fmt.sprint("Can't read JSON into a value of type %", type.name));
        }
    }
}

// A fixed array, a slice or a List from an array
@private
assignElements :: (v: Value, place: any, path: string, options: *Options) -> string {
    if v.kind != .array { return mismatch(path, "an array", v); }

    count := v.items.count;
    array := place.type.asArray();
    if array != null && array.arrayKind == .fixed {
        if count > array.count {
            return failAt(path, fmt.sprint("The array has % elements, but there is room for %", count, array.count));
        }
    } else {
        place.resize(count);
    }

    for item, i in v.items {
        err := assign(item, place.element(i), indexPath(path, i), options);
        if err != "" { return err; }
    }
    return "";
}

@private
assignStruct :: (v: Value, place: any, path: string, options: *Options) -> string {
    type := place.type.asStruct();

    if type.name == typeof(Value) {
        place.set(v.clone());
        return "";
    }
    if type.isList() {
        return assignElements(v, place, path, options);
    }
    if type.isMap() {
        return assignMap(v, place, path, options);
    }
    if type.isUnion() {
        return assignUnion(v, place, path, options);
    }

    if v.kind != .object { return mismatch(path, "an object", v); }

    // The name of each member in the JSON. Empty for skipped members
    keys: [..]string;
    for *member in type.members {
        field, named := fieldOf(member);
        key := field.name;
        if field.skip { key = ""; }
        else if !named { key = styleName(member.name, options.names); }
        keys.add(key);
    }

    err := "";
    for *member, i in type.members {
        key := keys[i];
        if key.len == 0 || !v.has(key) { continue; }

        err = assign(v.get(key), place.memberAt(member), memberPath(path, key), options);
        if err != "" { break; }
    }

    if err == "" && options.strict {
        for entry in v.fields {
            if !keys.contains(entry.key) {
                err = failAt(path, fmt.sprint("% has no member '%'", type.name, entry.key));
                break;
            }
        }
    }

    if options.names != .asWritten {
        for *member, i in type.members {
            _, named := fieldOf(member);
            if !named && keys[i].len > 0 { keys[i].free(); }
        }
    }
    keys.free();
    return err;
}

// A union from the name of a variant without a value, e.g "empty", or an object with one member, e.g {"circle": {"radius": 2}}
@private
assignUnion :: (v: Value, place: any, path: string, options: *Options) -> string {
    type := place.type.asStruct();
    name := "";
    if v.kind == .string {
        name = v.text;
    } else if v.kind == .object && v.fields.count == 1 {
        name = v.keys()[0];
    } else {
        return mismatch(path, fmt.sprint("the name of a variant of %, or an object with one", type.name), v);
    }

    for i in 1..type.members.count {
        variant := &type.members[i];
        styled := styleName(variant.name, options.enumValues);
        same := styled == name;
        if options.enumValues != .asWritten { styled.free(); }
        if !same { continue; }

        value := place.setVariant(variant.name);
        if variant.type.kind == .void {
            return "";
        }
        if v.kind == .string {
            return failAt(path, fmt.sprint("The variant '%' of % needs a value", name, type.name));
        }
        return assign(v.get(name), value, memberPath(path, name), options);
    }
    return failAt(path, fmt.sprint("'%' is not a variant of %", name, type.name));
}

// A Map<string, V> from an object
@private
assignMap :: (v: Value, place: any, path: string, options: *Options) -> string {
    if v.kind != .object { return mismatch(path, "an object", v); }
    if place.type.keyType().kind != .string {
        return failAt(path, fmt.sprint("Can't read an object into a % as its keys are not strings", place.type.name));
    }

    for field in v.fields {
        err := assign(field.value, place.put(field.key), memberPath(path, field.key), options);
        if err != "" { return err; }
    }
    return "";
}

@private
assignEnum :: (v: Value, place: any, path: string, options: *Options) -> string {
    type := place.type.asEnum();
    // The flags of an enum flags are a list of their names, e.g ["verbose", "color"]
    if v.kind == .array && type.isFlags() {
        place.zero();
        for item, i in v.items {
            flag: i64 = 0;
            err := assignEnum(item, anyAt(&flag, type), fmt.sprint("%[%]", path, i), options);
            if err != "" { return err; }
            value, _ := place.toInt();
            place.setInt(value | flag);
        }
        return "";
    }

    value: i64 = 0;
    switch v.kind {
        case .string {
            found := false;
            for option in type.values {
                name := styleName(option.name, options.enumValues);
                same := name == v.text;
                if options.enumValues != .asWritten { name.free(); }
                if same {
                    value = option.value;
                    found = true;
                    break;
                }
            }
            if !found {
                return failAt(path, fmt.sprint("'%' is not a value of %", v.text, type.name));
            }
        }
        case .number {
            value = v.number as i64;
            _, ok := type.nameOf(value);
            if !ok || value as f64 != v.number {
                return failAt(path, fmt.sprint("% is not a value of %", v.text, type.name));
            }
        }
        else {
            return mismatch(path, "the name of a value of the enum", v);
        }
    }

    place.setInt(value);
    return "";
}

// An integer is read from how the number is written, so that big numbers don't lose digits on the way through an f64
@private
assignInteger :: (v: Value, place: any, path: string) -> string {
    if place.setIntText(v.text) { return ""; }

    // e.g 1.0 or 2e3, which are whole numbers
    plain := true;
    for ch in v.text {
        if ch != '-' && (ch < '0' || ch > '9') { plain = false; }
    }
    n := v.number;
    if !plain {
        if n != (n as i64) as f64 {
            return failAt(path, fmt.sprint("% is not a whole number, as a % must be", v.text, place.type.name));
        }
        if place.setInt(n as i64) { return ""; }
    }
    return failAt(path, fmt.sprint("% doesn't fit in a %", v.text, place.type.name));
}
