namespace json;

// Writes values as JSON text, e.g
//
//     Person :: struct {
//         @json.Field(name: "first_name")
//         firstName: string;
//
//         @json.Field(skip: true)
//         cache: *void;
//     }
//
//     text := json.encode(person);              // {"first_name":"Ada"}
//     text := json.encode(person, json.Pretty); // over more lines, see options.sd

import fmt;
import time;
use c;

// How a struct member is written and read. Without it, a member is written with its own name
@attribute
Field :: struct {
    name:      string;        // The name in JSON, instead of the name of the member
    skip:      bool = false;  // Not written or read
    omitEmpty: bool = false;  // Not written when it is empty: 0, false, "", null or no elements
}

// The value as JSON text. The options say how, e.g json.Pretty, json.SnakeCase or json.Options{indent: 4, omitEmpty: true}
//
//   bool, numbers and strings   as themselves
//   enums                       the name of the value, e.g "open", or its number with enumsAsNumbers
//   structs                     objects, with the names from json.Field
//   arrays, slices and lists    arrays
//   Map<string, V>              objects
//   pointers                    the value they point to, or null
//   json.Value                  as it is
encode :: <T>(value: T, options := Options{}) -> string {
    w := newWriter(options);
    // A pointer keeps the type of a collection, which would be a slice of its elements in an any
    boxed: any = &value;
    pointer := boxed.type as *TypePointer;
    w.writeAny(*(boxed.data as **void), pointer.pointerTo);
    return w.sb.toString();
}

// A value whose type is only known when the program runs, e.g a result of a function of attributedFunctions(), which a
// reflect.Call gives as an any: json.encodeAt(call.result(0)). For a value of the program, use encode, which keeps the type
// of a collection
encodeAt :: (value: any, options := Options{}) -> string {
    w := newWriter(options);
    w.writeAny(value.data, value.type);
    return w.sb.toString();
}

//////////////////////////////////////////////////////////////////////////////////////
// Writer
//////////////////////////////////////////////////////////////////////////////////////

@private
Writer :: struct {
    sb:      fmt.StringBuilder;
    options: Options;
    depth:   int;
}

@private
newWriter :: (options: Options) -> Writer {
    return Writer{sb: fmt.newStringBuilder(64), options: options};
}

// A newline and the indentation, when writing over more lines
@private
newline :: method (w: *Writer) {
    if w.options.indent <= 0 { return; }
    w.sb.addChar('\n');
    for 0..(w.options.indent * w.depth) {
        w.sb.addChar(' ');
    }
}

@private
writeString :: method (w: *Writer, s: string) {
    w.sb.addChar('"');
    plain := 0;   // The start of the characters that are written as they are, which are added at once
    i := 0;
    while i < s.len {
        i = plainUntil(s, i);
        if i >= s.len { break; }
        ch := s[i];
        if i > plain { w.sb.addStringSlice(s, plain, i); }
        plain = i + 1;
        i += 1;
        switch ch {
            case '"'  { w.sb.addString("\\\""); }
            case '\\' { w.sb.addString("\\\\"); }
            case '\n' { w.sb.addString("\\n"); }
            case '\r' { w.sb.addString("\\r"); }
            case '\t' { w.sb.addString("\\t"); }
            case 8         { w.sb.addString("\\b"); }
            case 12        { w.sb.addString("\\f"); }
            case 0..' ' {
                // The other control characters
                w.sb.addString("\\u00");
                w.sb.addChar(hexChar((ch >> 4) as int));
                w.sb.addChar(hexChar((ch & 15) as int));
            }
            else { w.sb.addChar(ch); }
        }
    }
    if s.len > plain { w.sb.addStringSlice(s, plain, s.len as int); }
    w.sb.addChar('"');
}

// A byte in each of the 8 bytes of a u64, for plainUntil
@private EveryOne       :: 0x0101010101010101 as u64;
@private EveryTopBit    :: 0x8080808080808080 as u64;
@private EverySpace     :: 0x2020202020202020 as u64;   // ' '
@private EveryQuote     :: 0x2222222222222222 as u64;   // "
@private EveryBackslash :: 0x5C5C5C5C5C5C5C5C as u64;   // \

// The index of the first character from 'at' that has to be escaped: a control character, " or \. The length of s when
// there is none. Texts are mostly plain, so 8 characters are looked at at once, as the bytes of a u64: a byte b of x
// is below n when (b - n) borrows into its top bit while b's own top bit is clear, and it is c when x ^ c has a zero
// byte there. These are exact for whether any byte of the word matches, so a word that has none is skipped whole
@private
@noOverflowCheck   // The subtractions of the bytes of a word borrow on purpose
plainUntil :: (s: string, at: int) -> int {
    i := at;
    while i + 8 <= s.len {
        x := *((&s.data[i]) as *u64);
        quote := x ^ EveryQuote;
        slash := x ^ EveryBackslash;
        special := ((x - EverySpace) & ~x) | ((quote - EveryOne) & ~quote) | ((slash - EveryOne) & ~slash);
        if (special & EveryTopBit) != 0 { break; }
        i += 8;
    }
    while i < s.len {
        ch := s[i];
        if ch < ' ' || ch == '"' || ch == '\\' { return i; }
        i += 1;
    }
    return i;
}

@private
writeBool :: method (w: *Writer, b: bool) {
    if b { w.sb.addString("true"); }
    else { w.sb.addString("false"); }
}

@private
hexChar :: (digit: int) -> u8 {
    if digit < 10 { return ('0' + digit) as u8; }
    return ('a' + digit - 10) as u8;
}

// The shortest text that reads back as the same f64. Not a number and infinity are not JSON, so they are written as null
@private
writeF64 :: method (w: *Writer, n: f64) {
    if n != n || n - n != 0.0 {
        w.sb.addString("null");
        return;
    }

    buffer: [32]u8;
    for precision in 15..18 {
        sprintf(buffer.data, "%.*g", precision, n);
        if strtod(c.string{buffer.data}, null) == n { break; }
    }
    w.sb.addString(c.string{buffer.data}.toString());
}

@private
writeF32 :: method (w: *Writer, n: f32) {
    if n != n || n - n != 0.0 {
        w.sb.addString("null");
        return;
    }

    buffer: [32]u8;
    for precision in 6..10 {
        sprintf(buffer.data, "%.*g", precision, n as f64);
        if strtod(c.string{buffer.data}, null) as f32 == n { break; }
    }
    w.sb.addString(c.string{buffer.data}.toString());
}

@private
writeValue :: method (w: *Writer, v: Value) {
    switch v.kind {
        case .null   { w.sb.addString("null"); }
        case .bool   { w.writeBool(v.boolean); }
        case .string { w.writeString(v.text); }
        case .number {
            if v.text.len > 0 { w.sb.addString(v.text); }
            else              { w.writeF64(v.number); }
        }
        case .array {
            w.beginList('[', v.items.count);
            for item, i in v.items {
                w.nextElement(i);
                w.writeValue(item);
            }
            w.endList(']', v.items.count);
        }
        case .object {
            w.beginList('{', v.fields.count);
            i := 0;
            for entry in v.fields {
                w.nextElement(i);
                w.writeKey(entry.key);
                w.writeValue(entry.value);
                i += 1;
            }
            w.endList('}', v.fields.count);
        }
    }
}

@private
beginList :: method (w: *Writer, open: u8, count: i64) {
    w.sb.addChar(open);
    w.depth += 1;
}

@private
nextElement :: method (w: *Writer, index: i64) {
    if index > 0 { w.sb.addChar(','); }
    w.newline();
}

@private
endList :: method (w: *Writer, close: u8, count: i64) {
    w.depth -= 1;
    if count > 0 { w.newline(); }
    w.sb.addChar(close);
}

@private
writeKey :: method (w: *Writer, key: string) {
    w.writeString(key);
    w.sb.addChar(':');
    if w.options.indent > 0 { w.sb.addChar(' '); }
}

// The name of a member in the style of the options
@private
writeMemberName :: method (w: *Writer, name: string) {
    w.sb.addChar('"');
    addStyledName(&w.sb, name, w.options.names);
    w.sb.addChar('"');
    w.sb.addChar(':');
    if w.options.indent > 0 { w.sb.addChar(' '); }
}

//
// Writing any value through reflection
//

@private
writeAny :: method (w: *Writer, data: *void, type: *Type) {
    switch type.kind {
        case .bool {
            w.writeBool(*(data as *bool));
        }
        case .int {
            writeInteger(&w.sb, data, type as *TypePrimitive);
        }
        case .float {
            if type.size == 4 { w.writeF32(*(data as *f32)); }
            else              { w.writeF64(*(data as *f64)); }
        }
        case .string {
            w.writeString(*(data as *string));
        }
        case .enum {
            enumType := type as *TypeEnum;
            value := enumType.readValue(data);
            if type.flags.has(.isFlags) && !w.options.enumsAsNumbers {
                // The names of the flags that are set, e.g ["verbose", "color"]
                names, all := enumType.flagNames(value);
                if all {
                    w.sb.addChar('[');
                    for flag, i in names {
                        if i > 0 { w.sb.addChar(','); }
                        w.sb.addChar('"');
                        addStyledName(&w.sb, flag, w.options.enumValues);
                        w.sb.addChar('"');
                    }
                    w.sb.addChar(']');
                    names.free();
                    return;
                }
                names.free();
            }
            name, ok := enumType.nameOf(value);
            if ok && !w.options.enumsAsNumbers {
                w.sb.addChar('"');
                addStyledName(&w.sb, name, w.options.enumValues);
                w.sb.addChar('"');
            } else {
                w.sb.addInt64(value);
            }
        }
        case .pointer {
            pointee := (type as *TypePointer).pointerTo;
            address := *(data as **void);
            if address == null || pointee.kind == .void {
                w.sb.addString("null");
            } else {
                w.writeAny(address, pointee);
            }
        }
        case .array {
            arrayType := type as *TypeArray;
            elements, count := arrayElements(data, arrayType);
            w.writeElements(elements, count, arrayType.elemType);
        }
        case .struct {
            if type.isOptional() {
                // The value, or null when it is empty
                value, valueType, present := (type as *TypeStruct).optionalValue(data);
                if present { w.writeAny(value, valueType); }
                else       { w.sb.addString("null"); }
            } else if type.name == "time.Time" {
                // As RFC 3339 text, e.g "2026-11-02T10:15:00Z"
                text := (*(data as *time.Time)).toString();
                w.writeString(text);
                text.free();
            } else {
                w.writeStruct(data, type as *TypeStruct);
            }
        }
        case .any {
            boxed := *(data as *any);
            if boxed.type == null { w.sb.addString("null"); }
            else                  { w.writeAny(boxed.data, boxed.type); }
        }
        else {
            w.sb.addString("null");
        }
    }
}

@private
writeElements :: method (w: *Writer, elements: *u8, count: i64, elemType: *Type) {
    w.beginList('[', count);
    for i in 0..count {
        w.nextElement(i);
        w.writeAny(&elements[i * elemType.size], elemType);
    }
    w.endList(']', count);
}

@private
writeStruct :: method (w: *Writer, data: *void, type: *TypeStruct) {
    name := type.head.name;

    if name == typeof(Value) {
        w.writeValue(*(data as *Value));
        return;
    }
    if name.startsWith("List<") {
        elements, count, elemType := listElements(data, type);
        w.writeElements(elements, count, elemType);
        return;
    }
    if name.startsWith("Map<") {
        w.writeMap(data, type);
        return;
    }
    if type.head.isUnion() {
        w.writeUnion(data, type);
        return;
    }

    // The members that are written, with their keys, worked out once for the type
    plan := planOf(type, w.options.names);
    w.beginList('{', plan.members.count);
    written := 0;
    for i in 0..plan.members.count {
        member := &plan.members[i];
        value := (&((data as *u8)[member.offset])) as *void;
        if (member.omitEmpty || w.options.omitEmpty) && isEmpty(value, member.type) { continue; }

        w.nextElement(written);
        w.sb.addString(member.key);
        if w.options.indent > 0 { w.sb.addChar(' '); }
        w.writeAny(value, member.type);
        written += 1;
    }
    w.endList('}', written);
}

// How the members of a struct are written: the ones that aren't skipped, with their keys in the style of the names,
// e.g "created_at":. Each thread works it out once for each type and style, as reflection would cost the same for
// every value
@private
Plan :: struct {
    type:    *TypeStruct;
    names:   NameStyle;
    members: [..]PlanMember;
}

@private
PlanMember :: struct {
    offset:    i64;
    type:      *Type;
    key:       string;    // The quoted name and the colon
    omitEmpty: bool;
}

@private
@threadLocal plans: [..]*Plan;

@private
planOf :: (type: *TypeStruct, names: NameStyle) -> *Plan {
    for p in plans {
        if p.type == type && p.names == names { return p; }
    }
    plan := new(Plan, heapAllocator());
    plan.type  = type;
    plan.names = names;
    plan.members.allocator = heapAllocator();
    for i in 0..type.members.count {
        member := &type.members[i];
        field, named := fieldOf(member);
        if field.skip { continue; }
        key: Writer;
        key.sb.allocator = heapAllocator();
        if named { key.writeString(field.name); }
        else {
            key.sb.addChar('"');
            addStyledName(&key.sb, member.name, names);
            key.sb.addChar('"');
        }
        key.sb.addChar(':');
        plan.members.add(PlanMember{offset: member.offset, type: member.type, key: key.sb.toString(), omitEmpty: field.omitEmpty});
    }
    plans.allocator = heapAllocator();
    plans.add(plan);
    return plan;
}

// A union is the name of its variant, e.g "empty", or an object with the name and the value, e.g {"circle": {"radius": 2}}.
// The names are written like enum values, so in the style of enumValues
@private
writeUnion :: method (w: *Writer, data: *void, type: *TypeStruct) {
    variant := type.variantOf(data);
    if variant == null {
        w.sb.addString("null");
        return;
    }

    if variant.type.kind == .void {
        w.sb.addChar('"');
        addStyledName(&w.sb, variant.name, w.options.enumValues);
        w.sb.addChar('"');
        return;
    }

    w.beginList('{', 1);
    w.nextElement(0);
    w.sb.addChar('"');
    addStyledName(&w.sb, variant.name, w.options.enumValues);
    w.sb.addChar('"');
    w.sb.addChar(':');
    if w.options.indent > 0 { w.sb.addChar(' '); }
    w.writeAny(variant.valueIn(data), variant.type);
    w.endList('}', 1);
}

// A Map<string, V> is an object. Maps with other keys are arrays of [key, value] pairs
@private
writeMap :: method (w: *Writer, data: *void, type: *TypeStruct) {
    entriesMember := findMember(type, "entries");
    entriesType   := entriesMember.type as *TypeStruct;
    entries, count, entryType := listElements(entriesMember.valueIn(data), entriesType);

    entryStruct := entryType as *TypeStruct;
    keyMember   := findMember(entryStruct, "key");
    valueMember := findMember(entryStruct, "value");
    stringKeys  := keyMember.type.kind == .string;

    open  := '[' as u8;
    close := ']' as u8;
    if stringKeys {
        open  = '{' as u8;
        close = '}' as u8;
    }

    w.beginList(open, count);
    for i in 0..count {
        entry := (&entries[i * entryType.size]) as *void;
        w.nextElement(i);
        if stringKeys {
            w.writeKey(*(keyMember.valueIn(entry) as *string));
            w.writeAny(valueMember.valueIn(entry), valueMember.type);
        } else {
            w.sb.addChar('[');
            w.writeAny(keyMember.valueIn(entry), keyMember.type);
            w.sb.addChar(',');
            w.writeAny(valueMember.valueIn(entry), valueMember.type);
            w.sb.addChar(']');
        }
    }
    w.endList(close, count);
}

@private
writeInteger :: (sb: *fmt.StringBuilder, data: *void, type: *TypePrimitive) {
    // A char is written as its number
    switch type.kind {
        case .u8
        case .char { sb.addUInt64((*(data as *u8)) as u64); }
        case .u16  { sb.addUInt64((*(data as *u16)) as u64); }
        case .u32
        case .uint { sb.addUInt64((*(data as *u32)) as u64); }
        case .u64  { sb.addUInt64(*(data as *u64)); }
        case .i8   { sb.addInt64((*(data as *i8)) as i64); }
        case .i16  { sb.addInt64((*(data as *i16)) as i64); }
        case .i64  { sb.addInt64(*(data as *i64)); }
        else       { sb.addInt64((*(data as *i32)) as i64); }
    }
}

//
// Helpers for reflection, also used when decoding
//

// The json.Field of a member, and if it gives the member a name. Without one, the name is the name of the member
@private
fieldOf :: (member: *StructMember) -> Field, bool {
    field: Field;
    named := attributeOf(member, &field) && field.name.len > 0;
    if !named {
        field.name = member.name;
    }
    if member.isHidden() { field.skip = true; }   // e.g the link of a row of dbms
    return field, named;
}

@private
findMember :: (type: *TypeStruct, name: string) -> *StructMember {
    for i in 0..type.members.count {
        if type.members[i].name == name {
            return &type.members[i];
        }
    }
    return null;
}

// The elements of a fixed array or a slice
@private
arrayElements :: (data: *void, type: *TypeArray) -> *u8, i64 {
    if type.kind == .fixed {
        return data as *u8, type.count;
    }
    slice := *(data as *[]u8);
    return slice.data, slice.count;
}

// The elements of a List<T>, and the type T
@private
listElements :: (data: *void, type: *TypeStruct) -> *u8, i64, *Type {
    dataMember  := findMember(type, "data");
    countMember := findMember(type, "count");
    elements := *(dataMember.valueIn(data) as **u8);
    count    := *(countMember.valueIn(data) as *i64);
    elemType := (dataMember.type as *TypePointer).pointerTo;
    return elements, count, elemType;
}

// True for 0, false, "", null and things without elements
@private
isEmpty :: (data: *void, type: *Type) -> bool {
    if type.kind == .string {
        return (*(data as *string)).len == 0;
    }
    if type.kind == .array {
        _, count := arrayElements(data, type as *TypeArray);
        return count == 0;
    }
    if type.kind == .struct {
        structType := type as *TypeStruct;
        if structType.head.name.startsWith("List<") {
            _, count, _ := listElements(data, structType);
            return count == 0;
        }
        if structType.head.name.startsWith("Map<") {
            return *(findMember(structType, "count").valueIn(data) as *i64) == 0;
        }
        if structType.head.name == typeof(Value) {
            return (*(data as *Value)).kind == .null;
        }
    }

    // All bytes are zero
    bytes := data as *u8;
    for i in 0..type.size {
        if bytes[i] != 0 { return false; }
    }
    return true;
}
