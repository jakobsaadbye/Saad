namespace fmt;

use c; // printf

// Prints the format with every % replaced by the next argument, e.g print("% is % years old", name, age)
print :: (format: string, args: ...any, newline := true) {
    sb := newStringBuilder(256);
    sb.add(format, ...args);
    if newline {
        sb.addChar(10); // '\n'
    }
    printf("%s".data, sb.buffer);
    sb.free();
}

// Like print, but returns the text instead of printing it. Free it with text.free()
sprint :: (format: string, args: ...any) -> string {
    sb := newStringBuilder(64);
    sb.add(format, ...args);
    return sb.toString();
}
