namespace fmt; // StringBuilder and the formatting of values for fmt

import time;
use c;

////////////////////////////////////////////////////////////////////////////////////
//   StringBuilder
////////////////////////////////////////////////////////////////////////////////////

// Builds up a text, e.g
//
//     sb: fmt.StringBuilder;               // Ready to use, or newStringBuilder(capacity) to start with room
//     sb.add("% items: ", count);          // Formats like fmt.print: each % is the next argument, %% is a %
//     sb.addLine("total %", total);        // With a newline after it
//     sb.addChar('[');
//     sb.addString(name);
//     text := sb.toString();               // The text, without copying. It changes when the builder does
//     sb.free();
//
// The text is always followed by a 0 byte, so sb.buffer can be given to C.
StringBuilder :: struct {
    buffer:   *u8;   // The text and a 0 byte, or null before anything is added
    cursor:   int;   // The length of the text
    capacity: int;   // The bytes the buffer has room for
}

newStringBuilder :: (initialCapacity := 64) -> StringBuilder {
    sb: StringBuilder;
    sb.reserve(initialCapacity);
    return sb;
}

// Makes room for the text to grow by at least 'extra' bytes
reserve :: method (sb: *StringBuilder, extra: int) {
    needed := sb.cursor + extra + 1; // The text, and its 0 byte
    if needed <= sb.capacity {
        return;
    }
    capacity := sb.capacity * 2;
    if capacity < 16 {
        capacity = 16;
    }
    while capacity < needed {
        capacity *= 2;
    }

    buffer := realloc(sb.buffer, capacity) as *u8;
    if buffer == null {
        printf("Out of memory: a StringBuilder couldn't grow to %d bytes\n".data, capacity);
        exit(1);
    }
    sb.buffer   = buffer;
    sb.capacity = capacity;
    sb.buffer[sb.cursor] = 0;
}

@private
addBytes :: method (sb: *StringBuilder, bytes: *u8, count: int) {
    if count <= 0 {
        return;
    }
    sb.reserve(count);
    memcpy(&sb.buffer[sb.cursor], bytes, count);
    sb.cursor += count;
    sb.buffer[sb.cursor] = 0;
}

addString :: method (sb: *StringBuilder, s: string) {
    sb.addBytes(s.data, s.len as int);
}

// The part of the string from 'start' to 'end' (not included)
addStringSlice :: method (sb: *StringBuilder, s: string, start: int, end: int) {
    sb.addBytes(&s.data[start], end - start);
}

addChar :: method (sb: *StringBuilder, c: u8) {
    sb.reserve(1);
    sb.buffer[sb.cursor] = c;
    sb.cursor += 1;
    sb.buffer[sb.cursor] = 0;
}

// The character 'count' times, e.g for indentation
addRepeated :: method (sb: *StringBuilder, c: u8, count: int) {
    if count <= 0 {
        return;
    }
    sb.reserve(count);
    memset(&sb.buffer[sb.cursor], c, count);
    sb.cursor += count;
    sb.buffer[sb.cursor] = 0;
}

// Adds the format with each % replaced by the next argument, written like fmt.print writes it. %% adds a %
add :: method (sb: *StringBuilder, format: string, args: ...any) {
    next := 0;   // The next argument
    start := 0;  // The text since the last %
    i := 0;
    while i < format.len {
        if format[i] != '%' {
            i += 1;
            continue;
        }
        sb.addStringSlice(format, start, i as int);
        if i + 1 < format.len && format[i + 1] == '%' {
            sb.addChar('%');
            i += 2;
        } else {
            if next < args.count {
                sb.addValue(args[next]);
                next += 1;
            } else {
                sb.addChar('%'); // More % than arguments
            }
            i += 1;
        }
        start = i as int;
    }
    sb.addStringSlice(format, start, format.len as int);
}

// Like add, with a newline after it
addLine :: method (sb: *StringBuilder, format: string, args: ...any) {
    sb.add(format, ...args);
    sb.addChar('\n');
}

// The length of the text
length :: method (sb: StringBuilder) -> int {
    return sb.cursor;
}

isEmpty :: method (sb: StringBuilder) -> bool {
    return sb.cursor == 0;
}

endsWith :: method (sb: StringBuilder, s: string) -> bool {
    return sb.toString().endsWith(s);
}

// Removes the last 'count' bytes, e.g the ", " after the last element of a list
removeLast :: method (sb: *StringBuilder, count := 1) {
    if count > sb.cursor {
        count = sb.cursor;
    }
    sb.cursor -= count;
    if sb.buffer != null {
        sb.buffer[sb.cursor] = 0;
    }
}

// Empties the text, and keeps the buffer for more
clear :: method (sb: *StringBuilder) {
    sb.cursor = 0;
    if sb.buffer != null {
        sb.buffer[0] = 0;
    }
}

// The text, without copying it. It changes with the builder and is gone when it is freed, so copy it with .copy()
// to keep it after that
toString :: method (sb: StringBuilder) -> string {
    s: string;
    s.data = sb.buffer;
    s.len  = sb.cursor;
    return s;
}

free :: method (sb: *StringBuilder) {
    free(sb.buffer);
    sb.buffer   = null;
    sb.cursor   = 0;
    sb.capacity = 0;
}

// The strings with the separator between them, e.g join(["a", "b"], ", ") is "a, b". It is allocated with malloc
join :: (parts: []string, separator: string) -> string {
    sb: StringBuilder;
    for part, i in parts {
        if i > 0 {
            sb.addString(separator);
        }
        sb.addString(part);
    }
    return sb.toString();
}

////////////////////////////////////////////////////////////////////////////////////
//   Numbers
////////////////////////////////////////////////////////////////////////////////////

addFloat32 :: method (sb: *StringBuilder, v: f32) {
    buf: [32]u8;
    sprintf(buf.data, xx "%f", v);
    sb.addBytes(buf.data, strlen(buf.data) as int);
}

addFloat64 :: method (sb: *StringBuilder, v: f64) {
    buf: [32]u8;
    sprintf(buf.data, xx "%lf", v);
    sb.addBytes(buf.data, strlen(buf.data) as int);
}

addInt64 :: method (sb: *StringBuilder, v: i64) {
    if v < 0 {
        sb.addChar('-');
        // -v overflows for the smallest i64, so v + 1 is negated instead
        sb.addUInt64((-(v + 1)) as u64 + 1);
        return;
    }
    sb.addUInt64(v as u64);
}

addUInt64 :: method (sb: *StringBuilder, v: u64) {
    digits: [20]u8; // Enough for any u64
    n := 0;
    while true {
        digits[n] = (v % 10) as u8 + '0';
        n += 1;
        v = v / 10;
        if v == 0 {
            break;
        }
    }
    // The digits are in reverse order
    sb.reserve(n);
    for i in 0..n {
        sb.addChar(digits[n - 1 - i]);
    }
}

////////////////////////////////////////////////////////////////////////////////////
//   Values, written as in Saad
////////////////////////////////////////////////////////////////////////////////////

// Adds a value as it is written in Saad, so it can be copied back into a program, e.g Point{x: 1, name: "Ada"}.
// A string or a char on its own is added as it is, and with quotes in a struct, an array or a union
addValue :: method (sb: *StringBuilder, value: any) {
    sb.addValueIn(value, false);
}

@deprecated("Use addValue")
addAnyValue :: method (sb: *StringBuilder, value: any) {
    sb.addValueIn(value, false);
}

@private
addValueIn :: method (sb: *StringBuilder, arg: any, inside: bool) {
    switch arg.type.kind {
        case .int {
            prim := arg.type as *TypePrimitive;
            if inside && prim.kind == .char { sb.addQuotedChar(*(arg.data as *u8)); }
            else                            { sb.addInteger(arg.data, prim); }
        }
        case .float {
            if arg.type.size == 4 { sb.addFloat32(*(arg.data as *f32)); }
            else                  { sb.addFloat64(*(arg.data as *f64)); }
        }
        case .bool {
            if *(arg.data as *bool) { sb.addString("true"); }
            else                    { sb.addString("false"); }
        }
        case .string {
            if inside { sb.addQuoted(*(arg.data as *string)); }
            else      { sb.addString(*(arg.data as *string)); }
        }
        case .enum {
            enumType := arg.type as *TypeEnum;
            name, ok := enumType.nameOf(enumType.readValue(arg.data));
            sb.addChar('.');
            if ok { sb.addString(name); }
            else  { sb.addString("<invalid>"); }
        }
        case .pointer {
            buf: [64]u8;
            written := sprintf(buf.data, xx "0x%p", *(arg.data as **void));
            sb.addBytes(buf.data, written);
        }
        case .array {
            sb.addArray(arg.data, arg.type as *TypeArray);
        }
        case .struct {
            if arg.type.isOptional() {
                // The value, or null when it is empty
                data, type, present := (arg.type as *TypeStruct).optionalValue(arg.data);
                if !present {
                    sb.addString("null");
                } else {
                    value: any;
                    value.type = type;
                    value.data = data;
                    sb.addValueIn(value, inside);
                }
            }
            else if arg.type.name == "time.Time" {
                // As text, e.g 2026-11-02T10:15:00Z
                text := (*(arg.data as *time.Time)).toString();
                sb.addString(text);
                text.free();
            }
            else if arg.type.isUnion()                { sb.addUnion(arg.data, arg.type as *TypeStruct); }
            else if arg.type.name.startsWith("List<") { sb.addList(arg.data, arg.type as *TypeStruct); }
            else                                      { sb.addStruct(arg.data, arg.type as *TypeStruct); }
        }
        else {
            sb.addChar('<');
            sb.addString(arg.type.name);
            sb.addChar('>');
        }
    }
}

addInteger :: method (sb: *StringBuilder, data: *void, type: *TypePrimitive) {
    switch type.kind {
        case .char { sb.addChar(*(data as *u8)); }
        case .u8   { sb.addUInt64((*(data as *u8)) as u64); }
        case .u16  { sb.addUInt64((*(data as *u16)) as u64); }
        case .u32
        case .uint { sb.addUInt64((*(data as *u32)) as u64); }
        case .u64  { sb.addUInt64(*(data as *u64)); }
        case .i8   { sb.addInt64((*(data as *i8)) as i64); }
        case .i16  { sb.addInt64((*(data as *i16)) as i64); }
        case .i32
        case .int  { sb.addInt64((*(data as *i32)) as i64); }
        case .i64  { sb.addInt64(*(data as *i64)); }
        else       { sb.addString("UNHANDLED"); }
    }
}

addArray :: method (sb: *StringBuilder, data: *void, type: *TypeArray) {
    // A fixed array is stored in the value, a slice points to its elements
    elements := data as *u8;
    count    := type.count;
    if type.kind != .fixed {
        slice := *(data as *[]u8);
        elements = slice.data;
        count    = slice.count;
    }

    sb.addChar('[');
    for i in 0..count {
        if i > 0 {
            sb.addString(", ");
        }
        value: any;
        value.type = type.elemType;
        value.data = &elements[i * type.elemType.size];
        sb.addValueIn(value, true);
    }
    sb.addChar(']');
}

// A List<T> as its elements, like a slice, e.g [1, 2]
@private
addList :: method (sb: *StringBuilder, data: *void, type: *TypeStruct) {
    // List starts with data: *T and count: i64, like a slice
    elemType := (type.members[0].type as *TypePointer).pointerTo;
    slice    := *(data as *[]u8);

    sb.addChar('[');
    for i in 0..slice.count {
        if i > 0 {
            sb.addString(", ");
        }
        value: any;
        value.type = elemType;
        value.data = &slice.data[i * elemType.size];
        sb.addValueIn(value, true);
    }
    sb.addChar(']');
}

// The string in quotes, with '"', '\' and the control characters escaped, e.g "say \"hi\"\n"
addQuoted :: method (sb: *StringBuilder, s: string) {
    sb.addChar('"');
    for c in s {
        sb.addEscaped(c, '"');
    }
    sb.addChar('"');
}

// The character in quotes, e.g 'a' or '\n'
addQuotedChar :: method (sb: *StringBuilder, c: u8) {
    sb.addChar('\'');
    sb.addEscaped(c, '\'');
    sb.addChar('\'');
}

@private
addEscaped :: method (sb: *StringBuilder, c: u8, quote: u8) {
    switch c {
        case '\\' { sb.addString("\\\\"); }
        case '\n' { sb.addString("\\n"); }
        case '\r' { sb.addString("\\r"); }
        case '\t' { sb.addString("\\t"); }
        case 0    { sb.addString("\\0"); }
        else {
            if c == quote { sb.addChar('\\'); }
            sb.addChar(c);
        }
    }
}

// The name of a type before a literal. An anonymous struct has none, e.g {w: 1, h: 2}
@private
addTypeName :: method (sb: *StringBuilder, type: *Type) {
    if !type.name.startsWith("struct ") && !type.name.startsWith("union ") {
        sb.addString(type.name);
    }
}

// Like a literal of the union: Shape{circle: Circle{radius: 2.000000}}, or Shape.empty for a variant without a value.
// The variant without a value of a generic union is .none, as Option<int>.none can't be written
addUnion :: method (sb: *StringBuilder, data: *void, type: *TypeStruct) {
    variant := type.variantOf(data);
    if variant == null || variant.type.kind == .void {
        if type.head.name.indexOf("<") < 0 {
            sb.addString(type.head.name);
        }
        sb.addChar('.');
        if variant == null { sb.addString("<invalid>"); }
        else               { sb.addString(variant.name); }
        return;
    }
    value: any;
    value.type = variant.type;
    value.data = variant.valueIn(data);
    sb.addTypeName(&type.head);
    sb.addChar('{');
    sb.addString(variant.name);
    sb.addString(": ");
    sb.addValueIn(value, true);
    sb.addChar('}');
}

// Like a literal of the struct: Point{x: 1, y: 2}
addStruct :: method (sb: *StringBuilder, data: *void, type: *TypeStruct) {
    sb.addTypeName(&type.head);
    sb.addChar('{');
    first := true;
    for i in 0..type.members.count {
        member := type.members[i];
        if type.members[i].isHidden() { continue; }   // e.g the link of a row of dbms
        if !first {
            sb.addString(", ");
        }
        first = false;
        sb.addString(member.name);
        sb.addString(": ");

        value: any;
        value.type = member.type;
        value.data = member.valueIn(data);
        sb.addValueIn(value, true);
    }
    sb.addChar('}');
}
