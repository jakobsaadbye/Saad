namespace fmt; // StringBuilder and the formatting of values for fmt

use c;

////////////////////////////////////////////////////////////////////////////////////
//   StringBuilder
////////////////////////////////////////////////////////////////////////////////////
StringBuilder :: struct {
    buffer:    *u8;
    cursor:    int;
    capacity:  int;
}

newStringBuilder :: (initialCapacity: int) -> StringBuilder {
    buffer: *u8 = malloc(initialCapacity);

    memset(buffer, 0, initialCapacity);

    return {
        buffer: buffer,
        cursor: 0,
        capacity: initialCapacity,
    };
}

internalGrow :: method (sb: *StringBuilder, len: int) {
    newCapacity := sb.capacity * 2;
    while newCapacity <= sb.cursor + len {
        newCapacity *= 2;
    }

    newBuffer: *u8 = realloc(sb.buffer, newCapacity);
    if newBuffer == null {
        print("OutOfMemoryException: Failed to reallocate a new buffer for the string builder");
        exit(1);
    }

    sb.buffer = newBuffer;
    sb.capacity = newCapacity;

    memset(&sb.buffer[sb.cursor], 0, newCapacity - sb.cursor);
}

internalAdd :: method (sb: *StringBuilder, strPtr: *u8, len: int) {
    if sb.cursor + len < sb.capacity {
        memcpy(&sb.buffer[sb.cursor], strPtr, len);
        sb.cursor += len;
    } else {
        sb.internalGrow(len);
    
        // Append the string
        memcpy(&sb.buffer[sb.cursor], strPtr, len);
        sb.cursor += len;
    }
}

addStringSlice :: method (sb: *StringBuilder, str: string, start: int, end: int) {
    strLen := end - start;
    strPtr := str.data;
    strPtr = &strPtr[start];
    sb.internalAdd(strPtr, strLen);
}

addChar :: method (sb: *StringBuilder, c: u8) {
    strLen := 1;
    strPtr := &c;
    sb.internalAdd(strPtr, strLen);
}

addString :: method (sb: *StringBuilder, str: string) {
    sb.internalAdd(str.data, str.len);
}

addFloat32 :: method (sb: *StringBuilder, v: f32) {
    buf: [18]u8;
    sprintf(buf.data, xx "%f", v);

    str: string;
    str.data = buf.data as *u8;
    str.len = strlen(buf.data);
    sb.internalAdd(str.data, str.len);
}

addFloat64 :: method (sb: *StringBuilder, v: f64) {
    buf: [18]u8;
    sprintf(buf.data, xx "%lf", v);

    str: string;
    str.data = buf.data as *u8;
    str.len = strlen(buf.data);
    sb.internalAdd(str.data, str.len);
}

addInt64 :: method (sb: *StringBuilder, v: i64) {
    if v < 0 {
        sb.addChar(45); // -

        // -v overflows for the smallest i64, so v + 1 is negated instead
        sb.addUInt64((-(v + 1)) as u64 + 1);
        return;
    }
    sb.addUInt64(v as u64);
}

addUInt64 :: method (sb: *StringBuilder, v: u64) {
    if v == 0 {
        sb.addChar(48); // 0
        return;
    }

    tmp: [32]u8; // enough for 64-bit int

    n := 0;
    while v != 0 {
        digit := v % 10;
        v = v / 10;

        c := (digit + 48) as u8;

        tmp[n] = c;
        n += 1;
    }

    // Add the digits in reverse order
    for i in 0..n {
        ri := (n - 1) - i;
        c := tmp[ri];
        sb.addChar(c);
    }
}

// Adds a value as it is written in Saad, so it can be copied back into a program, e.g Point{x: 1, name: "Ada"}.
// A string on its own is added as it is, and with quotes when it is in a struct, an array or a union
addAnyValue :: method (sb: *StringBuilder, arg: any)  {
    sb.addValue(arg, false);
}

@private
addValue :: method (sb: *StringBuilder, arg: any, inside: bool)  {
    switch arg.type.kind {
        case .int {
            sb.addInteger(arg.data, arg.type as *TypePrimitive);
        }
        case .float {
            if arg.type.size == 4 { sb.addFloat32(*(arg.data as *f32)); }
            else                  { sb.addFloat64(*(arg.data as *f64)); }
        }
        case .bool {
            if *(arg.data as *bool) { sb.addString("true"); }
            else                    { sb.addString("false"); }
        }
        case .string {
            if inside { sb.addQuoted(*(arg.data as *string)); }
            else      { sb.addString(*(arg.data as *string)); }
        }
        case .enum {
            enumType := arg.type as *TypeEnum;
            name, ok := enumType.nameOf(enumType.readValue(arg.data));
            sb.addString(".");
            if ok { sb.addString(name); }
            else  { sb.addString("<invalid>"); }
        }
        case .pointer {
            buf: [64]u8;
            written := sprintf(buf.data, xx "0x%p", *(arg.data as **void));

            str: string;
            str.data = buf.data;
            str.len  = written;
            sb.addString(str);
        }
        case .array {
            sb.addArray(arg.data, arg.type as *TypeArray);
        }
        case .struct {
            if arg.type.isUnion() { sb.addUnion(arg.data, arg.type as *TypeStruct); }
            else                  { sb.addStruct(arg.data, arg.type as *TypeStruct); }
        }
        else {
            sb.addString("<");
            sb.addString(arg.type.name);
            sb.addString(">");
        }
    }
}

addInteger :: method (sb: *StringBuilder, data: *void, type: *TypePrimitive) {
    switch type.kind {
        case .char {
            sb.addChar(*(data as *u8));
        }
        case .u8  { sb.addUInt64((*(data as *u8)) as u64); }
        case .u16 { sb.addUInt64((*(data as *u16)) as u64); }
        case .u32
        case .uint { sb.addUInt64((*(data as *u32)) as u64); }
        case .u64  { sb.addUInt64(*(data as *u64)); }
        case .i8   { sb.addInt64((*(data as *i8)) as i64); }
        case .i16  { sb.addInt64((*(data as *i16)) as i64); }
        case .i32
        case .int  { sb.addInt64((*(data as *i32)) as i64); }
        case .i64  { sb.addInt64(*(data as *i64)); }
        else       { sb.addString("UNHANDLED"); }
    }
}

addArray :: method (sb: *StringBuilder, data: *void, type: *TypeArray) {
    // A fixed array is stored in the value, a slice points to its elements
    elements := data as *u8;
    count    := type.count;
    if type.kind != .fixed {
        slice := *(data as *[]u8);
        elements = slice.data;
        count    = slice.count;
    }

    sb.addString("[");
    for i in 0..count {
        value: any;
        value.type = type.elemType;
        value.data = &elements[i * type.elemType.size];
        sb.addValue(value, true);

        if i != count - 1 {
            sb.addString(", ");
        }
    }
    sb.addString("]");
}

// The string in quotes, with '"', '\\' and the control characters escaped, e.g "say \"hi\"\n"
addQuoted :: method (sb: *StringBuilder, s: string) {
    sb.addChar(Quote);
    for c in s {
        switch c {
            case Quote     { sb.addString("\\\""); }
            case Backslash { sb.addString("\\\\"); }
            case 10        { sb.addString("\\n"); }
            case 13        { sb.addString("\\r"); }
            case 9         { sb.addString("\\t"); }
            else           { sb.addChar(c); }
        }
    }
    sb.addChar(Quote);
}

// The name of a type before a literal. An anonymous struct has none, e.g {w: 1, h: 2}
@private
addTypeName :: method (sb: *StringBuilder, type: *Type) {
    if !type.name.startsWith("struct ") && !type.name.startsWith("union ") {
        sb.addString(type.name);
    }
}

@private Quote     :: 34;
@private Backslash :: 92;

// Like a literal of the union: Shape{circle: Circle{radius: 2.000000}}, or Shape.empty for a variant without a value.
// The variant without a value of a generic union is .none, as Option<int>.none can't be written
addUnion :: method (sb: *StringBuilder, data: *void, type: *TypeStruct) {
    variant := type.variantOf(data);
    if variant == null || variant.type.kind == .void {
        if type.head.name.indexOf("<") < 0 {
            sb.addString(type.head.name);
        }
        sb.addString(".");
        if variant == null { sb.addString("<invalid>"); }
        else               { sb.addString(variant.name); }
        return;
    }
    value: any;
    value.type = variant.type;
    value.data = variant.valueIn(data);
    sb.addTypeName(&type.head);
    sb.addString("{");
    sb.addString(variant.name);
    sb.addString(": ");
    sb.addValue(value, true);
    sb.addString("}");
}

// Like a literal of the struct: Point{x: 1, y: 2}
addStruct :: method (sb: *StringBuilder, data: *void, type: *TypeStruct) {
    sb.addTypeName(&type.head);
    sb.addString("{");
    for member, i in type.members {
        sb.addString(member.name);
        sb.addString(": ");

        value: any;
        value.type = member.type;
        value.data = member.valueIn(data);
        sb.addValue(value, true);

        if i != type.members.count - 1 {
            sb.addString(", ");
        }
    }
    sb.addString("}");
}

add :: method (sb: *StringBuilder, format: string, args: ...any) {

    // Scan the format string to find all the placeholders
    placeholderIndicies: [..]int;
    for c, i in format {
        if c == 37 { // '%'
            placeholderIndicies.add(i);
        }
    }

    // Build up the result string by pasting each segment of the source string
    cursor := 0;
    for index, i in placeholderIndicies {

        // Add the static text up untill the placeholder
        sb.addStringSlice(format, cursor, index);

        // Fill in the placeholder
        arg := args[i];
        sb.addAnyValue(arg);

        cursor = index + 1;
    }

    // Append the trailing part after the last placeholder
    sb.addStringSlice(format, cursor, format.len);
}

clear :: method (sb: *StringBuilder) {
    memset(sb.buffer, 0, sb.capacity);
}

toString :: method (sb: *StringBuilder) -> string {
    str: string;
    str.data = sb.buffer;
    str.len  = sb.cursor;
    return str;
}

free :: method (sb: *StringBuilder) {
    free(sb.buffer);
}