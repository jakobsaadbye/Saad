namespace fmt; // StringBuilder and the formatting of values for fmt

import time;
use c;
import mem;

////////////////////////////////////////////////////////////////////////////////////
//   StringBuilder
////////////////////////////////////////////////////////////////////////////////////

// Builds up a text, e.g
//
//     sb: fmt.StringBuilder;               // Ready to use, or newStringBuilder(capacity) to start with room
//     sb.add("% items: ", count);          // Formats like fmt.print: each % is the next argument, %% is a %
//     sb.addLine("total %", total);        // With a newline after it
//     sb.addChar('[');
//     sb.addString(name);
//     text := sb.toString();               // The text, without copying. It changes when the builder does
//     sb.free();
//
// The text is always followed by a 0 byte, so sb.buffer can be given to C.
StringBuilder :: struct {
    buffer:    *u8;          // The text and a 0 byte, or null before anything is added
    cursor:    int;          // The length of the text
    capacity:  int;          // The bytes the buffer has room for
    allocator: Allocator;    // Of the buffer: the allocator of the thread when it got its first memory
}

newStringBuilder :: (initialCapacity := 64) -> StringBuilder {
    sb: StringBuilder;
    sb.reserve(initialCapacity);
    return sb;
}

// Makes room for the text to grow by at least 'extra' bytes
reserve :: method (sb: *StringBuilder, extra: int) {
    needed := sb.cursor + extra + 1; // The text, and its 0 byte
    if needed <= sb.capacity {
        return;
    }
    capacity := sb.capacity * 2;
    if capacity < 16 {
        capacity = 16;
    }
    while capacity < needed {
        capacity *= 2;
    }

    if sb.allocator == null { sb.allocator = currentAllocator(); }
    buffer := mem.resize(sb.buffer, sb.capacity, capacity, sb.allocator) as *u8;
    if buffer == null {
        printf("Out of memory: a StringBuilder couldn't grow to %d bytes\n", capacity);
        exit(1);
    }
    sb.buffer   = buffer;
    sb.capacity = capacity;
    sb.buffer[sb.cursor] = 0;
}

@private
addBytes :: method (sb: *StringBuilder, bytes: *u8, count: int) {
    if count <= 0 {
        return;
    }
    sb.reserve(count);
    mem.copy(&sb.buffer[sb.cursor], bytes, count);
    sb.cursor += count;
    sb.buffer[sb.cursor] = 0;
}

addString :: method (sb: *StringBuilder, s: string) {
    sb.addBytes(s.data, s.len as int);
}

// The part of the string from 'start' to 'end' (not included)
addStringSlice :: method (sb: *StringBuilder, s: string, start: int, end: int) {
    sb.addBytes(&s.data[start], end - start);
}

addChar :: method (sb: *StringBuilder, c: u8) {
    if sb.cursor + 2 > sb.capacity { sb.reserve(1); }   // Room for it and the 0 byte
    sb.buffer[sb.cursor] = c;
    sb.cursor += 1;
    sb.buffer[sb.cursor] = 0;
}

// The character 'count' times, e.g for indentation
addRepeated :: method (sb: *StringBuilder, c: u8, count: int) {
    if count <= 0 {
        return;
    }
    sb.reserve(count);
    mem.set(&sb.buffer[sb.cursor], c, count);
    sb.cursor += count;
    sb.buffer[sb.cursor] = 0;
}

// Adds the format with each % replaced by the next argument, written like fmt.print writes it. \% adds a %, e.g
// sprint("% is 100\% done", name). A % after the last argument stays a %, e.g print("100%")
add :: method (sb: *StringBuilder, format: string, args: ...any) {
    next := 0;   // The next argument
    start := 0;  // The text since the last %
    i := 0;
    while i < format.len {
        isEscape := format[i] == '\\' && i + 1 < format.len && format[i + 1] == '%';
        if format[i] != '%' && !isEscape {
            i += 1;
            continue;
        }
        sb.addStringSlice(format, start, i as int);
        if isEscape {
            sb.addChar('%');
            i += 2;
        } else {
            if next < args.count {
                sb.addValue(args[next]);
                next += 1;
            } else {
                sb.addChar('%'); // More % than arguments
            }
            i += 1;
        }
        start = i as int;
    }
    sb.addStringSlice(format, start, format.len as int);
}

// Like add, with a newline after it
addLine :: method (sb: *StringBuilder, format: string, args: ...any) {
    sb.add(format, ...args);
    sb.addChar('\n');
}

// The length of the text
length :: method (sb: StringBuilder) -> int {
    return sb.cursor;
}

isEmpty :: method (sb: StringBuilder) -> bool {
    return sb.cursor == 0;
}

endsWith :: method (sb: StringBuilder, s: string) -> bool {
    return sb.toString().endsWith(s);
}

// Removes the last 'count' bytes, e.g the ", " after the last element of a list
removeLast :: method (sb: *StringBuilder, count := 1) {
    if count > sb.cursor {
        count = sb.cursor;
    }
    sb.cursor -= count;
    if sb.buffer != null {
        sb.buffer[sb.cursor] = 0;
    }
}

// Empties the text, and keeps the buffer for more
clear :: method (sb: *StringBuilder) {
    sb.cursor = 0;
    if sb.buffer != null {
        sb.buffer[0] = 0;
    }
}

// The text, without copying it. It changes with the builder and is gone when it is freed, so copy it with .copy()
// to keep it after that
toString :: method (sb: StringBuilder) -> string {
    s: string;
    s.data = sb.buffer;
    s.len  = sb.cursor;
    return s;
}

free :: method (sb: *StringBuilder) {
    mem.free(sb.buffer, sb.capacity, sb.allocator);
    sb.buffer   = null;
    sb.cursor   = 0;
    sb.capacity = 0;
}

// The strings with the separator between them, e.g join(["a", "b"], ", ") is "a, b". It is allocated with malloc
join :: (parts: []string, separator: string) -> string {
    sb: StringBuilder;
    for part, i in parts {
        if i > 0 {
            sb.addString(separator);
        }
        sb.addString(part);
    }
    return sb.toString();
}

////////////////////////////////////////////////////////////////////////////////////
//   Numbers
////////////////////////////////////////////////////////////////////////////////////

addFloat32 :: method (sb: *StringBuilder, v: f32) {
    buf: [32]u8;
    sprintf(buf.data, "%f", v);
    sb.addBytes(buf.data, strlen(c.string{buf.data}) as int);
}

addFloat64 :: method (sb: *StringBuilder, v: f64) {
    buf: [32]u8;
    sprintf(buf.data, "%lf", v);
    sb.addBytes(buf.data, strlen(c.string{buf.data}) as int);
}

// A float with a fixed number of decimals, rounded, e.g fmt.print("% s", fmt.fixed(12.345, 1)) prints 12.3 s. print and
// sprint write it like addFixed does, so it needs no memory of its own
Fixed :: struct {
    value:    f64;
    decimals: int;
}

fixed :: (value: f64, decimals: int) -> Fixed {
    return Fixed{value, decimals};
}

// Adds a float with this many decimals (0 to 9), rounded half away from zero, e.g addFixed(2.718, 2) adds 2.72
addFixed :: method (sb: *StringBuilder, value: f64, decimals: int) {
    if value != value {      // NaN isn't equal to itself
        sb.addString("nan");
        return;
    }
    if decimals < 0 { decimals = 0; }
    if decimals > 9 { decimals = 9; }

    scale: u64 = 1;
    for 0..decimals { scale *= 10; }

    magnitude := value;
    if value < 0 { magnitude = -value; }
    if magnitude * (scale as f64) >= 9000000000000000000.0 {   // Too big for the digits to fit in a u64
        sb.addFloat64(value);
        return;
    }

    scaled := (magnitude * (scale as f64) + 0.5) as u64;
    if value < 0 && scaled != 0 { sb.addChar('-'); }
    sb.addUInt64(scaled / scale);
    if decimals == 0 { return; }

    sb.addChar('.');
    fraction := scaled % scale;
    digit := scale / 10;
    while digit > 1 && fraction < digit {
        sb.addChar('0');    // The zeros after the point, e.g the 0 of 1.05
        digit /= 10;
    }
    sb.addUInt64(fraction);
}

addInt64 :: method (sb: *StringBuilder, v: i64) {
    if v < 0 {
        sb.addChar('-');
        // -v overflows for the smallest i64, so v + 1 is negated instead
        sb.addUInt64((-(v + 1)) as u64 + 1);
        return;
    }
    sb.addUInt64(v as u64);
}

addUInt64 :: method (sb: *StringBuilder, v: u64) {
    digits: [20]u8; // Enough for any u64
    n := 0;
    while true {
        digits[n] = (v % 10) as u8 + '0';
        n += 1;
        v = v / 10;
        if v == 0 {
            break;
        }
    }
    // The digits are in reverse order
    sb.reserve(n);
    for i in 0..n {
        sb.buffer[sb.cursor + i] = digits[n - 1 - i];
    }
    sb.cursor += n;
    sb.buffer[sb.cursor] = 0;
}

////////////////////////////////////////////////////////////////////////////////////
//   Values, written as in Saad
////////////////////////////////////////////////////////////////////////////////////

// Adds a value as it is written in Saad, so it can be copied back into a program, e.g Point{x: 1, name: "Ada"}.
// A string or a char on its own is added as it is, and with quotes in a struct, an array or a union
addValue :: method (sb: *StringBuilder, value: any) {
    sb.addValueIn(value, false);
}

@deprecated("Use addValue")
addAnyValue :: method (sb: *StringBuilder, value: any) {
    sb.addValueIn(value, false);
}

@private
addValueIn :: method (sb: *StringBuilder, arg: any, inside: bool) {
    switch arg.type.kind {
        case .int {
            if inside && arg.type.isChar() { sb.addQuotedChar(*(arg.data as *u8)); }
            else                           { sb.addInteger(arg); }
        }
        case .float {
            f, _ := arg.toFloat();
            if arg.type.size == 4 { sb.addFloat32(f as f32); }
            else                  { sb.addFloat64(f); }
        }
        case .bool {
            if *(arg.data as *bool) { sb.addString("true"); }
            else                    { sb.addString("false"); }
        }
        case .string {
            if inside { sb.addQuoted(*(arg.data as *string)); }
            else      { sb.addString(*(arg.data as *string)); }
        }
        case .enum {
            enumType := arg.type.asEnum();
            value, _ := arg.toInt();
            if enumType.isFlags() {
                // The flags that are set, e.g .verbose | .color, or 0 when none is
                names, ok := enumType.flagNames(value);
                if !ok || names.count == 0 {
                    sb.addInt64(value);
                } else {
                    for name, i in names {
                        if i > 0 { sb.addString(" | "); }
                        sb.addChar('.');
                        sb.addString(name);
                    }
                }
                names.free();
                return;
            }
            name, ok := arg.enumName();
            sb.addChar('.');
            if ok { sb.addString(name); }
            else  { sb.addString("<invalid>"); }
        }
        case .pointer {
            buf: [64]u8;
            written := sprintf(buf.data, "0x%p", *(arg.data as **void));
            sb.addBytes(buf.data, written);
        }
        case .array {
            sb.addElements(arg);
        }
        case .struct {
            if arg.type.isOptional() {
                // The value, or null when it is empty
                value, present := arg.optional();
                if present { sb.addValueIn(value, inside); }
                else       { sb.addString("null"); }
            }
            else if arg.type.name == "fmt.Fixed" {
                f := *(arg.data as *Fixed);
                sb.addFixed(f.value, f.decimals);
            }
            else if arg.type.name == "time.Time" {
                // As text, e.g 2026-11-02T10:15:00Z
                text := (*(arg.data as *time.Time)).toString();
                sb.addString(text);
                text.free();
            }
            else if arg.type.isUnion() { sb.addUnion(arg); }
            else if arg.type.isList()  { sb.addElements(arg); }
            else                       { sb.addStruct(arg); }
        }
        else {
            sb.addChar('<');
            sb.addString(arg.type.name);
            sb.addChar('>');
        }
    }
}

// Writes an integer of any size, e.g of an any whose type is an int, a u8 or an i64. A char is added as the character
addInteger :: method (sb: *StringBuilder, value: any) {
    if value.type.isChar() {
        sb.addChar(*(value.data as *u8));
        return;
    }
    if value.type.size == 8 && !value.type.isSigned() {
        sb.addUInt64(*(value.data as *u64));
        return;
    }
    n, ok := value.toInt();
    if ok { sb.addInt64(n); }
    else  { sb.addString("UNHANDLED"); }
}

// The elements of a fixed array, a slice or a List, e.g [1, 2]
@private
addElements :: method (sb: *StringBuilder, value: any) {
    sb.addChar('[');
    for i in 0..value.count() {
        if i > 0 {
            sb.addString(", ");
        }
        sb.addValueIn(value.element(i), true);
    }
    sb.addChar(']');
}

// The string in quotes, with '"', '\' and the control characters escaped, e.g "say \"hi\"\n"
addQuoted :: method (sb: *StringBuilder, s: string) {
    sb.addChar('"');
    for c in s {
        sb.addEscaped(c, '"');
    }
    sb.addChar('"');
}

// The character in quotes, e.g 'a' or '\n'
addQuotedChar :: method (sb: *StringBuilder, c: u8) {
    sb.addChar('\'');
    sb.addEscaped(c, '\'');
    sb.addChar('\'');
}

@private
addEscaped :: method (sb: *StringBuilder, c: u8, quote: u8) {
    switch c {
        case '\\' { sb.addString("\\\\"); }
        case '\n' { sb.addString("\\n"); }
        case '\r' { sb.addString("\\r"); }
        case '\t' { sb.addString("\\t"); }
        case 0    { sb.addString("\\0"); }
        else {
            if c == quote { sb.addChar('\\'); }
            sb.addChar(c);
        }
    }
}

// The name of a type before a literal. An anonymous struct has none, e.g {w: 1, h: 2}
@private
addTypeName :: method (sb: *StringBuilder, type: *Type) {
    if !type.name.startsWith("struct ") && !type.name.startsWith("union ") {
        sb.addString(type.name);
    }
}

// Like a literal of the union: Shape{circle: Circle{radius: 2.000000}}, or Shape.empty for a variant without a value.
// The variant without a value of a generic union is .none, as Option<int>.none can't be written
@private
addUnion :: method (sb: *StringBuilder, value: any) {
    variant, inner := value.variant();
    if variant == null || variant.type.kind == .void {
        if value.type.name.indexOf("<") < 0 {
            sb.addString(value.type.name);
        }
        sb.addChar('.');
        if variant == null { sb.addString("<invalid>"); }
        else               { sb.addString(variant.name); }
        return;
    }
    sb.addTypeName(value.type);
    sb.addChar('{');
    sb.addString(variant.name);
    sb.addString(": ");
    sb.addValueIn(inner, true);
    sb.addChar('}');
}

// Like a literal of the struct: Point{x: 1, y: 2}
@private
addStruct :: method (sb: *StringBuilder, value: any) {
    sb.addTypeName(value.type);
    sb.addChar('{');
    first := true;
    for *member in value.type.asStruct().members {
        if member.isHidden() { continue; }   // e.g the link of a row of dbms
        if !first {
            sb.addString(", ");
        }
        first = false;
        sb.addString(member.name);
        sb.addString(": ");
        sb.addValueIn(value.memberAt(member), true);
    }
    sb.addChar('}');
}
