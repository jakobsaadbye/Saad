namespace mem;

// Memory: the standard library takes its memory from here (and from new), not from C. All of it goes through an
// Allocator, the interface of the prelude, so a program, or a library, can give it any allocator. See docs/allocators.md
//
//     p := mem.allocate(64);              // 64 zeroed bytes from the allocator of the thread, or mem.allocate(64, &arena)
//     p = mem.resize(p, 64, 128);         // like realloc: the size it has, and the size it gets
//     mem.copy(to, from, 16);             // like memcpy
//     mem.free(p, 128);                   // with its size
//     point := new(Point);
//     mem.delete(point);                  // a T of new, which knows its size
//
// The allocator of the thread is what a null allocator means, e.g for new(T), strings, lists and fmt.sprint. It is the
// heap, unless it is set: a server sets it to the arena of a request while it answers the request, so everything the
// handler allocates is freed with the request. What lives longer is given the heap:
//
//     store.posts.allocator = mem.heap();
//     title := post.title.copy(mem.heap());
//
//     previous := mem.setAllocator(&arena);    // The allocator of the thread, until it is set back
//     defer mem.setAllocator(previous);
//
// Arenas: memory that is taken bit by bit and freed all at once, e.g for everything of one request. An Arena is an
// Allocator, so &arena can be given wherever one is wanted
//
//     arena: mem.Arena;
//     p := arena.allocate(64);
//     list.allocator = &arena;          // lists, maps, new(T, &arena) and e.g dbms.Connection
//     arena.clear();                    // Everything is free to use again
//     arena.free();

import c;

// The heap: realloc and free. For what lives longer than the allocator of the thread, e.g a request
heap :: () -> Allocator {
    return heapAllocator();
}

// The allocator of the thread: what a null allocator means
allocator :: () -> Allocator {
    return currentAllocator();
}

// Sets the allocator of the thread, and gives the one before, to set it back. Null is the heap
setAllocator :: (allocator: Allocator) -> Allocator {
    previous := threadAllocator;
    threadAllocator = allocator;
    return previous;
}

// Zeroed memory of the size, from the allocator (null is the allocator of the thread), aligned to 'align' bytes. Free
// it with mem.free, its size and the same allocator
allocate :: (size: int, allocator: Allocator = null, align := 8) -> *void {
    if size <= 0 { size = 1; }
    memory := resizeMemory(allocator, null, 0, size, align);
    if memory == null { panic("Out of memory"); }
    c.memset(memory, 0, size);
    return memory;
}

// The memory with another size, keeping what fits of it, like realloc: the size it has, and the size it gets. A null
// memory is new memory, and a size of 0 frees it
resize :: (memory: *void, oldSize: int, newSize: int, allocator: Allocator = null, align := 8) -> *void {
    result := resizeMemory(allocator, memory, oldSize, newSize, align);
    if result == null && newSize > 0 { panic("Out of memory"); }
    return result;
}

// Gives back memory of allocate or resize, with its size, to the allocator it came from (null is the allocator of the
// thread)
free :: (memory: *void, size: int, allocator: Allocator = null, align := 8) {
    freeMemory(memory, size, allocator, align);
}

// Gives back a T of new(T) to the allocator it came from (null is the allocator of the thread)
delete :: <T>(memory: *T, allocator: Allocator = null) {
    size := sizeof(T);
    if size == 0 { size = 1; }
    freeMemory(memory, size, allocator);
}

// Copies count bytes, like memcpy. The two may not overlap
copy :: (to: *void, from: *void, count: int) {
    if count > 0 { c.memcpy(to, from, count); }
}

// Sets count bytes to the value, like memset
set :: (to: *void, value: u8, count: int) {
    if count > 0 { c.memset(to, value as int, count); }
}

// If the count bytes are the same, like memcmp(a, b, count) == 0
equal :: (a: *void, b: *void, count: int) -> bool {
    return count <= 0 || c.memcmp(a, b, count) == 0;
}

Kilobyte :: 1024;
Megabyte :: 1048576;

Arena :: struct {
    currentChunk: *Chunk;
}

Chunk :: struct {
    data:     *u8;
    cursor:   int;
    capacity: int;
    prev:     *Chunk;
}

@private DefaultCapacity :: 4096;

newArena :: (capacity: int) -> Arena {
    arena := Arena{};
    arena.currentChunk = newChunk(null, capacity);
    return arena;
}

// Zeroed memory of the size, aligned to 'align' bytes (8 unless it is given), which is a power of two
allocate :: method (arena: *Arena, size: int, align := 8) -> *void {
    if align < 8 { align = 8; }
    size = (size + 7) / 8 * 8;
    chunk := arena.currentChunk;
    if chunk != null {
        pad := padding(&chunk.data[chunk.cursor], align);
        if chunk.cursor + pad + size <= chunk.capacity {
            ptr := &chunk.data[chunk.cursor + pad];
            chunk.cursor += pad + size;
            c.memset(ptr, 0, size);
            return ptr;
        }
    }

    // A new chunk, at least twice as big as the last one, with room for the alignment
    capacity := DefaultCapacity;
    if chunk != null { capacity = chunk.capacity * 2; }
    while capacity < size + align {
        capacity *= 2;
    }
    arena.currentChunk = newChunk(chunk, capacity);
    return arena.allocate(size, align);
}

// The Allocator of the arena: the arena itself, which is one, as it has resize. For a struct member of the type
// Allocator, e.g 'r.allocator = r.arena.allocator()'
allocator :: method (arena: *Arena) -> Allocator {
    return arena;
}

// The resize of an Allocator: a block of the arena. A smaller size keeps the block, the last block of the arena grows
// where it is when there is room, and a bigger one is a new block with what the old one had. Freeing does nothing: the
// memory is freed with the arena
resize :: method (arena: *Arena, memory: *void, oldSize: i64, newSize: i64, align: i64) -> *void {
    if newSize == 0 { return null; }
    if memory != null && newSize <= oldSize { return memory; }

    chunk := arena.currentChunk;
    if memory != null && chunk != null && oldSize > 0 {
        // The last block of the chunk, which can grow up to the end of it
        old := memory as *u8;
        rounded := ((oldSize + 7) / 8 * 8) as int;
        start := chunk.cursor - rounded;
        if start >= 0 && &chunk.data[start] == old && start + ((newSize + 7) / 8 * 8) as int <= chunk.capacity {
            grown := ((newSize + 7) / 8 * 8) as int;
            c.memset(&chunk.data[chunk.cursor], 0, grown - rounded);
            chunk.cursor = start + grown;
            return memory;
        }
    }

    block := arena.allocate(newSize as int, align as int);
    if memory != null {
        keep := oldSize;
        if keep > newSize { keep = newSize; }
        c.memcpy(block, memory, keep as int);
    }
    return block;
}

// The bytes to skip from the pointer to an address that is a multiple of align
@private
padding :: (at: *u8, align: int) -> int {
    address := at as u64;
    return ((align as u64 - address % align as u64) % align as u64) as int;
}

// Frees all the memory of the arena
free :: method (arena: *Arena) {
    chunk := arena.currentChunk;
    while chunk != null {
        freeChunkData(chunk);
        previous := chunk.prev;
        c.free(chunk);
        chunk = previous;
    }
    arena.currentChunk = null;
}

// Makes all the memory of the arena free to use again. It keeps the biggest chunk, so the next use doesn't allocate.
// With saad build --check-memory it keeps none, so a pointer into what was cleared is found when it is used
clear :: method (arena: *Arena) {
    #if CHECK_MEMORY {
        arena.free();
        return;
    }
    chunk := arena.currentChunk;
    if chunk == null {
        return;
    }
    previous := chunk.prev;
    while previous != null {
        freeChunkData(previous);
        next := previous.prev;
        c.free(previous);
        previous = next;
    }
    chunk.prev   = null;
    chunk.cursor = 0;
}

// The bytes of the arena that are in use
used :: method (arena: *Arena) -> int {
    total := 0;
    chunk := arena.currentChunk;
    while chunk != null {
        total += chunk.cursor;
        chunk = chunk.prev;
    }
    return total;
}

newChunk :: (oldChunk: *Chunk, capacity: int) -> *Chunk {
    chunk := c.malloc(sizeof(Chunk)) as *Chunk;
    assert(chunk != null); // Out of memory
    #if CHECK_MEMORY {
        chunk.data = checkedAllocate(capacity);   // See std/prelude/errors.sd
    } else {
        chunk.data = c.malloc(capacity) as *u8;
    }
    assert(chunk.data != null);
    chunk.cursor   = 0;
    chunk.capacity = capacity;
    chunk.prev     = oldChunk;
    return chunk;
}

@private
freeChunkData :: (chunk: *Chunk) {
    #if CHECK_MEMORY {
        checkedFree(chunk.data, chunk.capacity);
    } else {
        c.free(chunk.data);
    }
}
