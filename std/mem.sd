namespace mem;

// Memory: the standard library takes its memory from here (and from new), not from C, so a program can give it an
// Allocator, and C is only called in one place
//
//     p := mem.allocate(64);              // 64 zeroed bytes from the heap, or mem.allocate(64, &allocator)
//     p = mem.resize(p, 128);             // like realloc
//     mem.copy(to, from, 16);             // like memcpy
//     mem.free(p);
//
// Arenas: memory that is taken bit by bit and freed all at once, e.g for everything of one request
//
//     arena: mem.Arena;
//     p := arena.allocate(64);
//     alloc := arena.allocator();       // An Allocator for lists, maps, new(T, &alloc) and e.g dbms.Connection
//     arena.clear();                    // Everything is free to use again
//     arena.free();

import c;

// Zeroed memory of the size, from the allocator (null is the heap). Free it with mem.free and the same allocator
allocate :: (size: int, allocator: *Allocator = null) -> *void {
    if size <= 0 { size = 1; }
    memory := resizeMemory(allocator, null, size);
    if memory == null { panic("Out of memory"); }
    c.memset(memory, 0, size);
    return memory;
}

// The memory with a new size, keeping what fits of it, like realloc. A null memory is new memory, and a size of 0 frees it
resize :: (memory: *void, size: int, allocator: *Allocator = null) -> *void {
    result := resizeMemory(allocator, memory, size);
    if result == null && size > 0 { panic("Out of memory"); }
    return result;
}

// Gives back memory of allocate, resize or new to the allocator it came from (null is the heap)
free :: (memory: *void, allocator: *Allocator = null) {
    freeMemory(memory, allocator);
}

// Copies count bytes, like memcpy. The two may not overlap
copy :: (to: *void, from: *void, count: int) {
    if count > 0 { c.memcpy(to, from, count); }
}

// Sets count bytes to the value, like memset
set :: (to: *void, value: u8, count: int) {
    if count > 0 { c.memset(to, value as int, count); }
}

// If the count bytes are the same, like memcmp(a, b, count) == 0
equal :: (a: *void, b: *void, count: int) -> bool {
    return count <= 0 || c.memcmp(a, b, count) == 0;
}

Kilobyte :: 1024;
Megabyte :: 1048576;

Arena :: struct {
    currentChunk: *Chunk;
}

Chunk :: struct {
    data:     *u8;
    cursor:   int;
    capacity: int;
    prev:     *Chunk;
}

@private DefaultCapacity :: 4096;

newArena :: (capacity: int) -> Arena {
    arena := Arena{};
    arena.currentChunk = newChunk(null, capacity);
    return arena;
}

// Zeroed memory of the size, aligned to 8 bytes
allocate :: method (arena: *Arena, size: int) -> *void {
    size = (size + 7) / 8 * 8;
    chunk := arena.currentChunk;
    if chunk == null {
        capacity := DefaultCapacity;
        while capacity < size {
            capacity *= 2;
        }
        arena.currentChunk = newChunk(null, capacity);
        return arena.allocate(size);
    }

    if chunk.cursor + size <= chunk.capacity {
        ptr := &chunk.data[chunk.cursor];
        chunk.cursor += size;
        c.memset(ptr, 0, size);
        return ptr;
    }

    newCap := chunk.capacity * 2;
    while newCap < size {
        newCap *= 2;
    }
    arena.currentChunk = newChunk(chunk, newCap);
    return arena.allocate(size);
}

// An Allocator that takes its memory from the arena, e.g for a list: 'list.allocator = &alloc'. The memory is freed
// with the arena, so the allocator doesn't free anything itself
allocator :: method (arena: *Arena) -> Allocator {
    a: Allocator;
    a.context = arena;
    a.resize  = arenaResize;
    return a;
}

// Frees all the memory of the arena
free :: method (arena: *Arena) {
    chunk := arena.currentChunk;
    while chunk != null {
        c.free(chunk.data);
        previous := chunk.prev;
        c.free(chunk);
        chunk = previous;
    }
    arena.currentChunk = null;
}

// Makes all the memory of the arena free to use again. It keeps the biggest chunk, so the next use doesn't allocate
clear :: method (arena: *Arena) {
    chunk := arena.currentChunk;
    if chunk == null {
        return;
    }
    previous := chunk.prev;
    while previous != null {
        c.free(previous.data);
        next := previous.prev;
        c.free(previous);
        previous = next;
    }
    chunk.prev   = null;
    chunk.cursor = 0;
}

// The bytes of the arena that are in use
used :: method (arena: *Arena) -> int {
    total := 0;
    chunk := arena.currentChunk;
    while chunk != null {
        total += chunk.cursor;
        chunk = chunk.prev;
    }
    return total;
}

newChunk :: (oldChunk: *Chunk, capacity: int) -> *Chunk {
    chunk := c.malloc(sizeof(Chunk)) as *Chunk;
    assert(chunk != null); // Out of memory
    chunk.data     = c.malloc(capacity) as *u8;
    assert(chunk.data != null);
    chunk.cursor   = 0;
    chunk.capacity = capacity;
    chunk.prev     = oldChunk;
    return chunk;
}

// Each block of the allocator starts with its size, so a bigger block can copy the old one
@private
arenaResize :: (context: *void, memory: *void, size: i64) -> *void {
    if size == 0 {
        return null; // Freed with the arena
    }
    arena := context as *Arena;
    block := arena.allocate(size as int + 8) as *u8;
    *(block as *i64) = size;
    result := &block[8];
    if memory != null {
        old := memory as *u8;
        header := &old[-8];
        oldSize := *(header as *i64);
        if oldSize > size {
            oldSize = size;
        }
        c.memcpy(result, memory, oldSize as int);
    }
    return result;
}
