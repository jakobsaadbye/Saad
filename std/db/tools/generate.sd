// Writes the tables of a Postgres database as Saad, e.g
//
//     saad run std/db/tools/generate.sd -- "host=localhost dbname=shop user=postgres" models/shop.sd shop
//     saad run std/db/tools/generate.sd -- "host=localhost dbname=shop user=postgres" models/sales.sd sales sales
//
// The arguments are the connection string, the file to write, the namespace of the file, and the schema (public when it
// is left out). Make the file again when the database changes, instead of changing it. See docs/db.md

import db;
import db.postgres;
import os;
use fmt;

main :: () {
    args := os.args();
    if args.count < 4 {
        print("Usage: saad run std/db/tools/generate.sd -- <connection string> <file to write> <namespace> [schema]");
        print("   e.g saad run std/db/tools/generate.sd -- \"host=localhost dbname=shop user=postgres\" models/shop.sd shop");
        os.exit(2);
    }

    options := postgres.GenerateOptions{ns: args[3]};
    if args.count > 4 {
        options.schema = args[4];
    }

    conn, err := postgres.connect(args[1]);
    if err != "" {
        print("Can't connect: %", err);
        os.exit(1);
    }

    code, err2 := postgres.generate(&conn, options);
    conn.close();
    if err2 != "" {
        print("Can't read the tables: %", err2);
        os.exit(1);
    }

    if !os.writeFile(args[2], code) {
        print("Can't write %", args[2]);
        os.exit(1);
    }
    print("Wrote the tables of the schema % to %", options.schema, args[2]);
}
