namespace dbms;

// Databases: run SQL and read the rows into plain structs, e.g with Postgres
//
//     import dbms;
//     import dbms.postgres;
//
//     User :: struct { id: i64; name: string; email: ?string; }   // email can be NULL
//
//     conn, err := postgres.connect("host=localhost dbname=app user=postgres");
//     users, err2 := conn.query<User>("SELECT id, name, email FROM users WHERE id > $1", 10);
//     count, err3 := conn.exec("DELETE FROM users WHERE name = $1", "Bob");
//     conn.close();
//
// The namespace only knows the Driver below. A database is a driver of its own (dbms.postgres), so this folder
// doesn't depend on any of them. See docs/dbms.md

import fmt;
import time;
use c;
import mem;
import allocators;
import errors;

// What a database implements: a connection of its own, e.g the PGconn of libpq or the database of SQLite, which a
// dbms.Connection holds. It is an interface, so any type with these methods is a driver, e.g of another library
Driver :: interface {
    // Runs the SQL with the arguments, the parameters $1, $2, ... A driver binds them its own way, e.g as text with
    // textParams, or by their type. On an error, the rows are null and the message is written to 'err'
    execute :: method (sql: string, args: []any, err: *string) -> Rows;
    close   :: method ();
}

// The rows a statement gives, e.g a PGresult of libpq. Values are text, as written by the database. free() gives
// them back
Rows :: interface {
    count      :: method () -> i64;
    columns    :: method () -> i64;
    columnName :: method (column: i64) -> c.string;
    // The text of a value, or a null c.string for NULL. It lives until free
    value      :: method (row: i64, column: i64) -> c.string;
    // The text of a value that isn't NULL, with its length, so it isn't counted
    text       :: method (row: i64, column: i64) -> string;
    // The integer of a value, and true when the database gives it as one, e.g SQLite. False makes dbms read its text
    integer    :: method (row: i64, column: i64, value: *i64) -> bool;
    // The number of rows changed by INSERT, UPDATE or DELETE
    affected   :: method () -> i64;
    free       :: method ();
}

// A connection to a database, made by a driver, e.g postgres.connect(...). The driver is null when it is closed
Connection :: struct {
    driver: Driver;

    // Where the rows, strings and pointers read by query come from. Null means the heap (malloc), so they are
    // freed one by one. With an arena, e.g allocators.Arena.allocator(), they are freed all at once
    allocator: Allocator;
}

// Gives a struct member another column name, leaves it out of the rows, or says what the column is, e.g
//
//     User :: struct {
//         @dbms.Column(key: true, generated: true) id: i64;
//         @dbms.Column(name: "mail") email: string;
//         @dbms.Column(skip: true)   cache: *Cache;
//     }
//
// Without it, a member reads the column of the same name, where case and '_' don't matter: createdAt reads
// created_at, CreatedAt and createdat
@attribute
Column :: struct {
    name:      string;
    skip:      bool = false;
    key:       bool = false; // The primary key, for dbms.Table's get, update and delete
    generated: bool = false; // Made by the database, e.g a serial id or GENERATED ALWAYS. dbms.Table's insert and update leave it out
    defaulted: bool = false; // Has a default the database computes, e.g now(). Written by update, and by insert unless it is the zero value
}

// The kinds of the errors of dbms, for a catch to tell them apart, e.g err.is(dbms.DatabaseError)
DatabaseError :: ErrorKind{"dbms.DatabaseError"}; // What the database said, e.g a broken constraint, or the connection is gone
QueryError    :: ErrorKind{"dbms.QueryError"};    // A query of a table that can't be made into SQL, e.g a method SQL doesn't have
NoLink        :: ErrorKind{"dbms.NoLink"};        // The relations of a row that wasn't made by a table, see relations.sd

// The error of the message, or null when it is empty. The functions of dbms give these, and keep the text of errors inside
databaseError :: (message: string, kind := DatabaseError) -> error {
    if message == "" { return null; }
    return errors.make(message, kind: kind);
}

// Runs a statement that returns no rows, e.g INSERT, UPDATE or DELETE. Gives the number of rows it changed.
// The arguments are the parameters $1, $2, ... of the SQL
exec :: method (conn: *Connection, sql: string, args: ...any) -> i64, error {
    result, err := conn.run(sql, ...args);
    if err != "" {
        return 0, databaseError(err);
    }
    changed := result.affected();
    result.free();
    return changed, null;
}

// Runs a query and gives its rows, one T per row, e.g
//
//     users, err := conn.query<User>("SELECT * FROM users WHERE age > $1", 30);
//
// A column is read into the member of the same name (see dbms.Column). Columns that T doesn't have are skipped, and
// members without a column keep their default value.
//
// * A column that can be NULL is read into an optional, e.g ?string, which is empty for NULL. NULL into a pointer
//   is null, and into anything else leaves its value, e.g a default
// * Columns are read from their text: numbers, bool (t/f or true/false), string, enums (by name or number),
//   and optionals and pointers of them
// * The list, strings and pointers are allocated with conn.allocator
query :: method <T>(conn: *Connection, sql: string, args: ...any) -> [..]T, error {
    rows: [..]T;
    rows.allocator = conn.allocator;

    rowType := typeInfo<T>().asStruct();
    if rowType == null {
        return rows, databaseError(fmt.sprint("Rows are read into structs, not into values of type %. Use queryOne for a single value", typeInfo<T>().name), QueryError);
    }

    result, err := conn.run(sql, ...args);
    if err != "" {
        return rows, databaseError(err);
    }

    columns := conn.columnsOf(result, rowType);
    count := result.count();
    rows.reserve(count);
    for r in 0..count {
        row: T;
        err = conn.readRow(result, r, anyOf(&row), columns);
        if err != "" {
            err = fmt.sprint("Row %: %", r + 1, err);
            break;
        }
        rows.add(row);
    }
    columns.free();
    result.free();
    return rows, databaseError(err);
}

// Runs a query and gives its first row, or the first column of it when T isn't a struct, e.g
//
//     user, found, err := conn.queryOne<User>("SELECT * FROM users WHERE id = $1", id);
//     total, _, err2   := conn.queryOne<i64>("SELECT count(*) FROM users");
//
// found is false when there are no rows, and the value is then the default of T
queryOne :: method <T>(conn: *Connection, sql: string, args: ...any) -> T, bool, error {
    row: T;
    result, err := conn.run(sql, ...args);
    if err != "" {
        return row, false, databaseError(err);
    }

    place := anyOf(&row);
    found := result.count() > 0;
    if !found {
        // Nothing to read
    } else if place.type.kind != .struct {
        // A single value, e.g SELECT count(*)
        if result.columns() < 1 {
            err = "The query gives no columns";
        } else {
            err = conn.readValue(result.value(0, 0), place, conn.columnName(result, 0));
        }
    } else {
        columns := conn.columnsOf(result, place.type.asStruct());
        err = conn.readRow(result, 0, place, columns);
        columns.free();
    }
    result.free();
    return row, found, databaseError(err);
}

// Starts a transaction. Nothing it changes is seen by others until commit, and rollback undoes all of it, e.g
//
//     conn.begin();
//     try {
//         conn.exec("UPDATE accounts SET balance = balance - $1 WHERE id = $2", 10, from);
//         conn.exec("UPDATE accounts SET balance = balance + $1 WHERE id = $2", 10, to);
//         conn.commit();
//     } catch (err) {
//         conn.rollback();
//     }
begin :: method (conn: *Connection) -> error {
    _, err := conn.exec("BEGIN");
    return err;
}

commit :: method (conn: *Connection) -> error {
    _, err := conn.exec("COMMIT");
    return err;
}

rollback :: method (conn: *Connection) -> error {
    _, err := conn.exec("ROLLBACK");
    return err;
}

// Closes the connection
close :: method (conn: *Connection) {
    if conn.driver != null {
        conn.driver.close();
        conn.driver = null;
    }
}

////////////////////////////////////////////////////////////////////////////////////
//   Parameters
////////////////////////////////////////////////////////////////////////////////////

// Runs the SQL with the arguments, which the driver binds
@private
run :: method (conn: *Connection, sql: string, args: ...any) -> Rows, string {
    if conn.driver == null {
        return null, "The connection is closed";
    }
    list: []any;
    list.data  = args.data;
    list.count = args.count;
    failed := "";
    rows := conn.driver.execute(sql, list, &failed);
    if rows == null {
        if failed == "" { failed = "The query failed"; }
        return null, failed;
    }
    return rows, "";
}

// The arguments as the texts of parameters, allocated with malloc, for a driver that binds them as text, e.g Postgres.
// A null c.string is NULL. On an argument that can't be one, the error names it. freeTextParams gives them back
textParams :: (args: []any) -> [..]c.string, string {
    params: [..]c.string;
    for arg, i in args {
        text, ok := paramText(arg);
        if !ok {
            freeTextParams(&params);
            return params, fmt.sprint("Parameter $% can't be a %", i + 1, arg.type.name);
        }
        params.add(text);
    }
    return params, "";
}

freeTextParams :: (params: *[..]c.string) {
    for p in params { p.free(); }
    params.free();
}

// The value as the text of a parameter, allocated with malloc, and false when it can't be one. A null c.string is NULL.
// For drivers too, e.g for a type they don't bind themselves
paramText :: (arg: any) -> c.string, bool {
    sb: fmt.StringBuilder;
    switch arg.type.kind {
        case .int {
            sb.addInteger(arg);   // A char as the character
        }
        case .float {
            buf: [64]u8;
            value, _ := arg.toFloat();
            sprintf(buf.data, "%.17g", value);
            sb.addString(c.string{buf.data}.toString());
        }
        case .bool {
            if *(arg.data as *bool) { sb.addString("true"); }
            else                    { sb.addString("false"); }
        }
        case .string {
            sb.addString(*(arg.data as *string));
        }
        case .enum {
            name, ok := arg.enumName();
            if !ok { return c.string{}, false; }
            sb.addString(name);
        }
        case .struct {
            // A time as RFC 3339, e.g 2026-11-02T10:15:00.25+01:00
            if arg.is<time.Time>() {
                text := (*(arg.data as *time.Time)).toString();
                result := text.toCString();
                text.free();
                return result, true;
            }
            // An optional: empty is NULL, otherwise its value
            if !arg.type.isOptional() {
                return c.string{}, false;
            }
            value, present := arg.optional();
            if !present {
                return c.string{}, true;
            }
            return paramText(value);
        }
        case .pointer {
            // null is NULL, otherwise the value it points to
            pointee := arg.type.pointee();
            if pointee.kind == .void || pointee.kind == .pointer {
                return c.string{}, false;
            }
            value := arg.deref();
            if value.isEmpty() {
                return c.string{}, true;
            }
            return paramText(value);
        }
        else {
            return c.string{}, false;
        }
    }
    text := sb.toString();
    result := text.toCString();
    sb.free();
    return result, true;
}

////////////////////////////////////////////////////////////////////////////////////
//   Rows into structs
////////////////////////////////////////////////////////////////////////////////////

// The column of each member of the struct, or -1
@private
columnsOf :: method (conn: *Connection, result: Rows, type: *TypeStruct) -> [..]i64 {
    names: [..]string;
    count := result.columns();
    names.reserve(count);
    for c in 0..count { names.add(result.columnName(c).toString()); }

    columns: [..]i64;
    columns.reserve(type.members.count);
    for i in 0..type.members.count {
        member := &type.members[i];
        name, named, skip := columnOf(member);
        found: i64 = -1;
        if !skip {
            for column, c in names {
                if (named && column == name) || (!named && sameName(column, name)) {
                    found = c;
                    break;
                }
            }
        }
        columns.add(found);
    }
    names.free();
    return columns;
}

// The column name of a member, if it was given with dbms.Column, and if the member is skipped
@private
columnOf :: (member: *StructMember) -> string, bool, bool {
    column: Column;
    if attributeOf(member, &column) {
        if column.skip { return "", false, true; }
        if column.name.len > 0 { return column.name, true, false; }
    }
    return member.name, false, false;
}

// The same name, where case and '_' don't matter, e.g createdAt and created_at
@private
sameName :: (a: string, b: string) -> bool {
    i := 0;
    j := 0;
    while true {
        while i < a.len && a[i] == '_' { i += 1; }
        while j < b.len && b[j] == '_' { j += 1; }
        if i == a.len || j == b.len {
            return i == a.len && j == b.len;
        }
        if lower(a[i]) != lower(b[j]) {
            return false;
        }
        i += 1;
        j += 1;
    }
    return false;
}

@private
lower :: (c: u8) -> u8 {
    if c >= 'A' && c <= 'Z' { return c + 32; }
    return c;
}

@private
columnName :: method (conn: *Connection, result: Rows, column: i64) -> string {
    return result.columnName(column).toString();
}

@private
readRow :: method (conn: *Connection, result: Rows, row: i64, place: any, columns: [..]i64) -> string {
    for *member, i in place.type.asStruct().members {
        column := columns[i];
        if column < 0 { continue; }
        value := place.memberAt(member);
        if conn.readTyped(result, row, column, value) { continue; }
        text := result.value(row, column);
        err := conn.readValue(text, value, "");
        if err != "" {
            // Again with the name of the column, which is only made for the message
            return conn.readValue(text, value, conn.columnName(result, column));
        }
    }
    return "";
}

// Reads an integer or a string without its text, when the driver gives values by their type. False when it can't, and
// the value is read from its text
@private
readTyped :: method (conn: *Connection, result: Rows, row: i64, column: i64, place: any) -> bool {
    if place.type.kind == .int {
        n: i64 = 0;
        if !result.integer(row, column, &n) { return false; }
        if place.type.size == 8 && !place.type.isSigned() {
            *(place.data as *u64) = n as u64;
            return true;
        }
        return place.setInt(n);   // Else from its text, which says why it doesn't fit
    }
    if place.type.kind == .string {
        text := result.value(row, column);
        if text.isNull() { return false; }
        place.set(conn.copyString(result.text(row, column)));
        return true;
    }
    return false;
}

// Reads the text of a value (null for NULL) into the place
@private
readValue :: method (conn: *Connection, text: c.string, place: any, column: string) -> string {
    type := place.type;
    if text.isNull() {
        if type.kind == .pointer || type.isOptional() { place.zero(); }
        return "";
    }
    if type.isOptional() {
        return conn.readValue(text, place.setOptional(), column);
    }
    value := text.toString();

    switch type.kind {
        case .bool {
            if value == "t" || value == "true" || value == "1" {
                place.set(true);
            } else if value == "f" || value == "false" || value == "0" {
                place.set(false);
            } else {
                return fmt.sprint("%: '%' is not a bool", column, value);
            }
            return "";
        }
        case .int {
            return readInteger(value, place, column);
        }
        case .float {
            end: c.string;
            number := strtod(text, &end);
            if end.data == text.data || *end.data != 0 {
                return fmt.sprint("%: '%' is not a number", column, value);
            }
            place.setFloat(number);
            return "";
        }
        case .string {
            place.set(conn.copyString(value));
            return "";
        }
        case .enum {
            return readEnum(value, place, column);
        }
        case .struct {
            // A timestamp or a date, e.g 2026-11-02 10:15:00.25+01, or 2026-11-02 for a date, which is midnight UTC.
            // A timestamp without a time zone is UTC
            if type.is<time.Time>() {
                t, ok := time.parse(value);
                if !ok { return fmt.sprint("%: '%' is not a time", column, value); }
                place.set(t);
                return "";
            }
            return fmt.sprint("%: Can't read a column into a %", column, type.name);
        }
        case .pointer {
            pointee := type.pointee();
            if pointee.kind == .void || pointee.kind == .struct || pointee.kind == .array {
                return fmt.sprint("%: Can't read a column into a %", column, type.name);
            }
            memory := resizeMemory(conn.allocator, null, 0, pointee.size as i64);
            mem.set(memory, 0, pointee.size);
            *(place.data as **void) = memory;
            return conn.readValue(text, place.deref(), column);
        }
        else {
            return fmt.sprint("%: Can't read a column into a %", column, type.name);
        }
    }
}

// A copy of the string with the allocator of the connection, null terminated
@private
copyString :: method (conn: *Connection, s: string) -> string {
    copy: string;
    copy.data = resizeMemory(conn.allocator, null, 0, s.len + 1) as *u8;
    mem.copy(copy.data, s.data, s.len);
    copy.data[s.len] = 0;
    copy.len = s.len;
    return copy;
}

@private
readInteger :: (text: string, place: any, column: string) -> string {
    if place.setIntText(text) { return ""; }
    if isDigits(text) {
        return fmt.sprint("%: % doesn't fit in a %", column, text, place.type.name);
    }
    return fmt.sprint("%: '%' is not a whole number", column, text);
}

// If the text is a whole number, of digits with a sign or not
@private
isDigits :: (text: string) -> bool {
    for ch, i in text {
        if (ch == '-' || ch == '+') && i == 0 { continue; }
        if ch < '0' || ch > '9' { return false; }
    }
    return text.len > 0;
}

// An enum from the name of a value, e.g 'admin', where case and '_' don't matter, or its number
@private
readEnum :: (text: string, place: any, column: string) -> string {
    type := place.type.asEnum();
    for option in type.values {
        if sameName(option.name, text) {
            place.setInt(option.value);
            return "";
        }
    }

    number := text.toInt();
    if number.hasValue() {
        _, ok := type.nameOf(number.value());
        if ok && place.setInt(number.value()) { return ""; }
    }
    return fmt.sprint("%: '%' is not a value of %", column, text, type.name);
}
