namespace dbms;

// The rows of one table, as structs of T, e.g
//
//     context := dbms.newContext(&conn);
//     users := dbms.keyedTable<User, i64>(context, "users", "id");   // the column of the key, and its type
//     users.generated = ["id", "created_at"];                        // what the database makes, e.g a serial or now()
//
//     all, err := users.all();
//     ada, err2 := users.get(1);              // a *User, null when no row has the key 1
//     row := users.create();                  // a new *User. The changes are kept by the context ...
//     row.name = "Bo";
//     users.update(ada);
//     users.delete(7);
//     err3 := context.saveChanges();          // ... and written by saveChanges, in one transaction. See context.sd
//
// The columns are the members of T, in snake case: createdAt is created_at, and a _ at the end is left out, so for_
// is the column for. The generated columns are left to the database by create and update, and read back by
// saveChanges. @dbms.Column on a member says the same for a struct written by hand. std/dbms/tools/generate.sd writes
// the structs and tables of a database
import fmt;
use c;

// A table of rows without a key of one column: all, count and create. See KeyedTable for get, update and delete
Table :: struct <T> {
    context:   *Context;
    name:      string;      // e.g users
    schema:    string;      // e.g sales. Empty is the schema the connection uses, e.g public
    generated: [..]string;  // The columns the database makes, e.g id and created_at

    // Every row
    all :: method () -> ([..]T, string) {
        sql := fmt.sprint("SELECT * FROM %", qualifiedName(self.schema, self.name));
        rows, err := self.context.conn.query<T>(sql);
        sql.free();
        return rows, err;
    }

    // The number of rows
    count :: method () -> (i64, string) {
        sql := fmt.sprint("SELECT count(*) FROM %", qualifiedName(self.schema, self.name));
        n, _, err := self.context.conn.queryOne<i64>(sql);
        sql.free();
        return n, err;
    }

    // A new row with the defaults of T, which is added when the context saves its changes. Set its members before
    // that. Then what the database made, e.g its id, is written into it. It is made with the allocator of the connection
    create :: method () -> *T {
        empty: T;
        row := resizeMemory(self.context.conn.allocator, null, sizeof(T)) as *T;
        *row = empty;
        none: any;
        self.context.record(.create, self.info(""), row, none);
        return row;
    }

    info :: method (key: string) -> TableInfo {
        return TableInfo{name: self.name, schema: self.schema, key: key, generated: self.generated, type: rowType<T>()};
    }
}

// A table with a key of one column, of type K: what a Table has, and get, update and delete
KeyedTable :: struct <T, K> {
    @embed table: Table<T>;
    key: string;            // The column of the key, e.g id

    // A new row, like create of Table, which is tracked after it is saved
    create :: method () -> *T {
        empty: T;
        row := resizeMemory(self.context.conn.allocator, null, sizeof(T)) as *T;
        *row = empty;
        none: any;
        self.context.record(.create, self.info(self.key), row, none);
        return row;
    }

    // Every row. They are tracked, so what is changed on them is saved by saveChanges, unless context.track is false.
    // Don't add to the list then, as its rows can move
    all :: method () -> ([..]T, string) {
        rows, err := self.table.all();
        for i in 0..rows.count {
            self.context.trackRow(self.info(self.key), rows.indexRef(i));
        }
        return rows, err;
    }

    // The row with the key, or null when there is none. It is made with the allocator of the connection, and tracked, so
    // what is changed on it is saved by saveChanges, unless context.track is false
    get :: method (key: K) -> (*T, string) {
        sql := fmt.sprint("SELECT * FROM % WHERE % = $1", qualifiedName(self.schema, self.name), quoted(self.key));
        conn := self.context.conn;
        row, found, err := conn.queryOne<T>(sql, key);
        sql.free();
        if !found || err != "" {
            return null, err;
        }
        stored := resizeMemory(conn.allocator, null, sizeof(T)) as *T;
        *stored = row;
        self.context.trackRow(self.info(self.key), stored);
        return stored, "";
    }

    // Writes the row to the row with its key when the context saves its changes: every column that isn't the key or
    // generated. It is read then, so it must still be there. A row that get or all gave doesn't need it, as it is tracked
    update :: method (row: *T) {
        none: any;
        self.context.record(.update, self.info(self.key), row, none);
    }

    // Removes the row with the key when the context saves its changes
    delete :: method (key: K) {
        copy := resizeMemory(self.context.conn.allocator, null, sizeof(K)) as *K;
        *copy = key;
        boxed: any = key;
        stored: any;
        stored.type = boxed.type;
        stored.data = copy;
        self.context.record(.delete, self.info(self.key), null, stored);
    }
}

// The table of the name, e.g dbms.table<OrderItem>(context, "order_items")
table :: <T>(context: *Context, name: string, schema := "") -> Table<T> {
    t: Table<T>;
    t.context = context;
    t.name    = name;
    t.schema  = schema;
    return t;
}

// The table of the name, with the column of its key and the type of the key, e.g dbms.keyedTable<User, i64>(context, "users", "id")
keyedTable :: <T, K>(context: *Context, name: string, key: string, schema := "") -> KeyedTable<T, K> {
    t: KeyedTable<T, K>;
    t.table = table<T>(context, name, schema);
    t.key   = key;
    return t;
}

// The column of a member of a row struct
@private
TableColumn :: struct {
    name:      string;
    member:    *StructMember;
    key:       bool;
    generated: bool;
}

@private
rowType :: <T>() -> *TypeStruct {
    empty: T;
    boxed: any = empty;
    return boxed.type as *TypeStruct;
}

// The columns of the members of a row struct, without the skipped ones. The generated columns and the key come from the
// table, and from @dbms.Column
@private
columnsOf :: (type: *TypeStruct, generated: [..]string, key: string) -> [..]TableColumn {
    columns: [..]TableColumn;
    for i in 0..type.members.count {
        member := &type.members[i];
        attribute: Column;
        hasAttribute := attributeOf(member, &attribute);
        if hasAttribute && attribute.skip { continue; }

        column := TableColumn{member: member};
        column.name = columnName(member.name);
        if hasAttribute {
            if attribute.name.len > 0 { column.name = attribute.name; }
            column.key       = attribute.key;
            column.generated = attribute.generated;
        }
        if column.name == key           { column.key = true; }
        if generated.contains(column.name) { column.generated = true; }
        columns.add(column);
    }
    return columns;
}

@private
keyOf :: (columns: [..]TableColumn) -> (TableColumn, bool) {
    for column in columns {
        if column.key { return column, true; }
    }
    none: TableColumn;
    return none, false;
}

// The member of the row as a parameter
@private
valueOf :: (column: TableColumn, row: *void) -> any {
    value: any;
    value.type = column.member.type;
    value.data = column.member.valueIn(row);
    return value;
}

// A name for SQL in double quotes, e.g "order", so that any name works
@private
quoted :: (name: string) -> string {
    sb: fmt.StringBuilder;
    sb.addChar('"');
    for c in name {
        if c == '"' { sb.addChar('"'); }
        sb.addChar(c);
    }
    sb.addChar('"');
    return sb.toString();
}

@private
qualifiedName :: (schema: string, name: string) -> string {
    if schema.len == 0 {
        return quoted(name);
    }
    return fmt.sprint("%.%", quoted(schema), quoted(name));
}

// The column of a member: its name in snake case, without a _ at its end, e.g createdAt is created_at and for_ is for
columnName :: (member: string) -> string {
    sb: fmt.StringBuilder;
    end := member.len as int;
    while end > 1 && member[end - 1] == '_' { end -= 1; }
    for i in 0..end {
        c := member[i];
        if c >= 'A' && c <= 'Z' {
            if i > 0 && member[i - 1] != '_' && !(member[i - 1] >= 'A' && member[i - 1] <= 'Z') {
                sb.addChar('_');
            }
            sb.addChar(c + 32);
        } else {
            sb.addChar(c);
        }
    }
    return sb.toString();
}
