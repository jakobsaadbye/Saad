namespace dbms;

// Queries with lambdas, like LINQ of C#, e.g
//
//     adults, err := db.users.where(u => u.age >= minAge && u.active).orderBy(u => u.name).limit(10).all();
//     ada, err2   := db.users.where(u => u.email == email).first();        // a *User, null when there is none
//     n, err3     := db.users.where(u => u.role == .admin).count();
//     rows, err4  := db.users.where(u => u.age >= 18).select(u => {name: u.name, nextYear: u.age + 1}).all();
//
// The lambdas are expression trees (Expr, see docs/expression_trees.md), which are made into SQL. The values they use,
// like minAge, are sent as parameters ($1, $2, ...). Nothing is sent before all, first, count or exists.
//
// In a lambda, the members of the row are its columns, and these work:
//
//     ==  !=  <  <=  >  >=  &&  ||  !  +  -  *  /  %     x.email == null is IS NULL, and ?? is coalesce
//     x.name.startsWith(s)  x.name.endsWith(s)  x.name.indexOf(s)  x.name.toLower()  x.name.toUpper()  x.name.len
//     x.createdAt.after(t)  x.createdAt.before(t)  x.createdAt.equal(t)
//     x.publishedAt?.after(t) ?? false, for a column that can be NULL
//
// The rows that a foreign key refers to can be used too, e.g p.author().name, which joins the table of the authors:
//
//     posts, err := db.posts.where(p => p.author().name == "Ada").select(p => {p.title, p.author().email}).all();
//
// A member of a struct literal without a name gets the name of the member it reads, so the rows above are
// struct { title: string; email: string; }. The join is a LEFT JOIN: a post without an author gives the defaults
import fmt;

// A query of the rows of a table. The methods that add to it give a new query, so a query can be the start of others
Query :: struct <T> {
    context:    *Context;
    table:      TableInfo;      // table.type is the struct of the rows of the table, which isn't T after a select
    conditions: [..]*ExprNode;  // Of where, joined with AND
    orderings:  [..]Ordering;
    selection:  *ExprNode;      // Of select, or null for every column
    single:     bool;           // select gave a value that isn't a struct, e.g u => u.name
    take:       i64 = -1;       // limit, -1 for every row
    skip:       i64 = 0;        // offset
    failure:    string;         // A mistake in making the query, given by all, first, count and exists

    // Only the rows that the condition is true for. More conditions are joined with AND
    where :: method (condition: Expr<(T) -> bool>) -> Query<T> {
        q := self.copy();
        if q.selection != null && q.failure == "" {
            q.failure = "where after select isn't supported. Put the where before the select";
        }
        q.conditions.add(condition.root);
        return q;
    }

    // Sorted by the value, from the smallest. A second orderBy sorts the rows that the first one finds equal
    orderBy :: method <K> (by: Expr<(T) -> K>) -> Query<T> {
        q := self.copy();
        q.orderings.add(Ordering{by.root, false});
        return q;
    }

    // Sorted by the value, from the largest
    orderByDescending :: method <K> (by: Expr<(T) -> K>) -> Query<T> {
        q := self.copy();
        q.orderings.add(Ordering{by.root, true});
        return q;
    }

    // At most n rows
    limit :: method (n: i64) -> Query<T> {
        q := self.copy();
        q.take = n;
        return q;
    }

    // Without the first n rows
    offset :: method (n: i64) -> Query<T> {
        q := self.copy();
        q.skip = n;
        return q;
    }

    // Rows of only some columns, or values made of them, e.g u => {name: u.name, nextYear: u.age + 1}, which gives a
    // [..]struct { name: string; nextYear: int; }, or u => u.name, which gives a [..]string. They aren't tracked
    select :: method <U> (f: Expr<(T) -> U>) -> Query<U> {
        q: Query<U>;
        q.context    = self.context;
        q.table      = self.table;
        q.conditions = copyList(self.conditions);
        q.orderings  = copyList(self.orderings);
        q.take       = self.take;
        q.skip       = self.skip;
        q.failure    = self.failure;
        q.selection  = f.root;

        empty: U;
        boxed: any = empty;
        q.single = boxed.type.kind != .struct;
        if !q.single && f.root.kind != .object && q.failure == "" {
            q.failure = "select gives a struct literal with names, e.g u => {name: u.name}, or one value, e.g u => u.name";
        }
        return q;
    }

    // The rows. When the table has a key and nothing is selected, they are tracked like the rows of all of the table.
    // Don't add to the list then, as its rows can move
    all :: method () -> ([..]T, string) {
        rows, err := self.fetch();
        if err == "" && self.isTracked() {
            for i in 0..rows.count {
                self.context.trackRow(self.table, rows.indexRef(i) as *void);
            }
        }
        return rows, err;
    }

    // The first row, or null when there are none. It is made with the allocator of the connection, and tracked like the
    // rows of all
    first :: method () -> (*T, string) {
        q := self.limit(1);
        rows, err := q.fetch();
        if err != "" || rows.count == 0 {
            rows.free();
            return null, err;
        }
        row := resizeMemory(self.context.conn.allocator, null, sizeof(T)) as *T;
        *row = rows[0];
        rows.free();
        if self.isTracked() {
            self.context.trackRow(self.table, row as *void);
        }
        return row, "";
    }

    // The rows, without tracking them
    fetch :: method () -> ([..]T, string) {
        none: [..]T;
        sql, args, err := self.toSql();
        if err != "" { return none, err; }

        if self.single {
            values, e := self.context.conn.query<Single<T>>(sql, ...args.elements());
            sql.free();
            rows: [..]T;
            rows.allocator = self.context.conn.allocator;
            rows.reserve(values.count);
            for v in values { rows.add(v.value); }
            values.free();
            return rows, e;
        }

        rows, e := self.context.conn.query<T>(sql, ...args.elements());
        sql.free();
        if self.selection == null {
            type := rowType<T>();
            for i in 0..rows.count {
                linkRow(self.context, type, rows.indexRef(i) as *void);
            }
        }
        return rows, e;
    }

    // The number of rows
    count :: method () -> (i64, string) {
        sql, args, err := self.toSql();
        if err != "" { return 0, err; }
        counting := fmt.sprint("SELECT count(*) FROM (%) AS rows", sql);
        sql.free();
        n, _, e := self.context.conn.queryOne<i64>(counting, ...args.elements());
        counting.free();
        return n, e;
    }

    // The sum of a value of the rows, e.g db.posts.sum(p => p.views). 0 when there are no rows
    sum :: method <K> (f: Expr<(T) -> K>) -> (K, string) {
        value, err := self.aggregate<K>("coalesce(sum(\"value\"), 0)", f);
        return value, err;
    }

    // The smallest of a value of the rows, e.g db.posts.min(p => p.createdAt). The zero value when there are no rows
    min :: method <K> (f: Expr<(T) -> K>) -> (K, string) {
        value, err := self.aggregate<K>("min(\"value\")", f);
        return value, err;
    }

    // The largest of a value of the rows. The zero value when there are no rows
    max :: method <K> (f: Expr<(T) -> K>) -> (K, string) {
        value, err := self.aggregate<K>("max(\"value\")", f);
        return value, err;
    }

    // The average of a value of the rows, e.g db.posts.average(p => p.views). 0 when there are no rows
    average :: method <K> (f: Expr<(T) -> K>) -> (f64, string) {
        value, err := self.aggregate<f64>("coalesce(avg(\"value\"), 0)::double precision", f);
        return value, err;
    }

    // An aggregate of SQL over the values that f gives of the rows, which are the column "value"
    @private
    aggregate :: method <V, K> (of: string, f: Expr<(T) -> K>) -> (V, string) {
        values := self.select(f);
        values.single = true;
        sql, args, err := values.toSql();
        if err != "" {
            zero: V;
            return zero, err;
        }
        asking := fmt.sprint("SELECT % FROM (%) AS rows", of, sql);
        sql.free();
        value, _, e := self.context.conn.queryOne<V>(asking, ...args.elements());
        asking.free();
        return value, e;
    }

    // True when there is a row
    exists :: method () -> (bool, string) {
        sql, args, err := self.toSql();
        if err != "" { return false, err; }
        asking := fmt.sprint("SELECT EXISTS (%)", sql);
        sql.free();
        found, _, e := self.context.conn.queryOne<bool>(asking, ...args.elements());
        asking.free();
        return found, e;
    }

    // The SQL of the query, and its parameters
    toSql :: method () -> (string, [..]any, string) {
        sql, args, err, joins := self.sqlWith(false);
        if err == "" && joins > 0 {
            // A relation is joined or a subquery made, so the columns are written with their table, e.g t0."title"
            sql.free();
            args.free();
            sql2, args2, err2, _ := self.sqlWith(true);
            return sql2, args2, err2;
        }
        return sql, args, err;
    }

    // The SQL, the parameters, the error and the number of joins. 'qualified' writes the columns as t0."title"
    sqlWith :: method (qualified: bool) -> (string, [..]any, string, int) {
        aliases := 0;
        w: SqlWriter;
        w.table     = self.table;
        w.context   = self.context;
        w.qualified = qualified;
        w.aliases   = &aliases;
        if self.failure != "" {
            return "", w.args, self.failure, 0;
        }

        // The columns, then the conditions and the order. The joins they need come after FROM, so they are written last
        if self.selection == null {
            if qualified { w.sb.addString("t0.*"); } else { w.sb.addString("*"); }
        } else if self.single {
            w.write(self.selection);
            w.sb.addString(" AS \"value\"");
        } else {
            for value, i in self.selection.args {
                if i > 0 { w.sb.addString(", "); }
                w.write(value);
                w.sb.addString(" AS ");
                w.sb.addString(quoted(self.selection.names[i]));
            }
        }
        columns := w.sb.toString();
        w.sb = fmt.StringBuilder{};

        for condition, i in self.conditions {
            if i == 0 { w.sb.addString(" WHERE "); } else { w.sb.addString(" AND "); }
            w.sb.addChar('(');
            w.write(condition);
            w.sb.addChar(')');
        }
        for ordering, i in self.orderings {
            if i == 0 { w.sb.addString(" ORDER BY "); } else { w.sb.addString(", "); }
            w.write(ordering.by);
            if ordering.descending { w.sb.addString(" DESC"); }
        }
        if self.take >= 0 { w.sb.addString(fmt.sprint(" LIMIT %", self.take)); }
        if self.skip > 0  { w.sb.addString(fmt.sprint(" OFFSET %", self.skip)); }

        if w.err != "" {
            w.sb.free();
            columns.free();
            return "", w.args, w.err, 0;
        }
        rest := w.sb.toString();

        sql: fmt.StringBuilder;
        sql.addString("SELECT ");
        sql.addString(columns);
        sql.addString(" FROM ");
        sql.addString(qualifiedName(self.table.schema, self.table.name));
        if qualified { sql.addString(" AS t0"); }
        for join in w.joins {
            sql.addString(" LEFT JOIN ");
            sql.addString(qualifiedName(join.table.schema, join.table.name));
            sql.addString(" AS ");
            sql.addString(join.alias);
            sql.addString(" ON ");
            sql.addString(join.on);
        }
        sql.addString(rest);
        columns.free();
        rest.free();
        return sql.toString(), w.args, "", aliases;
    }

    copy :: method () -> Query<T> {
        q := *self;
        q.conditions = copyList(self.conditions);
        q.orderings  = copyList(self.orderings);
        return q;
    }

    isTracked :: method () -> bool {
        return self.selection == null && self.table.key != "" && self.context.track;
    }
}

// The query of every row of a table
queryOf :: <T>(context: *Context, table: TableInfo) -> Query<T> {
    q: Query<T>;
    q.context = context;
    q.table   = table;
    return q;
}

@private
Ordering :: struct {
    by:         *ExprNode;
    descending: bool;
}

// A row of one column, for a select of a value that isn't a struct
@private
Single :: struct <T> {
    value: T;
}

@private
copyList :: <E>(list: [..]E) -> [..]E {
    copy: [..]E;
    copy.reserve(list.count);
    for e in list { copy.add(e); }
    return copy;
}

// A table joined to the rows of the query for a relation, e.g authors for p.author().name
@private
Join :: struct {
    path:  string;      // The row and the relations from it, e.g "t0.author", or "t0.post.author" for c.post().author()
    alias: string;      // e.g t1. The rows of the query are t0
    table: TableInfo;
    on:    string;      // e.g t1."id" = t0."author_id"
    level: *SqlWriter;  // The query or the subquery whose FROM it is in
}

// A row of a query or a subquery: its alias, its table, and the writer of that query
@private
Row :: struct {
    path:  string;
    alias: string;
    table: TableInfo;
    level: *SqlWriter;
}

// Writes an expression tree as SQL. A subquery, e.g of a.posts().count(), is written by a writer of its own, whose
// outer is the writer of the query it is in, so its lambdas can use the rows of that query
@private
SqlWriter :: struct {
    sb:        fmt.StringBuilder;
    args:      [..]any;
    table:     TableInfo;
    context:   *Context;
    joins:     [..]Join;
    alias:     string = "t0";  // Of the rows of this query
    parameter: string;         // The parameter of the lambda that is written, in a subquery, e.g p of where(p => ...)
    outer:     *SqlWriter;     // The query a subquery is in
    aliases:   *int;           // The number of joins and subqueries of the whole query, for their aliases t1, t2, ...
    qualified: bool;           // The columns are written with their table, e.g t0."title", as there are joins
    err:       string;

    write :: method * (node: *ExprNode) {
        if self.err != "" { return; }
        switch node.kind {
            case .parameter {
                self.fail("A row can't be a value in SQL, only its members, e.g u.age");
            }
            case .member {
                self.writeMember(node);
            }
            case .value {
                if isNull(node) {
                    self.sb.addString("NULL");
                } else {
                    self.args.add(node.value);
                    self.sb.addString(fmt.sprint("$%", self.args.count));
                }
            }
            case .unary {
                if node.op == "!" { self.sb.addString("NOT ("); } else { self.sb.addString("-("); }
                self.write(node.left);
                self.sb.addChar(')');
            }
            case .binary {
                self.writeBinary(node);
            }
            case .call {
                self.writeCall(node);
            }
            case .object {
                self.fail("A struct literal is only for select, e.g select(u => {name: u.name})");
            }
            case .lambda {
                self.fail("A lambda in a lambda is only for the rows of a relation, e.g a.posts().where(p => p.views > 10).count()");
            }
        }
    }

    writeMember :: method * (node: *ExprNode) {
        // The length of a text column, e.g u.name.len
        if node.left.kind == .member && node.name == "len" {
            self.sb.addString("length(");
            self.writeMember(node.left);
            self.sb.addChar(')');
            return;
        }
        // A member of the first of the rows of a relation, e.g a.posts().orderBy(p => p.views).first().title
        if node.left.kind == .call && node.left.name == "first" && self.isManyRelation(node.left.left) {
            self.writeSubquery(node.left, node.name);
            return;
        }
        // A member of the row that a relation gives, e.g p.author().name
        if node.left.kind == .call {
            row, ok := self.rowOfCall(node.left);
            if !ok { return; }
            self.sb.addString(row.alias);
            self.sb.addChar('.');
            self.sb.addString(quoted(columnIn(row.table, node.name)));
            return;
        }
        if node.left.kind != .parameter {
            self.fail(fmt.sprint("Only the members of the row are columns, so .% of something else isn't supported", node.name));
            return;
        }
        row := self.rowOf(node.left.name);
        if row.level.qualified {
            self.sb.addString(row.alias);
            self.sb.addChar('.');
        }
        self.sb.addString(quoted(columnIn(row.table, node.name)));
    }

    // The row of a parameter: of the lambda of a subquery, or of a query around it, or the rows of the query
    @private
    rowOf :: method * (parameter: string) -> Row {
        if self.outer != null && parameter != self.parameter {
            return self.outer.rowOf(parameter);
        }
        return Row{path: self.alias, alias: self.alias, table: self.table, level: self};
    }

    // The row of a relation to one row, e.g of p.author() or c.post().author(). Its join is added the first time
    @private
    rowOfCall :: method * (call: *ExprNode) -> (Row, bool) {
        none: Row;
        if call.args.count != 0 {
            self.fail(fmt.sprint("% of a query is a relation, which has no arguments", call.name));
            return none, false;
        }
        from: Row;
        if call.left.kind == .call {
            outer, ok := self.rowOfCall(call.left);
            if !ok { return none, false; }
            from = outer;
        } else if call.left.kind == .parameter {
            from = self.rowOf(call.left.name);
        } else {
            self.fail(fmt.sprint("The relation % is called on the row of the query, e.g p.%().name", call.name, call.name));
            return none, false;
        }

        relation, found := relationNamed(from.table, call.name);
        if !found || relation.many {
            if found {
                self.fail(fmt.sprint("% gives the rows of % that refer to a row, so it is a query: count(), exists(), sum(f), min(f), max(f), average(f), or first() and a member, e.g a.%().count()", call.name, relation.table, call.name));
            } else {
                self.fail(fmt.sprint("% isn't a relation of %. A query can use the relations from the foreign keys, e.g p.author().name or a.posts().count()", call.name, from.table.name));
            }
            return none, false;
        }

        path := fmt.sprint("%.%", from.path, call.name);
        level := from.level;
        for join in level.joins {
            if join.path == path { return Row{path: path, alias: join.alias, table: join.table, level: level}, true; }
        }
        other, known := self.tableOf(relation, call.name);
        if !known { return none, false; }

        join: Join;
        join.path  = path;
        join.alias = self.newAlias();
        join.table = other;
        join.on    = fmt.sprint("%.% = %.%", join.alias, quoted(relation.references), from.alias, quoted(relation.column));
        join.level = level;
        level.joins.add(join);
        return Row{path: path, alias: join.alias, table: other, level: level}, true;
    }

    // If the call is of a relation to the rows that refer to a row, e.g a.posts(), maybe narrowed, e.g a.posts().where(...)
    isManyRelation :: method * (call: *ExprNode) -> bool {
        node := call;
        while node != null && node.kind == .call && isQueryStep(node.name) { node = node.left; }
        if node == null || node.kind != .call || node.args.count != 0 { return false; }
        table := self.table;
        if node.left.kind == .parameter {
            table = self.rowOf(node.left.name).table;
        } else if node.left.kind == .call {
            if !self.isManyRelation(node.left) {
                // A relation of a joined row, e.g c.post().comments()
                relationOfJoin, ok := self.oneRelationTable(node.left);
                if !ok { return false; }
                table = relationOfJoin;
            } else {
                return false;
            }
        } else {
            return false;
        }
        relation, found := relationNamed(table, node.name);
        return found && relation.many;
    }

    // The table of the row of a chain of relations to one row, without joining it, e.g authors of p.author()
    oneRelationTable :: method * (call: *ExprNode) -> (TableInfo, bool) {
        none: TableInfo;
        table := self.table;
        if call.left.kind == .parameter {
            table = self.rowOf(call.left.name).table;
        } else if call.left.kind == .call {
            outer, ok := self.oneRelationTable(call.left);
            if !ok { return none, false; }
            table = outer;
        } else {
            return none, false;
        }
        relation, found := relationNamed(table, call.name);
        if !found || relation.many { return none, false; }
        other, known := self.context.tableNamed(relation.table);
        return other, known;
    }

    // A subquery of the rows of a relation: 'node' is the call that gives a value of them, e.g count() of
    // a.posts().where(p => ...).count(). For first(), 'member' is the column of the first row that is the value
    writeSubquery :: method * (node: *ExprNode, member: string) {
        // The steps from the relation, e.g where and orderBy, and the relation, e.g posts of a.posts()
        steps: [..]*ExprNode;
        relationCall := node.left;
        while relationCall.kind == .call && isQueryStep(relationCall.name) {
            steps.add(relationCall);
            relationCall = relationCall.left;
        }
        steps.reverse();   // In the order they are written
        from: Row;
        if relationCall.left.kind == .parameter {
            from = self.rowOf(relationCall.left.name);
        } else {
            row, ok := self.rowOfCall(relationCall.left);
            if !ok { return; }
            from = row;
        }
        relation, _ := relationNamed(from.table, relationCall.name);
        other, known := self.tableOf(relation, relationCall.name);
        if !known { return; }

        inner: SqlWriter;
        inner.context   = self.context;
        inner.table     = other;
        inner.alias     = self.newAlias();
        inner.outer     = self;
        inner.aliases   = self.aliases;
        inner.qualified = true;
        inner.args      = self.args;   // The parameters go on, $1, $2, ...

        // The value, e.g count(*) or sum(p.views)
        aggregate := node.name;
        if aggregate == "exists" {
            inner.sb.addString("1");
        } else if aggregate == "count" {
            inner.sb.addString("count(*)");
        } else if aggregate == "first" {
            inner.sb.addString(inner.alias);
            inner.sb.addChar('.');
            inner.sb.addString(quoted(columnIn(other, member)));
        } else {
            f := lambdaOf(node);
            if f == null {
                self.fail(fmt.sprint("% of the rows of a relation takes a lambda of a column, e.g a.%().%(p => p.views)", aggregate, relationCall.name, aggregate));
                return;
            }
            if aggregate == "sum"     { inner.sb.addString("coalesce(sum("); }
            if aggregate == "min"     { inner.sb.addString("min("); }
            if aggregate == "max"     { inner.sb.addString("max("); }
            if aggregate == "average" { inner.sb.addString("avg("); }
            inner.parameter = f.names[0];
            inner.write(f.left);
            if aggregate == "sum" { inner.sb.addString("), 0)"); } else { inner.sb.addChar(')'); }
        }
        value := inner.sb.toString();
        inner.sb = fmt.StringBuilder{};

        // The rows that refer to the row, and the conditions of the steps
        inner.sb.addString(fmt.sprint(" WHERE %.% = %.%", inner.alias, quoted(relation.column), from.alias, quoted(relation.references)));
        orderings := 0;
        for step in steps {
            f := lambdaOf(step);
            if f == null { self.fail(fmt.sprint("% of the rows of a relation takes a lambda, e.g where(p => p.views > 10)", step.name)); return; }
            inner.parameter = f.names[0];
            if step.name == "where" {
                inner.sb.addString(" AND (");
                inner.write(f.left);
                inner.sb.addChar(')');
            }
        }
        for step in steps {
            if step.name == "where" { continue; }
            f := lambdaOf(step);
            inner.parameter = f.names[0];
            if orderings == 0 { inner.sb.addString(" ORDER BY "); } else { inner.sb.addString(", "); }
            orderings += 1;
            inner.write(f.left);
            if step.name == "orderByDescending" { inner.sb.addString(" DESC"); }
        }
        if aggregate == "first" { inner.sb.addString(" LIMIT 1"); }
        rest := inner.sb.toString();
        self.args = inner.args;
        if inner.err != "" {
            self.fail(inner.err);
            return;
        }

        if aggregate == "exists" { self.sb.addString("EXISTS "); }
        self.sb.addString("(SELECT ");
        self.sb.addString(value);
        self.sb.addString(" FROM ");
        self.sb.addString(qualifiedName(other.schema, other.name));
        self.sb.addString(" AS ");
        self.sb.addString(inner.alias);
        for join in inner.joins {
            self.sb.addString(fmt.sprint(" LEFT JOIN % AS % ON %", qualifiedName(join.table.schema, join.table.name), join.alias, join.on));
        }
        self.sb.addString(rest);
        self.sb.addChar(')');
        value.free();
        rest.free();
    }

    newAlias :: method * () -> string {
        *self.aliases += 1;
        return fmt.sprint("t%", *self.aliases);
    }

    tableOf :: method * (relation: Relation, name: string) -> (TableInfo, bool) {
        other, known := self.context.tableNamed(relation.table);
        if !known {
            self.fail(fmt.sprint("The table % of the relation % isn't known. database.open registers the tables", relation.table, name));
        }
        return other, known;
    }

    writeBinary :: method * (node: *ExprNode) {
        // == null and != null are IS NULL and IS NOT NULL
        if node.op == "==" || node.op == "!=" {
            other: *ExprNode = null;
            if isNull(node.right) { other = node.left; }
            if isNull(node.left)  { other = node.right; }
            if other != null {
                self.sb.addChar('(');
                self.write(other);
                if node.op == "==" { self.sb.addString(" IS NULL)"); } else { self.sb.addString(" IS NOT NULL)"); }
                return;
            }
        }
        if node.op == "??" {
            self.sb.addString("coalesce(");
            self.write(node.left);
            self.sb.addString(", ");
            self.write(node.right);
            self.sb.addChar(')');
            return;
        }

        op := node.op;
        if op == "==" { op = "="; }
        if op == "!=" { op = "<>"; }
        if op == "&&" { op = "AND"; }
        if op == "||" { op = "OR"; }
        self.sb.addChar('(');
        self.write(node.left);
        self.sb.addChar(' ');
        self.sb.addString(op);
        self.sb.addChar(' ');
        self.write(node.right);
        self.sb.addChar(')');
    }

    writeCall :: method * (node: *ExprNode) {
        // A value of the rows of a relation, e.g a.posts().count() or a.posts().sum(p => p.views)
        if node.left != null && isAggregate(node.name) && self.isManyRelation(node.left) {
            self.writeSubquery(node, "");
            return;
        }
        if node.left == null {
            self.fail(fmt.sprint("The function % can't be made into SQL. Call it outside the lambda, and use its value", node.name));
            return;
        }
        arguments := node.args.count;
        if node.name == "toLower" || node.name == "toUpper" {
            if arguments != 0 { self.failCall(node); return; }
            if node.name == "toLower" { self.sb.addString("lower("); } else { self.sb.addString("upper("); }
            self.write(node.left);
            self.sb.addChar(')');
            return;
        }
        if arguments != 1 { self.failCall(node); return; }
        // Times, e.g p.publishedAt.after(since)
        if node.name == "after" || node.name == "before" || node.name == "equal" {
            self.sb.addChar('(');
            self.write(node.left);
            if node.name == "after"  { self.sb.addString(" > "); }
            if node.name == "before" { self.sb.addString(" < "); }
            if node.name == "equal"  { self.sb.addString(" = "); }
            self.write(node.args[0]);
            self.sb.addChar(')');
            return;
        }
        if node.name == "startsWith" || node.name == "endsWith" {
            // left(x, length(s)) = s, so that % and _ in s are no wildcards
            if node.name == "startsWith" { self.sb.addString("(left("); } else { self.sb.addString("(right("); }
            self.write(node.left);
            self.sb.addString(", length(");
            self.write(node.args[0]);
            self.sb.addString(")) = ");
            self.write(node.args[0]);
            self.sb.addChar(')');
            return;
        }
        if node.name == "indexOf" {
            self.sb.addString("(strpos(");
            self.write(node.left);
            self.sb.addString(", ");
            self.write(node.args[0]);
            self.sb.addString(") - 1)");
            return;
        }
        self.failCall(node);
    }

    failCall :: method * (node: *ExprNode) {
        self.fail(fmt.sprint("The method % can't be made into SQL. These can: startsWith(s), endsWith(s), indexOf(s), toLower(), toUpper(), and after(t), before(t) and equal(t) of times", node.name));
    }

    fail :: method * (message: string) {
        if self.err == "" { self.err = message; }
    }
}

// The column of a member of the rows of the table
@private
columnIn :: (table: TableInfo, member: string) -> string {
    columns := columnsOf(table.type, table.generated, table.key);
    name := columnName(member);
    for column in columns {
        if column.member.name == member { name = column.name; }
    }
    columns.free();
    return name;
}

// null, or an empty optional
@private
isNull :: (node: *ExprNode) -> bool {
    if node.kind != .value { return false; }
    if node.value.type == null { return true; }
    if node.value.type.kind == .pointer { return *(node.value.data as **void) == null; }
    if node.value.type.isOptional() {
        _, _, present := (node.value.type as *TypeStruct).optionalValue(node.value.data);
        return !present;
    }
    return false;
}

// The steps of a query of the rows of a relation, e.g the where of a.posts().where(p => p.views > 10).count()
@private
isQueryStep :: (name: string) -> bool {
    return name == "where" || name == "orderBy" || name == "orderByDescending";
}

// What a query of the rows of a relation gives in a lambda, e.g count of a.posts().count()
@private
isAggregate :: (name: string) -> bool {
    return name == "count" || name == "exists" || name == "sum" || name == "min" || name == "max" || name == "average";
}

// The lambda that is the argument of a call, e.g p => p.views of sum(p => p.views), or null
@private
lambdaOf :: (call: *ExprNode) -> *ExprNode {
    if call.args.count != 1 || call.args[0].kind != .lambda { return null; }
    return call.args[0];
}

@private
relationNamed :: (table: TableInfo, name: string) -> (Relation, bool) {
    for r in table.relations {
        if r.name == name { return r, true; }
    }
    none: Relation;
    return none, false;
}
