namespace dbms.postgres;

// Writes the tables of a database as Saad files into a folder, e.g db:
//
//     db/entity/user.sd   the struct of a row of users, in the namespace entities
//     db/entity/role.sd   the enum role
//     db/database.sd      the tables, Database and open, in the namespace database
//
// The rows and enums are all that is in their namespace, so 'use entities;' brings in nothing else, e.g
//
//     files, err := postgres.generate(&conn, postgres.GenerateOptions{});
//     removed, err2 := postgres.writeFiles("db", files);
//
// std/dbms/tools/generate.sd is the program around it. See docs/dbms.md

import dbms;
import fmt;
import os;

GenerateOptions :: struct {
    entities: string = "entities"; // The namespace of the rows and enums, in the folder entity
    database: string = "database"; // The namespace of database.sd: the tables, Database and open
    schema:   string = "public";   // The schema whose tables are written
}

// A file to write, e.g entity/user.sd
GeneratedFile :: struct {
    name: string;
    code: string;
}

// The first line of every file, so that the files of an earlier run are known
GeneratedMark :: "// Made by std/dbms/tools/generate.sd";

// The Saad files of the tables and enums of the schema, or an error
generate :: (conn: *dbms.Connection, options: GenerateOptions) -> ([..]GeneratedFile, string) {
    files: [..]GeneratedFile;
    columns, err := conn.query<SchemaColumn>(ColumnsSql, options.schema);
    if err != "" { return files, err; }
    keys, err2 := conn.query<SchemaKey>(KeysSql, options.schema);
    if err2 != "" { return files, err2; }
    enumLabels, err3 := conn.query<SchemaEnumLabel>(EnumsSql, options.schema);
    if err3 != "" { return files, err3; }
    foreignKeys, err4 := conn.query<SchemaForeignKey>(ForeignKeysSql, options.schema);
    if err4 != "" { return files, err4; }

    // The enums with their labels, and the tables with their columns, in the order of their names
    enums: [..]SchemaEnum;
    for label in enumLabels {
        if enums.count == 0 || enums.last().name != label.typeName {
            enums.add(SchemaEnum{name: label.typeName});
        }
        enums.indexRef(enums.count - 1).labels.add(label.label);
    }

    tables: [..]SchemaTable;
    for column in columns {
        if tables.count == 0 || tables.last().name != column.tableName {
            tables.add(SchemaTable{name: column.tableName});
        }
        tables.indexRef(tables.count - 1).columns.add(column);
    }

    // A key of one column. Tables with a key of more columns get no get, update and delete
    for *table in tables {
        keyCount := 0;
        for key in keys {
            if key.tableName == table.name {
                keyCount += 1;
                table.key = key.columnName;
            }
        }
        if keyCount != 1 { table.key = ""; }
    }

    w := Writer{options: options, enums: enums};
    w.relationsOf(&tables, foreignKeys);
    for e in enums {
        files.add(GeneratedFile{name: w.fileNameOf(e.name, true), code: w.enumFile(e)});
    }
    for table in tables {
        files.add(GeneratedFile{name: w.fileNameOf(singular(table.name), false), code: w.rowFile(table)});
    }
    files.add(GeneratedFile{name: "database.sd", code: w.databaseFile(tables, files)});
    return files, "";
}

// Writes the files into the folder, which is made if it isn't there, and its folder entity. The files of an earlier run
// (listed in its database.sd) that are not written again, e.g of a table that is gone, are removed, if they were made by
// the generator. Gives the names of those
writeFiles :: (folder: string, files: [..]GeneratedFile) -> ([..]string, string) {
    removed: [..]string;
    for dir in [folder, fmt.sprint("%/entity", folder)] {
        if !os.makeDir(dir) {
            return removed, fmt.sprint("Can't make the folder %", dir);
        }
    }

    // The files of the last run
    old, hadOld := os.readFile(fmt.sprint("%/database.sd", folder));
    if hadOld {
        for line in old.split("\n") {
            if !line.startsWith("// Files: ") { continue; }
            for name in line.slice(10).split(", ") {
                if name.len == 0 { continue; }
                written := false;
                for file in files {
                    if file.name == name { written = true; }
                }
                if written { continue; }
                path := fmt.sprint("%/%", folder, name);
                text, ok := os.readFile(path);
                if ok && text.startsWith(GeneratedMark) && os.removeFile(path) {
                    removed.add(name);
                }
            }
        }
    }

    for file in files {
        path := fmt.sprint("%/%", folder, file.name);
        if !os.writeFile(path, file.code) {
            return removed, fmt.sprint("Can't write %", path);
        }
    }
    return removed, "";
}

//
// Reading the schema
//

@private
ColumnsSql :: "SELECT c.table_name, c.column_name, c.data_type, c.udt_name, c.is_nullable, c.column_default, c.is_identity, c.is_generated FROM information_schema.columns c JOIN information_schema.tables t ON t.table_schema = c.table_schema AND t.table_name = c.table_name WHERE c.table_schema = $1 AND t.table_type = 'BASE TABLE' ORDER BY c.table_name, c.ordinal_position";

@private
KeysSql :: "SELECT k.table_name, k.column_name FROM information_schema.table_constraints c JOIN information_schema.key_column_usage k ON k.constraint_schema = c.constraint_schema AND k.constraint_name = c.constraint_name WHERE c.constraint_type = 'PRIMARY KEY' AND c.table_schema = $1";

@private
EnumsSql :: "SELECT t.typname AS type_name, e.enumlabel AS label FROM pg_type t JOIN pg_enum e ON e.enumtypid = t.oid JOIN pg_namespace n ON n.oid = t.typnamespace WHERE n.nspname = $1 ORDER BY t.typname, e.enumsortorder";

// The foreign keys of one column, to a table of the same schema
@private
ForeignKeysSql :: "SELECT tc.constraint_name, kcu.table_name, kcu.column_name, ccu.table_name AS foreign_table, ccu.column_name AS foreign_column FROM information_schema.table_constraints tc JOIN information_schema.key_column_usage kcu ON kcu.constraint_schema = tc.constraint_schema AND kcu.constraint_name = tc.constraint_name JOIN information_schema.constraint_column_usage ccu ON ccu.constraint_schema = tc.constraint_schema AND ccu.constraint_name = tc.constraint_name WHERE tc.constraint_type = 'FOREIGN KEY' AND tc.table_schema = $1 AND ccu.table_schema = $1 ORDER BY kcu.table_name, kcu.column_name, tc.constraint_name";

@private
SchemaForeignKey :: struct {
    constraintName: string;
    tableName:      string;   // e.g posts
    columnName:     string;   // e.g author_id
    foreignTable:   string;   // e.g authors
    foreignColumn:  string;   // e.g id
}

// A method of a row for a foreign key: the row it refers to, e.g post.author(), or the rows that refer to it, e.g
// author.posts()
@private
Relation :: struct {
    name:         string;   // e.g author or posts
    toMany:       bool;     // The rows that refer to this one
    otherTable:   string;   // e.g authors, or posts
    column:       string;   // The column of the foreign key, e.g author_id of posts
    otherColumn:  string;   // The column it refers to, e.g id of authors
}

@private
SchemaColumn :: struct {
    tableName:     string;
    columnName:    string;
    dataType:      string;   // e.g timestamp with time zone, or USER-DEFINED for an enum
    udtName:       string;   // e.g int4, timestamptz, or the name of the enum
    isNullable:    string;   // YES or NO
    columnDefault: ?string;  // e.g 'guest'::role, true, 0 or nextval('users_id_seq'::regclass)
    isIdentity:    string;
    isGenerated:   string;
}

@private
SchemaKey :: struct {
    tableName:  string;
    columnName: string;
}

@private
SchemaEnumLabel :: struct {
    typeName: string;
    label:    string;
}

@private
SchemaEnum :: struct {
    name:   string;
    labels: [..]string;
}

@private
SchemaTable :: struct {
    name:      string;
    columns:   [..]SchemaColumn;
    key:       string;   // The column of its key, or empty
    relations: [..]Relation;
}

//
// Writing the code
//

@private
Writer :: struct {
    options: GenerateOptions;
    enums:   [..]SchemaEnum;
}

// A member of a row struct
@private
Member :: struct {
    name:      string;   // e.g createdAt
    type:      string;   // e.g ?string
    column:    string;   // e.g created_at
    attribute: string;   // @dbms.Column(name: ...) when the column is not the name of the member in snake case, or empty
    value:     string;   // The default, e.g .guest, or empty
    comment:   string;   // e.g timestamp with time zone, or empty
    generated: bool;     // Made by the database, e.g a serial or now()
}

// The file of a row or an enum, e.g entity/order_item.sd. A row with the name of an enum gets _table
@private
fileNameOf :: method (w: *Writer, name: string, isEnum: bool) -> string {
    file := dbms.columnName(camelCase(name));
    if !isEnum {
        for e in w.enums {
            if dbms.columnName(camelCase(e.name)) == file { return fmt.sprint("entity/%_table.sd", file); }
        }
    }
    return fmt.sprint("entity/%.sd", file);
}

@private
header :: method (w: *Writer, sb: *fmt.StringBuilder, ns: string) {
    sb.addLine("% from the schema % of a Postgres database. Make it again", GeneratedMark, w.options.schema);
    sb.addLine("// instead of changing it, e.g saad run std/dbms/tools/generate.sd -- \"host=localhost dbname=app\" db");
    sb.addLine("namespace %;", ns);
    sb.addLine("");
}

@private
enumFile :: method (w: *Writer, e: SchemaEnum) -> string {
    sb: fmt.StringBuilder;
    w.header(&sb, w.options.entities);
    sb.addLine("// The enum %", e.name);
    sb.add("% :: enum {", pascalCase(e.name));
    for label, i in e.labels {
        if i > 0 { sb.addChar(','); }
        sb.add(" %", enumValueName(label));
    }
    sb.addLine(" }");
    return sb.toString();
}

// The struct of a row, e.g User
@private
rowFile :: method (w: *Writer, table: SchemaTable) -> string {
    members: [..]Member;
    for column in table.columns {
        members.add(w.memberOf(column));
    }

    nameWidth := 0;
    typeWidth := 0;
    for m in members {
        nameWidth = atLeast(nameWidth, m.name.len as int);
        typeWidth = atLeast(typeWidth, declarationOf(m).len as int + 1);
    }

    sb: fmt.StringBuilder;
    w.header(&sb, w.options.entities);
    usesDbms := table.relations.count > 0;   // For dbms.Link and the relations
    usesTime := false;
    for m in members {
        if m.attribute.len > 0 { usesDbms = true; }  // For @dbms.Column
        if m.type.indexOf("time.Time") >= 0 { usesTime = true; }
    }
    if usesDbms { sb.addLine("import dbms;"); }
    if usesTime { sb.addLine("import time;"); }
    if usesDbms || usesTime { sb.addLine(""); }
    sb.addLine("// A row of %", table.name);
    sb.addLine("% :: struct {", rowTypeName(table.name));
    for m in members {
        if m.attribute.len > 0 {
            sb.addLine("    %", m.attribute);
        }
        sb.add("    %:", m.name);
        sb.addRepeated(' ', nameWidth - m.name.len as int + 1);
        declaration := declarationOf(m);
        sb.add("%;", declaration);
        if m.comment.len > 0 {
            sb.addRepeated(' ', typeWidth - declaration.len as int);
            sb.add("// %", m.comment);
        }
        sb.addLine("");
    }
    if table.relations.count > 0 {
        w.writeRelations(&sb, table);
    }
    sb.addLine("}");
    return sb.toString();
}

// The relations of the tables from the foreign keys of one column. A foreign key from posts.author_id to authors.id gives
// author() to a Post and posts() to an Author. A table with two foreign keys to the same table, e.g editor_id too, gives
// postsByAuthor() and postsByEditor(). A name that a member has already gets Row or Rows at its end
@private
relationsOf :: method (w: *Writer, tables: *[..]SchemaTable, foreignKeys: [..]SchemaForeignKey) {
    // Only foreign keys of one column
    keys: [..]SchemaForeignKey;
    for fk, i in foreignKeys {
        columns := 0;
        for other in foreignKeys {
            if other.constraintName == fk.constraintName { columns += 1; }
        }
        if columns == 1 { keys.add(fk); }
    }

    for fk in keys {
        from := tableIndex(tables, fk.tableName);
        to   := tableIndex(tables, fk.foreignTable);
        if from < 0 || to < 0 { continue; }

        // How many foreign keys the table has to the same table
        sameTarget := 0;
        for other in keys {
            if other.tableName == fk.tableName && other.foreignTable == fk.foreignTable { sameTarget += 1; }
        }

        // e.g author_id is author
        stem := fk.columnName;
        if stem.len > 3 && stem.slice(stem.len as int - 3) == "_id" { stem = stem.slice(0, stem.len as int - 3); }

        forward := Relation{toMany: false, otherTable: fk.foreignTable, column: fk.columnName, otherColumn: fk.foreignColumn};
        forward.name = memberName(stem);
        if stem == fk.columnName { forward.name = fmt.sprint("%Row", memberName(stem)); }
        tables.indexRef(from).relations.add(forward);

        back := Relation{toMany: true, otherTable: fk.tableName, column: fk.columnName, otherColumn: fk.foreignColumn};
        back.name = camelCase(fk.tableName);
        if sameTarget > 1 || fk.tableName == fk.foreignTable { back.name = fmt.sprint("%By%", camelCase(fk.tableName), pascalCase(stem)); }
        tables.indexRef(to).relations.add(back);
    }

    // Names that the members have already
    for *table in tables {
        for *relation in table.relations {
            for column in table.columns {
                if memberName(column.columnName) == relation.name {
                    if relation.toMany { relation.name = fmt.sprint("%Rows", relation.name); }
                    else               { relation.name = fmt.sprint("%Row", relation.name); }
                }
            }
        }
    }
}

@private
tableIndex :: (tables: *[..]SchemaTable, name: string) -> int {
    for i in 0..tables.count {
        if tables.indexRef(i).name == name { return i as int; }
    }
    return -1;
}

// The member of a row that links it to its database, for its relations
@private
linkName :: (table: SchemaTable) -> string {
    for column in table.columns {
        if memberName(column.columnName) == "dbLink" { return "dbLink_"; }
    }
    return "dbLink";
}

// The methods of the relations of a row
@private
writeRelations :: method (w: *Writer, sb: *fmt.StringBuilder, table: SchemaTable) {
    link := linkName(table);

    // The rows it refers to first, then the rows that refer to it
    relations: [..]Relation;
    for r in table.relations { if !r.toMany { relations.add(r); } }
    for r in table.relations { if r.toMany  { relations.add(r); } }

    names: [..]string;
    for r in relations { names.add(fmt.sprint("%()", r.name)); }
    sb.addLine("");
    sb.addLine("    // The database it came from, for %", fmt.join(names.elements(), ", "));
    sb.addLine("    @Hidden %: dbms.Link;", link);

    for r in relations {
        sb.addLine("");
        if r.toMany {
            row := rowTypeName(r.otherTable);
            sb.addLine("    // The rows of % whose % is the % of this one, as a query, e.g %.%().all()", r.otherTable, r.column, r.otherColumn, camelCase(singular(table.name)), r.name);
            sb.addLine("    % :: method () -> dbms.Query<%> {", r.name, row);
            sb.addLine("        return dbms.relatedRows<%>(self.%, %).where(row => row.% == self.%);", row, link, saadString(r.otherTable), memberName(r.column), memberName(r.otherColumn));
        } else {
            row := rowTypeName(r.otherTable);
            sb.addLine("    // The row of % that % refers to, or null", r.otherTable, memberName(r.column));
            sb.addLine("    % :: method () -> (*%, string) {", r.name, row);
            sb.addLine("        row, err := dbms.related<%>(self.%, %, %, self.%);", row, link, saadString(r.otherTable), saadString(r.otherColumn), memberName(r.column));
            sb.addLine("        return row, err;");
        }
        sb.addLine("    }");
    }
}

// The types of the tables, the Database with them, and open
@private
databaseFile :: method (w: *Writer, tables: [..]SchemaTable, files: [..]GeneratedFile) -> string {
    sb: fmt.StringBuilder;
    w.header(&sb, w.options.database);
    sb.addLine("import dbms;");
    sb.addLine("use %;", w.options.entities);
    sb.addLine("");

    // The files, so that a later run knows which ones to remove
    sb.add("// Files: ");
    for file, i in files {
        if i > 0 { sb.addString(", "); }
        sb.addString(file.name);
    }
    sb.addLine(", database.sd");
    sb.addLine("");

    // The context of the changes, unless a table has its name
    context := "context";
    for table in tables {
        if camelCase(table.name) == context { context = "dbContext"; }
    }

    sb.addLine("// The tables of the schema %, and the changes to them, which saveChanges writes in one transaction, e.g", w.options.schema);
    sb.addLine("//");
    sb.addLine("//     db := %.open(&conn);", w.options.database);
    if tables.count > 0 {
        sb.addLine("//     rows, err := db.%.all();", camelCase(tables[0].name));
        sb.addLine("//     row := db.%.create();", camelCase(tables[0].name));
    }
    sb.addLine("//     err2 := db.saveChanges();");
    sb.addLine("Database :: struct {");
    width := 0;
    for table in tables { width = atLeast(width, camelCase(table.name).len as int); }
    sb.addLine("    @embed %: *dbms.Context;", context);
    if tables.count > 0 { sb.addLine(""); }
    for table in tables {
        name := camelCase(table.name);
        sb.add("    %:", name);
        sb.addRepeated(' ', width - name.len as int + 1);
        sb.addLine("%;", tableTypeName(table.name));
    }
    sb.addLine("}");

    sb.addLine("");
    sb.addLine("// The tables on the connection");
    sb.addLine("open :: (conn: *dbms.Connection) -> Database {");
    sb.addLine("    tables: Database;");
    sb.addLine("    tables.% = dbms.newContext(conn);", context);
    for table in tables {
        name := camelCase(table.name);
        sb.add("    tables.%.table", name);
        sb.addRepeated(' ', width - name.len as int);
        if table.key.len > 0 {
            sb.add(" = dbms.keyedTable<%, %>(tables.%, %, %", rowTypeName(table.name), w.keyTypeOf(table), context, saadString(table.name), saadString(table.key));
        } else {
            sb.add(" = dbms.table<%>(tables.%, %", rowTypeName(table.name), context, saadString(table.name));
        }
        if w.options.schema != "public" {
            sb.add(", schema: %", saadString(w.options.schema));
        }
        sb.addLine(");");
    }

    // The columns the database makes
    for table in tables {
        generated: [..]string;
        for column in table.columns {
            if w.memberOf(column).generated { generated.add(saadString(column.columnName)); }
        }
        if generated.count > 0 {
            sb.addLine("    tables.%.generated = [%];", camelCase(table.name), fmt.join(generated.elements(), ", "));
        }
    }

    // The tables, for the relations of the rows
    for table in tables {
        sb.addLine("    tables.%.register(tables.%.tableInfo());", context, camelCase(table.name));
    }
    sb.addLine("    return tables;");
    sb.addLine("}");

    // The types of the tables
    for table in tables {
        sb.addLine("");
        if w.keyTypeOf(table).len > 0 {
            sb.addLine("// The rows of %: all, get, count, and create, update and delete of dbms.KeyedTable", table.name);
        } else {
            sb.addLine("// The rows of %: all, count and create of dbms.Table. It has no key of one column, so no get, update and delete", table.name);
        }
        sb.addLine("% :: struct {", tableTypeName(table.name));
        sb.addLine("    @embed table: %;", w.tableTypeOf(table));
        sb.addLine("}");
    }
    return sb.toString();
}

// The type of the key of the table, e.g i64, or empty when it has no key of one column
@private
keyTypeOf :: method (w: *Writer, table: SchemaTable) -> string {
    if table.key.len == 0 { return ""; }
    for column in table.columns {
        if column.columnName == table.key { return w.baseTypeOf(column); }
    }
    return "";
}

// e.g dbms.KeyedTable<User, i64>
@private
tableTypeOf :: method (w: *Writer, table: SchemaTable) -> string {
    keyType := w.keyTypeOf(table);
    if keyType.len > 0 { return fmt.sprint("dbms.KeyedTable<%, %>", rowTypeName(table.name), keyType); }
    return fmt.sprint("dbms.Table<%>", rowTypeName(table.name));
}

@private
memberOf :: method (w: *Writer, column: SchemaColumn) -> Member {
    m: Member;
    m.name   = memberName(column.columnName);
    m.column = column.columnName;

    base := w.baseTypeOf(column);
    m.type = base;
    if column.isNullable == "YES" {
        m.type = fmt.sprint("?%", base);
    }

    // What isn't text in Postgres, but is a string here, e.g numeric, and times that aren't timestamptz
    if base == "string" && column.udtName != "text" && column.udtName != "varchar" && column.udtName != "bpchar" {
        m.comment = column.dataType;
    }
    if column.udtName == "timestamp" { m.comment = "timestamp without time zone, which is UTC"; }
    if column.udtName == "date"      { m.comment = "date, at midnight UTC"; }

    // A default that is a constant becomes the default of the member. One that is computed, e.g nextval(...) of a
    // serial or now(), is made by the database
    m.generated = column.isIdentity == "YES" || column.isGenerated == "ALWAYS";
    if column.columnDefault.hasValue() && !m.generated {
        value, isConstant := w.defaultValue(column.columnDefault.value(), base);
        if isConstant { m.value = value; }
        else          { m.generated = true; }
    }

    // The column of a member is its name in snake case, e.g createdAt is created_at and for_ is for. Others are named
    if dbms.columnName(m.name) != column.columnName {
        m.attribute = fmt.sprint("@dbms.Column(name: %)", saadString(column.columnName));
    }
    return m;
}

// The type of a column without ?
@private
baseTypeOf :: method (w: *Writer, column: SchemaColumn) -> string {
    udt := column.udtName;
    if udt == "int2"   { return "i16"; }
    if udt == "int4"   { return "i32"; }
    if udt == "int8"   { return "i64"; }
    if udt == "float4" { return "f32"; }
    if udt == "float8" { return "f64"; }
    if udt == "bool"   { return "bool"; }
    if udt == "timestamptz" || udt == "timestamp" || udt == "date" { return "time.Time"; }
    if column.dataType == "USER-DEFINED" {
        for e in w.enums {
            if e.name == column.udtName { return pascalCase(e.name); }
        }
    }
    return "string"; // Text, and what is written as text, e.g numeric, uuid and json
}

// The default of a column as Saad, if it is a constant, e.g 'guest'::role is .guest, true is true and 0 is 0
@private
defaultValue :: method (w: *Writer, text: string, type: string) -> (string, bool) {
    // A quoted value with a cast, e.g 'guest'::role or '-1'::integer
    if text.len > 0 && text[0] == '\'' {
        end := 1;
        value: fmt.StringBuilder;
        while end < text.len {
            if text[end] == '\'' {
                if end + 1 < text.len && text[end + 1] == '\'' { // '' is a '
                    value.addChar('\'');
                    end += 2;
                    continue;
                }
                break;
            }
            value.addChar(text[end]);
            end += 1;
        }
        rest := text.slice(end + 1);
        if rest.len > 0 && !rest.startsWith("::") {
            return "", false; // An expression, e.g 'a' || 'b'
        }
        unquoted := value.toString();
        if type == "string" { return saadString(unquoted), true; }
        if isNumber(unquoted) && (type == "i16" || type == "i32" || type == "i64" || type == "f32" || type == "f64") { return numberFor(unquoted, type), true; }
        for e in w.enums {
            if pascalCase(e.name) == type && e.labels.contains(unquoted) { return fmt.sprint(".%", enumValueName(unquoted)), true; }
        }
        return "", false;
    }

    if text == "true" || text == "false" {
        if type == "bool" { return text, true; }
        return "", false;
    }
    if isNumber(text) {
        if type == "string" { return saadString(text), true; } // e.g numeric
        return numberFor(text, type), true;
    }
    return "", false; // Computed, e.g nextval('users_id_seq'::regclass) or now()
}

// A float type needs a float literal, e.g 0.0
@private
numberFor :: (text: string, type: string) -> string {
    if (type == "f32" || type == "f64") && text.indexOf(".") == -1 {
        return fmt.sprint("%.0", text);
    }
    return text;
}

@private
isNumber :: (text: string) -> bool {
    if text.len == 0 { return false; }
    digits := 0;
    for c, i in text {
        if c == '-' && i == 0 { continue; }
        if c == '.' { continue; }
        if c < '0' || c > '9' { return false; }
        digits += 1;
    }
    return digits > 0;
}

//
// Names
//

// e.g users is User, order_items is OrderItem and categories is Category
@private
rowTypeName :: (table: string) -> string {
    return pascalCase(singular(table));
}

// e.g users is UsersTable
@private
tableTypeName :: (table: string) -> string {
    return fmt.sprint("%Table", pascalCase(table));
}

// The singular of an English word, for most words: categories is category, addresses is address, users is user
@private
singular :: (word: string) -> string {
    if word.endsWith("ies") && word.len > 3 { return fmt.sprint("%y", word.slice(0, word.len as int - 3)); }
    if word.endsWith("sses") || word.endsWith("xes") || word.endsWith("ches") || word.endsWith("shes") {
        return word.slice(0, word.len as int - 2);
    }
    if word.endsWith("s") && !word.endsWith("ss") && word.len > 1 { return word.slice(0, word.len as int - 1); }
    return word;
}

// e.g order_items is OrderItems
@private
pascalCase :: (name: string) -> string {
    sb: fmt.StringBuilder;
    upper := true;
    for c in name {
        if !isNameChar(c) || c == '_' {
            upper = true;
            continue;
        }
        if upper && c >= 'a' && c <= 'z' { sb.addChar(c - 32); }
        else                             { sb.addChar(c); }
        upper = false;
    }
    text := sb.toString();
    if text.len == 0 || (text[0] >= '0' && text[0] <= '9') { return fmt.sprint("T%", text); }
    return text;
}

// e.g created_at is createdAt
@private
camelCase :: (name: string) -> string {
    pascal := pascalCase(name);
    if pascal.len == 0 || pascal[0] < 'A' || pascal[0] > 'Z' {
        return pascal;
    }
    sb: fmt.StringBuilder;
    sb.addChar(pascal[0] + 32);
    sb.addString(pascal.slice(1));
    return sb.toString();
}

// The member of a column, e.g created_at is createdAt. A keyword gets a _ at its end, e.g for_
@private
memberName :: (column: string) -> string {
    name := camelCase(column);
    if isKeyword(name) { return fmt.sprint("%_", name); }
    return name;
}

// The value of an enum label. A label that is a name is kept as it is, so that it is written back the same
@private
enumValueName :: (label: string) -> string {
    sb: fmt.StringBuilder;
    for c in label {
        if isNameChar(c) { sb.addChar(c); }
        else             { sb.addChar('_'); }
    }
    name := sb.toString();
    if name.len == 0 || (name[0] >= '0' && name[0] <= '9') || isKeyword(name) { return fmt.sprint("_%", name); }
    return name;
}

@private
isNameChar :: (c: u8) -> bool {
    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_';
}

@private
isKeyword :: (name: string) -> bool {
    keywords := ["if", "else", "for", "while", "return", "break", "continue", "in", "as", "xx", "new", "assert", "typeof", "sizeof",
                 "struct", "enum", "union", "method", "switch", "case", "import", "use", "namespace", "extern", "any", "string",
                 "true", "false", "null", "int", "uint", "float", "char", "bool", "void", "u8", "u16", "u32", "u64",
                 "i8", "i16", "i32", "i64", "f32", "f64"];
    return keywords.contains(name);
}

// A string literal of Saad, e.g "say \"hi\""
@private
saadString :: (text: string) -> string {
    sb: fmt.StringBuilder;
    sb.addQuoted(text);
    return sb.toString();
}

@private
atLeast :: (a: int, b: int) -> int {
    if a > b { return a; }
    return b;
}

// e.g ?string, or Role = .guest
@private
declarationOf :: (m: Member) -> string {
    if m.value.len > 0 { return fmt.sprint("% = %", m.type, m.value); }
    return m.type;
}
