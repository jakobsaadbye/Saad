namespace dbms.postgres;

// The Postgres driver of db, through libpq (libpq.dll), e.g
//
//     import dbms;
//     import dbms.postgres;
//
//     conn, err := postgres.connect("host=localhost port=5432 dbname=app user=postgres password=secret");
//     if err != "" { fmt.print("Can't connect: %", err); return; }
//
// libpq.dll comes with PostgreSQL, in its bin folder (e.g C:\Program Files\PostgreSQL\16\bin), together with
// the DLLs it needs. The program finds it when that folder is in PATH, or when the DLLs are next to it.
// See docs/dbms.md

import dbms;
import mem;

// Connects with a connection string of libpq, e.g "host=localhost dbname=app user=postgres", or a URL like
// "postgresql://postgres@localhost/app". err is empty when it worked
connect :: (connectionString: string) -> dbms.Connection, error {
    conn: dbms.Connection;
    info := connectionString.toCString();
    handle := PQconnectdb(info);
    info.free();

    if handle == null {
        return conn, dbms.databaseError("libpq couldn't make a connection");
    }
    if PQstatus(handle) != ConnectionOk {
        err := message(PQerrorMessage(handle));
        PQfinish(handle);
        return conn, dbms.databaseError(err);
    }

    conn.driver = driver();
    conn.handle = handle;
    return conn, null;
}

// The driver for dbms.Connection
driver :: () -> *dbms.Driver {
    if theDriver == null {
        d := new(dbms.Driver);
        d.name        = "postgres";
        d.execute     = execute;
        d.rowCount    = rowCount;
        d.columnCount = columnCount;
        d.columnName  = columnName;
        d.value       = value;
        d.affected    = affected;
        d.freeResult  = freeResult;
        d.close       = close;
        theDriver = d;
    }
    return theDriver;
}

@private theDriver: *dbms.Driver = null;

@private ConnectionOk    :: 0;
@private ResultCommandOk :: 1;
@private ResultTuplesOk  :: 2;

@private
execute :: (conn: *void, sql: c.string, params: []c.string, err: *string) -> *void {
    values: *c.string = null;
    if params.count > 0 {
        values = params.data;
    }
    result := PQexecParams(conn, sql, params.count as int, null, values, null, null, 0);
    if result == null {
        *err = message(PQerrorMessage(conn));
        return null;
    }
    status := PQresultStatus(result);
    if status != ResultCommandOk && status != ResultTuplesOk {
        *err = message(PQresultErrorMessage(result));
        PQclear(result);
        return null;
    }
    return result;
}

@private rowCount    :: (result: *void) -> i64 { return PQntuples(result) as i64; }
@private columnCount :: (result: *void) -> i64 { return PQnfields(result) as i64; }
@private columnName  :: (result: *void, column: i64) -> c.string { return PQfname(result, column as int); }
@private freeResult  :: (result: *void) { PQclear(result); }
@private close       :: (conn: *void) { PQfinish(conn); }

@private
value :: (result: *void, row: i64, column: i64) -> c.string {
    if PQgetisnull(result, row as int, column as int) != 0 {
        return c.string{};   // NULL
    }
    return PQgetvalue(result, row as int, column as int);
}

@private
affected :: (result: *void) -> i64 {
    text := PQcmdTuples(result).toString();
    n: i64 = 0;
    for i in 0..text.len {
        if text[i] < '0' || text[i] > '9' { break; }
        n = n * 10 + (text[i] - '0') as i64;
    }
    return n;
}

// A copy of an error message of libpq, without the line break at its end
@private
message :: (text: c.string) -> string {
    if text.isNull() {
        return "Unknown error";
    }
    s := text.toString();
    while s.len > 0 && (s[s.len - 1] == '\n' || s[s.len - 1] == ' ') {
        s.len -= 1;
    }
    if s.len == 0 {
        return "Unknown error";
    }
    return s.copy();
}

extern "libpq.dll" {
    PQconnectdb          :: (conninfo: c.string) -> *void;
    PQstatus             :: (conn: *void) -> int;
    PQerrorMessage       :: (conn: *void) -> c.string;
    PQfinish             :: (conn: *void);
    PQexecParams         :: (conn: *void, command: c.string, nParams: int, paramTypes: *u32, paramValues: *c.string, paramLengths: *int, paramFormats: *int, resultFormat: int) -> *void;
    PQresultStatus       :: (result: *void) -> int;
    PQresultErrorMessage :: (result: *void) -> c.string;
    PQntuples            :: (result: *void) -> int;
    PQnfields            :: (result: *void) -> int;
    PQfname              :: (result: *void, column: int) -> c.string;
    PQgetvalue           :: (result: *void, row: int, column: int) -> c.string;
    PQgetisnull          :: (result: *void, row: int, column: int) -> int;
    PQcmdTuples          :: (result: *void) -> c.string;
    PQclear              :: (result: *void);
}
