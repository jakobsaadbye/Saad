namespace dbms.postgres;

// The Postgres driver of db, through libpq (libpq.dll), e.g
//
//     import dbms;
//     import dbms.postgres;
//
//     conn, err := postgres.connect("host=localhost port=5432 dbname=app user=postgres password=secret");
//     if err != "" { fmt.print("Can't connect: %", err); return; }
//
// libpq.dll comes with PostgreSQL, in its bin folder (e.g C:\Program Files\PostgreSQL\16\bin), together with
// the DLLs it needs. The program finds it when that folder is in PATH, or when the DLLs are next to it.
// See docs/dbms.md

import dbms;
import mem;

// Connects with a connection string of libpq, e.g "host=localhost dbname=app user=postgres", or a URL like
// "postgresql://postgres@localhost/app". err is empty when it worked
connect :: (connectionString: string) -> dbms.Connection, error {
    conn: dbms.Connection;
    info := connectionString.toCString();
    handle := PQconnectdb(info);
    info.free();

    if handle == null {
        return conn, dbms.databaseError("libpq couldn't make a connection");
    }
    if PQstatus(handle) != ConnectionOk {
        err := message(PQerrorMessage(handle));
        PQfinish(handle);
        return conn, dbms.databaseError(err);
    }

    conn.driver = handle;   // A *PGconn is a dbms.Driver, by its methods below
    return conn, null;
}

// The connection and the result of libpq. Only libpq knows what is in them, so they are only used through pointers. A
// *PGconn is a dbms.Driver, and a *PGresult a dbms.Rows, by their methods
PGconn   :: struct {}
PGresult :: struct {}

@private ConnectionOk    :: 0;
@private ResultCommandOk :: 1;
@private ResultTuplesOk  :: 2;

// Runs the SQL with the arguments as text parameters
execute :: method (conn: *PGconn, sql: string, args: []any, err: *string) -> dbms.Rows {
    params, failed := dbms.textParams(args);
    if failed != "" {
        *err = failed;
        return null;
    }
    values: *c.string = null;
    if params.count > 0 {
        values = params.data;
    }
    query := sql.toCString();
    result := PQexecParams(conn, query, params.count as int, null, values, null, null, 0);
    query.free();
    dbms.freeTextParams(&params);
    if result == null {
        *err = message(PQerrorMessage(conn));
        return null;
    }
    status := PQresultStatus(result);
    if status != ResultCommandOk && status != ResultTuplesOk {
        *err = message(PQresultErrorMessage(result));
        PQclear(result);
        return null;
    }
    return result;
}

close :: method (conn: *PGconn) { PQfinish(conn); }

count      :: method (result: *PGresult) -> i64 { return PQntuples(result) as i64; }
columns    :: method (result: *PGresult) -> i64 { return PQnfields(result) as i64; }
columnName :: method (result: *PGresult, column: i64) -> c.string { return PQfname(result, column as int); }
free       :: method (result: *PGresult) { PQclear(result); }

value :: method (result: *PGresult, row: i64, column: i64) -> c.string {
    if PQgetisnull(result, row as int, column as int) != 0 {
        return c.string{};   // NULL
    }
    return PQgetvalue(result, row as int, column as int);
}

text :: method (result: *PGresult, row: i64, column: i64) -> string {
    t: string;
    t.data = PQgetvalue(result, row as int, column as int).data;
    t.len  = PQgetlength(result, row as int, column as int) as i64;
    return t;
}

// libpq gives every value as text
integer :: method (result: *PGresult, row: i64, column: i64, value: *i64) -> bool { return false; }

affected :: method (result: *PGresult) -> i64 {
    text := PQcmdTuples(result).toString();
    n: i64 = 0;
    for i in 0..text.len {
        if text[i] < '0' || text[i] > '9' { break; }
        n = n * 10 + (text[i] - '0') as i64;
    }
    return n;
}

// A copy of an error message of libpq, without the line break at its end
@private
message :: (text: c.string) -> string {
    if text.isNull() {
        return "Unknown error";
    }
    s := text.toString();
    while s.len > 0 && (s[s.len - 1] == '\n' || s[s.len - 1] == ' ') {
        s.len -= 1;
    }
    if s.len == 0 {
        return "Unknown error";
    }
    return s.copy();
}

extern "libpq.dll" {
    PQconnectdb          :: (conninfo: c.string) -> *PGconn;
    PQstatus             :: (conn: *PGconn) -> int;
    PQerrorMessage       :: (conn: *PGconn) -> c.string;
    PQfinish             :: (conn: *PGconn);
    PQexecParams         :: (conn: *PGconn, command: c.string, nParams: int, paramTypes: *u32, paramValues: *c.string, paramLengths: *int, paramFormats: *int, resultFormat: int) -> *PGresult;
    PQresultStatus       :: (result: *PGresult) -> int;
    PQresultErrorMessage :: (result: *PGresult) -> c.string;
    PQntuples            :: (result: *PGresult) -> int;
    PQnfields            :: (result: *PGresult) -> int;
    PQfname              :: (result: *PGresult, column: int) -> c.string;
    PQgetvalue           :: (result: *PGresult, row: int, column: int) -> c.string;
    PQgetlength          :: (result: *PGresult, row: int, column: int) -> int;
    PQgetisnull          :: (result: *PGresult, row: int, column: int) -> int;
    PQcmdTuples          :: (result: *PGresult) -> c.string;
    PQclear              :: (result: *PGresult);
}
