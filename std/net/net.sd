namespace net;

// TCP over IPv4: a server listens and accepts connections, a client dials one, e.g
//
//     listener := net.listen(":8080");          // Thrown when the port is in use
//     defer listener.close();
//     while true {
//         conn := listener.accept();
//         buffer: [4096]u8;
//         n, err := conn.read(buffer);          // err is of the kind net.Closed when the other end closed
//         conn.write("hello\n");
//         conn.close();
//     }
//
//     conn := net.dial("example.com:80");
//     conn.startTls("example.com");             // TLS, e.g for https (tls.sd)
//
// Winsock (ws2_32.dll) on Windows and BSD sockets on Linux, through their typed bindings in net.sys. Errors are of the
// kinds net.Timeout, net.Closed, net.Refused, net.InUse and net.NetError

use c;
import fmt;
import thread;
import net.sys;
import mem;
import errors;

Timeout  :: ErrorKind{"net.Timeout"};   // A read or a write took longer than its timeout
Closed   :: ErrorKind{"net.Closed"};    // The other end closed the connection, or it was reset
Refused  :: ErrorKind{"net.Refused"};   // Nothing listens at the address
InUse    :: ErrorKind{"net.InUse"};     // Something else listens at the port
NetError :: ErrorKind{"net.Error"};     // Any other failure, e.g a name that can't be resolved

//
// Errors
//

// The error of the last call that failed, with what was being done, e.g "connect to 127.0.0.1:80"
lastError :: (what: string) -> error {
    #if OS == .windows {
        code := sys.WSAGetLastError();
        kind := switch code {
            case sys.WsaeTimedOut => Timeout;
            case sys.WsaeConnReset
            case sys.WsaeConnAborted => Closed;
            case sys.WsaeConnRefused => Refused;
            case sys.WsaeAddrInUse => InUse;
            else => NetError;
        };
        return errors.make("%: Winsock error %", what, code, kind: kind);
    } else {
        code := *sys.__errno_location();
        kind := switch code {
            case sys.Eagain => Timeout;
            case sys.EconnReset
            case sys.Epipe => Closed;
            case sys.EconnRefused => Refused;
            case sys.EaddrInUse => InUse;
            else => NetError;
        };
        return errors.make("%: %", what, sys.strerror(code).toString(), kind: kind);
    }
}

// Winsock is started once, before the first socket
started := false;
startMutex: thread.Mutex;

startup :: () -> error {
    #if OS == .windows {
        startMutex.lock();
        defer startMutex.unlock();
        if started { return null; }
        data: sys.WsaData;
        code := sys.WSAStartup(0x0202, &data);   // Version 2.2
        if code != 0 { return errors.make("Winsock couldn't start: error %", code, kind: NetError); }
        started = true;
    }
    return null;
}

//
// Addresses
//

// An IPv4 address and a port, e.g 127.0.0.1:8080
Addr :: struct {
    ip:   [4]u8;
    port: int;
}

toString :: method (a: *Addr) -> string {
    return fmt.sprint("%.%.%.%:%", a.ip[0], a.ip[1], a.ip[2], a.ip[3], a.port);
}

toSockAddr :: method (a: *Addr) -> sys.SockAddrIn {
    address: sys.SockAddrIn;
    address.family = sys.AfInet;
    address.port   = sys.toNetwork(a.port as u16);
    address.addr   = a.ip;
    return address;
}

fromSockAddr :: (address: *sys.SockAddrIn) -> Addr {
    a: Addr;
    a.ip   = address.addr;
    a.port = sys.fromNetwork(address.port) as int;
    return a;
}

// Splits "host:port" into its host and port. The host can be empty, e.g ":8080" for every address of the computer
splitHostPort :: (address: string) -> string, int, error {
    colon := -1;
    for ch, i in address {
        if ch == ':' { colon = i as int; }
    }
    if colon < 0 {
        return "", 0, errors.make("'%' has no port, e.g localhost:8080", address, kind: NetError);
    }
    host := address.slice(0, colon);
    portText := address.slice(colon + 1);
    if portText.len == 0 {
        return "", 0, errors.make("'%' has no port, e.g localhost:8080", address, kind: NetError);
    }
    port := 0;
    for ch in portText {
        if !ch.isDigit() { return "", 0, errors.make("The port of '%' isn't a number", address, kind: NetError); }
        port = port * 10 + ch.digitValue();
        if port > 65535 { return "", 0, errors.make("The port of '%' is above 65535", address, kind: NetError); }
    }
    return host, port, null;
}

// The IPv4 address of a host, e.g "localhost", "127.0.0.1" or "example.com". An empty host is every address (0.0.0.0)
resolve :: (host: string, port: int) -> Addr, error {
    result: Addr;
    result.port = port;
    if host == "" { return result, null; }   // 0.0.0.0

    err := startup();
    if err != null { return result, err; }

    hints: sys.AddrInfo;
    hints.family   = sys.AfInet;
    hints.socktype = sys.SockStream;
    found: *sys.AddrInfo;
    name := host.toCString();
    defer name.free();
    code := sys.getaddrinfo(name, c.string{}, &hints, &found);
    if code != 0 || found == null {
        #if OS == .windows {
            return result, errors.make("The address of '%' couldn't be found: error %", host, code, kind: NetError);
        } else {
            return result, errors.make("The address of '%' couldn't be found: %", host, sys.gai_strerror(code).toString(), kind: NetError);
        }
    }
    result.ip = found.addr.addr;
    sys.freeaddrinfo(found);
    return result, null;
}

//
// Listener
//

// A socket that accepts connections
Listener :: struct {
    socket: sys.Socket;
    addr:   Addr;    // Where it listens, with the port the system chose for port 0
}

// Listens at "host:port", e.g ":8080", "127.0.0.1:8080", or ":0" for a port the system chooses (listener.addr.port).
// backlog is how many connections may wait to be accepted (the system caps it). With reusePort, other sockets, e.g of
// other processes, can listen at the same port too, and the system shares the connections between them (Linux)
listen :: (address: string, backlog := 1024, reusePort := false) -> *Listener, error {
    host, port, err := splitHostPort(address);
    if err != null { return null, err; }
    addr: Addr;
    addr, err = resolve(host, port);
    if err != null { return null, err; }
    err = startup();
    if err != null { return null, err; }

    s := sys.socket(sys.AfInet, sys.SockStream, sys.IpprotoTcp);
    if s == sys.InvalidSocket { return null, lastError("socket"); }

    // A port that was just used can be listened at again right away
    yes: sys.OptionValue = 1;
    sys.setsockopt(s, sys.SolSocket, sys.SoReuseAddr, (&yes) as *u8, sizeof(sys.OptionValue) as sys.AddrLength);
    #if OS != .windows {
        if reusePort { sys.setsockopt(s, sys.SolSocket, sys.SoReusePort, (&yes) as *u8, sizeof(sys.OptionValue) as sys.AddrLength); }
    }

    sockAddr := addr.toSockAddr();
    if sys.bind(s, &sockAddr, sys.addrLength()) != 0 || sys.listen(s, backlog as i32) != 0 {
        failed := lastError(fmt.sprint("listen at %", address));
        sys.closeSocket(s);
        return null, failed;
    }

    // The port the system chose for port 0
    bound: sys.SockAddrIn;
    length := sys.addrLength();
    sys.getsockname(s, &bound, &length);

    listener := new(Listener, mem.heap());   // It lives longer than a request
    listener.socket = s;
    listener.addr   = fromSockAddr(&bound);
    return listener, null;
}

// Waits for a connection. After close(), it gives an error of the kind net.Closed
accept :: method (listener: *Listener) -> *Conn, error {
    remote: sys.SockAddrIn;
    length := sys.addrLength();
    s := sys.accept(listener.socket, &remote, &length);
    if s == sys.InvalidSocket {
        if listener.socket == sys.InvalidSocket {
            return null, errors.make("The listener is closed", kind: Closed);
        }
        return null, lastError("accept");
    }
    conn := new(Conn, mem.heap());
    conn.socket = s;
    conn.remote = fromSockAddr(&remote);
    return conn, null;
}

// Accepts a connection that waits, on a listener made non-blocking. null, without an error, when none waits. The
// connection is non-blocking too
tryAccept :: method (listener: *Listener) -> *Conn, error {
    remote: sys.SockAddrIn;
    length := sys.addrLength();
    #if OS == .windows {
        s := sys.accept(listener.socket, &remote, &length);
        if s == sys.InvalidSocket {
            if sys.WSAGetLastError() == sys.WsaeWouldBlock { return null, null; }
            return null, lastError("accept");
        }
        setNonBlocking(s);
    } else {
        s := sys.accept4(listener.socket, &remote, &length, sys.SockNonBlock | sys.SockCloexec);
        if s == sys.InvalidSocket {
            code := *sys.__errno_location();
            if code == sys.Eagain || code == sys.Eintr { return null, null; }
            return null, lastError("accept");
        }
    }
    conn := new(Conn, mem.heap());
    conn.socket = s;
    conn.remote = fromSockAddr(&remote);
    return conn, null;
}

// Makes accept on the listener give null instead of waiting, see tryAccept
setNonBlocking :: method (listener: *Listener) {
    setNonBlocking(listener.socket);
}

// Stops listening. An accept() that waits gives an error of the kind net.Closed
close :: method (listener: *Listener) {
    s := listener.socket;
    if s == sys.InvalidSocket { return; }
    listener.socket = sys.InvalidSocket;
    sys.shutdown(s, sys.ShutdownBoth);   // Wakes an accept() that waits, on Linux
    sys.closeSocket(s);
}

//
// Poll: waits until one of many sockets can be read, e.g for a server that keeps many connections open
//
//     p: net.Poll;
//     p.add(listener.socket);
//     p.add(conn.socket);
//     n := p.wait(1000);          // Milliseconds, -1 for ever. 0 when the time was up
//     if p.ready(1) { ... }       // conn has something to read, or was closed
//

Poll :: struct {
    fds: [..]sys.PollFd;
}

add :: method (p: *Poll, socket: sys.Socket) {
    p.fds.add(sys.PollFd{socket: socket, events: sys.PollIn});
}

clear :: method (p: *Poll) {
    p.fds.clear();
}

free :: method (p: *Poll) {
    p.fds.free();
}

// Waits until a socket can be read, and gives how many can
wait :: method (p: *Poll, milliseconds: int) -> int, error {
    if p.fds.count == 0 {
        if milliseconds > 0 { thread.sleep(milliseconds); }
        return 0, null;
    }
    #if OS == .windows {
        n := sys.WSAPoll(p.fds.data, p.fds.count as u32, milliseconds as i32) as int;
    } else {
        n := sys.poll(p.fds.data, p.fds.count as u64, milliseconds as i32) as int;
    }
    if n < 0 { return 0, lastError("poll"); }
    return n, null;
}

// If the socket at the index can be read, or was closed, after wait()
ready :: method (p: *Poll, index: int) -> bool {
    return (p.fds[index].revents & sys.PollDone) != 0;
}

//
// Conn
//

// A TCP connection
Conn :: struct {
    socket: sys.Socket;
    remote: Addr;    // The other end
    tls:    *void;   // The TLS of OpenSSL, after startTls (tls.sd)
}

// Connects to "host:port", e.g "example.com:80". An empty host is this computer
dial :: (address: string) -> *Conn, error {
    host, port, err := splitHostPort(address);
    if err != null { return null, err; }
    if host == "" { host = "127.0.0.1"; }
    addr: Addr;
    addr, err = resolve(host, port);
    if err != null { return null, err; }

    s := sys.socket(sys.AfInet, sys.SockStream, sys.IpprotoTcp);
    if s == sys.InvalidSocket { return null, lastError("socket"); }
    sockAddr := addr.toSockAddr();
    if sys.connect(s, &sockAddr, sys.addrLength()) != 0 {
        failed := lastError(fmt.sprint("connect to %", address));
        sys.closeSocket(s);
        return null, failed;
    }
    conn := new(Conn, mem.heap());
    conn.socket = s;
    conn.remote = addr;
    return conn, null;
}

// Reads what has come, at most buffer.count bytes. n is 0 with an error of the kind net.Closed when the other end
// closed the connection, and net.Timeout after the read timeout
read :: method (conn: *Conn, buffer: []u8) -> int, error {
    if buffer.count == 0 { return 0, null; }
    if conn.tls != null { return readTls(conn, buffer); }
    n := sys.recv(conn.socket, buffer.data, buffer.count as sys.Length, 0) as int;
    if n == 0 { return 0, errors.make("The connection was closed", kind: Closed); }
    if n < 0  { return 0, lastError("read"); }
    return n, null;
}

// Writes all of the bytes
write :: method (conn: *Conn, data: string) -> error {
    if conn.tls != null { return writeTls(conn, data); }
    sent := 0;
    while sent < data.len {
        n := sys.send(conn.socket, &data.data[sent], (data.len - sent) as sys.Length, sys.SendFlags) as int;
        if n <= 0 { return lastError("write"); }
        sent += n;
    }
    return null;
}

// Reads what has come, on a non-blocking connection: 0 without an error when nothing has come yet. 0 with an error of
// the kind net.Closed when the other end closed it
tryRead :: method (conn: *Conn, buffer: []u8) -> int, error {
    if buffer.count == 0 { return 0, null; }
    n := sys.recv(conn.socket, buffer.data, buffer.count as sys.Length, 0) as int;
    if n > 0 { return n, null; }
    if n == 0 { return 0, errors.make("The connection was closed", kind: Closed); }
    if wouldBlock() { return 0, null; }
    return 0, lastError("read");
}

// Writes what the connection takes now, on a non-blocking connection, and gives how many bytes that was: fewer than
// all, maybe 0, when the system's buffer of the connection is full. Write the rest when it is writable (Poller)
tryWrite :: method (conn: *Conn, data: string) -> int, error {
    sent := 0;
    while sent < data.len {
        n := sys.send(conn.socket, &data.data[sent], (data.len - sent) as sys.Length, sys.SendFlags) as int;
        if n <= 0 {
            if n < 0 && wouldBlock() { return sent, null; }
            return sent, lastError("write");
        }
        sent += n;
    }
    return sent, null;
}

// Makes reads and writes give what they can at once instead of waiting, see tryRead and tryWrite
setNonBlocking :: method (conn: *Conn) {
    setNonBlocking(conn.socket);
}

// Sends small writes at once instead of waiting to put them together (TCP_NODELAY), e.g for the responses of a server
setNoDelay :: method (conn: *Conn) {
    yes: sys.OptionValue = 1;
    sys.setsockopt(conn.socket, sys.IpprotoTcp, sys.TcpNoDelay, (&yes) as *u8, sizeof(sys.OptionValue) as sys.AddrLength);
}

setNonBlocking :: (s: sys.Socket) {
    #if OS == .windows {
        yes: u32 = 1;
        sys.ioctlsocket(s, sys.FionBio as i32, &yes);
    } else {
        yes: i32 = 1;
        sys.ioctl(s, sys.FionBio, &yes);
    }
}

// If the last call failed only because a non-blocking socket had nothing to give or no room
wouldBlock :: () -> bool {
    #if OS == .windows {
        return sys.WSAGetLastError() == sys.WsaeWouldBlock;
    } else {
        code := *sys.__errno_location();
        return code == sys.Eagain || code == sys.Eintr;
    }
}

// Lets the process have as many sockets and files open as the system allows it (Linux), e.g for a server with many
// connections. Gives how many that is
raiseOpenFileLimit :: () -> int {
    #if OS == .windows {
        return 16777216;   // Windows has no such limit for sockets
    } else {
        limit: sys.RLimit;
        if sys.getrlimit(sys.RlimitNofile, &limit) != 0 { return 1024; }
        if limit.current < limit.maximum {
            limit.current = limit.maximum;
            sys.setrlimit(sys.RlimitNofile, &limit);
        }
        return limit.current as int;
    }
}

// A read that waits longer than this gives an error of the kind net.Timeout. 0 waits for ever
setReadTimeout :: method (conn: *Conn, milliseconds: int) {
    setTimeout(conn.socket, sys.SoRcvTimeo, milliseconds);
}

setWriteTimeout :: method (conn: *Conn, milliseconds: int) {
    setTimeout(conn.socket, sys.SoSndTimeo, milliseconds);
}

setTimeout :: (s: sys.Socket, option: i32, milliseconds: int) {
    #if OS == .windows {
        value := milliseconds as u32;   // A DWORD of milliseconds
        sys.setsockopt(s, sys.SolSocket, option, (&value) as *u8, 4);
    } else {
        value: sys.TimeVal;
        value.seconds      = (milliseconds / 1000) as i64;
        value.microseconds = ((milliseconds % 1000) * 1000) as i64;
        sys.setsockopt(s, sys.SolSocket, option, (&value) as *u8, sizeof(sys.TimeVal) as u32);
    }
}

// Closes the connection
close :: method (conn: *Conn) {
    if conn.tls != null { closeTls(conn); }
    if conn.socket != sys.InvalidSocket {
        sys.closeSocket(conn.socket);
        conn.socket = sys.InvalidSocket;
    }
}
