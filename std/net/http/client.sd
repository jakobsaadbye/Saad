namespace net.http;

// The client: a request, and the response to it, e.g
//
//     response := http.get("http://localhost:8080/posts");
//     defer response.free();
//     if response.status == 200 { print(response.body); }
//
//     response = http.post("http://localhost:8080/posts", "application/json", text);
//
// http and https (TLS of net, with OpenSSL). Each request is a connection of its own.
//
// A request goes through the proxy that the environment names, as curl and most tools do: https_proxy (or HTTPS_PROXY)
// for an https url, http_proxy (or HTTP_PROXY) for an http url, but not for the hosts of no_proxy (or NO_PROXY), e.g
// "localhost,.internal.example.com". The proxy is a url, with a user and password when it wants one, e.g
// http://user:secret@proxy.example.com:3128. An https request goes through a tunnel the proxy opens (CONNECT), so it is
// still encrypted all the way to the host; an http request is sent to the proxy with its whole url. useProxies = false
// always connects straight to the host

import net;
import os;
import base64;
import bytes;
import mem;
import allocators;
import fmt;
import errors;

Response :: struct {
    status:     int;           // e.g 200
    statusText: string;        // e.g OK
    version:    string;        // e.g HTTP/1.1
    headers:    [..]Header;
    body:       string;

    arena:     allocators.Arena;      // The memory of the texts, freed by free()
    allocator: Allocator;
}

header :: method (response: *Response, name: string) -> string, bool {
    return findHeader(response.headers, name);
}

free :: method (response: *Response) {
    response.arena.free();
    mem.delete(response);
}

ProtocolError :: ErrorKind{"http.ProtocolError"};   // A url that isn't http, or a response that isn't HTTP

// The parts of an http or https url
Url :: struct {
    host: string;      // e.g localhost
    port: int;         // 80 when it isn't given, or 443 for https
    path: string;      // With the query, e.g /posts?page=2. / when it isn't given
    tls:  bool;        // https
}

// The host, port and path of "http://host[:port][/path]" or "https://host[:port][/path]"
parseUrl :: (url: string) -> Url, error {
    result: Url;
    rest := "";
    if url.startsWith("http://") {
        rest = url.slice(7);
        result.port = 80;
    } else if url.startsWith("https://") {
        rest = url.slice(8);
        result.port = 443;
        result.tls = true;
    } else {
        return result, errors.make("'%' isn't an http url, e.g http://localhost:8080/", url, kind: ProtocolError);
    }
    slash := rest.indexOf("/");
    hostPort := rest;
    result.path = "/";
    if slash >= 0 {
        hostPort = rest.slice(0, slash);
        result.path = rest.slice(slash);
    }
    result.host = hostPort;
    if hostPort.indexOf(":") >= 0 {
        host, port, err := net.splitHostPort(hostPort);
        if err != null { return result, err; }
        result.host = host;
        result.port = port;
    }
    if result.host.len == 0 { return result, errors.make("'%' has no host", url, kind: ProtocolError); }
    return result, null;
}

useProxies := true;        // False to connect straight to the host, whatever the environment says

// The proxy a request to a url goes through, and the value of its Proxy-Authorization header (or ""), from the
// environment. False when it goes straight to the host
proxyFor :: (target: Url) -> Url, string, bool {
    none: Url;
    if !useProxies { return none, "", false; }
    names: []string = ["http_proxy", "HTTP_PROXY"];
    if target.tls { names = ["https_proxy", "HTTPS_PROXY"]; }
    address := "";
    for name in names {
        value, found := os.getEnv(name);
        if found && value.len > 0 {
            address = value;
            break;
        }
    }
    if address.len == 0 { return none, "", false; }
    for name in ["no_proxy", "NO_PROXY"] {
        value, found := os.getEnv(name);
        if found && bypassesProxy(target.host, value) { return none, "", false; }
    }

    // A proxy without a scheme is an http one, e.g proxy.example.com:3128
    if address.indexOf("://") < 0 { address = fmt.sprint("http://%", address); }
    // The user and password, before the host: http://user:secret@host:port
    auth := "";
    scheme := address.indexOf("://") + 3;
    at := address.lastIndexOf("@");
    if at > scheme {
        arena: allocators.Arena;
        defer arena.free();
        auth = fmt.sprint("Basic %", base64.encode(decodeUrl(address.slice(scheme, at), &arena)));
        address = fmt.sprint("%%", address.slice(0, scheme), address.slice(at + 1));
    }
    proxy, err := parseUrl(address);
    if err != null { return none, "", false; }
    return proxy, auth, true;
}

// If a host is one of no_proxy, which is a list of hosts split by commas: a host (and its subdomains), a domain that starts
// with a dot or *. (only its subdomains, and itself), or * for all of them. A port after a host is left out
bypassesProxy :: (host: string, noProxy: string) -> bool {
    rest := noProxy;
    while rest.len > 0 {
        comma := rest.indexOf(",");
        entry := rest;
        if comma >= 0 {
            entry = rest.slice(0, comma);
            rest = rest.slice(comma + 1);
        } else {
            rest = "";
        }
        entry = trimSpaces(entry);
        if entry == "*" { return true; }
        colon := entry.lastIndexOf(":");
        if colon > 0 && entry.indexOf(":") == colon { entry = entry.slice(0, colon); }    // Not of an IPv6 address
        if entry.startsWith("*.") { entry = entry.slice(1); }
        if entry.len == 0 { continue; }
        if entry.startsWith(".") { entry = entry.slice(1); }
        if equalFold(host, entry) { return true; }
        // A subdomain: the host ends in .entry
        if host.len > entry.len && host[host.len - entry.len - 1] == '.' && equalFold(host.slice(host.len - entry.len), entry) { return true; }
    }
    return false;
}

// Asks a proxy for a tunnel to the host of an https url, through which the request then goes, encrypted
@private
openTunnel :: (conn: *net.Conn, target: Url, auth: string) -> error {
    out := fmt.newStringBuilder(256);
    defer out.free();
    out.add("CONNECT %:% HTTP/1.1\r\nHost: %:%\r\n", target.host, target.port, target.host, target.port);
    if auth.len > 0 { out.add("Proxy-Authorization: %\r\n", auth); }
    out.addString("\r\n");
    err := conn.write(out.toString());
    if err != null { return err; }

    arena: allocators.Arena;
    defer arena.free();
    headers: [..]Header;
    headers.allocator = &arena;
    buffer: bytes.Buffer;
    defer buffer.free();
    limits: Limits;
    first, status := readHead(conn, &buffer, &limits, &arena, &headers);
    if status != 0 { return errors.make("the proxy didn't answer CONNECT %:%", target.host, target.port, kind: ProtocolError); }
    // HTTP/1.1 200 Connection established
    space := first.indexOf(" ");
    if space < 0 || !first.startsWith("HTTP/1.") || !first.slice(space + 1).startsWith("2") {
        return errors.make("the proxy refused a tunnel to %:%: %", target.host, target.port, first, kind: ProtocolError);
    }
    return null;
}

get :: (url: string) -> *Response, error {
    return request("GET", url);
}

post :: (url: string, contentType: string, body: string) -> *Response, error {
    headers := [Header{"Content-Type", contentType}];
    return request("POST", url, headers, body);
}

// Sends a request, e.g request("PUT", url, headers, body), and reads the response to it. A response with an error status, e.g 404, isn't an error
request :: (verb: string, url: string, headers: []Header = [], body := "") -> *Response, error {
    parts, err := parseUrl(url);
    if err != null { return null, err; }
    proxy, auth, viaProxy := proxyFor(parts);
    address := fmt.sprint("%:%", parts.host, parts.port);
    if viaProxy { address = fmt.sprint("%:%", proxy.host, proxy.port); }
    conn: *net.Conn;
    conn, err = net.dial(address);
    if err != null { return null, err; }
    defer {
        conn.close();
        mem.delete(conn, mem.heap());
    }
    if viaProxy && parts.tls {
        err = openTunnel(conn, parts, auth);
        if err != null { return null, err; }
    }
    if parts.tls {
        err = conn.startTls(parts.host);
        if err != null { return null, err; }
    }

    out := fmt.newStringBuilder(256 + body.len as int);
    defer out.free();
    // To a proxy (without a tunnel) the whole url, else only the path
    if viaProxy && !parts.tls { out.add("% http://%:%% HTTP/1.1\r\n", verb, parts.host, parts.port, parts.path); }
    else                      { out.add("% % HTTP/1.1\r\n", verb, parts.path); }
    if viaProxy && !parts.tls && auth.len > 0 { out.add("Proxy-Authorization: %\r\n", auth); }
    if parts.port == 80 && !parts.tls || parts.port == 443 && parts.tls { out.add("Host: %\r\n", parts.host); }
    else { out.add("Host: %:%\r\n", parts.host, parts.port); }
    for h in headers { out.add("%: %\r\n", h.name, h.value); }
    if body.len > 0 || verb == "POST" || verb == "PUT" || verb == "PATCH" {
        out.add("Content-Length: %\r\n", body.len);
    }
    out.addString("Connection: close\r\n\r\n");
    out.addString(body);
    err = conn.write(out.toString());
    if err != null { return null, err; }

    response := new(Response);
    response.allocator = &response.arena;
    response.headers.allocator = &response.arena;
    buffer: bytes.Buffer;
    defer buffer.free();
    limits: Limits;

    first, status := readHead(conn, &buffer, &limits, &response.arena, &response.headers);
    if status != 0 {
        response.free();
        return null, errors.make("% %: no response", verb, url, kind: ProtocolError);
    }

    // HTTP/1.1 200 OK
    space := first.indexOf(" ");
    if space <= 0 || !first.startsWith("HTTP/1.") {
        response.free();
        return null, errors.make("% %: the response isn't HTTP: %", verb, url, first, kind: ProtocolError);
    }
    response.version = first.slice(0, space);
    rest := first.slice(space + 1);
    space = rest.indexOf(" ");
    code := rest;
    if space >= 0 {
        code = rest.slice(0, space);
        response.statusText = rest.slice(space + 1);
    }
    response.status = parseCount(code) as int;
    if response.status < 100 || code.len != 3 {
        response.free();
        return null, errors.make("% %: the status of the response isn't a number: %", verb, url, first, kind: ProtocolError);
    }

    // No body for HEAD, 204 and 304
    if verb != "HEAD" && response.status != 204 && response.status != 304 {
        response.body, status = readBody(conn, &buffer, response.headers, &limits, &response.arena, true);
        if status != 0 {
            response.free();
            return null, errors.make("% %: the body of the response couldn't be read", verb, url, kind: ProtocolError);
        }
    }
    return response, null;
}
