namespace net.http;

// The server: a Router routes each request to a handler, and a Server runs the handlers on a pool of threads, e.g
//
//     router: http.Router;
//     router.handle("GET /posts", listPosts);
//     router.handle("GET /posts/{id}", showPost);
//     router.handle("POST /posts", createPost);
//     router.handle("/static/", files);          // Everything below /static/
//     router.handleFiles("/assets/", "public");  // The files of a folder (files.sd)
//     http.listenAndServe(":8080", &router);
//
// A handler that throws gives a 500, and the server goes on. While a handler runs, the allocator of the thread is the
// arena of its request: what it allocates, e.g with new(T), fmt.sprint or a list, is freed after the response. Give
// what lives longer the heap, e.g title.copy(mem.heap()) or list.allocator = mem.heap()

use c;
import net;
import bytes;
import mem;
import allocators;
import fmt;
import io;
import thread;
import time;

Request :: struct {
    method:  string;            // e.g GET
    target:  string;            // As it was written, e.g /posts?page=2
    path:    string;            // e.g /posts
    query:   string;            // After the ?, e.g page=2
    version: string;            // e.g HTTP/1.1
    headers: [..]Header;
    body:    string;
    remote:  net.Addr;          // Who sent it
    pattern: string;            // The pattern of the Router that matched, e.g GET /posts/{id}
    values:  [..]Header;        // The values of the {names} of the pattern
    router:  *Router;           // The router that routed it, and its route
    route:   *Route;
    server:  *Server;           // That answers it

    arena:     allocators.Arena;       // The memory of the request, freed when the handler returned
    allocator: Allocator;
}

// The value of a header, e.g r.header("Content-Type"). Without case
header :: method (r: *Request, name: string) -> string, bool {
    return findHeader(r.headers, name);
}

// The value of a {name} of the pattern, e.g "42" of /posts/42 for /posts/{id}. Empty when there is none
pathValue :: method (r: *Request, name: string) -> string {
    for v in r.values {
        if v.name == name { return v.value; }
    }
    return "";
}

// A value of the query, e.g r.queryValue("page") of /posts?page=2, with %XX and + decoded
queryValue :: method (r: *Request, name: string) -> string, bool {
    return findValue(r.query, name, &r.arena);
}

// What a handler answers with. It is sent when the handler returns, with its Content-Length
ResponseWriter :: struct {
    status:  int = 200;
    headers: [..]Header;
    body:    bytes.Buffer;
}

// Sets a header, in place of one with the name, e.g w.setHeader("Content-Type", "application/json")
setHeader :: method (w: *ResponseWriter, name: string, value: string) {
    for i in 0..w.headers.count {
        if equalFold(w.headers[i].name, name) {
            w.headers[i].value = value;
            return;
        }
    }
    w.headers.add(Header{name, value});
}

// Adds a header, also when there is one with the name, e.g Set-Cookie
addHeader :: method (w: *ResponseWriter, name: string, value: string) {
    w.headers.add(Header{name, value});
}

// The status of the response, e.g 201. It is 200 when it isn't set
writeHeader :: method (w: *ResponseWriter, status: int) {
    w.status = status;
}

// Adds to the body
write :: method (w: *ResponseWriter, text: string) {
    w.body.write(text);
}

// An error status with a text, e.g w.error(404, "no such post")
error :: method (w: *ResponseWriter, status: int, message: string) {
    w.status = status;
    w.setHeader("Content-Type", "text/plain; charset=utf-8");
    w.body.clear();
    w.body.write(message);
    w.body.write("\n");
}

// Sends the client to another url, e.g after a POST
redirect :: method (w: *ResponseWriter, url: string, status := 303) {
    w.status = status;
    w.setHeader("Location", url);
}

// Answers a request
Handler :: (w: *ResponseWriter, r: *Request);

//
// Router: a pattern for each handler
//

Route :: struct {
    pattern:  string;          // As it was given
    method:   string;          // Empty for any. GET also matches HEAD
    segments: [..]string;      // Of the path, e.g ["posts", "{id}"]
    prefix:   bool;            // The pattern ends with /, so it matches every path below it
    handler:  Handler;
    folder:   string;          // Of handleFiles: the folder of the files below the prefix
}

Router :: struct {
    routes:   [..]Route;
    notFound: Handler;   // When no route matches. A 404 when it is null
}

// Adds a route: "[METHOD ]/path", where a segment {name} matches any segment, e.g "GET /posts/{id}", and a path that
// ends with / matches every path below it, e.g "/static/". "/" matches every path, and "/{$}" only / itself. When more patterns match, the one
// with the most segments that are written out wins
handle :: method (router: *Router, pattern: string, handler: Handler) {
    route: Route;
    route.pattern = pattern;
    route.handler = handler;
    path := pattern;
    space := pattern.indexOf(" ");
    if space >= 0 {
        route.method = pattern.slice(0, space);
        path = trimSpaces(pattern.slice(space + 1));
    }
    assert(path.startsWith("/"));   // A pattern is a path that starts with /, e.g "GET /posts"
    route.prefix = path.endsWith("/");
    if path.endsWith("/{$}") {      // Only the path itself, e.g "GET /{$}" is / and nothing below it
        path = path.slice(0, path.len - 3);
        route.prefix = false;
    }
    for segment in path.split("/") {
        if segment.len > 0 { route.segments.add(segment); }
    }
    router.routes.add(route);
}

// The route for the request, with the values of its {names}. A 404 or 405 when there is none
serve :: method (router: *Router, w: *ResponseWriter, r: *Request) {
    segments: [..]string;
    segments.allocator = r.allocator;
    for segment in r.path.split("/") {
        if segment.len > 0 { segments.add(segment); }
    }

    best := -1;
    bestScore := -1;
    pathMatched := false;
    allowed: [..]string;
    allowed.allocator = r.allocator;
    for route, i in router.routes {
        score := matchScore(&route, segments);
        if score < 0 { continue; }
        methodMatches := route.method.len == 0 || route.method == r.method || (route.method == "GET" && r.method == "HEAD");
        if !methodMatches {
            pathMatched = true;
            if !allowed.contains(route.method) { allowed.add(route.method); }
            continue;
        }
        if route.method.len > 0 { score += 1; }   // A route with a method wins over one without
        if score > bestScore {
            best = i as int;
            bestScore = score;
        }
    }

    if best < 0 {
        if pathMatched {
            allow := fmt.newStringBuilder(32);
            for m, i in allowed {
                if i > 0 { allow.addString(", "); }
                allow.addString(m);
            }
            w.setHeader("Allow", keep(allow.toString(), &r.arena));
            allow.free();
            w.error(405, "Method Not Allowed");
            return;
        }
        if router.notFound != null { router.notFound(w, r); return; }
        w.error(404, "Not Found");
        return;
    }

    route := &router.routes[best];
    r.pattern = route.pattern;
    r.router = router;
    r.route = route;
    r.values.allocator = r.allocator;
    for segment, i in route.segments {
        if segment.startsWith("{") && segment.endsWith("}") {
            name := segment.slice(1, segment.len - 1);
            r.values.add(Header{name, decodeUrl(segments[i], &r.arena)});
        }
    }
    route.handler(w, r);
}

// How well the route matches the segments of a path: the number of segments that are written out, times 2, and 1000
// more for a match of the whole path. -1 when it doesn't match
matchScore :: (route: *Route, segments: []string) -> int {
    if route.segments.count > segments.count { return -1; }
    if !route.prefix && route.segments.count != segments.count { return -1; }
    score := 0;
    for pattern, i in route.segments {
        if pattern.startsWith("{") && pattern.endsWith("}") { continue; }
        if pattern != segments[i] { return -1; }
        score += 2;
    }
    if !route.prefix { score += 1000; }
    return score;
}

//
// Server
//

Server :: struct {
    router:       *Router;       // Routes the requests. Or handler, for one handler of every request
    handler:      Handler;
    workers:      int;           // Threads, each with an event loop of its own connections. 0 is 2 for each processor, at least 4
    readTimeout:  int = 30000;   // Milliseconds for the rest of a request that has started to come
    writeTimeout: int = 30000;   // Milliseconds for a response that the client doesn't take
    idleTimeout:  int = 60000;   // Milliseconds a kept alive connection may wait for its next request
    limits:       Limits;
    log:          bool = true;   // Writes the errors of handlers to stderr
    reusePort:    bool;          // Other processes may listen at the port too, and the system shares the connections (Linux)
    maxConnections: int;         // Of each worker. When it has as many, it accepts no more until one closes. 0 is what the
                                 // open files of the process allow

    listener: *net.Listener;
    mutex:    thread.Mutex;
    stopping: bool;
    wake:     *net.Conn;         // A byte written to it wakes every loop, for shutdown
    woken:    *net.Conn;         // The other end, which every loop waits for
    loops:    [..]*Loop;
    threads:  [..]thread.Thread;
}

// A worker: a thread that waits for its connections with a Poller and answers the requests that come on them, one
// after the other. Its request and response are used again for every request.
//
// The responses of a round of events are written after all of its requests are answered: writing to a socket runs the
// network stack of the system, which takes the caches of the processor from the handlers, e.g from a database. So the
// handlers of a round run one after the other, then the responses are written one after the other
Loop :: struct {
    server:      *Server;
    poller:      *net.Poller;
    connections: [..]*Connection;   // Open, for the timeouts
    closed:      [..]*Connection;   // Closed while the events were handled, freed after them
    input:       bytes.Buffer;      // What has come on the connection that is read, while its requests are answered
    out:         fmt.StringBuilder; // The responses of this round of events, written by sendAll after them
    sends:       [..]Send;          // The part of out that is for each connection
    request:     Request;
    response:    ResponseWriter;
    accepting:   bool;
    stopping:    bool;              // As of the last wait: the requests that come now are answered with Connection: close
    now:         i64;               // Milliseconds, as of the last wait
    limit:       int;               // Of connections
}

// Responses in the out of a loop for a connection: out[start:end]
Send :: struct {
    connection: *Connection;
    start:      int;
    end:        int;
}

// A connection that is kept alive. An idle connection has no buffers: only what came of a request that isn't whole
// yet, and what the client didn't take of a response
Connection :: struct {
    conn:      *net.Conn;
    input:     bytes.Buffer;     // The part of the next request that has come
    output:    bytes.Buffer;     // What the connection didn't take yet. No more requests are answered until it has
    lastUsed:  i64;              // Milliseconds
    index:     int;              // In the connections of its loop
    closing:   bool;             // Closed when its output is written
    continued: bool;             // 100 Continue was sent for the request that is coming
    queued:    bool;             // Has responses in the out of its loop, which are written after this round of events
    open:      bool;
}

// Listens at the address, e.g ":8080", and answers the requests with the routes of the router. Returns when it can't
// listen, or after shutdown()
listenAndServe :: (address: string, router: *Router) -> error {
    server := new(Server, mem.heap());
    server.router = router;
    return server.listenAndServe(address);
}

listenAndServe :: method (server: *Server, address: string) -> error {
    err := server.listen(address);
    if err != null { return err; }
    return server.serve();
}

// Listens at the address. server.listener.addr says where, e.g the port of ":0"
listen :: method (server: *Server, address: string) -> error {
    listener, err := net.listen(address, reusePort: server.reusePort);
    if err != null { return err; }
    server.listener = listener;
    return null;
}

// Accepts connections and answers them, until shutdown(). The workers are threads with an event loop each: a Poller
// (epoll on Linux) waits for their connections, so idle connections, e.g of browsers, cost no thread and almost no
// memory, and a request is answered by the thread that read it, without being handed to another
serve :: method (server: *Server) -> error {
    assert(server.listener != null);   // listen() first
    server.loops.allocator   = mem.heap();
    server.threads.allocator = mem.heap();
    files := net.raiseOpenFileLimit();
    server.listener.setNonBlocking();

    // A connection to itself, which shutdown() writes a byte to
    wakeListener, err := net.listen("127.0.0.1:0");
    if err != null { return err; }
    wake: *net.Conn;
    wake, err = net.dial(wakeListener.addr.toString());
    if err != null { return err; }
    woken: *net.Conn;
    woken, err = wakeListener.accept();
    wakeListener.close();
    if err != null { return err; }
    server.mutex.lock();
    server.wake  = wake;
    server.woken = woken;
    server.mutex.unlock();

    workers := server.workers;
    if workers <= 0 {
        workers = thread.processorCount() * 2;
        if workers < 4 { workers = 4; }
    }
    limit := server.maxConnections;
    if limit <= 0 {
        limit = (files - 64) / workers;
        if limit < 16 { limit = 16; }
    }
    for i in 0..workers {
        loop := new(Loop, mem.heap());
        loop.server = server;
        loop.limit  = limit;
        poller, pollErr := net.newPoller();
        if pollErr != null { return pollErr; }
        loop.poller = poller;
        server.loops.add(loop);
    }
    for i in 1..workers {
        t: thread.Thread;
        t, err = thread.spawn(runLoop, server.loops[i]);
        if err != null { return err; }
        server.threads.add(t);
    }
    runLoop(server.loops[0]);   // This thread is a worker too
    for i in 0..server.threads.count { server.threads.indexRef(i).join(); }
    server.threads.clear();
    server.listener.close();   // Connections that come now are refused
    for loop in server.loops { mem.delete(loop, mem.heap()); }
    server.loops.clear();

    server.mutex.lock();
    server.wake = null;   // Under the lock, as shutdown() writes to it
    server.mutex.unlock();
    wake.close();
    woken.close();
    return null;
}

isStopping :: method (server: *Server) -> bool {
    server.mutex.lock();
    stopping := server.stopping;
    server.mutex.unlock();
    return stopping;
}

// Stops listening and accepting. serve() returns when the requests that came are answered. Idle connections are closed
shutdown :: method (server: *Server) {
    server.mutex.lock();
    server.stopping = true;
    if server.wake != null { _ := server.wake.write("x"); }   // Wakes the loops
    server.mutex.unlock();
}

// The event loop of a worker
runLoop :: (loop: *Loop) {
    server := loop.server;
    loop.connections.allocator = mem.heap();
    loop.closed.allocator      = mem.heap();
    loop.input.allocator       = mem.heap();
    loop.out.allocator         = mem.heap();
    loop.sends.allocator       = mem.heap();
    loop.response.body.allocator = mem.heap();   // Kept for the next request, so not in its arena
    loop.poller.add(server.listener.socket, server.listener as *void, exclusive: true);
    loop.poller.add(server.woken.socket, server.woken as *void);
    loop.accepting = true;
    loop.now = time.now().unixMilli();
    lastSweep := loop.now;

    while !loop.stopping {
        events, err := loop.poller.wait(1000);   // At least once a second, for the timeouts
        if err != null { break; }
        loop.now = time.now().unixMilli();
        loop.stopping = server.isStopping();
        for e in events {
            if e.data == server.listener as *void {
                loop.acceptAll();
                continue;
            }
            if e.data == server.woken as *void { continue; }
            c := e.data as *Connection;
            if !c.open { continue; }
            if e.writable && c.output.available() > 0 { loop.flush(c); }
            if c.open && (e.readable || e.closed) && c.output.available() == 0 { loop.readAndServe(c); }
        }
        loop.sendAll();
        loop.freeClosed();
        if loop.now - lastSweep >= 1000 {
            loop.sweep();
            lastSweep = loop.now;
        }
    }

    // Stopping: the connections are closed
    while loop.connections.count > 0 { loop.closeConnection(loop.connections[loop.connections.count - 1]); }
    loop.freeClosed();
    loop.connections.free();
    loop.closed.free();
    loop.input.free();
    loop.out.free();
    loop.sends.free();
    loop.response.body.free();
    loop.request.arena.free();
    loop.poller.free();
}

// Accepts the connections that wait, up to the limit of the loop
acceptAll :: method (loop: *Loop) {
    server := loop.server;
    for i in 0..256 {
        if loop.connections.count >= loop.limit {
            // Full: the listener isn't waited for until a connection closes
            if loop.accepting {
                loop.poller.remove(server.listener.socket);
                loop.accepting = false;
            }
            return;
        }
        conn, err := server.listener.tryAccept();
        if conn == null { return; }   // None waits, or it failed, e.g no more files: tried again at the next event
        conn.setNoDelay();
        c := new(Connection, mem.heap());
        c.conn = conn;
        c.input.allocator  = mem.heap();
        c.output.allocator = mem.heap();
        c.lastUsed = loop.now;
        c.open = true;
        c.index = loop.connections.count as int;
        loop.connections.add(c);
        if loop.poller.add(conn.socket, c as *void) != null { loop.closeConnection(c); }
    }
}

// Reads what has come on the connection, and answers the requests that are whole
readAndServe :: method (loop: *Loop, c: *Connection) {
    working := &loop.input;
    working.clear();
    if c.input.available() > 0 {
        working.write(c.input.unread());
        c.input.clear();
    }
    ended := false;
    while true {
        space := working.space(16384);
        n, err := c.conn.tryRead(space);
        if err != null { ended = true; break; }
        if n == 0 { break; }   // Nothing more has come
        working.wrote(n);
        if n < space.count || working.available() > loop.server.limits.headBytes + loop.server.limits.bodyBytes { break; }
    }
    c.lastUsed = loop.now;
    loop.serveWhole(c, working);
    if ended && c.open { loop.finish(c); }
}

// Answers the whole requests in the buffer, in order, and keeps the rest for the next read
serveWhole :: method (loop: *Loop, c: *Connection, working: *bytes.Buffer) {
    server := loop.server;
    while c.open && !c.closing && c.output.available() == 0 && working.available() > 0 {
        length, status, expects := requestLength(working.unread(), &server.limits);
        if status != 0 {
            w := &loop.response;
            w.body.clear();
            noHeaders: [..]Header;
            w.headers = noHeaders;
            w.headers.allocator = mem.heap();
            w.error(status, statusText(status));
            w.setHeader("Connection", "close");
            loop.request.method = "GET";
            loop.send(c, w, &loop.request, true);
            w.headers.free();
            working.clear();
            return;
        }
        if length == 0 {
            // Not whole yet. A client that waits for 100 Continue before it sends the body is told to go on
            if expects && !c.continued {
                c.continued = true;
                start := loop.out.cursor;
                loop.out.addString("HTTP/1.1 100 Continue\r\n\r\n");
                loop.queue(c, start);
            }
            break;
        }
        c.continued = false;
        loop.serveOne(c, working);
    }
    if c.open && working.available() > 0 {
        c.input.write(working.unread());
    } else if c.input.available() == 0 {
        c.input.free();   // An idle connection keeps no buffer
    }
    working.clear();
}

// Answers the request at the start of the buffer, which is whole
serveOne :: method (loop: *Loop, c: *Connection, working: *bytes.Buffer) {
    server := loop.server;
    r := &loop.request;
    w := &loop.response;
    r.arena.clear();
    *r = Request{arena: r.arena};
    r.allocator = &r.arena;
    r.headers.allocator = &r.arena;
    r.remote = c.conn.remote;
    r.server = server;

    w.body.clear();
    noHeaders: [..]Header;
    w.headers = noHeaders;
    w.headers.allocator = r.allocator;
    w.status = 200;

    status := readRequest(null, working, &server.limits, r);
    if status != 0 {
        w.error(status, statusText(status));
        w.setHeader("Connection", "close");
        loop.send(c, w, r, true);
        return;
    }

    // What the handler allocates is in the arena of the request, unless it says otherwise, e.g mem.heap()
    previous := mem.setAllocator(r.allocator);
    try {
        if server.handler != null      { server.handler(w, r); }
        else if server.router != null  { server.router.serve(w, r); }
        else                           { w.error(404, "Not Found"); }
    } catch (err) {
        if server.log {
            io.writeError(fmt.sprint("http: % % failed: %\n", r.method, r.target, err.message));
        }
        w.headers.clear();
        w.error(500, "Internal Server Error");
    }
    mem.setAllocator(previous);

    close := wantsClose(r) || loop.stopping;
    if close { w.setHeader("Connection", "close"); }
    loop.send(c, w, r, close);
}

// Sends the response, after the other requests of this round of events are answered (sendAll)
send :: method (loop: *Loop, c: *Connection, w: *ResponseWriter, r: *Request, close: bool) {
    start := loop.out.cursor;
    writeResponse(&loop.out, w, r);
    loop.queue(c, start);
    if close { c.closing = true; }
    c.lastUsed = loop.now;
    // A round with many big responses doesn't hold all of them
    if loop.out.cursor >= SendAllAt { loop.sendAll(); }
}

// The bytes of responses after which they are written, also when the round of events isn't over
SendAllAt :: 1048576;

// Gives the connection what out has from start on, which is written by sendAll
queue :: method (loop: *Loop, c: *Connection, start: int) {
    last := loop.sends.count - 1;
    if last >= 0 && loop.sends[last].connection == c {
        loop.sends.indexRef(last).end = loop.out.cursor;   // e.g pipelined requests: one write for all
        return;
    }
    loop.sends.add(Send{connection: c, start: start, end: loop.out.cursor});
    c.queued = true;
}

// Writes the responses of the round. What a connection doesn't take now is kept and written when it is writable
sendAll :: method (loop: *Loop) {
    all := loop.out.toString();
    for s in loop.sends {
        c := s.connection;
        c.queued = false;
        if !c.open { continue; }
        text := all.slice(s.start, s.end);
        if c.output.available() > 0 {
            c.output.write(text);   // After what it hasn't taken yet
            continue;
        }
        sent, err := c.conn.tryWrite(text);
        if err != null {
            loop.closeConnection(c);
            continue;
        }
        if sent < text.len {
            c.output.write(text.slice(sent));
            if loop.poller.modify(c.conn.socket, c as *void, write: true) != null { loop.closeConnection(c); }
            continue;
        }
        if c.closing { loop.closeConnection(c); }
    }
    loop.sends.clear();
    loop.out.clear();
}

// Writes what is left of the responses, when the connection takes more. Then the requests that waited are answered
flush :: method (loop: *Loop, c: *Connection) {
    sent, err := c.conn.tryWrite(c.output.unread());
    if err != null {
        loop.closeConnection(c);
        return;
    }
    c.lastUsed = loop.now;
    c.output.skip(sent);
    if c.output.available() > 0 { return; }
    c.output.free();
    if c.closing {
        loop.closeConnection(c);
        return;
    }
    loop.poller.modify(c.conn.socket, c as *void, write: false);
    if c.input.available() > 0 {
        working := &loop.input;
        working.clear();
        working.write(c.input.unread());
        c.input.clear();
        loop.serveWhole(c, working);
    }
}

// The other end closed: the connection is closed, after what it hasn't taken of the responses
finish :: method (loop: *Loop, c: *Connection) {
    if c.output.available() > 0 || c.queued {
        c.closing = true;
        return;
    }
    loop.closeConnection(c);
}

// Closes connections that waited too long: for the rest of a request, for the client to take a response, or idle
sweep :: method (loop: *Loop) {
    server := loop.server;
    i := 0;
    while i < loop.connections.count {
        c := loop.connections[i];
        waited := loop.now - c.lastUsed;
        late := false;
        if c.output.available() > 0     { late = waited > server.writeTimeout as i64; }
        else if c.input.available() > 0 { late = waited > server.readTimeout as i64; }
        else                            { late = waited > server.idleTimeout as i64; }
        if late { loop.closeConnection(c); }   // The last connection takes its place
        else    { i += 1; }
    }
    loop.freeClosed();
}

closeConnection :: method (loop: *Loop, c: *Connection) {
    if !c.open { return; }
    c.open = false;
    loop.poller.remove(c.conn.socket);
    c.conn.close();
    last := loop.connections[loop.connections.count - 1];
    loop.connections[c.index] = last;
    last.index = c.index;
    loop.connections.count -= 1;
    loop.closed.add(c);   // Freed after the events, which can still point to it
    if !loop.accepting && loop.connections.count < loop.limit {
        loop.poller.add(loop.server.listener.socket, loop.server.listener as *void, exclusive: true);
        loop.accepting = true;
    }
}

freeClosed :: method (loop: *Loop) {
    for c in loop.closed {
        mem.delete(c.conn, mem.heap());
        c.input.free();
        c.output.free();
        mem.delete(c, mem.heap());
    }
    loop.closed.clear();
}

// How many bytes the request at the start of the data has when it is whole: its head and its body. 0 when it isn't
// whole yet, with expects when it waits for 100 Continue. status is what is wrong with it, e.g 431 for a head that is
// too long, or 0
requestLength :: (data: string, limits: *Limits) -> int, int, bool {
    end := data.indexOf("\r\n\r\n");
    if end < 0 {
        if data.len > limits.headBytes { return 0, 431, false; }
        return 0, 0, false;
    }
    headLength := end + 4;
    if headLength > limits.headBytes { return 0, 431, false; }

    // The headers that say how long the body is
    contentLength: i64 = -1;
    chunked := false;
    expects := false;
    rest := data.slice(0, end);
    first := true;
    while rest.len > 0 {
        lineEnd := rest.indexOf("\r\n");
        line := rest;
        if lineEnd >= 0 { line = rest.slice(0, lineEnd); rest = rest.slice(lineEnd + 2); }
        else            { rest = ""; }
        if first { first = false; continue; }   // The request line
        colon := line.indexOf(":");
        if colon <= 0 { continue; }   // readHead says what is wrong with it
        name := line.slice(0, colon);
        value := trimSpaces(line.slice(colon + 1));
        if equalFold(name, "Content-Length") {
            contentLength = parseCount(value);
            if contentLength < 0 { return 0, 400, false; }
        } else if equalFold(name, "Transfer-Encoding") {
            if !equalFold(value, "chunked") { return 0, 501, false; }
            chunked = true;
        } else if equalFold(name, "Expect") {
            expects = equalFold(value, "100-continue");
        }
    }

    if chunked {
        at := headLength;
        total := 0;
        while true {
            lineEnd := data.indexOf("\r\n", at);
            if lineEnd < 0 { return 0, 0, expects; }
            line := data.slice(at, lineEnd);
            semicolon := line.indexOf(";");
            if semicolon >= 0 { line = line.slice(0, semicolon); }
            line = trimSpaces(line);
            if line.len == 0 || line.len > 15 { return 0, 400, false; }
            size := 0;
            for ch in line {
                if !ch.isHexDigit() { return 0, 400, false; }
                size = size * 16 + ch.digitValue();
            }
            total += size;
            if total > limits.bodyBytes { return 0, 413, false; }
            at = lineEnd + 2;
            if size == 0 {
                // The trailer, up to an empty line
                while true {
                    trailerEnd := data.indexOf("\r\n", at);
                    if trailerEnd < 0 { return 0, 0, false; }
                    empty := trailerEnd == at;
                    at = trailerEnd + 2;
                    if empty { return at, 0, false; }
                }
            }
            if data.len < at + size + 2 { return 0, 0, expects; }
            at += size + 2;
        }
    }
    if contentLength > limits.bodyBytes as i64 { return 0, 413, false; }
    if contentLength > 0 {
        whole := headLength + contentLength as int;
        if data.len < whole { return 0, 0, expects; }
        return whole, 0, false;
    }
    return headLength, 0, false;
}

// If the connection ends after this request: HTTP/1.0 without keep-alive, or Connection: close
wantsClose :: (r: *Request) -> bool {
    connection, given := r.header("Connection");
    if given && equalFold(connection, "close") { return true; }
    if r.version == "HTTP/1.0" { return !(given && equalFold(connection, "keep-alive")); }
    return false;
}

// Reads a request: 0 when it worked, Gone when the connection ended, or the status of what was wrong. Without a
// connection, the buffer has all of the request
readRequest :: (conn: *net.Conn, buffer: *bytes.Buffer, limits: *Limits, r: *Request) -> int {
    first, status := readHead(conn, buffer, limits, &r.arena, &r.headers);
    if status != 0 { return status; }

    // METHOD target HTTP/1.1
    space := first.indexOf(" ");
    if space <= 0 { return 400; }
    r.method = first.slice(0, space);
    rest := first.slice(space + 1);
    space = rest.indexOf(" ");
    if space <= 0 { return 400; }
    r.target  = rest.slice(0, space);
    r.version = rest.slice(space + 1);
    if !r.version.startsWith("HTTP/1.") { return 505; }
    if !r.target.startsWith("/") && r.target != "*" { return 400; }

    question := r.target.indexOf("?");
    r.path = r.target;
    if question >= 0 {
        r.path  = r.target.slice(0, question);
        r.query = r.target.slice(question + 1);
    }

    // A client that waits for 100 Continue before it sends the body
    expect, expects := r.header("Expect");
    if conn != null && expects && equalFold(expect, "100-continue") {
        conn.write("HTTP/1.1 100 Continue\r\n\r\n");
    }

    body: string;
    body, status = readBody(conn, buffer, r.headers, limits, &r.arena, false);
    if status != 0 { return status; }
    r.body = body;
    return 0;
}

// Writes the response: the status line, the headers with Content-Length, and the body (not for HEAD)
writeResponse :: (out: *fmt.StringBuilder, w: *ResponseWriter, r: *Request) {
    out.addString("HTTP/1.1 ");
    out.addInt64(w.status as i64);
    out.addChar(' ');
    out.addString(statusText(w.status));
    out.addString("\r\n");
    _, typed := findHeader(w.headers, "Content-Type");
    if !typed && w.body.length > 0 { out.addString("Content-Type: text/plain; charset=utf-8\r\n"); }
    for h in w.headers {
        if equalFold(h.name, "Content-Length") { continue; }
        out.addString(h.name);
        out.addString(": ");
        out.addString(h.value);
        out.addString("\r\n");
    }
    if w.status != 204 && w.status != 304 {
        out.addString("Content-Length: ");
        out.addInt64(w.body.length as i64);
        out.addString("\r\n");
    }
    out.addString("\r\n");
    if r.method != "HEAD" && w.status != 204 && w.status != 304 { out.addString(w.body.toString()); }
}
