namespace c;

// <stdlib.h>

extern "C" {
    malloc  :: (size: int) -> *void;
    calloc  :: (num: int, size: int) -> *void;
    realloc :: (buffer: *void, new_size: int) -> *void;
    free    :: (ptr: *void);
    exit    :: (code: int);
    getenv  :: (name: *u8) -> *u8;
    system  :: (command: *u8) -> int;
}
