namespace c;

// <stdlib.h>

extern "C" {
    malloc  :: (size: int) -> *void;
    calloc  :: (num: int, size: int) -> *void;
    realloc :: (buffer: *void, new_size: int) -> *void;
    free    :: (ptr: *void);
    exit    :: (code: int);
    getenv  :: (name: c.string) -> c.string;
    system  :: (command: c.string) -> int;
    strtod  :: (str: c.string, end: *c.string) -> f64;
}
