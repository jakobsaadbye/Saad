namespace c;

// <stdio.h>. A FILE is opaque, so it is a *void

SeekSet :: 0;
SeekCur :: 1;
SeekEnd :: 2;

extern "C" {
    printf  :: (format: *u8, args: ...any) -> int;
    sprintf :: (buffer: *u8, format: *u8, args: ...any) -> int;
    puts    :: (str: *u8) -> int;

    fopen   :: (path: *u8, mode: *u8) -> *void;
    fclose  :: (file: *void) -> int;
    fread   :: (buffer: *void, size: i64, count: i64, file: *void) -> i64;
    fwrite  :: (buffer: *void, size: i64, count: i64, file: *void) -> i64;
    fflush  :: (file: *void) -> int;
    fseek   :: (file: *void, offset: i32, origin: int) -> int;
    ftell   :: (file: *void) -> i32;

    // Runs a command and gives a FILE to read its output from (mode "rb"), or to write its input to (mode "wb").
    // _pclose waits for it to end and returns its exit code. These are the Windows names of popen and pclose
    _popen  :: (command: *u8, mode: *u8) -> *void;
    _pclose :: (file: *void) -> int;

    remove  :: (path: *u8) -> int;
    rename  :: (oldPath: *u8, newPath: *u8) -> int;
}
