namespace web;

// Endpoints: a backend whose API is its functions, like a remote procedure call. A function with @web.endpoint is
// called at the url of its name, with its parameters from the JSON of the request, and its result is the JSON of the
// response, e.g
//
//     Session :: struct {
//         @embed base: web.Session;     // The request and the response
//         db: *blog.Db;                // What the program wants in each session
//     }
//
//     @web.endpoint(.get)
//     getPosts :: (session: *Session, authorId: int) -> [..]Post {
//         return session.db.posts.where(p => p.authorId == authorId).all();
//     }
//
//     @web.endpoint
//     createPost :: (session: *Session, post: Post) -> Post, error { ... }
//
//     app := web.newApp<Session>("/v1");
//     app.onStart(openSession);                   // e.g give the session its database context
//     app.listenAndServe(":8080");
//
//     GET  /v1/getPosts?authorId=2
//     POST /v1/createPost   {"post": {"title": "..."}}
//
// * The url is the prefix and the name of the function, so the names of endpoints are unique
// * POST takes the parameters as the members of a JSON object, and GET from the query, e.g ?authorId=2. A parameter that
//   isn't there is a 400, unless it has a default, e.g 'page := 1', or is an optional
// * The result is the JSON of the response: the value, an array of the values when there are more, or null for none
// * An error, given or thrown, is {"error": message, "kind": kind} with a status from its kind, e.g web.NotFound is 404
// * The first parameter is the session, a struct of the program that embeds web.Session. Each request gets a new one
//
// The memory of a request, e.g its texts and its session, is freed after the response. session.request.allocator
// allocates from it

import net.http;
import json;
import fmt;
import mem;
import errors;
import io;

// The attribute of an endpoint: @web.endpoint for POST, @web.endpoint(.get) for GET. With a path, it is called at the
// path instead of the url of its name, e.g @web.endpoint(.get, path: "/posts/{id}"), and a parameter with the name of a
// {segment} is read from it. With authorize, the hook of app.onAuthorize runs first, before the parameters are read
@attribute
endpoint :: struct {
    method:    Method = .post;
    path:      string;
    authorize: bool = false;
}

Method :: enum {
    post,
    get,
}

// The kinds of errors that give a status other than 500
BadRequest   :: ErrorKind{"web.BadRequest"};     // 400
Unauthorized :: ErrorKind{"web.Unauthorized"};   // 401
Forbidden    :: ErrorKind{"web.Forbidden"};      // 403
NotFound     :: ErrorKind{"web.NotFound"};       // 404
Conflict     :: ErrorKind{"web.Conflict"};       // 409

// The kinds of the errors of the app itself, so their messages can be the program's own (app.setMessage)
MalformedJson    :: ErrorKind{"web.MalformedJson"};      // 400: the body of a POST isn't JSON
MissingParameter :: ErrorKind{"web.MissingParameter"};   // 400: a parameter without a default isn't there
InvalidParameter :: ErrorKind{"web.InvalidParameter"};   // 400: a parameter isn't of its type
NoEndpoint       :: ErrorKind{"web.NoEndpoint"};         // 404: no endpoint is at the path
MethodNotAllowed :: ErrorKind{"web.MethodNotAllowed"};   // 405: the endpoint is called with another method
InternalError    :: ErrorKind{"web.InternalError"};      // 500: the message of every error that gives a 500

// What every session has. The session of a program embeds it: @embed base: web.Session;
Session :: struct {
    request:  *http.Request;
    response: *http.ResponseWriter;
    app:      *App;
}

// An endpoint of the app
Endpoint :: struct {
    name:      string;
    method:    Method;
    function:  *AttributedFunction;
    path:      string;            // Its own path, e.g /posts/{id}, or empty for the prefix and its name
    segments:  [..]string;        // Of the path, e.g ["posts", "{id}"]
    authorize: bool;
    names:     [..]string;        // The name of each parameter in JSON, in the style of app.jsonOptions
}

App :: struct {
    server:    http.Server;       // First, as a request finds its app through its server. Its fields can be set, e.g workers
    prefix:    string;            // Of the urls, e.g /v1
    endpoints: [..]Endpoint;

    // How results are written and parameters read, e.g json.SnakeCase, so createdAt is created_at
    jsonOptions: json.Options;
    // An error is {"error": message, "kind": kind}, or {"error": message} without
    errorKinds: bool = true;
    messages:   Map<string, string>;   // The message of the errors of a kind, by the name of the kind (setMessage)

    sessionType:   *TypeStruct;   // Of the session of the program
    sessionOffset: int;           // Where its web.Session is in it
    start:         (session: *u8);
    finish:        (session: *u8);
    authorizer:    (session: *u8);
}

// The app of the endpoints whose first parameter is a *S, with urls under the prefix, e.g "/v1". S is web.Session, or a
// struct that embeds one. An error says what is wrong with an endpoint, e.g a name that two endpoints have
newApp :: <S>(prefix: string) -> *App, error {
    app := new(App);
    app.prefix = prefix;
    if app.prefix.endsWith("/") { app.prefix = app.prefix.slice(0, app.prefix.len - 1); }

    probe: S;
    boxed: any = probe;
    app.sessionType = boxed.type as *TypeStruct;
    base: Session;
    boxedBase: any = base;
    if app.sessionType != boxedBase.type as *TypeStruct {
        found := false;
        for member in app.sessionType.members {
            if member.type == boxedBase.type {
                app.sessionOffset = member.offset as int;
                found = true;
            }
        }
        if !found {
            return null, errors.make("The session % has no web.Session: give it a member '@embed base: web.Session;'", app.sessionType.head.name);
        }
    }

    for f, i in attributedFunctions() {
        marked: endpoint;
        if !f.attribute(&marked) { continue; }
        function := &attributedFunctions()[i];
        first := f.parameters.count > 0 && f.parameters[0].type.kind == .pointer && (f.parameters[0].type as *TypePointer).pointerTo == boxed.type;
        if !first {
            return null, errors.make("The endpoint % must take a *% as its first parameter", f.name, app.sessionType.head.name);
        }
        for i in 1..f.parameters.count {
            param := f.parameters[i];
            problem := jsonProblem(param.type, true, 0);
            if problem != "" {
                return null, errors.make("The parameter % of the endpoint % can't come from JSON: %", param.name, f.name, problem);
            }
            if param.hasDefault && param.defaultValue == null {
                return null, errors.make("The default of the parameter % of the endpoint % must be known when compiling, e.g a number, a string or a constant", param.name, f.name);
            }
        }
        for result in f.results {
            if isErrorType(result.type) { continue; }
            problem := jsonProblem(result.type, false, 0);
            if problem != "" {
                return null, errors.make("The result of the endpoint % can't be written as JSON: %", f.name, problem);
            }
        }
        added: Endpoint;
        added.name      = f.name;
        added.method    = marked.method;
        added.function  = function;
        added.path      = marked.path;
        added.authorize = marked.authorize;
        if added.path.len > 0 {
            if !added.path.startsWith("/") { return null, errors.make("The path of the endpoint % must start with /, e.g /posts/{id}", f.name); }
            for segment in added.path.split("/") {
                if segment.len > 0 { added.segments.add(segment); }
            }
        }
        for e in app.endpoints {
            if e.path.len == 0 && added.path.len == 0 && e.name == f.name {
                return null, errors.make("Two endpoints are named %: the name of an endpoint is its url, so it must be unique", f.name);
            }
            if e.path.len > 0 && e.path == added.path && e.method == added.method {
                return null, errors.make("The endpoints % and % have the same method and path %", e.name, f.name, added.path);
            }
        }
        app.endpoints.add(added);
    }
    app.useJson(app.jsonOptions);

    app.server.handler = dispatch;
    return app, null;
}

// A function that is called with each new session before its endpoint, e.g to give it a database context. It can
// throw, e.g web.Unauthorized, and the endpoint isn't called then
onStart :: method <S>(app: *App, hook: (session: *S)) {
    address := hook as *void;
    app.start = address as (session: *u8);
}

// A function that is called with each session after its endpoint, also when the endpoint threw, e.g to save changes
onFinish :: method <S>(app: *App, hook: (session: *S)) {
    address := hook as *void;
    app.finish = address as (session: *u8);
}

// How results are written and parameters read, e.g app.useJson(json.SnakeCase): createdAt is written as created_at,
// and a parameter likeCount is read from like_count
useJson :: method (app: *App, options: json.Options) {
    app.jsonOptions = options;
    for i in 0..app.endpoints.count {
        e := app.endpoints.indexRef(i);
        e.names.free();
        e.names.allocator = mem.heap();
        for p in e.function.parameters { e.names.add(json.styleName(p.name, options.names).copy(mem.heap())); }
    }
}

// The message of the errors of a kind, in place of their own, e.g app.setMessage(web.NoEndpoint, "not found") or
// app.setMessage(web.InternalError, "internal server error") for every 500
setMessage :: method (app: *App, kind: ErrorKind, message: string) {
    app.messages.allocator = mem.heap();
    app.messages.set(kind.name.copy(mem.heap()), message.copy(mem.heap()));
}

// A function that is called before the parameters of an endpoint with authorize are read, e.g to check a token. It
// throws when the request isn't allowed, e.g web.Unauthorized, and the endpoint isn't called then. Its session has
// been given to onStart first
onAuthorize :: method <S>(app: *App, hook: (session: *S)) {
    address := hook as *void;
    app.authorizer = address as (session: *u8);
}

listenAndServe :: method (app: *App, address: string) -> error {
    return app.server.listenAndServe(address);
}

//
// Answering a request
//

// The status of an error, from its kind
statusOf :: (err: error) -> int {
    if err.is(BadRequest) || err.is(json.DecodeError) || err.is(MalformedJson) || err.is(MissingParameter) || err.is(InvalidParameter) { return 400; }
    if err.is(Unauthorized) { return 401; }
    if err.is(Forbidden)    { return 403; }
    if err.is(NotFound) || err.is(NoEndpoint) { return 404; }
    if err.is(MethodNotAllowed) { return 405; }
    if err.is(Conflict)     { return 409; }
    return 500;
}

// The error as JSON: {"error": message, "kind": kind}, or without the kind. The message of a 500 isn't told, as it can
// be what went wrong inside, e.g of the database: it is written to stderr instead (server.log)
respondWith :: (app: *App, w: *http.ResponseWriter, err: error) {
    status := statusOf(err);
    message := err.message;
    if status == 500 {
        if app.server.log { io.writeError(fmt.sprint("web: %: %\n", err.kind.name, err.message)); }
        message = app.messages.get(InternalError.name, "Internal Server Error");
    }
    message = app.messages.get(err.kind.name, message);
    w.status = status;
    w.body.clear();
    w.setHeader("Content-Type", "application/json");
    w.write("{\"error\":");
    w.write(json.encode(message));
    if app.errorKinds {
        w.write(",\"kind\":");
        w.write(json.encode(err.kind.name));
    }
    w.write("}");
}

// The endpoint of the request, and the values of the {segments} of its path. Null and the error when there is none
findEndpoint :: (app: *App, r: *http.Request, values: *[..]http.Header) -> *Endpoint, error {
    name := "";
    if r.path.startsWith(app.prefix) && r.path.len > app.prefix.len && r.path[app.prefix.len] == '/' {
        name = r.path.slice(app.prefix.len + 1);
    }
    isGet := r.method == "GET" || r.method == "HEAD";
    otherMethod: *Endpoint;
    for i in 0..app.endpoints.count {
        e := app.endpoints.indexRef(i);
        matches := false;
        if e.path.len == 0 {
            matches = name.len > 0 && e.name == name;
        } else {
            values.clear();
            matches = matchPath(e, r.path, values);
        }
        if !matches { continue; }
        if (e.method == .get) == isGet && (e.method == .get || r.method == "POST") { return e, null; }
        otherMethod = e;
    }
    if otherMethod != null {
        wanted := "POST";
        if otherMethod.method == .get { wanted = "GET"; }
        r.values.clear();
        return otherMethod, errors.make("% is called with %", otherMethod.name, wanted, kind: MethodNotAllowed);
    }
    return null, errors.make("There is no endpoint at %", r.path, kind: NoEndpoint);
}

// If the path is the path of the endpoint, with the values of its {segments}
matchPath :: (e: *Endpoint, path: string, values: *[..]http.Header) -> bool {
    at := 0;
    for segment in e.segments {
        while at < path.len && path[at] == '/' { at += 1; }
        if at >= path.len { return false; }
        end := at;
        while end < path.len && path[end] != '/' { end += 1; }
        part := path.slice(at, end);
        if segment.len > 2 && segment[0] == '{' && segment[segment.len - 1] == '}' {
            values.add(http.Header{segment.slice(1, segment.len - 1), part});
        } else if part != segment {
            return false;
        }
        at = end;
    }
    while at < path.len && path[at] == '/' { at += 1; }
    return at == path.len;
}

// The handler of the server of an app
dispatch :: (w: *http.ResponseWriter, r: *http.Request) {
    app := r.server as *App;   // The server is the first member of the app

    r.values.allocator = r.allocator;
    target, notFound := findEndpoint(app, r, &r.values);
    if notFound != null {
        if notFound.is(MethodNotAllowed) {
            wanted := "POST";
            if target.method == .get { wanted = "GET"; }
            w.setHeader("Allow", wanted);
        }
        respondWith(app, w, notFound);
        return;
    }

    f := target.function;
    arguments := r.arena.allocate(f.argumentsSize as int) as *u8;
    results   := r.arena.allocate(f.resultsSize as int + 8) as *u8;

    // A new session, with the request and the response
    session := r.arena.allocate(app.sessionType.head.size) as *u8;
    base := (&session[app.sessionOffset]) as *Session;
    base.request  = r;
    base.response = w;
    base.app      = app;
    *((&arguments[f.parameters[0].offset]) as **u8) = session;

    try {
        if app.start != null { app.start(session); }
        if target.authorize && app.authorizer != null { app.authorizer(session); }
        err := readArguments(app, target, r, arguments);
        if err != null { throw err; }
        f.invoke(arguments, results);
    } catch (thrown) {
        if app.finish != null { app.finish(session); }
        respondWith(app, w, thrown);
        return;
    }
    if app.finish != null { app.finish(session); }

    // The results: an error that is given, and the values
    values: [..]FunctionValue;
    values.allocator = r.allocator;
    for result in f.results {
        if isErrorType(result.type) {
            given := *((&results[result.offset]) as *error);
            if given != null {
                respondWith(app, w, given);
                return;
            }
            continue;
        }
        values.add(result);
    }
    w.setHeader("Content-Type", "application/json");
    if values.count == 0 {
        w.write("null");
    } else if values.count == 1 {
        w.write(json.encodeAt(&results[values[0].offset], values[0].type, app.jsonOptions));
    } else {
        w.write("[");
        for v, i in values {
            if i > 0 { w.write(","); }
            w.write(json.encodeAt(&results[v.offset], v.type, app.jsonOptions));
        }
        w.write("]");
    }
}

// What of the type can't be JSON, e.g "Job.run is a function", or empty when all of it can. A parameter is read from JSON,
// which can't make an any, and a result is written
jsonProblem :: (type: *Type, reading: bool, depth: int) -> string {
    if depth > 8 { return ""; }   // e.g a struct with a pointer to itself
    switch type.kind {
        case .bool
        case .int
        case .float
        case .string
        case .enum {
            return "";
        }
        case .pointer {
            to := (type as *TypePointer).pointerTo;
            if to.kind == .void { return fmt.sprint("% is a pointer to nothing", type.name); }
            return jsonProblem(to, reading, depth + 1);
        }
        case .array {
            return jsonProblem((type as *TypeArray).elemType, reading, depth + 1);
        }
        case .struct {
            // What json reads and writes as a whole
            name := type.name;
            if name == "time.Time" || name == "json.Value" { return ""; }
            structType := type as *TypeStruct;
            if type.flags.has(.isOptional) { return jsonProblem(structType.members[0].type, reading, depth + 1); }
            if name.startsWith("List<") {
                return jsonProblem((memberType(structType, "data") as *TypePointer).pointerTo, reading, depth + 1);
            }
            if name.startsWith("Map<") {
                entries := memberType(structType, "entries") as *TypeStruct;
                entry := (memberType(entries, "data") as *TypePointer).pointerTo as *TypeStruct;
                if reading && memberType(entry, "key").kind != .string { return fmt.sprint("the keys of % aren't strings", name); }
                return jsonProblem(memberType(entry, "value"), reading, depth + 1);
            }
            for member in structType.members {
                if member.isHidden() || member.name.startsWith("$") { continue; }
                problem := jsonProblem(member.type, reading, depth + 1);
                if problem != "" {
                    if member.type.kind == .function { return fmt.sprint("%.% is a function", type.name, member.name); }
                    return problem;
                }
            }
            return "";
        }
        case .any {
            if reading { return "any has no type to read into"; }
            return "";
        }
        case .function {
            return fmt.sprint("% is a function", type.name);
        }
        else {
            return fmt.sprint("% is a %", type.name, type.kind);
        }
    }
}

// The type of a member of a struct, by its name
memberType :: (type: *TypeStruct, name: string) -> *Type {
    for member in type.members {
        if member.name == name { return member.type; }
    }
    return null;
}

// A string, or a ?string
isText :: (type: *Type) -> bool {
    if type.kind == .string { return true; }
    if type.flags.has(.isOptional) {
        item := (type as *TypeStruct).members[0].type;
        return item.kind == .string;
    }
    return false;
}

// If the type is error, a *Error
isErrorType :: (type: *Type) -> bool {
    probe: error;
    boxed: any = probe;
    return type == boxed.type;
}

// The parameters after the session: the members of the JSON object of the body for POST, or the query for GET, and the
// {segments} of the path of the endpoint. One that isn't there is an error, unless it has a default or is an optional
readArguments :: (app: *App, e: *Endpoint, r: *http.Request, arguments: *u8) -> error {
    f := e.function;
    body: json.Value;
    isGet := r.method == "GET" || r.method == "HEAD";
    if !isGet && f.parameters.count > 1 {
        text := r.body;
        if text.len == 0 { text = "{}"; }
        parsed, err := json.parse(text);
        if err != null { return errors.make("The body isn't JSON: %", err.message, kind: MalformedJson); }
        if parsed.kind != .object { return errors.make("The body is a JSON object of the parameters, e.g {\"id\": 1}", kind: BadRequest); }
        body = parsed;
    }

    for i in 1..f.parameters.count {
        p := f.parameters[i];
        name := e.names[i];
        place := (&arguments[p.offset]) as *void;
        value: json.Value;
        given := false;
        text, inPath := pathValue(r, p.name);
        found := inPath;
        if !inPath && isGet { text, found = r.queryValue(name); }
        if found {
            // A text is as it is, also for a ?string. Other types are JSON, e.g 2, true or [1, 2]
            given = true;
            if isText(p.type) { text = json.encode(text); }
            parsed, err := json.parse(text);
            if err != null { return errors.make("%: '%' isn't a value of type %", name, text, p.type.name, kind: InvalidParameter); }
            value = parsed;
        } else if !isGet {
            given = body.has(name);
            if given { value = body.get(name); }
        }
        if !given {
            if p.defaultValue != null {
                mem.copy(place, p.defaultValue, p.type.size);
                continue;
            }
            if p.type.flags.has(.isOptional) { continue; }
            return errors.make("The parameter % is missing", name, kind: MissingParameter);
        }
        err := json.assignAt(value, place, p.type, name, app.jsonOptions);
        if err != null { return errors.make(err.message, kind: InvalidParameter); }
    }
    return null;
}

// The value of a {segment} of the path of the endpoint
pathValue :: (r: *http.Request, name: string) -> string, bool {
    for v in r.values {
        if v.name == name { return v.value, true; }
    }
    return "", false;
}
