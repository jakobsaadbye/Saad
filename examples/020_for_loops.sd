use fmt;

main :: () {
    
    print("Exclusive range");
    // Exclusive range
    for i in 0..10 {
        print("%", i);
    }
    
    print("Inclusive range");
    // Inclusive range
    for i in 0...10 {
        print("%", i);
    }
    
    
    // Ranges can be arbitrary expressions
    print("Ranges with variables");
    a := 0;
    b := 10;
    for i in a...b+10 {
        print("%", i);
    }
    
    print("");

    // // A loop that doesn't need the value doesn't name it
    for 0..3 {
        print("Hello");
    }
    
    print("");

    
    // // Looping over arrays has the same syntax
    x := [1, 1, 2, 3, 5, 8, 11, 19];
    for n in x {
        print("%", n);
    }

    print("");
    
    // // If no expression is given, its an infinite loop like in Go
    for {
        print("To infinity and beyond!");
        break;
    }

    print("");

    // Its also possible to include an index
    fibonacci_numbers := [1, 1, 2, 3, 5, 8, 11, 19];
    for n, i in fibonacci_numbers {
        print("(%, %)", i, n);
    }

    print("");
    
    // And it also works with ranges ()
    for n, i in 10...20 {
        print("(%, %)", i, n);
    }
    
    print("");

}