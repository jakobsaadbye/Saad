// instead of changing it, e.g saad run std/dbms/tools/generate.sd -- "host=localhost dbname=app" db
namespace entities;

import dbms;
import time;

// A row of follows
Follow :: struct {
    id:        i64;
    readerId:  i64;
    authorId:  i64;
    createdAt: time.Time;

    // The database it came from, for author(), reader()
    @Hidden dbLink: dbms.Link;

    // The row of authors that authorId refers to, or null
    author :: method () -> (*Author, error) {
        return dbms.related<Author>(self.dbLink, "authors", "id", self.authorId);
    }

    // The row of readers that readerId refers to, or null
    reader :: method () -> (*Reader, error) {
        return dbms.related<Reader>(self.dbLink, "readers", "id", self.readerId);
    }
}
