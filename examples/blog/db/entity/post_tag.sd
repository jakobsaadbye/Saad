namespace entities;

import dbms;

// A row of post_tags
PostTag :: struct {
    postId: i64;
    tag:    string;

    // The database it came from, for post()
    @Hidden dbLink: dbms.Link;

    // The row of posts that postId refers to, or null
    post :: method () -> (*Post, string) {
        row, err := dbms.related<Post>(self.dbLink, "posts", "id", self.postId);
        return row, err;
    }
}
