namespace entities;

import time;

// A row of posts
Post :: struct {
    id:          i64;
    authorId:    i64;
    title:       string;
    slug:        string;
    body:        string = "";
    status:      PostStatus = .draft;
    views:       i32 = 0;
    publishedAt: ?time.Time;
    createdAt:   time.Time;
}
