// Made by std/dbms/tools/generate.sd from the schema saad_blog of a Postgres database. Make it again
// instead of changing it, e.g saad run std/dbms/tools/generate.sd -- "host=localhost dbname=app" db
namespace entities;

import dbms;
import time;

// A row of posts
Post :: struct {
    id:          i64;
    authorId:    i64;
    title:       string;
    slug:        string;
    body:        string = "";
    status:      PostStatus = .draft;
    views:       i32 = 0;
    publishedAt: ?time.Time;
    createdAt:   time.Time;

    // The database it came from, for author(), comments(), postTags()
    @Hidden dbLink: dbms.Link;

    // The row of authors that authorId refers to, or null
    author :: method () -> (*Author, string) {
        row, err := dbms.related<Author>(self.dbLink, "authors", "id", self.authorId);
        return row, err;
    }

    // The rows of comments whose post_id is the id of this one, as a query, e.g post.comments().all()
    comments :: method () -> dbms.Query<Comment> {
        return dbms.relatedRows<Comment>(self.dbLink, "comments").where(row => row.postId == self.id);
    }

    // The rows of post_tags whose post_id is the id of this one, as a query, e.g post.postTags().all()
    postTags :: method () -> dbms.Query<PostTag> {
        return dbms.relatedRows<PostTag>(self.dbLink, "post_tags").where(row => row.postId == self.id);
    }
}
