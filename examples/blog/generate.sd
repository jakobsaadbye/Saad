// Writes the tables of the schema saad_blog as Saad files into examples/blog/db. Run it when schema.sql changes:
//
//     saad run examples/blog/generate.sd -- "host=localhost dbname=postgres user=postgres"

import dbms.postgres;
import os;
use fmt;

main :: () {
    connectionString := "host=localhost dbname=postgres user=postgres password=postgres";

    generator := postgres.EntityGenerator{connectionString: connectionString, schema: "saad_blog", folder: "examples/blog/db"};

    report, err := generator.run();
    if err != null {
        print("Can't generate: %", err.message);
        os.exit(1);
    }
    print("Wrote % files to %", report.written.count, generator.folder);
    for name in report.removed { print("Removed %, as its table is gone", name); }
}
