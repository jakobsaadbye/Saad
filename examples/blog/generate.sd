// Writes the tables of the schema saad_blog as Saad files into examples/blog/db. Run it when schema.sql changes:
//
//     saad run examples/blog/generate.sd -- "host=localhost dbname=postgres user=postgres"

import cli;
import dbms.postgres;
import os;
use fmt;

@cli.Options(about: "Writes the tables of the schema saad_blog as Saad files")
Options :: struct {
    @cli.Arg(positional: true, help: "How to connect to Postgres, e.g the database of tools/linux/dbtests.sh")
    connection := "host=localhost dbname=postgres user=postgres password=postgres";
    @cli.Arg(positional: true, help: "The folder of the files")
    folder := "examples/blog/db";
}

main :: () {
    options, usage := cli.parseArguments<Options>();
    if usage != null {
        print("%", usage.message);
        os.exit(2);
    }

    generator := postgres.EntityGenerator{connectionString: options.connection, schema: "saad_blog", folder: options.folder};

    report, err := generator.run();
    if err != null {
        print("Can't generate: %", err.message);
        os.exit(1);
    }
    print("Wrote % files to %", report.written.count, generator.folder);
    for name in report.removed { print("Removed %, as its table is gone", name); }
}
