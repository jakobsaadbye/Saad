// @Todo: Should be revised

use fmt;

EngineType :: enum {
    v8,
    v6,
}

DefaultEngineType :: EngineType.v6;

Fuel :: enum {
    electric,
    diesel,
    gasoline,
}

Engine :: struct {
    type      : EngineType;
    fuel      : Fuel;
    cylinders : int;
    capacity  : float;
}

Car :: struct {
    doors     : int;
    max_speed : float;
    engine    : Engine;
}

main :: () {
    bugatti := Car{
        doors: 4,
        max_speed: 320.0,
        engine: {
            type: DefaultEngineType,
            fuel: .gasoline,
            cylinders: 8,
            capacity: 30.0
        }
    };

    print("%", bugatti.engine.type);
    print("%", bugatti.engine.fuel);
}