Vector4 :: struct {
    x, y, z, w: float;
}

Vector2 :: struct {
    x, y: float;
}

Mesh :: struct {
    points: [3]Vector2;
}

Entity :: struct {
    health: int;
    rotation: Vector4;
    meshes: [10]Mesh;
    mana: int;
}

main :: () {
    e := Entity{
        health = 100,
        rotation = Vector4{4, 9, 13, 15},
    };
    
    v := e.meshes[1].points[2].x;

