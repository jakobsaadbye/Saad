extern "C" {
    printf :: (format: *u8, args: ...any);
}

Vector4 :: struct {
    x, y, z, w: float;
}

Entity :: struct {
    health: int;
    rotation: Vector4;
    mana: int;
}

main :: () {
    e := Entity{
        health = 100,
        rotation = Vector4{4, 9, 13, 15},
    };

    printf(xx "%d %d %f %f %f %f\n", e.health, e.mana, e.rotation.x, e.rotation.y, e.rotation.z, e.rotation.w);
}