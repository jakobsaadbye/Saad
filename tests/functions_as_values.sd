use fmt;

main :: () {
    // Functions can be assigned to a new function
    {
        foo := () {
            print("foo");
        };

        foo = () {
            print("another foo");
        };

        foo(); // -> another foo
    }

    // Functions can be stored in arrays
    {
        funcs := [
            () { print("1"); },
            () { print("2"); },
            () { print("3"); },
            () { print("4"); },
            () { print("5"); },
        ];

        for func in funcs {
            func();
        }
    }

    // Functions as struct members
    {
        MyButton :: struct {
            onClick: () -> void;
        }

        btn := MyButton{
            onClick: () {
                print("Click!");
            }
        };
    
        btn.onClick();
    }


}