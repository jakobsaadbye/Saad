// std/prelude/slices.sd: the methods on slices

use fmt;


Card :: struct {
    rank: int;
}

main :: () {
    {
        xs := [5, 3, 9, 1, 7];
        xs.sort();
        assert(xs[0] == 1 && xs[1] == 3 && xs[2] == 5 && xs[3] == 7 && xs[4] == 9);
        assert(xs.isSorted());
    }
    {
        // Big enough for the quicksort part, with duplicates and sorted runs
        xs: [..]int;
        for i in 0..200 {
            xs.add((i * 7919) % 101);
        }
        for i in 0..50 {
            xs.add(i);
        }
        assert(!xs.isSorted());
        xs.sort();
        assert(xs.isSorted());
        assert(xs.count == 250);

        // Already sorted and reversed input
        xs.sort();
        assert(xs.isSorted());
        xs.reverse();
        assert(xs[0] >= xs[xs.count - 1]);
        xs.sort();
        assert(xs.isSorted());
    }
    {
        names: [..]string;
        names.add("carl");
        names.add("anna");
        names.add("bob");
        names.sort();
        assert(names[0] == "anna" && names[1] == "bob" && names[2] == "carl");
        assert(names.indexOf("bob") == 1);
        assert(names.indexOf("dave") == -1);
        assert(names.contains("carl"));
    }
    {
        // Fixed arrays, floats and structs with ==
        fs: [4]f64 = [2.5, -1.0, 0.5, 2.0];
        fs.sort();
        assert(fs[0] == -1.0 && fs[3] == 2.5);

        cards := [Card{1}, Card{2}, Card{3}];
        assert(cards.contains(Card{2}));
        cards.reverse();
        assert(cards[0].rank == 3);
        cards.swap(0, 2);
        assert(cards[0].rank == 1);
    }
    {
        empty: [..]int;
        empty.sort();
        empty.reverse();
        assert(empty.isSorted());
        assert(!empty.contains(1));
    }

    print("ok");
}
