// std/random.sd

import random;

main :: () {
    {
        // The functions, on the generator that is seeded from the clock
        for 0..1000 {
            dice := random.between(1, 6);
            assert(dice >= 1 && dice <= 6);
            f := random.random();
            assert(f >= 0.0 && f < 1.0);
            u := random.uniform(-2.0, 2.0);
            assert(u >= -2.0 && u < 2.0);
        }
        assert(random.between(3, 3) == 3);

        names := ["ada", "bob", "cy"];
        name := random.choice(names);
        assert(names.contains(name));
    }
    {
        // between includes both ends
        seen: [6]bool;
        for 0..1000 {
            seen[random.between(1, 6) - 1] = true;
        }
        for s in seen {
            assert(s);
        }
        negative := random.between(-10, -5);
        assert(negative >= -10 && negative <= -5);
    }
    {
        // seed makes the numbers repeatable
        random.seed(42);
        a := random.bits();
        b := random.between(0, 1000);
        random.seed(42);
        assert(random.bits() == a);
        assert(random.between(0, 1000) == b);
    }
    {
        // A generator of your own has the same methods and its own sequence
        x := random.newRandom(7);
        y := random.newRandom(7);
        for 0..100 {
            assert(x.bits() == y.bits());
        }
        z := random.newRandom(8);
        assert(x.bits() != z.bits());

        rng := random.newRandom(1);
        trues := 0;
        sum: f64 = 0.0;
        for 0..1000 {
            if rng.chance(0.25) { trues += 1; }
            sum += rng.gauss(10.0, 2.0);
        }
        assert(trues > 150 && trues < 350);
        assert(sum / 1000.0 > 9.5 && sum / 1000.0 < 10.5);

        cards := ["a", "b", "c", "d"];
        assert(cards.contains(rng.choice(cards)));
    }
    {
        // choices can repeat, sample can't
        xs: [..]int;
        for i in 0..50 {
            xs.add(i);
        }

        picks := random.choices(xs, 100);
        assert(picks.count == 100);
        for p in picks {
            assert(p >= 0 && p < 50);
        }

        some := random.sample(xs, 20);
        assert(some.count == 20);
        for p, i in some {
            for q, j in some {
                if i != j { assert(p != q); }
            }
        }
        all := random.sample(xs, 50);
        all.sort();
        for p, i in all {
            assert(p == i);
        }
    }
    {
        xs: [..]int;
        for i in 0..50 {
            xs.add(i);
        }
        random.shuffle(xs);
        assert(!xs.isSorted());
        xs.sort();
        for x, i in xs {
            assert(x == i);
        }

        rng := random.newRandom(3);
        rng.shuffle(xs);
        assert(!xs.isSorted());
    }
}
