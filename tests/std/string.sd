use fmt;

main :: () {
    skip := false;

    if !skip {
        // Taking a slice of a string
        text := "The quick brown fox jumps over the lazy dog";

        quickBrown := text.slice(4, 15);

        print("%", quickBrown);
        print("%", quickBrown.len);

        fox := text.slice(16);
        print("%", fox);
        print("%", fox.len);
    }
    if !skip {
        // Copying a string
        text := "The quick brown fox jumps over the lazy dog";
        
        copy := text.copy();

        text[4] = 115; // 's'
        text[5] = 108; // 'l'
        text[6] = 111; // 'o'
        text[7] = 119; // 'w'
        text[8] = 32;
        print("%", text);

        print("%", copy);
    }
    if !skip {
        // To uppercase
        text := "The quick brown fox jumps over the lazy dog";

        uppercased := text.toUpper();
        print("%", uppercased);
    }

    if !skip {
        // To lowercase
        text := "THE QUICK Brown FOX JUMPS OVER THE LAZY DOG";

        lowercase := text.toLower();
        print("%", lowercase);
    }

    if !skip {
        // startsWith
        text := "The quick brown fox jumps over the lazy dog";
        assert(text.startsWith("The"));
    }

    if !skip {
        // endsWith
        text := "The quick brown fox jumps over the lazy dog";
        assert(text.endsWith("dog"));
    }

    if !skip {
        // indexOf
        text := "the quick brown fox jumps over the lazy dog";

        index1 := text.indexOf("quick");
        assert(index1 == 4);

        index2 := text.indexOf("dog");
        assert(index2 == 40);

        // check fromIndex works
        index3 := text.indexOf("quick", 10);
        assert(index3 == -1);

        index4 := text.indexOf("the", 4);
        assert(index4 == 31);
    }

    if true {
        // lastIndexOf
        text := "the quick brown fox jumps over the lazy dog";
        assert(text.lastIndexOf("the") == 31);
        assert(text.lastIndexOf("g") == text.len - 1);
        assert(text.lastIndexOf("t") == 31);
        assert(text.lastIndexOf("cat") == -1);
        assert(text.lastIndexOf("") == -1);
        assert("step_2".lastIndexOf("_") == 4);
        assert("ab".lastIndexOf("abc") == -1);
        assert("aaa".lastIndexOf("aa") == 1);
    }

    if true {
        // split
        text := "The quick brown fox jumps over the lazy dog";

        splitted := text.split(" ");

        print("%", splitted.count);
        assert(splitted.count == 9);

        for s in splitted {
            print("%", s);
        }
    }

    if true {
        // reverse
        text := "The quick brown fox jumps over the lazy dog";

        reversed := text.reverse();

        assert(reversed == "god yzal eht revo spmuj xof nworb kciuq ehT");
    }

    // toInt and toFloat: the number a text is, or nothing
    assert("42".toInt() == 42 && "-7".toInt() == -7 && "+3".toInt() == 3 && "1_000".toInt() == 1000);
    assert("".toInt() == null && "4x".toInt() == null && "1.5".toInt() == null && " 1".toInt() == null);
    assert("9223372036854775807".toInt() == 9223372036854775807 && "9223372036854775808".toInt() == null);
    assert("-9223372036854775808".toInt().hasValue());
    assert("3.25".toFloat() == 3.25 && "-1e3".toFloat() == -1000.0 && "7".toFloat() == 7.0);
    assert("".toFloat() == null && "1.5x".toFloat() == null && " 2".toFloat() == null);
}
