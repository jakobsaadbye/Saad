// The SQL that dbms.Query makes of lambdas, without a database. tests/db/shop_tables.sd runs queries on Postgres
import dbms;
import time;
use fmt;

Role :: enum { guest, admin }

User :: struct {
    id:        i64;
    name:      string;
    age:       ?int;
    role:      Role;
    email:     ?string;
    createdAt: time.Time;
    seenAt:    ?time.Time;
    teamId:    ?i64;

    // A relation like the generator writes. In a query it is a join, so its body doesn't matter here
    team :: method () -> (*Team, string) {
        return null, "";
    }
}

Team :: struct {
    id:      i64;
    name:    string;
    groupId: i64;

    group :: method () -> (*Group, string) {
        return null, "";
    }
}

Group :: struct {
    id:    i64;
    title: string;
}

main :: () {
    conn: dbms.Connection;
    context := dbms.newContext(&conn);
    users := dbms.keyedTable<User, i64>(context, "users", "id", schema: "shop");

    // The values are parameters, the members are columns, in snake case
    minAge := 18;
    sql, args, err := users.where(u => u.age ?? 0 >= minAge && u.name != "").toSql();
    assert(err == "" && args.count == 3);
    assert(sql == "SELECT * FROM \"shop\".\"users\" WHERE (((coalesce(\"age\", $1) >= $2) AND (\"name\" <> $3)))");
    assert(*(args[1].data as *int) == 18);

    // where again is AND, and null and empty optionals are IS NULL
    noEmail: ?string;
    sql2, args2, _ := users.where(u => u.email == null).where(u => !(u.email != noEmail) || u.role == .admin).toSql();
    assert(sql2 == "SELECT * FROM \"shop\".\"users\" WHERE ((\"email\" IS NULL)) AND ((NOT ((\"email\" IS NOT NULL)) OR (\"role\" = $1)))");
    assert(args2.count == 1 && args2[0].type.kind == .enum);

    // Times: after, before and equal are comparisons, ?. of a column that can be NULL is the column, and the time is a
    // parameter of RFC 3339 text
    since := time.date(2026, 11, 2, 10, 15);
    sqlTime, argsTime, _ := users.where(u => u.createdAt.after(since) && (u.seenAt?.before(since) ?? true)).toSql();
    assert(sqlTime == "SELECT * FROM \"shop\".\"users\" WHERE (((\"created_at\" > $1) AND coalesce((\"seen_at\" < $2), $3)))");
    assert(argsTime[0].type.name == "time.Time" && (*(argsTime[0].data as *time.Time)).toString() == "2026-11-02T10:15:00Z");

    // Sorting and a part of the rows
    sql3, _, _ := users.orderBy(u => u.name.toLower()).orderByDescending(u => u.id).limit(10).offset(20).toSql();
    assert(sql3 == "SELECT * FROM \"shop\".\"users\" ORDER BY lower(\"name\"), \"id\" DESC LIMIT 10 OFFSET 20");

    // Strings
    sql4, _, _ := users.where(u => u.name.startsWith("A") && u.name.indexOf("x") < 0 && u.name.len > 2).toSql();
    assert(sql4 == "SELECT * FROM \"shop\".\"users\" WHERE ((((left(\"name\", length($1)) = $2) AND ((strpos(\"name\", $3) - 1) < $4)) AND (length(\"name\") > $5)))");

    // select into an anonymous struct, or into one value
    sql5, _, _ := users.where(u => u.id > 1).select(u => {name: u.name, older: (u.age ?? 0) + 1}).toSql();
    assert(sql5 == "SELECT \"name\" AS \"name\", (coalesce(\"age\", $1) + $2) AS \"older\" FROM \"shop\".\"users\" WHERE ((\"id\" > $3))");
    sql6, _, _ := users.select(u => u.name).toSql();
    assert(sql6 == "SELECT \"name\" AS \"value\" FROM \"shop\".\"users\"");

    // Mistakes are errors of the query
    _, _, err7 := users.where(u => u.name.reverse() == "x").toSql();
    assert(err7.startsWith("The method reverse can't be made into SQL"));
    _, _, err8 := users.select(u => u.name).where(n => n == "x").toSql();
    assert(err8 == "where after select isn't supported. Put the where before the select");

    // A query is the start of others
    adults := users.where(u => u.age ?? 0 >= 18);
    a, _, _ := adults.where(u => u.role == .admin).toSql();
    b, _, _ := adults.where(u => u.role == .guest).limit(1).toSql();
    c, _, _ := adults.toSql();
    assert(a.indexOf("LIMIT") < 0 && b.indexOf("LIMIT 1") > 0 && c.indexOf("role") < 0);

    // The row that a foreign key refers to is a join, and the columns are written with their table then
    teams  := dbms.keyedTable<Team, i64>(context, "teams", "id", schema: "shop");
    groups := dbms.keyedTable<Group, i64>(context, "groups", "id", schema: "shop");
    users.relations = [dbms.Relation{name: "team", column: "team_id", table: "teams", references: "id"}];
    teams.relations = [dbms.Relation{name: "group", column: "group_id", table: "groups", references: "id"}];
    context.register(users.tableInfo());
    context.register(teams.tableInfo());
    context.register(groups.tableInfo());

    sql9, _, err9 := users.where(u => u.age ?? 0 >= 18).select(u => {u.name, teamName: u.team().name, u.team().group().title}).toSql();
    assert(err9 == "");
    assert(sql9 == "SELECT t0.\"name\" AS \"name\", t1.\"name\" AS \"teamName\", t2.\"title\" AS \"title\" FROM \"shop\".\"users\" AS t0 LEFT JOIN \"shop\".\"teams\" AS t1 ON t1.\"id\" = t0.\"team_id\" LEFT JOIN \"shop\".\"groups\" AS t2 ON t2.\"id\" = t1.\"group_id\" WHERE ((coalesce(t0.\"age\", $1) >= $2))");
    sql10, _, _ := users.where(u => u.team().name == "Core" && u.team().id > 1).toSql();
    assert(sql10 == "SELECT t0.* FROM \"shop\".\"users\" AS t0 LEFT JOIN \"shop\".\"teams\" AS t1 ON t1.\"id\" = t0.\"team_id\" WHERE (((t1.\"name\" = $1) AND (t1.\"id\" > $2)))");
    sql11, _, _ := users.orderBy(u => u.team().name).select(u => u.team().group().title).toSql();
    assert(sql11.startsWith("SELECT t2.\"title\" AS \"value\" FROM \"shop\".\"users\" AS t0 LEFT JOIN") && sql11.endsWith(" ORDER BY t1.\"name\""));

    // A member without a name gets the name of the member it reads
    named := {u: 1}.u;
    p := User{name: "Ada"};
    q := {p.name, p.age, years: 3};
    assert(q.name == "Ada" && q.years == 3 && named == 1);

    // A method that isn't a relation of the table is an error of the query
    groups.relations.clear();
    context.register(groups.tableInfo());
    teams.relations.clear();
    context.register(teams.tableInfo());
    _, _, err12 := users.select(u => u.team().group().title).toSql();
    assert(err12.startsWith("group isn't a relation of teams to one row"));

    print("dbms query ok");
}
