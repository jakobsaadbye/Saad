// dbms.Context without a database: a driver of its own records the SQL that saveChanges sends, and answers an INSERT
// with the row the database would have stored. tests/db/shop_tables.sd does the same with Postgres

import dbms;
use fmt;
use c;

User :: struct {
    id:    i64;
    name:  string;
    email: ?string;
    cache: int = 5;    // Not a column of the answer, so it keeps its value
}

// The fake database: what it was sent, and what it answers
Fake :: struct {
    sent:     [..]string;  // Each statement with its parameters, e.g INSERT ... [Ada, NULL]
    columns:  []string;
    cells:    []*u8;
    affected: i64 = 1;
}

fakeExecute :: (conn: *void, sql: *u8, params: []*u8, err: *string) -> *void {
    fake := conn as *Fake;
    sb: StringBuilder;
    sb.addString(fromCString(sql));
    if params.count > 0 {
        sb.addString(" [");
        for p, i in params {
            if i > 0 { sb.addString(", "); }
            if p == null { sb.addString("NULL"); }
            else         { sb.addString(fromCString(p)); }
        }
        sb.addChar(']');
    }
    statement := sb.toString();
    fake.sent.add(statement);
    if statement.indexOf("Mallory") >= 0 {
        *err = "ERROR: no Mallory";
        return null;
    }
    return fake;
}
fakeRowCount    :: (result: *void) -> i64 { f := result as *Fake; return f.cells.count / f.columns.count; }
fakeColumnCount :: (result: *void) -> i64 { return (result as *Fake).columns.count; }
fakeColumnName  :: (result: *void, column: i64) -> *u8 { return (result as *Fake).columns[column].data; }
fakeValue       :: (result: *void, row: i64, column: i64) -> *u8 { f := result as *Fake; return f.cells[row * f.columns.count + column]; }
fakeAffected    :: (result: *void) -> i64 { return (result as *Fake).affected; }
fakeFreeResult  :: (result: *void) {}
fakeClose       :: (conn: *void) {}

main :: () {
    columns := ["id", "name", "email"];
    cells: [..]*u8;
    for v in ["7", "Ada", ""] { cells.add(v.data); }
    cells[2] = null;
    fake := Fake{columns: columns, cells: cells.elements()};

    driver: dbms.Driver;
    driver.name        = "fake";
    driver.execute     = fakeExecute;
    driver.rowCount    = fakeRowCount;
    driver.columnCount = fakeColumnCount;
    driver.columnName  = fakeColumnName;
    driver.value       = fakeValue;
    driver.affected    = fakeAffected;
    driver.freeResult  = fakeFreeResult;
    driver.close       = fakeClose;
    conn := dbms.Connection{driver: &driver, handle: &fake};

    context := dbms.newContext(&conn);
    users := dbms.keyedTable<User, i64>(context, "users", "id", schema: "shop");
    users.generated = ["id"];

    // Nothing is sent until saveChanges
    ada := User{name: "Ada", cache: 9};
    users.create(&ada);
    bo := User{id: 2, name: "Bo", email: "bo@example.com"};
    users.update(&bo);
    users.delete(3);
    assert(fake.sent.count == 0 && context.pendingChanges() == 3);
    assert(context.saveChanges() == "");

    assert(fake.sent.count == 5);
    assert(fake.sent[0] == "BEGIN");
    assert(fake.sent[1] == "INSERT INTO \"shop\".\"users\" (\"name\", \"email\", \"cache\") VALUES ($1, $2, $3) RETURNING * [Ada, NULL, 9]");
    assert(fake.sent[2] == "UPDATE \"shop\".\"users\" SET \"name\" = $1, \"email\" = $2, \"cache\" = $3 WHERE \"id\" = $4 [Bo, bo@example.com, 5, 2]");
    assert(fake.sent[3] == "DELETE FROM \"shop\".\"users\" WHERE \"id\" = $1 [3]");
    assert(fake.sent[4] == "COMMIT");

    // What the database stored is written back. A member that isn't in the answer keeps its value
    assert(ada.id == 7 && ada.name == "Ada" && ada.email == null && ada.cache == 9);
    assert(context.pendingChanges() == 0);

    // A failing change rolls back, and nothing is written back
    fake.sent.clear();
    cy := User{name: "Cy"};
    mallory := User{name: "Mallory"};
    users.create(&cy);
    users.create(&mallory);
    err := context.saveChanges();
    assert(err == "create in users (change 2 of 2): ERROR: no Mallory");
    assert(fake.sent.count == 4 && fake.sent[3] == "ROLLBACK");
    assert(cy.id == 0 && context.pendingChanges() == 2);
    context.discardChanges();

    // A row that isn't there
    fake.affected = 0;
    users.delete(4);
    assert(context.saveChanges() == "delete in users (change 1 of 1): No row has the key 4");
    context.discardChanges();
    fake.affected = 1;

    // Nothing to save sends nothing
    fake.sent.clear();
    assert(context.saveChanges() == "" && fake.sent.count == 0);

    print("dbms context ok");
}
