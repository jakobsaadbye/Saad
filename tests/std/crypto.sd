// crypto: SHA-256 and HMAC-SHA256 against the test vectors of FIPS 180-4 and RFC 4231
import crypto;
use fmt;

main :: () {
    assert(crypto.sha256("").hex() == "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855");
    assert(crypto.sha256("abc").hex() == "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad");
    assert(crypto.sha256("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq").hex() == "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1");

    // In parts, across the blocks, and 1000 times 'a' (more than a block, and a padding block of its own)
    long: [..]u8;
    for i in 0..1000 { long.add('a'); }
    text: string;
    text.data = long.data;
    text.len  = long.count;
    h: crypto.Sha256;
    for i in 0..1000 { h.write(text.slice(i, i + 1)); }
    assert(h.finish().hex() == crypto.sha256(text).hex());
    assert(crypto.sha256(text).hex() == "41edece42d63e8d9bf515a9ba6932e1c20cbc9f5a5d134645adb5db1b9737ea3");
    for n in 50..70 {   // Around the 56 bytes where the length needs a block of its own
        part := text.slice(0, n);
        h.write(part.slice(0, 7)); h.write(part.slice(7));
        assert(h.finish().hex() == crypto.sha256(part).hex());
    }

    // RFC 4231: test cases 1, 2 and 6 (a key longer than a block)
    key1: [20]u8;
    for i in 0..20 { key1[i] = 0x0b; }
    key1Text: string;
    key1Text.data = &key1[0];
    key1Text.len  = 20;
    assert(crypto.hmacSha256(key1Text, "Hi There").hex() == "b0344c61d8db38535ca8afceaf0bf12b881dc200c9833da726e9376c2e32cff7");
    assert(crypto.hmacSha256("Jefe", "what do ya want for nothing?").hex() == "5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843");
    key6: [131]u8;
    for i in 0..131 { key6[i] = 0xaa; }
    key6Text: string;
    key6Text.data = &key6[0];
    key6Text.len  = 131;
    assert(crypto.hmacSha256(key6Text, "Test Using Larger Than Block-Size Key - Hash Key First").hex() == "60e431591ee0b67f0d8a26aacbf5b77f8e0bc6213728c5140546040f0ee37f54");

    // A key used for many messages gives the same as one at a time
    signer := crypto.newHmacSha256("Jefe");
    for i in 0..3 { assert(signer.sum("what do ya want for nothing?").equals(crypto.hmacSha256("Jefe", "what do ya want for nothing?"))); }
    a := crypto.sha256("a");
    b := crypto.sha256("b");
    assert(!a.equals(b) && a.equals(a) && crypto.equal(a.bytes, a.bytes));
    print("crypto ok");
}
