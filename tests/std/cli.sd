// cli.parseArguments: the options of the command line, read into a struct. The test starts itself again with the
// arguments of each case (CLI_TEST says which struct), and the started one writes what it read as JSON, or the mistake
import cli;
import json;
import os;
use fmt;

Difficulty :: enum { easy, normal, inTransit, expert }

@cli.Options(about: "Runs games of bots, and says how they did", naming: .kebab)
Options :: struct {
    @cli.Arg(help: "The bots of each game", short: "b", min: 1, max: 8)
    botCount := 4;
    games := 3;
    seed:     u64 = 1;
    small:    i8;
    peaceful: bool;
    difficulty := Difficulty.expert;
    look:   f32 = 0.5;
    genome: ?string;
    tags:   [..]string;
    stats:  [3]int;           // Not an option, as a fixed array isn't read from the command line
    @cli.Arg(skip: true)
    cache := 7;
    @cli.Arg(name: "out", short: "o", required: true)
    output: string;
    @cli.Arg(positional: true, help: "Replays to watch")
    files:  [..]string;
}

// The names of the members, unless the struct or an option says otherwise
Camel :: struct {
    botCount := 4;
    @cli.Arg(naming: .kebab)
    maxSpeed := 1.0;
    @cli.Arg(naming: .snake)
    startLevel := 0;
    @cli.Arg(name: "v")
    verboseOutput: bool;
}

Copy :: struct {
    @cli.Arg(positional: true, required: true)
    from: string;
    @cli.Arg(positional: true)
    to:   string;
    for_: string;             // --for
}

// What the started test writes: the options and the members that were given
Read :: struct<T> {
    options: T;
    given:   [..]string;
}

// The started test: reads its own arguments into a T, and writes them as JSON, or the mistake with exit code 3. --help
// writes the help and ends with exit code 0
child :: <T>(given: (options: *T) -> [..]string) {
    options, err := cli.parseArguments<T>();
    if err != null {
        print("%", err.message);
        os.exit(3);
    }
    print("%", json.encode(Read<T>{options: options, given: given(&options)}));
    os.exit(0);
}

givenOptions :: (o: *Options) -> [..]string {
    given: [..]string;
    if cli.wasGiven(o, &o.botCount) { given.add("botCount"); }
    if cli.wasGiven(o, &o.peaceful) { given.add("peaceful"); }
    if cli.wasGiven(o, &o.output)   { given.add("output"); }
    if cli.wasGiven(o, &o.tags)     { given.add("tags"); }
    if cli.wasGiven(o, &o.cache)    { given.add("cache"); }
    if cli.wasGiven(o, &o.stats)    { given.add("stats"); }
    return given;
}

givenCamel :: (o: *Camel) -> [..]string {
    given: [..]string;
    if cli.wasGiven(o, &o.botCount)      { given.add("botCount"); }
    if cli.wasGiven(o, &o.maxSpeed)      { given.add("maxSpeed"); }
    if cli.wasGiven(o, &o.startLevel)    { given.add("startLevel"); }
    if cli.wasGiven(o, &o.verboseOutput) { given.add("verboseOutput"); }
    return given;
}

givenNone :: (o: *Copy) -> [..]string {
    given: [..]string;
    return given;
}

// Starts the test again with the arguments of a case, and gives what it read, or the message and exit code of a mistake
run :: <T>(name: string, arguments: []string) -> (Read<T>, string, int) {
    command := sprint("'%'", os.args()[0]);
    for argument in arguments { command = sprint("% '%'", command, argument); }
    os.setEnv("CLI_TEST", name);
    text, code := os.output(command);
    if text.endsWith("\n") { text = text.slice(0, text.len - 1); }
    read: Read<T>;
    if code == 0 && text.startsWith("{") {
        decoded, err := json.decode<Read<T>>(text);
        assert(err == null);
        read = decoded;
    }
    return read, text, code;
}

has :: (given: [..]string, name: string) -> bool {
    for g in given { if g == name { return true; } }
    return false;
}

parse :: (arguments: []string) -> (Options, string) {
    read, text, code := run<Options>("Options", arguments);
    if code != 0 { return read.options, text; }
    return read.options, "";
}

main :: () {
    which, started := os.getEnv("CLI_TEST");
    if started && which == "Options" { child<Options>(givenOptions); }
    if started && which == "Camel"   { child<Camel>(givenCamel); }
    if started && which == "Copy"    { child<Copy>(givenNone); }

    // Every kind of value, with its name and = or the next argument, short options, flags and positional values
    r, err, code := run<Options>("Options", ["-b", "6", "--games=5", "--peaceful", "--difficulty", "IN_TRANSIT", "--look", "0.25",
        "--genome", "g.txt", "--tags", "a", "--tags", "b", "x.rp", "-o", "out.txt", "y.rp",
        "--seed", "42", "--small", "-5"]);
    if code != 0 { print("%", err); }
    assert(code == 0);
    o := r.options;
    assert(o.botCount == 6 && o.games == 5 && o.seed == 42 && o.small == -5 && o.peaceful && o.difficulty == .inTransit);
    assert(o.look == 0.25 && o.genome ?? "" == "g.txt" && o.output == "out.txt");
    assert(o.tags.count == 2 && o.tags[1] == "b" && o.files.count == 2 && o.files[0] == "x.rp" && o.files[1] == "y.rp");

    // What isn't given keeps its default, and which options were given, also when given their default
    rd, _, c1 := run<Options>("Options", ["--out", "x", "--peaceful=false", "--bot-count=2"]);
    d := rd.options;
    assert(c1 == 0 && d.games == 3 && d.seed == 1 && d.look == 0.5 && d.difficulty == .expert && d.genome == null && d.cache == 7);
    assert(!d.peaceful && d.botCount == 2 && d.files.count == 0);
    assert(has(rd.given, "botCount") && has(rd.given, "peaceful") && has(rd.given, "output"));
    assert(!has(rd.given, "tags") && !has(rd.given, "cache") && !has(rd.given, "stats"));
    // Mistakes say what is wrong
    _, m1 := parse(["--out", "x", "--bots", "2"]);
    assert(m1 == "Unknown option '--bots'. --help lists the options");
    _, m2 := parse(["--out", "x", "--bot-cont", "2"]);
    assert(m2 == "Unknown option '--bot-cont' (did you mean --bot-count?). --help lists the options");
    _, m3 := parse(["--out", "x", "--games", "many"]);
    assert(m3 == "--games is a whole number, not 'many'. --help lists the options");
    _, m4 := parse(["--out", "x", "--difficulty", "hard"]);
    assert(m4 == "--difficulty is one of easy, normal, inTransit, expert, not 'hard'. --help lists the options");
    _, m5 := parse(["--out", "x", "--games"]);
    assert(m5 == "--games needs a value, e.g --games <n>. --help lists the options");
    _, m6 := parse(["--out", "x", "-b", "9"]);
    assert(m6 == "--bot-count is from 1 to 8, not 9. --help lists the options");
    _, m7 := parse(["--games", "1"]);
    assert(m7 == "--out is needed. --help lists the options");
    _, m8 := parse(["--out", "x", "--small", "200"]);
    assert(m8 == "--small is from -128 to 127, not 200. --help lists the options");
    _, m9 := parse(["--out", "x", "--seed", "-1"]);
    assert(m9 == "--seed can't be negative, not -1. --help lists the options");
    _, m10 := parse(["--out", "x", "--peaceful=maybe"]);
    assert(m10 == "--peaceful is true or false, not 'maybe'. --help lists the options");
    _, m11 := parse(["--out", "x", "--look", "fast"]);
    assert(m11 == "--look is a number, not 'fast'. --help lists the options");
    _, m12 := parse(["--out", "x", "--stats", "1"]);
    assert(m12 == "Unknown option '--stats' (did you mean --tags?). --help lists the options");
    _, _, eKind := run<Options>("Options", ["--nope"]);
    assert(eKind == 3);

    rg, _, c8 := run<Camel>("Camel", ["--botCount", "4", "--v"]);
    assert(c8 == 0 && has(rg.given, "botCount") && has(rg.given, "verboseOutput"));
    assert(!has(rg.given, "maxSpeed") && !has(rg.given, "startLevel"));

    // camelCase by default, and an option can be named otherwise
    rk, _, c6 := run<Camel>("Camel", ["--botCount", "2", "--max-speed", "2.5", "--start_level", "3", "--v"]);
    k := rk.options;
    assert(c6 == 0 && k.botCount == 2 && k.maxSpeed == 2.5 && k.startLevel == 3 && k.verboseOutput);
    _, m13, _ := run<Camel>("Camel", ["--bot-count", "2"]);
    assert(m13 == "Unknown option '--bot-count' (did you mean --botCount?). --help lists the options");
    camelHelp := cli.helpOf<Camel>("bots");
    assert(camelHelp.indexOf("--botCount <n>") >= 0 && camelHelp.indexOf("--max-speed <number>") >= 0 && camelHelp.indexOf("--start_level <n>") >= 0);

    // Positional values, in the order of the members, and -- before values that look like options
    rc, _, c2 := run<Copy>("Copy", ["a.txt", "--for", "me", "b.txt"]);
    assert(c2 == 0 && rc.options.from == "a.txt" && rc.options.to == "b.txt" && rc.options.for_ == "me");
    rc2, _, c3 := run<Copy>("Copy", ["--", "-x"]);
    assert(c3 == 0 && rc2.options.from == "-x" && rc2.options.to == "");
    none: []string;
    _, m14, _ := run<Copy>("Copy", none);
    assert(m14 == "<from> is needed. --help lists the options");
    _, m15, _ := run<Copy>("Copy", ["a", "b", "c"]);
    assert(m15 == "Didn't expect 'c'. --help lists the options");

    // --help writes the help, made from the members and their attributes, and ends the program
    help := cli.helpOf<Options>("race");
    expected := "Runs games of bots, and says how they did

Usage: race [options] [files...]

Options:
  -b, --bot-count <n>               The bots of each game (1 to 8, default 4)
      --games <n>                   (default 3)
      --seed <n>                    (default 1)
      --small <n>                   (default 0)
      --peaceful
      --difficulty <easy|normal|inTransit|expert>
                                    (default expert)
      --look <number>               (default 0.5)
      --genome <text>
      --tags <text>                 (can be given more than once)
  -o, --out <text>                  (needed)
  <files>                           Replays to watch
  -h, --help                        Shows this help
";
    if help != expected { print("%", help); }
    assert(help == expected);
    _, written, c4 := run<Options>("Options", ["--help"]);
    assert(c4 == 0 && written.startsWith("Runs games of bots") && written.indexOf("  -h, --help") >= 0);
    assert(cli.helpOf<Copy>("copy").startsWith("Usage: copy [options] <from> [to]\n"));

    print("cli ok");
}
