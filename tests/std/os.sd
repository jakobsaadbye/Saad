// std/os/os.sd and std/time.sd

use fmt;

import os;
import time;

main :: () {
    {
        path := "build/std_os_test.txt";
        assert(os.writeFile(path, "Hello") == null);
        assert(os.appendFile(path, ", World") == null);
        assert(os.fileExists(path));

        text, err := os.readFile(path);
        assert(err == null);
        assert(text == "Hello, World");

        newPath := "build/std_os_test_renamed.txt";
        assert(os.renameFile(path, newPath) == null);
        assert(!os.fileExists(path));
        assert(os.removeFile(newPath) == null);
        assert(!os.fileExists(newPath));

        _, missing := os.readFile("build/this_file_does_not_exist.txt");
        assert(missing != null && missing.is(os.NotFound));
        assert(os.removeFile("build/this_file_does_not_exist.txt").is(os.NotFound));
    }
    {
        // A file bigger than the first buffer of readFile
        line := "0123456789abcdefghijklmnopqrstuvwxyz\n";
        assert(os.writeFile("build/std_os_big.txt", "") == null);
        for 0..500 {
            os.appendFile("build/std_os_big.txt", line);
        }
        text := os.readFile("build/std_os_big.txt");   // Thrown if it can't be read
        assert(text.len == 500 * line.len);
        assert(text.slice(text.len - line.len) == line);
        os.removeFile("build/std_os_big.txt");
    }
    {
        // What a command writes, and its exit code
        text, code := os.output("echo hello");
        assert(code == 0);
        assert(text.startsWith("hello"));

        _, failed := os.output("exit 3");
        assert(failed == 3);

        // The program itself is the first argument
        args := os.args();
        assert(args.count >= 1 && args[0].len > 0);
    }
    {
        _, ok := os.getEnv("SAAD_SURELY_NOT_SET_VARIABLE");
        assert(!ok);
        assert(os.run("exit 3") != 0);
        assert(os.run("exit 0") == 0);
    }
    {
        assert(time.now().unix() > 1700000000);

        watch := time.startStopwatch();
        time.sleep(20);
        ms := watch.milliseconds();
        assert(ms >= 15.0 && ms < 2000.0);
        assert(watch.seconds() < 2.0);

        watch.restart();
        assert(watch.milliseconds() < 15.0);
    }

    print("ok");
}
