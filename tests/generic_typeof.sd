Point :: struct { x: int; y: int; }

typeName :: <T>(value: T) -> string {
    return typeof(value);
}

elementType :: <T>(values: []T) -> string {
    first: T;
    return typeof(first);
}

main :: () {
    assert(typeName(1) == "int");
    assert(typeName(1.5) == "float");
    assert(typeName(true) == "bool");
    assert(typeName("hi") == "string");
    assert(typeName(Point{1, 2}) == "Point");

    p := Point{1, 2};
    assert(typeName(&p) == "*Point");

    numbers: [..]u8;
    numbers.add(1);
    assert(elementType(numbers) == "u8");
}
