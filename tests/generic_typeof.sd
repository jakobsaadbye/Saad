Point :: struct { x: int; y: int; }

type_name :: <T>(value: T) -> string {
    return typeof(value);
}

element_type :: <T>(values: []T) -> string {
    first: T;
    return typeof(first);
}

main :: () {
    assert(type_name(1) == "int");
    assert(type_name(1.5) == "float");
    assert(type_name(true) == "bool");
    assert(type_name("hi") == "string");
    assert(type_name(Point{1, 2}) == "Point");

    p := Point{1, 2};
    assert(type_name(&p) == "*Point");

    numbers: [..]u8;
    append(numbers, 1);
    assert(element_type(numbers) == "u8");
}
