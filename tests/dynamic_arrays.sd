import "fmt";

Vector2 :: struct {
    x, y: f32;
}

Fruit :: enum {
    mango,
    kiwi,
    dragonfruit,
    apple,
    orange,
    grape,
}

main :: () {
    {
        // Simple numbers
        numbers: [..]u8;
        
        numbers.add(1 + 2);
        numbers.add(2);
        numbers.add(3);
        numbers.add(4);
        numbers.add(5);
    
        for v in numbers {
            print("v = %\n", v);
        }
    
        assert(numbers.count == 5);
        assert(numbers.capacity == 8);
    }
    {
        // Structs
        verticies: [..]Vector2;

        verticies.add({1, 2});
        verticies.add({3, 4});
        verticies.add({5, 6});
        verticies.add({7, 8});
        verticies.add({9, 10});

        for v in verticies {
            print("v = %\n", v);
        }
    }
    {
        // Struct, but in a variable
        arr: [..]Vector2;

        start := Vector2{6, 9};
        arr.add(start);

        for v in arr {
            Print("%", v);
        }
    }
    {
        // Enums
        fruits: [..]Fruit;

        fruits.add(.mango);
        fruits.add(.kiwi);
        fruits.add(.dragonfruit);
        fruits.add(.apple);
        fruits.add(.orange);

        for v in fruits {
            print("v = %\n", v);
        }
    }
    

}