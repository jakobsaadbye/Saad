// Indexing a **T twice: p[k][j] is the j-th of the k-th row, for reading, writing and taking its address. And the
// pointer a call gives back can be indexed too

V :: struct { x, y, z: f32; }

rowOf :: (rows: **int, k: int) -> *int {
    return rows[k];
}

main :: () {
    a: [2]V; b: [2]V; c: [2]V;
    a[1].x = 1; b[1].x = 2; c[1].x = 3;
    rows: [3]*V;
    rows[0] = &a[0]; rows[1] = &b[0]; rows[2] = &c[0];
    p: **V = &rows[0];
    k := 2;
    assert(p[0][1].x == 1);
    assert(p[1][1].x == 2);
    assert(p[k][1].x == 3);

    p[1][0].y = 7;
    assert(b[0].y == 7);
    q := &p[k][1];
    q.z = 9;
    assert(c[1].z == 9);

    i0: [2]int; i1: [2]int;
    i0[1] = 10; i1[1] = 11;
    ints: [2]*int;
    ints[0] = &i0[0]; ints[1] = &i1[0];
    pi: **int = &ints[0];
    assert(pi[0][1] == 10);
    assert(pi[1][1] == 11);
    pi[1][0] = 5;
    assert(i1[0] == 5);
    assert(rowOf(pi, 1)[1] == 11);
    assert(rowOf(pi, 0)[1] == 10);
}
