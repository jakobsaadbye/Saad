namespace entities;

import time;

// A row of users
User :: struct {
    id:        i64;
    name:      string;
    email:     ?string;
    age:       ?i32;
    role:      Role = .guest;
    active:    bool = true;
    score:     f64 = 0.0;
    createdAt: time.Time;
}
