// The code that std/db/postgres/generate.sd wrote (tests/db/shop/shop.sd), used on the database it was written from

import db;
import db.postgres;
import shop;
import shopsetup;
use fmt;
use c;

main :: () {
    conn, err := postgres.connect(fromCString(getenv(xx "SAAD_TEST_POSTGRES")));
    assert(err == "");
    shopsetup.create(&conn);

    app := shop.open(&conn);

    // Insert gives back what the database made: the key from the serial and created_at from now()
    ada, e1 := app.users.insert(shop.User{name: "Ada", email: "ada@example.com", age: 36, role: .admin});
    assert(e1 == "");
    assert(ada.id == 1 && ada.name == "Ada" && ada.role == .admin);
    assert(ada.createdAt.len > 0);
    assert(ada.active && ada.score == 0.0); // The defaults of the database are the defaults of the struct

    bo, e2 := app.users.insert(shop.User{name: "Bo"});
    assert(e2 == "" && bo.id == 2 && bo.email == null && bo.age == null && bo.role == .guest);

    count, e3 := app.users.count();
    assert(e3 == "" && count == 2);

    // get gives an optional
    found, e4 := app.users.get(ada.id);
    assert(e4 == "" && found?.name == "Ada" && found?.email == "ada@example.com");
    missing, e5 := app.users.get(99);
    assert(e5 == "" && missing == null);

    // update writes the row with its key
    bo.email = "bo@example.com";
    bo.active = false;
    changed, e6 := app.users.update(bo);
    assert(e6 == "" && changed == 1);
    again, _ := app.users.get(bo.id);
    assert(again?.email == "bo@example.com" && again?.active == false);

    // Enums, numeric as text, a varchar with a default, and a column named with a keyword
    order, e7 := app.orders.insert(shop.Order{userId: ada.id, status: .in_transit, total: "12.50", type: "gift"});
    assert(e7 == "");
    assert(order.id == 1 && order.status == .in_transit && order.total == "12.50" && order.note == "none" && order.type == "gift");

    // A table with a key of two columns has insert and all
    _, e8 := app.orderItems.insert(shop.OrderItem{orderId: order.id, product: "tea", quantity: 3});
    _, e9 := app.orderItems.insert(shop.OrderItem{orderId: order.id, product: "cake"});
    assert(e8 == "" && e9 == "");
    items, e10 := app.orderItems.all();
    assert(e10 == "" && items.count == 2);
    quantities := items.reduce(0, (sum: int, item: shop.OrderItem) -> int { return sum + item.quantity; });
    assert(quantities == 4);

    // A text key, and the column "for", which is the member for_
    category, e11 := app.categories.insert(shop.Category{code: "books", for_: "readers"});
    assert(e11 == "" && category.code == "books" && category.for_ == "readers" && category.uid == null);
    books, _ := app.categories.get("books");
    assert(books?.for_ ?? "" == "readers");

    // delete
    removed, e12 := app.categories.delete("books");
    assert(e12 == "" && removed == 1);
    gone, _ := app.categories.get("books");
    assert(gone == null);

    // Errors of the database come back as errors, e.g the user of an order must exist
    _, e13 := app.orders.insert(shop.Order{userId: 999});
    assert(e13.startsWith("ERROR:") && e13.indexOf("foreign key") >= 0);

    // all, with the methods of lists
    users, e14 := app.users.all();
    assert(e14 == "" && users.count == 2);
    admins := users.filter((u: shop.User) -> bool { return u.role == .admin; }).map((u: shop.User) -> string { return u.name; });
    assert(admins.count == 1 && admins[0] == "Ada");

    conn.close();
    print("shop tables ok");
}
