namespace entities;

import db;

// A row of users
User :: struct {
    id:        i64;
    name:      string;
    email:     ?string;
    age:       ?i32;
    role:      Role = .guest;
    active:    bool = true;
    score:     f64 = 0.0;
    createdAt: string;        // timestamp with time zone
}

// The rows of users: all, get, insert, update, delete and count of db.KeyedTable
UsersTable :: struct {
    @embed table: db.KeyedTable<User, i64>;
}
