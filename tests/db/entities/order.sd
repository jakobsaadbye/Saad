// A row of orders
Order :: struct {
    id:     i32;
    userId: i64;
    status: OrderStatus = .open;
    total:  ?string;             // numeric
    note:   ?string = "none";
    type:   ?string;
}

// The rows of orders: all, get, insert, update, delete and count of db.KeyedTable
