namespace entities;

import db;

// Files: order_status.sd, role.sd, category.sd, order_item.sd, order.sd, user.sd, database.sd

// The tables of the schema saad_shop, e.g
//
//     app := entities.open(&conn);
//     rows, err := app.categories.all();
Database :: struct {
    categories: CategoriesTable;
    orderItems: OrderItemsTable;
    orders:     OrdersTable;
    users:      UsersTable;
}

// The tables on the connection
open :: (conn: *db.Connection) -> Database {
    tables: Database;
    tables.categories.table = db.keyedTable<Category, string>(conn, "categories", "code", schema: "saad_shop");
    tables.orderItems.table = db.table<OrderItem>(conn, "order_items", schema: "saad_shop");
    tables.orders.table     = db.keyedTable<Order, i32>(conn, "orders", "id", schema: "saad_shop");
    tables.users.table      = db.keyedTable<User, i64>(conn, "users", "id", schema: "saad_shop");
    tables.orders.generated = ["id"];
    tables.users.generated = ["id", "created_at"];
    return tables;
}
