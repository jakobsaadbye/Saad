// changing it, e.g saad run std/db/tools/generate.sd -- "host=localhost dbname=app" <this file> shop
namespace shop;

import db;

// The enum order_status
OrderStatus :: enum { open, paid, in_transit, delivered }

// The enum role
Role :: enum { guest, member, admin }

// A row of categories
Category :: struct {
    @db.Column(key: true)
    code: string;
    @db.Column(name: "for")
    for_: ?string;
    uid:  ?string; // uuid
}

// A row of order_items
OrderItem :: struct {
    orderId:  i32;
    product:  string;
    quantity: i16 = 1;
}

// A row of orders
Order :: struct {
    @db.Column(key: true, generated: true)
    id:     i32;
    userId: i64;
    status: OrderStatus = .open;
    total:  ?string;             // numeric
    note:   ?string = "none";
    type:   ?string;
}

// A row of users
User :: struct {
    @db.Column(key: true, generated: true)
    id:        i64;
    name:      string;
    email:     ?string;
    age:       ?i32;
    role:      Role = .guest;
    active:    bool = true;
    score:     f64 = 0.0;
    @db.Column(generated: true)
    createdAt: string;        // timestamp with time zone
}

// The tables of the schema saad_shop, on a connection, e.g
//
//     app := shop.open(&conn);
//     rows, err := app.categories.all();
Database :: struct {
    categories: CategoriesTable;
    orderItems: OrderItemsTable;
    orders:     OrdersTable;
    users:      UsersTable;
}

open :: (conn: *db.Connection) -> Database {
    tables: Database;
    tables.categories.table = db.Table<Category>{conn: conn, name: "categories", schema: "saad_shop"};
    tables.orderItems.table = db.Table<OrderItem>{conn: conn, name: "order_items", schema: "saad_shop"};
    tables.orders.table     = db.Table<Order>{conn: conn, name: "orders", schema: "saad_shop"};
    tables.users.table      = db.Table<User>{conn: conn, name: "users", schema: "saad_shop"};
    return tables;
}

// The rows of categories
CategoriesTable :: struct {
    table: db.Table<Category>;

    all :: method () -> ([..]Category, string) {
        rows, err := self.table.all();
        return rows, err;
    }

    // The row with the key, or empty
    get :: method (key: string) -> (?Category, string) {
        found, err := self.table.get(key);
        return found, err;
    }

    // Adds the row, and gives it back with what the database made, e.g its key
    insert :: method (row: Category) -> (Category, string) {
        saved, err := self.table.insert(row);
        return saved, err;
    }

    // Writes the row to the row with its key. Gives the number of rows changed
    update :: method (row: Category) -> (i64, string) {
        changed, err := self.table.update(row);
        return changed, err;
    }

    // Removes the row with the key. Gives the number of rows removed
    delete :: method (key: string) -> (i64, string) {
        removed, err := self.table.delete(key);
        return removed, err;
    }

    count :: method () -> (i64, string) {
        n, err := self.table.count();
        return n, err;
    }
}

