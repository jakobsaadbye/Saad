// Control flow: short-circuit evaluation, nested loops with break/continue, recursion,
// early returns and function pointers.

sideEffect :: (result: bool, counter: *int) -> bool {
    *counter = *counter + 1;
    return result;
}

fib :: (n: int) -> int {
    if n < 2 { return n; }
    return fib(n - 1) + fib(n - 2);
}

firstEven :: (xs: []int) -> int {
    for x in xs {
        if x % 2 == 0 { return x; }
    }
    return -1;
}

apply :: (f: (value: int) -> int, x: int) -> int {
    return f(x);
}

// Inner functions with the same name in different scopes get distinct symbols
innerOne :: () -> int {
    helper :: () -> int { return 1; }
    return helper();
}
innerTwo :: () -> int {
    helper :: () -> int { return 2; }
    return helper();
}

double :: (x: int) -> int { return x * 2; }
square :: (x: int) -> int { return x * x; }

main :: () {
    // Short-circuit: the right side must not run
    count := 0;
    if sideEffect(false, &count) && sideEffect(true, &count) { assert(false); }
    assert(count == 1);
    if sideEffect(true, &count) || sideEffect(true, &count) { } else { assert(false); }
    assert(count == 2);
    value := sideEffect(false, &count) && sideEffect(true, &count);
    assert(!value);
    assert(count == 3);
    value = sideEffect(false, &count) || sideEffect(true, &count);
    assert(value);
    assert(count == 5);

    // Nested loops
    total := 0;
    for i in 0..10 {
        if i == 7 { break; }
        for j in 0..10 {
            if j == 3 { continue; }
            if j == 6 { break; }
            total += 1;
        }
    }
    assert(total == 35);

    k := 0;
    while k < 100 {
        k += 1;
        if k % 2 == 0 { continue; }
        if k > 50 { break; }
    }
    assert(k == 51);

    // Recursion
    assert(fib(20) == 6765);

    // Early return from inside a loop
    assert(firstEven([1, 3, 5, 8, 9]) == 8);
    assert(firstEven([1, 3]) == -1);

    // Function pointers
    assert(apply(double, 21) == 42);
    assert(apply(square, 9) == 81);
    f := double;
    assert(f(5) == 10);
    f = square;
    assert(f(5) == 25);

    assert(innerOne() == 1);
    assert(innerTwo() == 2);
}
