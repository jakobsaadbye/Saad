// switch on values, ranges and strings, and switch expressions

Status :: enum { open, closed, locked }

describe :: (s: Status) -> string {
    // Every value is handled, so there is no else
    switch s {
        case .open   { return "open"; }
        case .closed
        case .locked { return "shut"; }  // Cases right after each other share the block
    }
    return "?";
}

grade :: (score: int) -> string {
    switch score {
        case 90...100 { return "A"; }   // 90 to 100
        case 80..90   { return "B"; }   // 80 to 89
        case 0
        case -1       { return "none"; }
        else          { return "C"; }
    }
    return "";
}

// A switch expression gives the value of the case that matches
size :: (s: Status) -> int {
    return switch s {
        case .open   => 1;
        case .closed
        case .locked => 2;
    };
}

next :: (n: *int) -> int {
    *n += 1;
    return *n;
}

main :: () {
    assert(describe(.open) == "open");
    assert(describe(.closed) == "shut" && describe(.locked) == "shut");

    assert(grade(95) == "A" && grade(100) == "A" && grade(90) == "A");
    assert(grade(89) == "B" && grade(80) == "B");
    assert(grade(0) == "none" && grade(-1) == "none");
    assert(grade(50) == "C" && grade(101) == "C");

    {
        // Switch expressions
        assert(size(.open) == 1 && size(.locked) == 2);

        choices: [..]string;
        for x in 0..4 {
            choice := switch x {
                case 1 => "icecream";
                case 2 => "coffee";
                else   => "mango";
            };
            choices.add(choice);
        }
        assert(choices[0] == "mango" && choices[1] == "icecream" && choices[2] == "coffee" && choices[3] == "mango");

        // The wanted type is the type of the switch
        big: i64 = switch choices.count {
            case 4 => 5000000000;
            else   => 0;
        };
        assert(big == 5000000000);

        // Ranges, and a switch inside a case
        letter := switch 85 {
            case 90...100 => "A";
            case 80..90   => switch 1 {
                case 1 => "B";
                else   => "?";
            };
            else          => "C";
        };
        assert(letter == "B");

        // In an expression
        doubled := 2 * switch Status.closed {
            case .open => 10;
            else       => 20;
        };
        assert(doubled == 40);
    }

    {
        // Strings
        result := "";
        switch "beta" {
            case "alpha"         { result = "a"; }
            case "beta"
            case "gamma" { result = "b or g"; }
        }
        assert(result == "b or g");
    }
    {
        // The value is evaluated once
        n := 0;
        switch next(&n) {
            case 5 { }
            case 3 { }
            case 1 { }
        }
        assert(n == 1);
    }
    {
        // break and continue are for the loop around the switch
        seen := 0;
        for i in 0..10 {
            switch i {
                case 2 { continue; }
                case 5 { break; }
            }
            seen += 1;
        }
        assert(seen == 4); // 0, 1, 3, 4
    }
    {
        // Only an else
        hit := false;
        switch 7 {
            else { hit = true; }
        }
        assert(hit);

        // No case matches and there is no else
        x := 3;
        switch x {
            case 1 { x = 100; }
        }
        assert(x == 3);
    }
}
