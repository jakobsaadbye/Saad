// switch on values, ranges, strings and conditions

Status :: enum { open, closed, locked }

describe :: (s: Status) -> string {
    // Every value is handled, so there is no else
    switch s {
        case .open   { return "open"; }
        case .closed
        case .locked { return "shut"; }  // Cases right after each other share the block
    }
    return "?";
}

grade :: (score: int) -> string {
    switch score {
        case 90...100 { return "A"; }   // 90 to 100
        case 80..90   { return "B"; }   // 80 to 89
        case 0
        case -1       { return "none"; }
        else          { return "C"; }
    }
    return "";
}

sign :: (x: f64) -> int {
    switch {
        case x < 0.0  { return -1; }
        case x == 0.0 { return 0; }
        else          { return 1; }
    }
    return 9;
}

next :: (n: *int) -> int {
    *n += 1;
    return *n;
}

main :: () {
    assert(describe(.open) == "open");
    assert(describe(.closed) == "shut" && describe(.locked) == "shut");

    assert(grade(95) == "A" && grade(100) == "A" && grade(90) == "A");
    assert(grade(89) == "B" && grade(80) == "B");
    assert(grade(0) == "none" && grade(-1) == "none");
    assert(grade(50) == "C" && grade(101) == "C");

    assert(sign(-2.5) == -1 && sign(0.0) == 0 && sign(3.0) == 1);

    {
        // Strings
        result := "";
        switch "beta" {
            case "alpha"         { result = "a"; }
            case "beta"
            case "gamma" { result = "b or g"; }
        }
        assert(result == "b or g");
    }
    {
        // The value is evaluated once
        n := 0;
        switch next(&n) {
            case 5 { }
            case 3 { }
            case 1 { }
        }
        assert(n == 1);
    }
    {
        // break and continue are for the loop around the switch
        seen := 0;
        for i in 0..10 {
            switch i {
                case 2 { continue; }
                case 5 { break; }
            }
            seen += 1;
        }
        assert(seen == 4); // 0, 1, 3, 4
    }
    {
        // Only an else
        hit := false;
        switch 7 {
            else { hit = true; }
        }
        assert(hit);

        // No case matches and there is no else
        x := 3;
        switch x {
            case 1 { x = 100; }
        }
        assert(x == 3);
    }
}
