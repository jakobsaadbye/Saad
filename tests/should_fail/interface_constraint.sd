// expect-error: 'S' of 'totalArea' must be a Shape, but it is Plain
// expect-error: Plain isn't a Shape: it has no method 'area'

Shape :: interface { area :: method () -> f64; }
Plain :: struct { x: int; }
totalArea :: <S: Shape>(shapes: []S) -> f64 { return 0.0; }

main :: () {
    ps := [Plain{x: 1}];
    totalArea(ps);
}
