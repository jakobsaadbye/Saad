// Used by the namespace tests in tests/should_fail
namespace shapes;

Vec2 :: struct {
    x: f64;
    y: f64;

    @private
    secret :: method () -> int { return 7; }
}

@private
twiceInternal :: (x: int) -> int { return x * 2; }

@private
operator + :: (a: Vec2, b: Vec2) -> Vec2 { return Vec2{a.x + b.x, a.y + b.y}; }
