// expect-error: Cannot call the method 'clear', which can change its receiver, on self in the non-mutating method Counter.getAndClear

Counter :: struct {
    count: int;

    clear :: method * () {
        self.count = 0;
    }

    getAndClear :: method () -> int {
        value := self.count;
        self.clear();
        return value;
    }
}

main :: () {
}
