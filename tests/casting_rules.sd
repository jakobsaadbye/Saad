use fmt;

Pi      :: 3.1415929;
Tau     :: Pi * 2;
PiHalf :: 1.570795;

HoldType :: enum {
    crimp,
    sloper,
    jug,
}

main :: () {

    x := Pi;

    // print("--- Integer -> X casts ---");
    x1: int = xx 280;
    x2: float = xx 5;
    x3: bool = xx 1;
    x4: HoldType = xx 2;

    assert(x1 == 280);
    assert(x2 == 5.0);
    assert(x3);
    assert(x4 == .jug);

    // print("--- Float -> X casts ---");
    a1: f32 = xx 69.0;
    a2: f64 = xx a1;   // up casting
    a3: f32 = xx a2;   // down casting
    a4: int = xx Pi;   // float32 -> int
    a5: int = xx a2;   // float64 -> int
    a6: bool = xx -0.1;
    assert(a6);

    // print("--- Enum -> X casts ---");
    b1 := (xx HoldType.crimp + 1);
    b2 := b1 as HoldType;
    // print("%", b1);
    // print("%", b2);

    // print("--- Boolean -> X casts ---");
    c1: int = xx false;
    c2: int = xx true;
    assert(c1 == 0);
    assert(c2 == 1);
}

