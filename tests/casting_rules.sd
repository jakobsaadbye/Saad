use fmt;

Pi  :: 3.1415929;
Tau :: Pi * 2;
PiHalf :: 1.570795;

HoldType :: enum {
    crimp,
    sloper,
    jug,
}

main :: () {
    x := Pi;

    // print("--- Integer -> X casts ---");
    x1: int = 280 as int;
    x2: float = 5 as float;
    x3: bool = 1 as bool;
    x4: HoldType = 2 as HoldType;

    assert(x1 == 280);
    assert(x2 == 5.0);
    assert(x3);
    assert(x4 == .jug);

    // print("--- Float -> X casts ---");
    a1: f32 = 69.0 as f32;
    a2: f64 = a1 as f64;   // up casting
    a3: f32 = a2 as f32;   // down casting
    a4: int = Pi as int;   // float32 -> int
    a5: int = a2 as int;   // float64 -> int
    a6: bool = -0.1 as bool;
    assert(a6);

    // print("--- Enum -> X casts ---");
    b1 := (HoldType.crimp as int + 1);
    b2 := b1 as HoldType;
    // print("%", b1);
    // print("%", b2);

    // print("--- Boolean -> X casts ---");
    c1: int = false as int;
    c2: int = true as int;
    assert(c1 == 0);
    assert(c2 == 1);
}
