use fmt;

Fruit :: enum {
    mango,
    kiwi,
    watermelon,
    dragonfruit,
    pear,
    apple
}

Vector3 :: struct {
    x, y, z: float;
}

EntityKind :: enum {
    wall,
    monster,
    human,
}

Entity :: struct {
    kind:     EntityKind;
    position: Vector3;
    rotation: Vector3;
    dead:     bool;
}

main :: () {
    print("-------------------- Primitive types ----------------");
    if true {
        x: any = 5 as u8;
        assert(x.type.kind == .int);
        
        type := x.type as *TypePrimitive;
        print("TypePrimitive = %", *type);
    }
    print("\n-------------------- Array type ----------------");
    if true {
        x: any = [1, 2, 3];

        assert(x.type.kind == .array);

        type := x.type as *TypeArray;
        print("TypeArray = %", *type);
        print("ElemType  = %", *type.elemType);
    }
    print("\n-------------------- Enum type ----------------");
    if true {
        x: any = Fruit.watermelon;

        assert(x.type.kind == .enum);

        type := x.type as *TypeEnum;
        print("TypeEnum = %", *type);
        print("BackingType = %", *type.backingType);
    }
    print("\n-------------------- Struct type ----------------");
    if true {
        x: any = Entity{
            kind: .human,
            position: Vector3{3, 3, 3},
            rotation: Vector3{0, 0.5, 0},
            dead: false,
        };

        assert(x.type.kind == .struct);
        printStructType(x.type as *TypeStruct);
    }
    print("\n-------------------- Changing types at runtime ----------------");
    if true {
        x: any = 5;
        print("%", *x.type);
        assert(x.type.kind == .int);

        x = Vector3{1, 4, 9};
        assert(x.type.kind == .struct);
        printStructType(x.type as *TypeStruct);

        x = Entity{
            kind: .human,
            position: Vector3{3, 3, 3},
            rotation: Vector3{0, 0.5, 0},
            dead: false,
        };
        assert(x.type.kind == .struct);
        printStructType(x.type as *TypeStruct);
    }
}

printStructType :: (structType: *TypeStruct) {
    print("% :: struct {", structType.head.name);
    for member in structType.members {
        print("\t%: %;", member.name, member.type.name);
    }
    print("}");
}