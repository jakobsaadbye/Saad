Point :: struct {
  x:int;
     y : int = -1;
  label:string;  // Lined up
  ok:   bool;    // with the label
    @embed base : Base;
}

Base :: struct { id: i64; }

Shape :: union { circle: f64; empty; }

scale :: method * (p: *Point,factor:int) {
p.x*=factor;
    p.y = p.y*factor+ -1;
}

sum :: <T>(xs: []T) -> T {
    total : T;
    for x in xs { total+=x; }
    return total;
}

