use fmt;
use c; // printf

myPrint2 :: (format: string, args: ...any) {
    for arg, i in args {
        print("%", *arg.type);
    }
}

myPrint3 :: (format: string, args: ...any) {
    myPrint3Helper(format, ...args);
}

myPrint3Helper :: (format: string, args: ...any) {
    for arg, i in args {
        print("%", *arg.type);
    }
}

functionWithAny :: (x: any) {
    print("%", *x.type);
}

MyJsonData :: struct {
    data: any;
    contentLength: int;
}

Vector3 :: struct {
    x, y, z: float;
}

main :: () {
    print("----------- Struct with any member -----------");
    {
        x := MyJsonData{3.14, 1};
        print("%", *x.data.type);
    }
    print("----------- Array of any -----------");
    {
        x: []any = [3.14, 5, Vector3{1, 4, 9}, [1 as int, 2, 3]];
        print("%", *x[0].type);
        print("%", *x[1].type);
        print("%", *x[2].type);
        print("%", *x[3].type);
    }
    print("----------- Passing argument to an any parameter -----------");
    {
        functionWithAny(3);
    }
    print("----------- Passing arguments to an any variadic parameter -----------");
    {
        myPrint2("Hello %s", "World", "Hellope", 3.14);
    }
    print("----------- Passing arguments to an any variadic parameter into another variadic parameter -----------");
    {
        myPrint3("Hello %s", "World", "Hellope", 3.14);
    }
    print("---------------- Passing variadic arguments to C function ----------------");
    {
        printf(xx "Passing %s arguments into %s functions is %d doable", "variadic".data, "C".data, 100);
    }
}