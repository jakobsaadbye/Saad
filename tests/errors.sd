// Errors: a value when it is taken, thrown when it isn't, and caught with try and catch
use fmt;

NotFound :: ErrorKind{"NotFound"};

find :: (name: string) -> (int, error) {
    if name == "ada" { return 36, null; }
    return 0, newError(sprint("no one is called %", name), NotFound);
}

log: [..]string;

age :: (name: string) -> int {
    defer log.add(sprint("left age(%)", name));
    a := find(name);                       // The error isn't taken, so it is thrown
    return a + 1;
}

save :: (ok: bool) -> error {
    if ok { return null; }
    return errorf("can't save %", 42);
}

third :: (sl: []int) -> int { return sl[2]; }

Link :: struct {
    value: int;
    next:  *Link;

    nextValue :: method () -> int { return self.next.value; }
}

divide :: (a: int, b: int) -> int {
    return a / b;
}

// An error thrown deeper is caught here, and a new one thrown with it as the cause
load :: (name: string) -> int {
    try {
        return age(name);
    } catch (err) {
        throw newError("loading failed", cause: err);
    }
    return 0;
}

main :: () {
    // Taken: a value
    a, err := find("bo");
    assert(a == 0 && err != null && err.message == "no one is called bo" && err.is(NotFound));
    b, none := find("ada");
    assert(b == 36 && none == null);

    // Not taken: thrown, through the defers, to the catch, with a frame for each function it left
    assert(age("ada") == 37);
    caught := false;
    try {
        age("bo");
        assert(false);                     // Not reached
    } catch (e) {
        caught = true;
        assert(e.is(NotFound) && e.trace.count == 2);
        assert(e.trace[0].function.toString() == "age" && e.trace[1].function.toString() == "main");
    }
    assert(caught && log.count == 2 && log[1] == "left age(bo)");

    // A function that gives only an error, as a statement, throws it
    save(true);
    try {
        save(false);
        assert(false);
    } catch (e) {
        assert(e.message == "can't save 42");
    }
    taken := save(false);                  // Taken: a value
    assert(taken.message == "can't save 42");

    // A division by zero is a Panic
    try {
        divide(1, 0);
        assert(false);
    } catch (e) {
        assert(e.is(Panic) && e.message == "Division by zero");
    }

    // An index outside of the elements is a Panic: of a fixed array, a slice, a list and a string
    xs := [1, 2, 3];
    list: [..]int;
    list.add(1);
    text := "ab";
    misses := 0;
    for i in 0..4 {
        try {
            if i == 0 { n := xs[5 - i * 0]; }
            if i == 1 { n := third([7, 8]); }
            if i == 2 { n := list[1]; }
            if i == 3 { c := text[-1]; }
        } catch (e) {
            assert(e.is(Panic) && e.message.indexOf("is out of bounds") > 0);
            misses += 1;
        }
    }
    assert(misses == 4 && xs[2] == 3 && list[0] == 1 && text[1] == 'b');

    // A null pointer that is dereferenced is a Panic, which names the pointer: a member, a write, *p, an index into a
    // pointer and self of a method. The defers on the way run
    last := Link{value: 1};
    nothing: *Link;
    bytes: *u8;
    nulls := 0;
    deferred := 0;
    for i in 0..6 {
        try {
            defer deferred += 1;
            if i == 0 { n := last.next.value; }
            if i == 1 { last.next.value = 2; }
            if i == 2 { copy := *nothing; }
            if i == 3 { b := bytes[3]; }
            if i == 4 { n := last.nextValue(); }
            if i == 5 { n := nothing.nextValue(); }
        } catch (e) {
            assert(e.is(Panic));
            if i <= 1 || i == 4 { assert(e.message == "Null pointer dereference: self.next is null" || e.message == "Null pointer dereference: last.next is null"); }
            if i == 2 { assert(e.message == "Null pointer dereference: nothing is null"); }
            if i == 3 { assert(e.message == "Null pointer dereference: bytes is null"); }
            if i == 5 { assert(e.message == "Null pointer dereference: self is null"); }
            nulls += 1;
        }
    }
    assert(nulls == 6 && deferred == 6);

    // A failed assert is a Panic too, with the place of the assert first in its trace
    try {
        assert(misses == 0);
    } catch (e) {
        assert(e.message == "Assertion failed" && e.trace[0].line > 0);
    }

    // A catch can throw again, and the cause is kept
    try {
        load("cy");
    } catch (e) {
        assert(e.message == "loading failed" && e.is(NotFound) && e.cause.message == "no one is called cy");
    }

    // try and catch in a loop, and nothing is thrown after a catch
    count := 0;
    for i in 0..5 {
        try {
            if i % 2 == 1 { throw newError("odd"); }
            count += 1;
        } catch (e) {
            count += 10;
        }
    }
    assert(count == 23);
    assert(thrownError == null);

    print("errors ok");
}
