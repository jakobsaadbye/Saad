// Errors: a value when it is taken, thrown when it isn't, and caught with try and catch
use fmt;
import errors;

NotFound :: ErrorKind{"NotFound"};

// An error type of its own: a struct that embeds Error, with what a catch wants to know besides the message
QueryError :: struct {
    @embed base: Error;
    sql:  string;
    code: int;
}

Timeout :: struct {
    @embed base: Error;
    seconds: int;
}

// A switch on an error: a case for each error type, the first that it or a cause is, and else for the rest and null
describe :: (err: error) -> string {
    switch e in err {
        case *QueryError { return sprint("query % (%)", e.sql, e.code); }   // e: *QueryError
        case *Timeout    { return sprint("timeout after %", e.seconds); }   // e: *Timeout
        else             { if err == null { return "none"; } return err.message; }
    }
    return "";
}

query :: (sql: string) -> (int, error) {
    if sql == "" { return 0, errors.make("no sql"); }
    if sql.startsWith("DROP") { return 0, errors.typed(QueryError{sql: sql, code: 42}, "% isn't allowed", sql); }
    return 1, null;
}

find :: (name: string) -> (int, error) {
    if name == "ada" { return 36, null; }
    return 0, errors.make("no one is called %", name, kind: NotFound);
}

log: [..]string;

age :: (name: string) -> int {
    defer log.add(sprint("left age(%)", name));
    a := find(name);                       // The error isn't taken, so it is thrown
    return a + 1;
}

save :: (ok: bool) -> error {
    if ok { return null; }
    return errors.make("can't save %", 42);
}

third :: (sl: []int) -> int { return sl[2]; }

Link :: struct {
    value: int;
    next:  *Link;

    nextValue :: method () -> int { return self.next.value; }
}

divide :: (a: int, b: int) -> int {
    return a / b;
}

// An error thrown deeper is caught here, and a new one thrown with it as the cause
load :: (name: string) -> int {
    try {
        return age(name);
    } catch (err) {
        throw errors.make("loading failed", cause: err);
    }
    return 0;
}

main :: () {
    // Taken: a value
    a, err := find("bo");
    assert(a == 0 && err != null && err.message == "no one is called bo" && err.is(NotFound));
    b, none := find("ada");
    assert(b == 36 && none == null);

    // Not taken: thrown, through the defers, to the catch, with a frame for each function it left
    assert(age("ada") == 37);
    caught := false;
    try {
        age("bo");
        assert(false);                     // Not reached
    } catch (e) {
        caught = true;
        assert(e.is(NotFound) && e.trace.count == 2);
        assert(e.trace[0].function.toString() == "age" && e.trace[1].function.toString() == "main");
    }
    assert(caught && log.count == 2 && log[1] == "left age(bo)");

    // A function that gives only an error, as a statement, throws it
    save(true);
    try {
        save(false);
        assert(false);
    } catch (e) {
        assert(e.message == "can't save 42");
    }
    taken := save(false);                  // Taken: a value
    assert(taken.message == "can't save 42");

    // A division by zero is a Panic
    try {
        divide(1, 0);
        assert(false);
    } catch (e) {
        assert(e.is(Panic) && e.message == "Division by zero");
    }

    // An index outside of the elements is a Panic: of a fixed array, a slice, a list and a string
    xs := [1, 2, 3];
    list: [..]int;
    list.add(1);
    text := "ab";
    misses := 0;
    for i in 0..4 {
        try {
            if i == 0 { n := xs[5 - i * 0]; }
            if i == 1 { n := third([7, 8]); }
            if i == 2 { n := list[1]; }
            if i == 3 { c := text[-1]; }
        } catch (e) {
            assert(e.is(Panic) && e.message.indexOf("is out of bounds") > 0);
            misses += 1;
        }
    }
    assert(misses == 4 && xs[2] == 3 && list[0] == 1 && text[1] == 'b');

    // A null pointer that is dereferenced is a Panic, which names the pointer: a member, a write, *p, an index into a
    // pointer and the receiver of a method. The defers on the way run
    last := Link{value: 1};
    nothing: *Link;
    bytes: *u8;
    nulls := 0;
    deferred := 0;
    for i in 0..6 {
        try {
            defer deferred += 1;
            if i == 0 { n := last.next.value; }
            if i == 1 { last.next.value = 2; }
            if i == 2 { copy := *nothing; }
            if i == 3 { b := bytes[3]; }
            if i == 4 { n := last.nextValue(); }
            if i == 5 { n := nothing.nextValue(); }
        } catch (e) {
            assert(e.is(Panic));
            if i <= 1 || i == 4 { assert(e.message == "Null pointer dereference: self.next is null" || e.message == "Null pointer dereference: last.next is null"); }
            if i == 2 { assert(e.message == "Null pointer dereference: nothing is null"); }
            if i == 3 { assert(e.message == "Null pointer dereference: bytes is null"); }
            if i == 5 { assert(e.message == "Null pointer dereference: nothing is null"); }   // The call checks the receiver
            nulls += 1;
        }
    }
    assert(nulls == 6 && deferred == 6);

    // Taking an address only computes it, so &p[i] and &p.x of a null p don't throw, but a read on the way does
    at := &bytes[3];
    member := &nothing.next;
    assert(at as u64 == 3 && member as u64 == 8);
    try {
        through := &nothing.next.value;
        assert(false);
    } catch (e) {
        assert(e.message == "Null pointer dereference: nothing is null");
    }

    // A failed assert is a Panic too, with the place of the assert first in its trace
    try {
        assert(misses == 0);
    } catch (e) {
        assert(e.message == "Assertion failed" && e.trace[0].line > 0);
    }

    // A catch can throw again, and the cause is kept
    try {
        load("cy");
    } catch (e) {
        assert(e.message == "loading failed" && e.is(NotFound) && e.cause.message == "no one is called cy");
    }

    // try and catch in a loop, and nothing is thrown after a catch
    count := 0;
    for i in 0..5 {
        try {
            if i % 2 == 1 { throw errors.make("odd"); }
            count += 1;
        } catch (e) {
            count += 10;
        }
    }
    assert(count == 23);
    assert(thrownError == null);

    // An error type of its own: made with errors.typed, given as an error. The type is its kind, and 'as' gives it back,
    // also from the causes
    n, qerr := query("DROP users");
    assert(n == 0 && qerr.message == "DROP users isn't allowed" && qerr.kind.name == "QueryError");
    assert(qerr.is(QueryError) && !qerr.is(NotFound));
    q, ok := qerr as *QueryError;
    assert(ok && q.sql == "DROP users" && q.code == 42 && q.message == qerr.message);
    _, plain := query("");
    absent, found := plain as *QueryError;
    assert(!found && absent == null && !plain.is(QueryError));
    wrapped := errors.wrap(qerr, "loading %", "users");
    assert(wrapped.message == "loading users" && wrapped.is(QueryError) && (wrapped as *QueryError).code == 42);
    try {
        throw errors.typed(QueryError{sql: "x"}, "thrown");    // A *QueryError is an error
    } catch (e) {
        assert(e.is(QueryError) && (e as *QueryError).sql == "x" && e.trace.count == 1);
    }
    try {
        query("DROP posts");                                    // Not taken: thrown, and still a QueryError
    } catch (e) {
        assert((e as *QueryError).sql == "DROP posts");
    }
    try {
        other := plain as *QueryError;                          // Not one: a Panic
        assert(false);
    } catch (e) {
        assert(e.is(Panic) && e.message == "The error isn't a QueryError");
    }
    noError: error = null;
    _, isOne := noError as *QueryError;
    assert(!isOne);

    // A switch on an error
    assert(describe(qerr) == "query DROP users (42)");
    assert(describe(errors.typed(Timeout{seconds: 3}, "slow")) == "timeout after 3");
    assert(describe(errors.wrap(errors.typed(Timeout{seconds: 9}, "slow"), "loading")) == "timeout after 9");   // a cause
    assert(describe(plain) == "no sql" && describe(null) == "none");
    either := 0;
    for e in [qerr, errors.typed(Timeout{seconds: 1}, "slow") as error, plain] {
        switch x in e {
            case *QueryError
            case *Timeout { either += 1; assert(x.message.len > 0); }      // more types: x is the error
        }
    }
    assert(either == 2);
    seconds := switch t in errors.typed(Timeout{seconds: 5}, "slow") as error {
        case *Timeout => t.seconds;
        else => 0;
    };
    assert(seconds == 5);

    // Without values, the message is as written, so a % stays a %
    assert(errors.make("100% sure").message == "100% sure");

    print("errors ok");
}
