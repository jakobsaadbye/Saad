Counter :: struct <T> {
    value: T;
}

makeCounter :: (start: int) -> Counter<int> {
    return Counter<int>{start};
}

bump :: method <T>(c: *Counter<T>) -> T {
    c.value += 1;
    return c.value;
}

get :: method <T>(c: Counter<T>) -> T {
    return c.value;
}

main :: () {
    // The result of makeCounter() is not addressable, so it is put in a temporary whose address is passed.
    // The mutation only changes the temporary
    assert(makeCounter(5).bump() == 6);
    assert(makeCounter(5).get() == 5);

    c := makeCounter(1);
    makeCounter(100).bump();
    assert(c.value == 1);
}
