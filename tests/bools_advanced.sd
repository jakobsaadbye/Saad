main :: () {
    a := !false && true;
    b := !(2 <= 3 && 2 >= 4 || 5 == 6 && 7 < 3 && 5 > 9);
    c := 5 != 2;
    d := false && true || 3 == 2;
    e := false && true;
    f := 2.5 + 1.0 > 4.0 || 2.0 * 3.0 == 6.0;
    g := false == true;
    h := false != true;

    assert(a);
    assert(b);
    assert(c);
    assert(!d);
    assert(!e);
    assert(f);
    assert(!g);
    assert(h);
}