DogKind :: enum {
    samoid,
    chiwawa,
    bulldog,
}

Dog :: struct {
    kind : DogKind;
}

Status :: enum {
    ok = 1,
    created,

    badRequest = 400,
    permissionDenied,
    paymentRequired,
    forbidden,
    notFound,
    methodNotAllowed = xx (xx Status.badRequest + 5),
}

main :: () {
    // Checking enum values in struct + enum arithmetic
    dog1 := Dog{ .samoid };
    dog2 := Dog{ .bulldog };

    // Checking Auto-increment and const-expr inside enum
    assert(Status.ok == 1);
    assert(Status.created == 2);
    assert(Status.badRequest == 400);
    assert(Status.permissionDenied == 401);
    assert(Status.permissionDenied == 401);
    assert(Status.methodNotAllowed == 405);
}